color continuationColor = input.color(
     color.rgb(0, 181, 120),
     "Validated marker color",
     group = GROUP_DISPLAY,
     display = display.none)

//------------------------------------------------------------------------------
// Types and retained objects
//------------------------------------------------------------------------------

type ProfileCandidate
    int startTime = na
    int endTime = na
    int startBarIndex = na
    int endBarIndex = na
    int createdBarIndex = na
    float movementLow = na
    float movementHigh = na
    float val = na
    float poc = na
    float vah = na
    float cumulativeVolume = na
    float greenBarShare = na
    float greenVolumeShare = na
    float efficiency = na
    bool vahAccepted = false
    int vahCloseStreak = 0
    bool pocTestActive = false
    int nearPOCTestCount = 0
    bool nearPOCArmed = true
    float pocTestLow = na
    float pocTestDistance = na
    float pocTestATR = na
    int pocReclaimDeadline = na
    int readyBarIndex = na
    bool failed = false

type DisplayedProfile
    float val = na
    line valLine = na
    line pocLine = na
    line vahLine = na
    bool active = true

var array<ProfileCandidate> pendingCandidates =
     array.new<ProfileCandidate>()
var array<DisplayedProfile> displayedProfiles =
     array.new<DisplayedProfile>()
var array<box> retainedBoxes = array.new_box()
var array<line> retainedLines = array.new_line()
var array<label> retainedLabels = array.new_label()

var int provenOriginBarIndex = na
var int provenOriginTime = na

//------------------------------------------------------------------------------
// Helpers
//------------------------------------------------------------------------------

f_calculateHistoricalProfile(
     int oldestOffset,
     int newestOffset,
     int rowCount,
     float valueFraction) =>
    array<float> result = array.new_float(6, na)
    int span = oldestOffset - newestOffset
    float rangeLow = 1e20
    float rangeHigh = -1e20
    float cumulativeVolume = 0.0

    int rangeStep = 0
    while rangeStep <= span
        int offset = oldestOffset - rangeStep
        rangeLow := math.min(rangeLow, low[offset])
        rangeHigh := math.max(rangeHigh, high[offset])
        cumulativeVolume += nz(volume[offset])
        rangeStep += 1

    if rangeHigh > rangeLow and rowCount > 0
        float rowHeight = (rangeHigh - rangeLow) / rowCount
        array<float> rowVolumes = array.new_float(rowCount, 0.0)

        int candleStep = 0
        while candleStep <= span
            int offset = oldestOffset - candleStep
            float candleLow = low[offset]
            float candleHigh = high[offset]
            float candleVolume = nz(volume[offset])
            if candleHigh <= candleLow
                int closeRow = math.max(
                     0,
                     math.min(
                          rowCount - 1,
                          int(math.floor((close[offset] - rangeLow) / rowHeight))))
                array.set(
                     rowVolumes,
                     closeRow,
                     array.get(rowVolumes, closeRow) + candleVolume)
            else
                int rowIndex = 0
                while rowIndex < rowCount
                    float rowLow = rangeLow + rowIndex * rowHeight
                    float rowHigh = rowLow + rowHeight
                    float overlap = math.max(
                         0.0,
                         math.min(candleHigh, rowHigh) -
                              math.max(candleLow, rowLow))
                    if overlap > 0.0
                        float allocatedVolume =
                             candleVolume * overlap /
                                  (candleHigh - candleLow)
                        array.set(
                             rowVolumes,
                             rowIndex,
                             array.get(rowVolumes, rowIndex) +
                                  allocatedVolume)
                    rowIndex += 1
            candleStep += 1

        int pocRow = 0
        float pocRowVolume = array.get(rowVolumes, 0)
        int rowScan = 1
        while rowScan < rowCount
            float candidateVolume = array.get(rowVolumes, rowScan)
            if candidateVolume > pocRowVolume
                pocRow := rowScan
                pocRowVolume := candidateVolume
            rowScan += 1

        int valueLowRow = pocRow
        int valueHighRow = pocRow
        float includedVolume = pocRowVolume
        float targetVolume = cumulativeVolume * valueFraction
        while includedVolume < targetVolume and
             (valueLowRow > 0 or valueHighRow < rowCount - 1)
            float belowVolume =
                 valueLowRow > 0 ?
                 array.get(rowVolumes, valueLowRow - 1) : -1.0
            float aboveVolume =
                 valueHighRow < rowCount - 1 ?
                 array.get(rowVolumes, valueHighRow + 1) : -1.0
            if aboveVolume >= belowVolume
                valueHighRow += 1
                includedVolume +=
                     array.get(rowVolumes, valueHighRow)
            else
                valueLowRow -= 1
                includedVolume +=
                     array.get(rowVolumes, valueLowRow)

        array.set(result, 0, rangeLow + valueLowRow * rowHeight)
        array.set(result, 1, rangeLow + (pocRow + 0.5) * rowHeight)
        array.set(result, 2, rangeLow + (valueHighRow + 1.0) * rowHeight)
        array.set(result, 3, rangeLow)
        array.set(result, 4, rangeHigh)
        array.set(result, 5, cumulativeVolume)
    result

f_candidateAlreadyExists(int startBar, int endBar) =>
    bool found = false
    int index = 0
    while index < array.size(pendingCandidates) and not found
        ProfileCandidate candidate =
             array.get(pendingCandidates, index)
        if candidate.startBarIndex == startBar and
             candidate.endBarIndex == endBar
            found := true
        index += 1
    found

f_retainBox(box newBox) =>
    array.push(retainedBoxes, newBox)
    if array.size(retainedBoxes) > maximumHistoricalRanges
        box.delete(array.shift(retainedBoxes))

f_retainLine(line newLine) =>
    array.push(retainedLines, newLine)
    if array.size(retainedLines) > maximumHistoricalRanges * 3
        line.delete(array.shift(retainedLines))

f_retainLabel(label newLabel) =>
    array.push(retainedLabels, newLabel)
    if array.size(retainedLabels) > maximumHistoricalRanges
        label.delete(array.shift(retainedLabels))

//------------------------------------------------------------------------------
// Shared series
//------------------------------------------------------------------------------

float atrValue = ta.atr(atrLength)
float volumeAverage = ta.sma(volume, volumeAverageLength)
float candleRange = high - low
float candleCloseLocation =
     candleRange > 0.0 ? (close - low) / candleRange : 0.5
float previousRange = high[1] - low[1]
float previousCloseLocation =
     previousRange > 0.0 ?
     (close[1] - low[1]) / previousRange : 0.5

bool timeframeSupported =
     timeframe.isminutes and timeframe.multiplier <= maximumChartMinutes
bool inAnalysisSession =
     not na(time(timeframe.period, analysisSession))
int dateKey = year * 10000 + month * 100 + dayofmonth
bool newTradingDate = bar_index > 0 and dateKey != dateKey[1]

if newTradingDate
    array.clear(pendingCandidates)
    provenOriginBarIndex := na
    provenOriginTime := na

//------------------------------------------------------------------------------
// Candidate discovery
//------------------------------------------------------------------------------

bool rejectionAfterRange =
     barstate.isconfirmed and
     timeframeSupported and
     inAnalysisSession and
     close < close[1] and
     close < open and
     candleCloseLocation <= rejectionMaximumCloseLocation and
     previousCloseLocation >=
          math.min(
               rangeEndMinimumCloseLocation,
               rotationalMinimumEndCloseLocation)

if rejectionAfterRange and not na(atrValue[1])
    bool provenOriginActive =
         not na(provenOriginBarIndex) and
         not na(provenOriginTime) and
         bar_index - 1 > provenOriginBarIndex and
         bar_index - 1 - provenOriginBarIndex + 1 <= maximumRangeBars and
         time[1] - provenOriginTime <=
              provenOriginMaximumSpanMinutes * 60000

    int candidateBars =
         math.min(minimumRangeBars, compactMaximumBars)
    while candidateBars <= maximumRangeBars and
         candidateBars + 1 <= bar_index
        int startOffset = candidateBars
        int endOffset = 1
        int candidateStartBarIndex = bar_index - startOffset
        int candidateEndBarIndex = bar_index - endOffset

        bool allowedByProvenOrigin =
             not provenOriginActive or
             candidateStartBarIndex == provenOriginBarIndex

        float originRange = high[startOffset] - low[startOffset]
        float originCloseLocation =
             originRange > 0.0 ?
             (close[startOffset] - low[startOffset]) /
                  originRange : 0.5
        float originRelativeVolume =
             not na(volumeAverage[startOffset]) and
             volumeAverage[startOffset] > 0.0 ?
             volume[startOffset] /
                  volumeAverage[startOffset] : na
        bool originContextQualified =
             allowedByProvenOrigin and
             dateKey[startOffset] == dateKey and
             inAnalysisSession[startOffset] and
             not na(originRelativeVolume) and
             close[startOffset] > open[startOffset] and
             originRelativeVolume >= originMinimumRelativeVolume
        bool standardOriginQualified =
             originContextQualified and
             originCloseLocation >= originMinimumCloseLocation and
             (
                  close[startOffset + 1] <= open[startOffset + 1] or
                  close[startOffset] > high[startOffset + 1]
             )
        float originRangeATR =
             not na(atrValue[startOffset]) and
             atrValue[startOffset] > 0.0 ?
             originRange / atrValue[startOffset] : 0.0
        float originBodyATR =
             not na(atrValue[startOffset]) and
             atrValue[startOffset] > 0.0 ?
             (close[startOffset] - open[startOffset]) /
                  atrValue[startOffset] : 0.0
        bool compactOriginQualified =
             originContextQualified and
             originCloseLocation >=
                  compactOriginMinimumCloseLocation and
             high[startOffset] > high[startOffset + 1] and
             originRangeATR >= compactOriginMinimumRangeATR and
             originBodyATR >= compactOriginMinimumBodyATR
        bool originQualified =
             standardOriginQualified or compactOriginQualified

        if originQualified
            float candidateLow = 1e20
            float candidateHigh = -1e20
            float candidateVolume = 0.0
            float candidateGreenVolume = 0.0
            int candidateGreenBars = 0
            float closeTravel = 0.0
            bool gapsValid = true

            int metricStep = 0
            while metricStep < candidateBars
                int offset = startOffset - metricStep
                candidateLow := math.min(candidateLow, low[offset])
                candidateHigh := math.max(candidateHigh, high[offset])
                candidateVolume += nz(volume[offset])
                if close[offset] > open[offset]
                    candidateGreenBars += 1
                    candidateGreenVolume += nz(volume[offset])
                if metricStep > 0
                    closeTravel +=
                         math.abs(close[offset] - close[offset + 1])
                if metricStep > 0 and
                     time[offset] - time[offset + 1] >
                          maximumGapMinutes * 60000
                    gapsValid := false
                metricStep += 1

            float candidateRange = candidateHigh - candidateLow
            float greenBarShare =
                 candidateGreenBars * 1.0 / candidateBars
            float greenVolumeShare =
                 candidateVolume > 0.0 ?
                 candidateGreenVolume / candidateVolume : 0.0
            float directionalEfficiency =
                 closeTravel > 0.0 ?
                 math.max(
                      0.0,
                      close[endOffset] - close[startOffset]) /
                      closeTravel : 0.0
            float candidateRangeATR =
                 not na(atrValue[endOffset]) and
                 atrValue[endOffset] > 0.0 ?
                 candidateRange / atrValue[endOffset] : 0.0
            bool originFloorHeld =
                 candidateLow >=
                      low[startOffset] -
                      atrValue[startOffset] *
                           originFloorToleranceATR
            float endCloseLocation =
                 candidateRange > syminfo.mintick ?
                 (close[endOffset] - candidateLow) /
                      candidateRange
                 : 0.0
            bool compactBurst =
                 candidateBars <= compactMaximumBars and
                 compactOriginQualified and
                 candidateRangeATR >= compactMinimumRangeATR and
                 greenBarShare >= compactMinimumGreenBarShare and
                 greenVolumeShare >=
                      compactMinimumGreenVolumeShare and
                 directionalEfficiency >=
                      compactMinimumDirectionalEfficiency
            bool rotationalExpansion =
                 candidateBars <= rotationalMaximumBars and
                 candidateRangeATR >= rotationalMinimumRangeATR and
                 originRelativeVolume >=
                      rotationalMinimumOriginRelativeVolume and
                 originBodyATR >= rotationalMinimumOriginBodyATR and
                 directionalEfficiency >=
                      rotationalMinimumDirectionalEfficiency
            bool standardRange =
                 candidateBars >= minimumRangeBars and
                 candidateRangeATR >= minimumRangeATR
            bool endLocationQualified =
                 endCloseLocation >= rangeEndMinimumCloseLocation or
                 (
                      rotationalExpansion and
                      endCloseLocation >=
                           rotationalMinimumEndCloseLocation
                 )
            bool terminalCandleQualified =
                 previousCloseLocation >=
                      rangeEndMinimumCloseLocation or
                 compactBurst or rotationalExpansion
            bool originParticipationQualified =
                 provenOriginActive or
                 (
                      candidateVolume > 0.0 and
                      volume[startOffset] / candidateVolume >=
                           originMinimumRangeVolumeShare
                 )
            bool candidateQualified =
                 gapsValid and
                 originFloorHeld and
                 (standardRange or compactBurst) and
                 endLocationQualified and
                 terminalCandleQualified and
                 originParticipationQualified and
                 candidateVolume >= minimumCumulativeVolume and
                 greenBarShare >= minimumGreenBarShare and
                 greenVolumeShare >= minimumGreenVolumeShare and
                 (
                      directionalEfficiency >=
                           minimumDirectionalEfficiency or
                      compactBurst or rotationalExpansion
                 ) and
                 not f_candidateAlreadyExists(
                      candidateStartBarIndex,
                      candidateEndBarIndex)

            if candidateQualified
                array<float> profile =
                     f_calculateHistoricalProfile(
                          startOffset,
                          endOffset,
                          profileRows,
                          valueAreaPercent / 100.0)
                float candidateVAL = array.get(profile, 0)
                float candidatePOC = array.get(profile, 1)
                float candidateVAH = array.get(profile, 2)

                if not na(candidateVAL) and
                     not na(candidatePOC) and
                     not na(candidateVAH)
                    int vahStreak = 0
                    int maximumVAHStreak = 0
                    int acceptanceStep = 0
                    while acceptanceStep < candidateBars
                        int offset = startOffset - acceptanceStep
                        if close[offset] > candidateVAH
                            vahStreak += 1
                            maximumVAHStreak :=
                                 math.max(
                                      maximumVAHStreak,
                                      vahStreak)
                        else
                            vahStreak := 0
                        acceptanceStep += 1

                    ProfileCandidate newCandidate =
                         ProfileCandidate.new(
                              startTime = time[startOffset],
                              // Store the opening time of the last accepted
                              // range bar. Drawing uses its bar index below,
                              // so the confirming rejection bar can never be
                              // included visually, even across a halt gap.
                              endTime = time[endOffset],
                              startBarIndex =
                                   candidateStartBarIndex,
                              endBarIndex = candidateEndBarIndex,
                              createdBarIndex = bar_index,
                              movementLow = candidateLow,
                              movementHigh = candidateHigh,
                              val = candidateVAL,
                              poc = candidatePOC,
                              vah = candidateVAH,
                              cumulativeVolume = candidateVolume,
                              greenBarShare = greenBarShare,
                              greenVolumeShare =
                                   greenVolumeShare,
                              efficiency = directionalEfficiency,
                              vahAccepted =
                                   maximumVAHStreak >=
                                        requiredVAHAcceptanceCloses,
                              vahCloseStreak = vahStreak)
                    array.push(pendingCandidates, newCandidate)

        candidateBars += 1

// Keep the hidden set bounded. Confirmed drawings are retained separately.
while array.size(pendingCandidates) > 60
    array.shift(pendingCandidates)

//------------------------------------------------------------------------------
// VAH acceptance and the first POC return
//------------------------------------------------------------------------------

if barstate.isconfirmed and timeframeSupported and
     array.size(pendingCandidates) > 0
    int candidateIndex = 0
    while candidateIndex < array.size(pendingCandidates)
        ProfileCandidate candidate =
             array.get(pendingCandidates, candidateIndex)

        if not candidate.failed and
             na(candidate.readyBarIndex) and
             bar_index >= candidate.createdBarIndex
            if bar_index - candidate.createdBarIndex >
                 candidateExpiryBars
                candidate.failed := true
            else
                bool exactPOCTest =
                     low <= candidate.poc and
                     high >= candidate.poc
                bool nearPOCTest =
                     low > candidate.poc and
                     low <= candidate.poc +
                          atrValue * pocFrontRunAllowanceATR

                if not candidate.pocTestActive and
                     not candidate.nearPOCArmed and
                     high >= candidate.poc +
                          atrValue * nearPOCRearmATR
                    candidate.nearPOCArmed := true

                if not candidate.pocTestActive and
                     nearPOCTest and
                     candidate.nearPOCArmed
                    candidate.nearPOCTestCount += 1
                    candidate.nearPOCArmed := false

                bool confirmedNearPOCTest =
                     nearPOCTest and
                     candidate.nearPOCTestCount >=
                          requiredNearPOCTests
                bool qualifyingPOCReturn =
                     exactPOCTest or confirmedNearPOCTest

                // The POC event is evaluated before the current close can add
                // another VAH-acceptance bar. This preserves the event order.
                if not candidate.pocTestActive and
                     qualifyingPOCReturn
                    if not candidate.vahAccepted
                        candidate.failed := true
                    else
                        candidate.pocTestActive := true
                        candidate.pocTestLow := low
                        candidate.pocTestDistance :=
                             math.abs(low - candidate.poc)
                        candidate.pocTestATR := atrValue
                        candidate.pocReclaimDeadline :=
                             bar_index + pocReclaimWindowBars

                if candidate.pocTestActive and not candidate.failed
                    candidate.pocTestLow :=
                         math.min(candidate.pocTestLow, low)
                    bool pocReclaimed =
                         close >= candidate.poc -
                              atrValue * pocCloseToleranceATR
                    if pocReclaimed
                        candidate.readyBarIndex := bar_index
                    else if bar_index >=
                         candidate.pocReclaimDeadline
                        candidate.failed := true
                else if not qualifyingPOCReturn and
                     not candidate.failed
                    if close > candidate.vah
                        candidate.vahCloseStreak += 1
                    else
                        candidate.vahCloseStreak := 0
                    if candidate.vahCloseStreak >=
                         requiredVAHAcceptanceCloses
                        candidate.vahAccepted := true

        array.set(
             pendingCandidates,
             candidateIndex,
             candidate)
        candidateIndex += 1

// Select one historical range when several candidates explain the same POC
// response. First find the closest normalized POC, then treat candidates within
// 0.25 ATR as the same retest cluster and choose its earliest qualified origin.
int bestCandidateIndex = na
float minimumNormalizedPOCDistance = 1e20
if barstate.isconfirmed and array.size(pendingCandidates) > 0
    int readyScan = 0
    while readyScan < array.size(pendingCandidates)
        ProfileCandidate candidate =
             array.get(pendingCandidates, readyScan)
        if not candidate.failed and
             candidate.readyBarIndex == bar_index and
             not na(candidate.pocTestATR) and
             candidate.pocTestATR > 0.0
            minimumNormalizedPOCDistance :=
                 math.min(
                      minimumNormalizedPOCDistance,
                      candidate.pocTestDistance /
                           candidate.pocTestATR)
        readyScan += 1

    int clusterScan = 0
    int earliestClusterStart = na
    while clusterScan < array.size(pendingCandidates)
        ProfileCandidate candidate =
             array.get(pendingCandidates, clusterScan)
        bool inBestRetestCluster =
             not candidate.failed and
             candidate.readyBarIndex == bar_index and
             not na(candidate.pocTestATR) and
             candidate.pocTestATR > 0.0 and
             candidate.pocTestDistance /
                  candidate.pocTestATR <=
                  minimumNormalizedPOCDistance + 0.25
        if inBestRetestCluster and
             (
                  na(earliestClusterStart) or
                  candidate.startBarIndex < earliestClusterStart
             )
            earliestClusterStart := candidate.startBarIndex
            bestCandidateIndex := clusterScan
        clusterScan += 1

bool newValidatedRange = not na(bestCandidateIndex)

// Keep every validated profile visible until a completed candle closes below
// its own VAL. Intrabar movement below VAL does not terminate the levels.
if barstate.isconfirmed and timeframeSupported and
     array.size(displayedProfiles) > 0
    int displayedIndex = 0
    while displayedIndex < array.size(displayedProfiles)
        DisplayedProfile displayed =
             array.get(displayedProfiles, displayedIndex)
        if displayed.active
            line.set_x2(displayed.valLine, bar_index)
            line.set_x2(displayed.pocLine, bar_index)
            line.set_x2(displayed.vahLine, bar_index)
            if close < displayed.val
                displayed.active := false
            array.set(
                 displayedProfiles,
                 displayedIndex,
                 displayed)
        displayedIndex += 1

if newValidatedRange
    ProfileCandidate selected =
         array.get(pendingCandidates, bestCandidateIndex)

    // A newly validated profile replaces every older profile as the active
    // reference. Older levels remain visible historically through this
    // validation candle, but they no longer extend on subsequent bars.
    if array.size(displayedProfiles) > 0
        int olderProfileIndex = 0
        while olderProfileIndex < array.size(displayedProfiles)
            DisplayedProfile olderProfile =
                 array.get(
                      displayedProfiles,
                      olderProfileIndex)
            if olderProfile.active
                line.set_x2(olderProfile.valLine, bar_index)
                line.set_x2(olderProfile.pocLine, bar_index)
                line.set_x2(olderProfile.vahLine, bar_index)
                olderProfile.active := false
                array.set(
                     displayedProfiles,
                     olderProfileIndex,
                     olderProfile)
            olderProfileIndex += 1

    if showRangeBox
        box rangeBox = box.new(
             left = selected.startBarIndex,
             top = selected.movementHigh,
             right = selected.endBarIndex,
             bottom = selected.movementLow,
             xloc = xloc.bar_index,
             border_color = color.new(vahColor, 45),
             border_width = 1,
             bgcolor = color.new(vahColor, 91))
        f_retainBox(rangeBox)

    line valLine = line.new(
         x1 = selected.startBarIndex,
         y1 = selected.val,
         x2 = bar_index,
         y2 = selected.val,
         xloc = xloc.bar_index,
         extend = extend.none,
         color = color.new(valColor, 20),
         width = 1)
    line vahLine = line.new(
         x1 = selected.startBarIndex,
         y1 = selected.vah,
         x2 = bar_index,
         y2 = selected.vah,
         xloc = xloc.bar_index,
         extend = extend.none,
         color = vahColor,
         width = 1)
    line pocLine = line.new(
         x1 = selected.startBarIndex,
         y1 = selected.poc,
         x2 = bar_index,
         y2 = selected.poc,
         xloc = xloc.bar_index,
         extend = extend.none,
         color = pocColor,
         width = 1,
         style = line.style_dashed)
    f_retainLine(valLine)
    f_retainLine(vahLine)
    f_retainLine(pocLine)

    DisplayedProfile displayedProfile =
         DisplayedProfile.new(
              val = selected.val,
              valLine = valLine,
              pocLine = pocLine,
              vahLine = vahLine)
    array.push(displayedProfiles, displayedProfile)
    if array.size(displayedProfiles) > maximumHistoricalRanges
        array.shift(displayedProfiles)

    if showValidationLabel
        string rangeText =
             "FRVP VAH→POC\n" +
             str.format_time(selected.startTime, "HH:mm") +
             "–" +
             str.format_time(selected.endTime, "HH:mm") +
             "\nPOC " +
             str.tostring(selected.poc, format.mintick) +
             " • VAH " +
             str.tostring(selected.vah, format.mintick)
        label validationLabel = label.new(
             x = bar_index,
             y = low,
             text = rangeText,
             xloc = xloc.bar_index,
             yloc = yloc.belowbar,
             style = label.style_label_up,
             color = continuationColor,
             textcolor = color.white,
             size = size.tiny)
        f_retainLabel(validationLabel)

    provenOriginBarIndex := selected.startBarIndex
    provenOriginTime := selected.startTime

    // Only one range is revealed for one POC response. Every competing ready
    // candidate is retired after the best historical explanation is selected.
    int retireIndex = 0
    while retireIndex < array.size(pendingCandidates)
        ProfileCandidate candidate =
             array.get(pendingCandidates, retireIndex)
        if candidate.readyBarIndex == bar_index
            candidate.failed := true
            array.set(
                 pendingCandidates,
                 retireIndex,
                 candidate)
        retireIndex += 1

alertcondition(
     newValidatedRange,
     "Validated VAH acceptance with POC retest",
     "A bullish volume profile accepted above VAH before its first qualifying POC return and has now reclaimed POC.")
