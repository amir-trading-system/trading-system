//@version=6
indicator(
     "Volume Profile: Price Acceptance Above VAH with POC Retest v2.3",
     shorttitle = "VP VAH→POC v2.3",
     overlay = true,
     max_bars_back = 5000,
     max_lines_count = 300,
     max_boxes_count = 100,
     max_labels_count = 100)

//==============================================================================
// Purpose
//------------------------------------------------------------------------------
// This version intentionally detects only one structure:
//
//   clean bullish auction
//        → final VAH receives two completed closes before the first POC return
//        → first exact POC test, or a repeated near-POC floor, reclaims POC
//        → reveal the historical FRVP range.
//
// Important implementation details:
//   • VAH acceptance may occur inside the last bars of the completed range.
//   • A rejection candle freezes the range at the immediately preceding bar;
//     the rejection/confirmation candle is never included in the profile.
//   • Several possible bullish subranges remain hidden simultaneously. This is
//     what allows WYHG 2026-08-06 to select 09:47–10:00 instead of committing
//     early to 09:30 and extending through 10:05.
//   • When an origin proves itself, a later higher expansion may reuse the same
//     origin. This preserves both WETO 09:33–09:54 and 09:33–10:24.
//   • The profile is approximate because Pine cannot read TradingView's built-
//     in FRVP values. Each chart candle's volume is distributed uniformly over
//     the price rows crossed by that candle.
//==============================================================================

const string GROUP_RANGE   = "1. Bullish range"
const string GROUP_PROFILE = "2. Fixed-range volume profile"
const string GROUP_RULE    = "3. VAH acceptance → POC retest"
const string GROUP_DISPLAY = "4. Display"

string analysisSession = input.session(
     "0400-2000",
     "Analysis session",
     group = GROUP_RANGE,
     display = display.none)

int maximumChartMinutes = input.int(
     5,
     "Maximum supported chart timeframe (minutes)",
     minval = 1,
     maxval = 15,
     group = GROUP_RANGE,
     display = display.none)

int atrLength = input.int(
     14,
     "ATR length",
     minval = 5,
     maxval = 100,
     group = GROUP_RANGE,
     display = display.none)

int volumeAverageLength = input.int(
     20,
     "Volume average length",
     minval = 5,
     maxval = 100,
     group = GROUP_RANGE,
     display = display.none)

int minimumRangeBars = input.int(
