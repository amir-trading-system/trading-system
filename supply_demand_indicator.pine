//@version=6
indicator("Bullish Supply→Demand Flip Zones [v6.30.9 • Three-Bar Evidence Survival]", overlay = true, max_bars_back = 5000, max_boxes_count = 500, max_labels_count = 500)

// Invisible output anchor for TradingView editor compatibility.
plot(na, title = "Output anchor", display = display.none)

// This indicator detects bullish demand-retest zones from supply flips and continuation bases:
//   1. A rejection pivot starts a live-safe supply formation. The formation extends forward until participation collapses
//      or price clearly disengages beneath the evolving supply band.
//      Its top is the highest high and its bottom is the highest close before the collapse bar.
//   2. A compact multi-bar rejection shelf may qualify collectively when no
//      single bar carries all of the body, volume, and trend evidence.
//   3. The seller-control structure must terminate at confirmed demand.
//   4. Supply may flip through a high-quality final break candle or a strong breakout impulse followed by acceptance.
//   5. After confirmation, all drawings stay hidden while retest logic remains active.
//   6. The full original supply structure appears when price first returns to the zone.
//   7. A zone touch or fresh re-entry controls visibility/state only; it never draws an S→D arrow by itself.
//   8. An S→D arrow requires either confirmed pivot support at the flipped zone or
//      a confirmed immediate post-breakout front-run defense.
//   9. A separate continuation-base path recognizes compact high-volume bullish shelves that launch higher.
//  10. Classic retests require a completed candle whose low is above the zone top before the return.
//  11. A separate progressive-takeover path allows demand to defend the lower edge, preserve its low,
//      and then confirm acceptance above the upper edge on renewed volume.
//  12. A separate immediate front-run path recognizes the first full-separation candle when it
//      approaches the old supply top after an exceptional breakout, rejects lower prices, and
//      preserves its low for the configured confirmation bars.
//  13. When multiple visible zones substantially overlap, an optional display
//      filter keeps only the broadest price area visible.
//  14. Timestamp-based candle-edge coordinates let zones begin on the true
//      origin bar without drawing the left border through its wick.
//  15. A supply retest that fails before confirmed S→D demand is removed entirely.
//      Only zones with confirmed demand preserve their successful history after a later break.
//  16. When drawing history reaches its limit, hidden and unconfirmed zones are
//      retired before confirmed S→D/BASE areas, preventing orphan arrows.
//  17. Broad-zone suppression requires the shaded rectangles to overlap in both
//      price and time; an unrelated zone from another session cannot hide one.
//  18. Every BASE/S→D area must survive three later bars after its evidence
//      becomes knowable live. An earlier breakdown removes the entire area.

// ─────────────────────── Inputs ─────────────────────────
groupSupply = "1. Hidden supply qualification"
pivotLeft = input.int(3, "Pivot bars left", minval = 1, maxval = 20, group = groupSupply, display = display.none)
pivotRight = input.int(3, "Pivot bars right", minval = 1, maxval = 20, group = groupSupply, display = display.none)
allowBearishSupplyCandle = input.bool(true, "Allow bearish rejection supply candle", group = groupSupply,
     tooltip = "Allows high-volume bearish rejection origins such as SDOT 2026-06-29 10:24. All wick, departure, trend, and volume filters still apply.", display = display.none)
minBearishOriginBodyAtr = input.float(0.45, "Bearish origin minimum body (ATR)", minval = 0.0, step = 0.05, group = groupSupply,
     tooltip = "Prevents small ordinary red candles from qualifying as bearish supply origins.", display = display.none)
minUpperWickAtr = input.float(0.10, "Minimum upper wick (ATR)", minval = 0.0, step = 0.05, group = groupSupply, display = display.none)
minBearishDepartureAtr = input.float(0.50, "Minimum bearish departure (ATR)", minval = 0.1, step = 0.05, group = groupSupply, display = display.none)
maxHiddenAge = input.int(750, "Maximum hidden-zone age (bars)", minval = 20, maxval = 5000, group = groupSupply, display = display.none)
maxHiddenCandidates = input.int(75, "Maximum hidden candidates", minval = 5, maxval = 250, group = groupSupply, display = display.none)

groupSupplyStructure = "1a. Multi-bar supply structure"
expandSupplyStructure = input.bool(true, "Expand pivot into multi-bar supply structure", group = groupSupplyStructure,
     tooltip = "Walks backward through contiguous high-volume rejection bars that touched the pivot's supply band. The price band remains defined by the pivot.", display = display.none)
minSupplyStructureBars = input.int(3, "Minimum supply-structure bars", minval = 2, maxval = 10, group = groupSupplyStructure,
     tooltip = "The effective minimum is capped at Pivot bars left + 1 because the structure scan stays inside the confirmed pivot window.", display = display.none)
structureTouchBufferAtr = input.float(0.05, "Structure touch buffer (ATR)", minval = 0.0, step = 0.05, group = groupSupplyStructure, display = display.none)
structureCloseBufferAtr = input.float(0.10, "Structure close buffer (ATR)", minval = 0.0, step = 0.05, group = groupSupplyStructure,
     tooltip = "A participating bar must touch the supply band and then close back at or below its proximal boundary, allowing this buffer.", display = display.none)
useForwardVolumeSupplyFormation = input.bool(true, "Extend supply until volume collapses", group = groupSupplyStructure,
     tooltip = "Starts at the confirmed supply pivot and extends forward through the active high-participation formation. The first collapse bar ends the scan but is not included in the zone.", display = display.none)
maxForwardSupplyFormationBars = input.int(10, "Maximum forward supply-formation bars", minval = 4, maxval = 30, group = groupSupplyStructure,
     tooltip = "Safety cap including the original supply bar. If no dramatic collapse occurs, the formation freezes after this many bars.", display = display.none)
formationCollapsePreviousRatio = input.float(0.45, "Volume collapse vs previous bar", minval = 0.05, maxval = 1.0, step = 0.05, group = groupSupplyStructure,
     tooltip = "A bar may end the formation when its volume is at or below this fraction of the previous included bar's volume.", display = display.none)
formationCollapsePeakRatio = input.float(0.35, "Volume collapse vs formation peak", minval = 0.05, maxval = 1.0, step = 0.05, group = groupSupplyStructure,
     tooltip = "Also detects gradual fading by comparing the current bar with the highest volume already included in the formation.", display = display.none)
formationCollapseRequiresBelowAverage = input.bool(true, "Collapse bar must be below volume average", group = groupSupplyStructure,
     tooltip = "Recommended. Prevents one merely quieter but still highly active bar from ending the supply formation.", display = display.none)
enableCollectiveSupplyShelves = input.bool(true, "Allow compact multi-bar supply shelves", group = groupSupplyStructure,
     tooltip = "Allows several compact rejection bars to qualify together when the final pivot bar narrowly misses the single-candle body, volume, or trend-location rules.", display = display.none)
collectiveSupplyBars = input.int(3, "Collective supply-shelf bars", minval = 3, maxval = 5, group = groupSupplyStructure,
     tooltip = "The compact shelf must end on the confirmed pivot high. Three bars captures SDOT 2026-06-03 07:10–07:12.", display = display.none)
collectiveMaxHighSpreadAtr = input.float(0.50, "Collective shelf maximum high spread (ATR)", minval = 0.05, step = 0.05, group = groupSupplyStructure,
     tooltip = "Keeps the bars clustered near one rejected price ceiling instead of treating an accelerating rally as supply.", display = display.none)
collectiveMaxCloseSpreadAtr = input.float(0.50, "Collective shelf maximum close spread (ATR)", minval = 0.05, step = 0.05, group = groupSupplyStructure,
     tooltip = "Requires closing prices to remain compact while supply is forming.", display = display.none)
collectiveMinAggregateRelativeVolume = input.float(1.00, "Collective shelf minimum aggregate relative volume", minval = 0.10, step = 0.10, group = groupSupplyStructure,
     tooltip = "Compares the shelf's total volume with the sum of its per-bar volume averages.", display = display.none)
collectiveMinClosesAboveTrend = input.int(2, "Collective shelf closes above EMA/VWAP", minval = 1, maxval = 5, group = groupSupplyStructure,
     tooltip = "Minimum shelf bars that must close above EMA 9, EMA 20, and session VWAP.", display = display.none)
collectiveMinPriorAdvanceAtr = input.float(0.50, "Collective shelf minimum prior advance (ATR)", minval = 0.0, step = 0.05, group = groupSupplyStructure,
     tooltip = "Requires price to advance into the shelf before the rejection develops.", display = display.none)

groupSellerLeg = "1b. Seller-control leg and demand termination"
requireSellerControlLeg = input.bool(true, "Require completed seller-control leg", group = groupSellerLeg,
     tooltip = "Requires supply to produce a multi-bar decline that ends at confirmed demand before it can flip to demand.", display = display.none)
demandPivotLeft = input.int(3, "Demand pivot bars left", minval = 1, maxval = 10, group = groupSellerLeg, display = display.none)
demandPivotRight = input.int(3, "Demand pivot bars right", minval = 1, maxval = 10, group = groupSellerLeg, display = display.none)
minSellerLegBars = input.int(3, "Minimum seller-leg bars", minval = 1, maxval = 50, group = groupSellerLeg, display = display.none)
maxSellerLegBars = input.int(30, "Maximum seller-leg bars", minval = 3, maxval = 100, group = groupSellerLeg, display = display.none)
collectiveMaxSellerLegBars = input.int(40, "Multi-bar supply maximum seller-leg bars", minval = 3, maxval = 100, group = groupSellerLeg,
     tooltip = "Applies only when the supply origin spans multiple bars. It lets an extended seller-controlled decline reach its final confirmed demand without changing the 30-bar limit for single-bar supply.", display = display.none)
minSellerLegAtr = input.float(1.50, "Minimum supply-to-demand decline (ATR)", minval = 0.1, step = 0.25, group = groupSellerLeg, display = display.none)
minDemandLowerWickAtr = input.float(0.10, "Demand minimum lower wick (ATR)", minval = 0.0, step = 0.05, group = groupSellerLeg, display = display.none)
minDemandReactionAtr = input.float(0.75, "Minimum reaction from demand (ATR)", minval = 0.1, step = 0.25, group = groupSellerLeg, display = display.none)
minDemandRelativeVolume = input.float(0.80, "Demand/reaction minimum relative volume", minval = 0.1, step = 0.1, group = groupSellerLeg,
     tooltip = "May qualify on the exact demand pivot or on a reaction candle before that pivot is confirmed.", display = display.none)
allowCompactSellerLeg = input.bool(true, "Allow compact high-volume seller leg", group = groupSellerLeg,
     tooltip = "Allows a 1-2 bar seller leg when the supply origin has exceptional volume and demand remains stable for the required right bars.", display = display.none)
compactMaxSellerLegBars = input.int(2, "Compact seller-leg maximum bars", minval = 1, maxval = 5, group = groupSellerLeg, display = display.none)
compactDemandRightBars = input.int(2, "Compact demand confirmation bars", minval = 1, maxval = 5, group = groupSellerLeg, display = display.none)
minCompactSupplyRelativeVolume = input.float(2.00, "Compact-leg supply minimum relative volume", minval = 1.0, step = 0.25, group = groupSellerLeg,
     tooltip = "Keeps compact pullbacks selective. SDOT 2026-07-17 07:09 measures approximately 3.87x average volume.", display = display.none)

groupContinuation = "1c. Bullish continuation-base zones"
enableContinuationBases = input.bool(true, "Detect bullish continuation bases", group = groupContinuation,
     tooltip = "Adds a separate live-safe path for compact, high-volume bullish shelves that immediately launch higher. It does not weaken the supply-flip rules.", display = display.none)
continuationMinBaseBars = input.int(3, "Minimum base bars", minval = 2, maxval = 8, group = groupContinuation, display = display.none)
continuationMaxBaseBars = input.int(5, "Maximum base bars", minval = 2, maxval = 10, group = groupContinuation,
     tooltip = "The detector tests the longest qualifying base first. Keep this at or above Minimum base bars.", display = display.none)
continuationZoneFloor = input.string("Lowest close", "Continuation-zone lower boundary",
     options = ["Lowest close", "Highest body low"], group = groupContinuation,
     tooltip = "Lowest close captures the full accepted shelf. Highest body low creates a narrower, more conservative zone.", display = display.none)
continuationMinAverageRelativeVolume = input.float(1.50, "Base minimum average relative volume", minval = 0.1, step = 0.25, group = groupContinuation, display = display.none)
continuationMinBarRelativeVolume = input.float(0.80, "Each base bar minimum relative volume", minval = 0.1, step = 0.10, group = groupContinuation, display = display.none)
continuationHighVolumeThreshold = input.float(1.50, "High-volume base-bar threshold", minval = 0.1, step = 0.25, group = groupContinuation, display = display.none)
continuationMinHighVolumeBars = input.int(2, "Minimum high-volume bars in base", minval = 1, maxval = 8, group = groupContinuation, display = display.none)
continuationMaxZoneWidthAtr = input.float(2.25, "Maximum continuation-zone width (ATR)", minval = 0.25, step = 0.25, group = groupContinuation, display = display.none)
continuationMaxCloseSpreadAtr = input.float(1.50, "Maximum base close spread (ATR)", minval = 0.10, step = 0.10, group = groupContinuation, display = display.none)
continuationMaxNetPullbackAtr = input.float(0.25, "Maximum first-to-last close pullback (ATR)", minval = 0.0, step = 0.05, group = groupContinuation,
     tooltip = "The last base close may sit slightly below the first close, but the shelf cannot materially roll over.", display = display.none)
continuationPriorImpulseLookback = input.int(5, "Prior impulse lookback bars", minval = 1, maxval = 30, group = groupContinuation, display = display.none)
continuationMinPriorImpulseAtr = input.float(1.50, "Minimum prior impulse into base (ATR)", minval = 0.0, step = 0.25, group = groupContinuation, display = display.none)
continuationBreakBufferAtr = input.float(0.05, "Continuation close-above-base buffer (ATR)", minval = 0.0, step = 0.05, group = groupContinuation, display = display.none)
continuationMinBreakBodyAtr = input.float(0.50, "Continuation breakout minimum body (ATR)", minval = 0.0, step = 0.05, group = groupContinuation, display = display.none)
continuationMinBreakRelativeVolume = input.float(1.20, "Continuation breakout minimum relative volume", minval = 0.1, step = 0.10, group = groupContinuation, display = display.none)
continuationMaxBreakUpperWickAtr = input.float(0.50, "Continuation breakout maximum upper wick (ATR)", minval = 0.0, step = 0.10, group = groupContinuation, display = display.none)
continuationDuplicateWindowBars = input.int(10, "Duplicate suppression window (bars)", minval = 1, maxval = 100, group = groupContinuation, display = display.none)

groupTrend = "2. Bullish-trend filters"
requireBullishTrend = input.bool(true, "Require bullish trend context", group = groupTrend, display = display.none)
fastEmaLength = input.int(9, "Fast EMA length", minval = 2, maxval = 100, group = groupTrend, display = display.none)
slowEmaLength = input.int(20, "Slow EMA length", minval = 3, maxval = 250, group = groupTrend, display = display.none)
trendSlopeBars = input.int(3, "Rising-average lookback", minval = 1, maxval = 20, group = groupTrend, display = display.none)
requireRisingEmas = input.bool(true, "Require EMA 9 and EMA 20 to be rising", group = groupTrend, display = display.none)
requireRisingVwap = input.bool(false, "Require VWAP to be rising", group = groupTrend, display = display.none)
requireSupplyVolume = input.bool(true, "Require supply volume above average", group = groupTrend, display = display.none)
minSupplyRelativeVolume = input.float(1.00, "Supply minimum relative volume", minval = 0.1, step = 0.1, group = groupTrend, display = display.none)
requireReactionAboveSlowEma = input.bool(true, "Require supply reaction to hold EMA 20", group = groupTrend,
     tooltip = "Keeps supply reactions that behave like pullbacks within a bullish trend.", display = display.none)
maxSupplyExtensionAtr = input.float(2.50, "Maximum supply extension above trend (ATR)", minval = 0.0, step = 0.25, group = groupTrend,
     tooltip = "Rejects exhaustion highs. Set to 0 to disable. The SDOT 07:09 setup needs approximately 2.35 ATR or more.", display = display.none)
maxBearishSupplyExtensionAtr = input.float(3.00, "Maximum bearish-origin extension (ATR)", minval = 0.0, step = 0.25, group = groupTrend,
     tooltip = "Bearish rejection origins may spike farther from trend before closing back down. SDOT 2026-06-29 10:24 measures approximately 2.76 ATR.", display = display.none)
useExtremeVolumeExtensionOverride = input.bool(true, "Allow extreme-volume extension override", group = groupTrend,
     tooltip = "Allows unusually active supply origins to exceed the normal extension limit. The seller-leg, breakout, and retest rules still apply.", display = display.none)
minExtremeSupplyRelativeVolume = input.float(3.00, "Extreme-volume minimum relative volume", minval = 1.0, step = 0.25, group = groupTrend, display = display.none)
maxExtremeSupplyExtensionAtr = input.float(4.50, "Extreme-volume maximum extension (ATR)", minval = 0.0, step = 0.25, group = groupTrend,
     tooltip = "SDOT 2026-07-01 09:30 measures approximately 3.79 ATR with approximately 9.7x average volume.", display = display.none)

groupFlip = "3. Flip confirmation"
requiredBreakCloses = input.int(2, "Consecutive closes required above supply", minval = 1, maxval = 5, group = groupFlip,
     tooltip = "Two closes reject one-bar probes such as SDOT 10:46 and confirm the cleaner 10:49-10:50 break.", display = display.none)
allowImpulseThenAcceptance = input.bool(true, "Allow strong breakout impulse followed by acceptance", group = groupFlip,
     tooltip = "The first close above supply may provide the required bullish body, volume, and trend quality. A later consecutive close confirms acceptance even when that acceptance candle is neutral or bearish.", display = display.none)
breakBufferAtr = input.float(0.05, "Close above supply buffer (ATR)", minval = 0.0, step = 0.05, group = groupFlip, display = display.none)
minBreakBodyAtr = input.float(0.50, "Minimum bullish breakout body (ATR)", minval = 0.0, step = 0.05, group = groupFlip, display = display.none)
volumeAverageLength = input.int(20, "Volume average length", minval = 2, maxval = 200, group = groupFlip, display = display.none)
requireBreakVolume = input.bool(true, "Require breakout volume above average", group = groupFlip, display = display.none)
minBreakRelativeVolume = input.float(1.20, "Breakout minimum relative volume", minval = 0.1, step = 0.1, group = groupFlip, display = display.none)
confirmedBarsOnly = input.bool(true, "Confirm signals only at bar close", group = groupFlip,
     tooltip = "Recommended. Prevents realtime signals from appearing and disappearing intrabar.", display = display.none)

groupProgressive = "3a. Progressive supply takeover"
enableProgressiveSupplyTakeover = input.bool(true, "Allow progressive supply takeover", group = groupProgressive,
     tooltip = "Allows demand to defend the lower edge of supply, preserve that low, and later confirm acceptance above the supply top on renewed volume.", display = display.none)
progressiveBottomTestToleranceAtr = input.float(0.20, "Lower-edge test tolerance (ATR)", minval = 0.0, step = 0.05, group = groupProgressive,
     tooltip = "The demand candle may undercut the supply bottom by this ATR amount and must close back above the bottom.", display = display.none)
progressiveMaxBarsToAcceptance = input.int(20, "Maximum bars from demand to acceptance", minval = 2, maxval = 100, group = groupProgressive,
     tooltip = "The takeover demand low must remain preserved until upper-edge acceptance completes.", display = display.none)
progressivePreservationToleranceTicks = input.int(1, "Demand-low preservation tolerance (ticks)", minval = 0, maxval = 20, group = groupProgressive,
     tooltip = "Allows this many minimum ticks beneath the candidate demand low before the progressive takeover is reset.", display = display.none)
progressiveMinAcceptanceRelativeVolume = input.float(1.20, "Upper-edge acceptance minimum relative volume", minval = 0.1, step = 0.1, group = groupProgressive,
     tooltip = "The candle completing the consecutive closes above supply must reach this volume multiple. No bullish-body minimum is required for this path.", display = display.none)

groupImmediateFrontRun = "3b. Immediate front-run demand"
enableImmediateFrontRunDemand = input.bool(true, "Allow immediate front-run demand", group = groupImmediateFrontRun,
     tooltip = "Recognizes the first full-separation candle immediately after a strong breakout when buyers defend just above the old supply top. The demand marker appears only after later bars preserve its low and confirm the reaction.", display = display.none)
immediateFrontRunProximityAtr = input.float(0.25, "Maximum distance above supply top (ATR)", minval = 0.0, step = 0.05, group = groupImmediateFrontRun,
     tooltip = "Applies only to this immediate post-breakout path. SDOT 2026-06-04 13:23 stopped approximately 0.215 ATR above the 8.2499 supply top.", display = display.none)
immediateFrontRunConfirmationBars = input.int(3, "Low-preservation confirmation bars", minval = 1, maxval = 10, group = groupImmediateFrontRun,
     tooltip = "The front-run candle's low must remain preserved for this many completed bars before the historical S→D marker is drawn.", display = display.none)
immediateFrontRunPreservationTicks = input.int(1, "Low-preservation tolerance (ticks)", minval = 0, maxval = 20, group = groupImmediateFrontRun,
     tooltip = "Allows this many minimum ticks beneath the front-run low during confirmation.", display = display.none)

groupManagement = "4. Flipped-demand management"
invalidationMode = input.string("Close", "Invalidation method", options = ["Close", "Wick"], group = groupManagement, display = display.none)
invalidationBufferAtr = input.float(0.10, "Invalidation buffer (ATR)", minval = 0.0, step = 0.05, group = groupManagement,
     tooltip = "Allows a small close/wick penetration beyond the zone before declaring failure.", display = display.none)
minimumEvidenceSurvivalBars = input.int(3, "Minimum bars zone must survive after evidence", minval = 0, maxval = 20, group = groupManagement,
     tooltip = "Counts from the live confirmation bar of BASE, S→D, progressive takeover, or immediate front-run evidence. If the zone invalidates before this many later bars complete, its entire area is removed.", display = display.none)
supplyRetestProximityAtr = input.float(0.10, "Supply retest proximity above zone (ATR)", minval = 0.0, step = 0.05, group = groupManagement,
     tooltip = "Allows buyers to front-run a flipped supply top by a small ATR distance. SDOT 2026-06-03 10:05 stopped at 6.32, only about 0.07 ATR above the 6.29 zone top.", display = display.none)
sendDynamicAlerts = input.bool(true, "Send dynamic flip/retest alerts", group = groupManagement,
     tooltip = "Create a TradingView alert using 'Any alert() function call'. Messages include the zone prices.", display = display.none)
maxHistoricalFlipStructures = input.int(200, "Maximum retained flip structures (history)", minval = 1, maxval = 200, group = groupManagement,
     tooltip = "Retains older confirmed zones on long historical datasets. When full, hidden and unconfirmed zones are retired before confirmed S→D/BASE areas.", display = display.none)
maxHistoricalSupportMarkers = input.int(400, "Maximum retained S→D markers (history)", minval = 1, maxval = 400, group = groupManagement,
     tooltip = "Retains confirmed support arrows for older zones while staying within TradingView's label-object limit.", display = display.none)

groupDisplay = "5. Display"
activeFill = input.color(color.new(color.lime, 84), "Active demand fill", group = groupDisplay, display = display.none)
activeBorder = input.color(color.new(color.lime, 15), "Active demand border", group = groupDisplay, display = display.none)
invalidTextColor = input.color(color.new(color.red, 0), "Invalid-zone text/marker", group = groupDisplay, display = display.none)
showSellerControlLeg = input.bool(true, "Show full supply/control structure after retest", group = groupDisplay, display = display.none)
sellerLegFill = input.color(color.new(color.red, 91), "Supply/control structure fill", group = groupDisplay, display = display.none)
sellerLegBorder = input.color(color.new(color.red, 55), "Supply/control structure border", group = groupDisplay, display = display.none)
showContinuationBaseStructure = input.bool(true, "Show continuation-base structure after retest", group = groupDisplay, display = display.none)
continuationBaseFill = input.color(color.new(color.aqua, 90), "Continuation-base structure fill", group = groupDisplay, display = display.none)
continuationBaseBorder = input.color(color.new(color.aqua, 45), "Continuation-base structure border", group = groupDisplay, display = display.none)
showFlipMarkers = input.bool(true, "Show zone-type arrows on retests", group = groupDisplay, display = display.none)
showAdditionalSupplyRetests = input.bool(true, "Track every fresh S→D zone re-entry", group = groupDisplay,
     tooltip = "Tracks each later re-entry after price leaves the zone. Re-entry alone does not draw an arrow; only a confirmed demand pivot inside the zone does.", display = display.none)
showConfirmedSupplyFlipSupports = input.bool(true, "Mark confirmed S→D support arrows", group = groupDisplay,
     tooltip = "Marks qualified pivot supports and confirmed immediate front-run demand on their actual candles. Both paths retain their own wick, reaction, volume, and location requirements.", display = display.none)
showRetestMarkers = input.bool(true, "Show first-retest markers", group = groupDisplay, display = display.none)
showLaterBreakMarkers = input.bool(true, "Show red marker when a retested zone later breaks", group = groupDisplay, display = display.none)
showOnlyBroadestOverlappingZone = input.bool(true, "Show only broadest overlapping zone", group = groupDisplay,
     tooltip = "When visible S→D, progressive, immediate front-run, or BASE zones substantially overlap, hides the narrower price areas while preserving all detection, lifecycle, marker, and alert logic.", display = display.none)
broadZoneMinimumOverlap = input.float(0.75, "Minimum overlap of narrower zone", minval = 0.10, maxval = 1.00, step = 0.05, group = groupDisplay,
     tooltip = "The broader zone must cover at least this fraction of the narrower zone before the narrower area is hidden. The default 0.75 ignores small edge overlaps.", display = display.none)
zoneLeftPaddingBars = input.int(0, "Start visible area before origin (bars)", minval = 0, maxval = 20, group = groupDisplay,
     tooltip = "Zero starts at the left edge of the true origin candle, keeping the border away from its wick. Higher values add whole-bar visual padding without changing detection.", display = display.none)
drawFromSupplyOrigin = input.bool(true, "Draw from original supply candle", group = groupDisplay, display = display.none)
showTrendAverages = input.bool(false, "Show EMA 9, EMA 20, and VWAP", group = groupDisplay, display = display.none)

// ────────────────────── Core calculations ──────────────────────
float atr = ta.atr(14)
float volumeAverage = ta.sma(volume, volumeAverageLength)
float fastEma = ta.ema(close, fastEmaLength)
float slowEma = ta.ema(close, slowEmaLength)
float sessionVwap = ta.vwap(hlc3)
float confirmedPivotHigh = ta.pivothigh(high, pivotLeft, pivotRight)
float confirmedPivotLow = ta.pivotlow(low, demandPivotLeft, demandPivotRight)
float postDemandHigh = ta.highest(high, demandPivotRight)
float compactPostDemandLow = ta.lowest(low, compactDemandRightBars)
float compactPostDemandHigh = ta.highest(high, compactDemandRightBars)
float postPivotLow = ta.lowest(low, pivotRight)
float postPivotClose = ta.lowest(close, pivotRight)
bool signalBarReady = not confirmedBarsOnly or barstate.isconfirmed

// TradingView places bar-index drawings on the candle's center. Use timestamps
// shifted by half of the chart interval to address the candle's visual edges.
// This lets the zone include the true origin candle without placing its left
// vertical border through the candle's wick.
float chartTimeframeSeconds = timeframe.in_seconds()
int visualHalfBarMs = not na(chartTimeframeSeconds) ?
     math.max(1, int(chartTimeframeSeconds * 500.0)) : 1

f_bar_left_edge_time(int absoluteBarIndex, int paddingBars) =>
    int paddedBarIndex = math.max(0, math.min(bar_index, absoluteBarIndex - paddingBars))
    int barsBack = bar_index - paddedBarIndex
    time[barsBack] - visualHalfBarMs

f_bar_right_edge_time(int absoluteBarIndex) =>
    int safeBarIndex = math.max(0, math.min(bar_index, absoluteBarIndex))
    int barsBack = bar_index - safeBarIndex
    time[barsBack] + visualHalfBarMs

plot(showTrendAverages ? fastEma : na, title = "EMA 9", color = color.new(color.teal, 0), linewidth = 1, display = display.all - display.status_line)
plot(showTrendAverages ? slowEma : na, title = "EMA 20", color = color.new(color.orange, 0), linewidth = 1, display = display.all - display.status_line)
plot(showTrendAverages ? sessionVwap : na, title = "Session VWAP", color = color.new(color.purple, 0), linewidth = 1, display = display.all - display.status_line)

int ZONE_KIND_SUPPLY_FLIP = 0
int ZONE_KIND_CONTINUATION_BASE = 1
int ZONE_KIND_PROGRESSIVE_TAKEOVER = 2
int ZONE_KIND_IMMEDIATE_FRONT_RUN = 3

// Hidden supply candidates.
var array<float> candidateTops = array.new<float>()
var array<float> candidateBottoms = array.new<float>()
var array<float> candidateLegReferences = array.new<float>()
var array<float> candidateOriginRelativeVolumes = array.new<float>()
var array<int> candidateOriginBars = array.new<int>()
var array<int> candidateStructureStartBars = array.new<int>()
var array<float> candidateOriginAtrs = array.new<float>()
var array<float> candidateTrackedLows = array.new<float>()
var array<bool> candidateLegConfirmed = array.new<bool>()
var array<float> candidateDemandLows = array.new<float>()
var array<int> candidateDemandBars = array.new<int>()
var array<int> candidateBreakCounts = array.new<int>()
var array<bool> candidateBreakImpulseQualified = array.new<bool>()
var array<bool> candidateFormationFinalized = array.new<bool>()
var array<int> candidateFormationEndBars = array.new<int>()
var array<int> candidateFormationBarCounts = array.new<int>()
var array<float> candidateFormationPeakVolumes = array.new<float>()
var array<float> candidateFormationLastVolumes = array.new<float>()
var array<int> candidateFirstSeparationBars = array.new<int>()
// Progressive takeover state: a lower-edge demand candle is armed, its low must
// remain preserved, and later volume-backed closes must accept above supply.
var array<bool> candidateProgressiveArmed = array.new<bool>()
var array<float> candidateProgressiveDemandLows = array.new<float>()
var array<int> candidateProgressiveDemandBars = array.new<int>()
var array<float> candidateProgressiveDemandAtrs = array.new<float>()

// Confirmed supply→demand zones.
var array<box> flipBoxes = array.new<box>()
var array<box> flipLegBoxes = array.new<box>()
var array<label> flipTextLabels = array.new<label>()
var array<float> flipTops = array.new<float>()
var array<float> flipBottoms = array.new<float>()
var array<float> flipDemandLows = array.new<float>()
var array<int> flipDemandBars = array.new<int>()
var array<int> flipConfirmationBars = array.new<int>()
var array<int> flipOriginTimes = array.new<int>()
var array<bool> flipRetested = array.new<bool>()
var array<bool> flipWasIntersecting = array.new<bool>()
var array<bool> flipActive = array.new<bool>()
var array<int> flipZoneKinds = array.new<int>()
var array<bool> flipDemandConfirmed = array.new<bool>()
// Bar where BASE/S→D evidence first became knowable live. This is deliberately
// different from a marker bar that may be plotted retrospectively.
var array<int> flipEvidenceConfirmationBars = array.new<int>()
// First completed candle whose entire range traded above the zone.
var array<int> flipFirstSeparationBars = array.new<int>()

// Prefer retiring drawings that never produced a visible, confirmed result.
// This keeps old confirmed zones synchronized with their longer marker history.
f_flip_retention_eviction_index() =>
    int firstHiddenIndex = na
    int firstUnconfirmedIndex = na
    int retainedZoneCount = array.size(flipBoxes)

    if retainedZoneCount > 0
        for retentionIndex = 0 to retainedZoneCount - 1
            bool retentionRetested = array.get(flipRetested, retentionIndex)
            bool retentionDemandConfirmed = array.get(flipDemandConfirmed, retentionIndex)
            int retentionZoneKind = array.get(flipZoneKinds, retentionIndex)
            bool retentionBaseConfirmed =
                 retentionZoneKind == ZONE_KIND_CONTINUATION_BASE and retentionRetested
            bool retentionLifecycleConfirmed =
                 retentionDemandConfirmed or retentionBaseConfirmed

            if na(firstHiddenIndex) and not retentionRetested
                firstHiddenIndex := retentionIndex
            if na(firstUnconfirmedIndex) and not retentionLifecycleConfirmed
                firstUnconfirmedIndex := retentionIndex

    not na(firstHiddenIndex) ? firstHiddenIndex :
         not na(firstUnconfirmedIndex) ? firstUnconfirmedIndex : 0

// Confirmed support pivots inside already flipped original supply zones.
// These are arrows only; they never create a separate demand box.
var array<int> confirmedSupplyFlipSupportBars = array.new<int>()
var array<label> confirmedSupplyFlipSupportLabels = array.new<label>()

bool flipDetected = false
bool firstRetestDetected = false
bool supplyFlipRetestDetected = false
bool additionalSupplyFlipRetestDetected = false
bool confirmedSupplyFlipSupportDetected = false
bool continuationBaseRetestDetected = false
bool progressiveTakeoverDetected = false
bool invalidationDetected = false
bool laterBreakDetected = false
color hiddenDrawingColor = color.new(color.black, 100)

// ───────────────── Create hidden supply candidates ────────────────
if signalBarReady and not na(confirmedPivotHigh) and bar_index > pivotRight + trendSlopeBars and not na(atr[pivotRight])
    float pivotOpen = open[pivotRight]
    float pivotClose = close[pivotRight]
    float pivotHigh = high[pivotRight]
    float bodyHigh = math.max(pivotOpen, pivotClose)
    float bodyLow = math.min(pivotOpen, pivotClose)
    float pivotAtr = atr[pivotRight]
    float pivotFastEma = fastEma[pivotRight]
    float pivotSlowEma = slowEma[pivotRight]
    float pivotVwap = sessionVwap[pivotRight]
    float pivotVolumeAverage = volumeAverage[pivotRight]
    float nearestTrendReference = math.max(pivotFastEma, math.max(pivotSlowEma, pivotVwap))

    float bearishOriginBody = pivotOpen - pivotClose
    bool bullishSupplyOrigin = pivotClose >= pivotOpen
    bool bearishRejectionOrigin = allowBearishSupplyCandle and pivotClose < pivotOpen and
         bearishOriginBody >= pivotAtr * minBearishOriginBodyAtr
    bool directionOk = bullishSupplyOrigin or bearishRejectionOrigin
    // A bearish rejection candle performs part of the departure inside its own body,
    // so its close/body-low is the more faithful proximal boundary. Bullish origins
    // retain the original upper-wick/body-high boundary.
    float actionableZoneBottom = bearishRejectionOrigin ? bodyLow : bodyHigh
    bool wickOk = pivotHigh - bodyHigh >= pivotAtr * minUpperWickAtr
    bool departureOk = bodyHigh - postPivotLow >= pivotAtr * minBearishDepartureAtr and postPivotClose < bodyHigh
    bool validZoneWidth = pivotHigh > bodyHigh

    bool trendDataReady = not na(pivotFastEma) and not na(pivotSlowEma) and not na(pivotVwap)
    bool supplyAboveTrend = pivotClose > pivotFastEma and pivotClose > pivotSlowEma and pivotClose > pivotVwap and
         pivotHigh > pivotFastEma and pivotHigh > pivotSlowEma and pivotHigh > pivotVwap
    bool bullishStack = pivotFastEma > pivotSlowEma
    bool slopeDataReady = not na(fastEma[pivotRight + trendSlopeBars]) and not na(slowEma[pivotRight + trendSlopeBars])
    bool risingEmas = not requireRisingEmas or
         (slopeDataReady and pivotFastEma > fastEma[pivotRight + trendSlopeBars] and
         pivotSlowEma > slowEma[pivotRight + trendSlopeBars])
    bool risingVwap = not requireRisingVwap or
         (not na(sessionVwap[pivotRight + trendSlopeBars]) and pivotVwap > sessionVwap[pivotRight + trendSlopeBars])
    float supplyRelativeVolume = not na(volume[pivotRight]) and not na(pivotVolumeAverage) and pivotVolumeAverage > 0.0 ?
         volume[pivotRight] / pivotVolumeAverage : na
    bool supplyVolumeOk = not requireSupplyVolume or
         (not na(supplyRelativeVolume) and supplyRelativeVolume >= minSupplyRelativeVolume)
    float applicableMaxExtensionAtr = bearishRejectionOrigin ? maxBearishSupplyExtensionAtr : maxSupplyExtensionAtr
    float supplyExtensionAtr = pivotAtr > 0.0 ? (bodyHigh - nearestTrendReference) / pivotAtr : na
    bool normalExtensionOk = applicableMaxExtensionAtr <= 0.0 or
         (not na(supplyExtensionAtr) and supplyExtensionAtr <= applicableMaxExtensionAtr)
    bool extremeVolumeExtensionOk = useExtremeVolumeExtensionOverride and
         not na(supplyRelativeVolume) and supplyRelativeVolume >= minExtremeSupplyRelativeVolume and
         not na(supplyExtensionAtr) and supplyExtensionAtr <= maxExtremeSupplyExtensionAtr
    bool extensionOk = normalExtensionOk or extremeVolumeExtensionOk

    bool reactionHoldsSlowEma = true
    for reactionOffset = 0 to pivotRight - 1
        reactionHoldsSlowEma := reactionHoldsSlowEma and not na(slowEma[reactionOffset]) and
             close[reactionOffset] >= slowEma[reactionOffset]
    bool reactionLocationOk = not requireReactionAboveSlowEma or reactionHoldsSlowEma

    bool supplyTrendOk = supplyVolumeOk and (not requireBullishTrend or
         (trendDataReady and supplyAboveTrend and bullishStack and risingEmas and risingVwap and
         reactionLocationOk and extensionOk))

    bool standardSupplyQualified = directionOk and wickOk and departureOk and validZoneWidth and supplyTrendOk

    // Collective shelf fallback. A compact sequence may carry valid supply
    // evidence across several bars even when the final pivot narrowly misses a
    // single-candle threshold. Its top is the highest high and its bottom is the
    // highest accepted close across the shelf.
    bool collectiveDataReady = enableCollectiveSupplyShelves and
         bar_index > pivotRight + collectiveSupplyBars
    float collectiveTop = na
    float collectiveBottom = na
    float collectiveMinimumHigh = na
    float collectiveMinimumClose = na
    float collectiveMaximumBodyHigh = na
    float collectiveVolumeSum = 0.0
    float collectiveVolumeAverageSum = 0.0
    float collectivePeakVolume = 0.0
    int collectiveHighVolumeBars = 0
    int collectiveTrendCloses = 0
    bool collectiveAllClosesAboveVwap = true

    for collectiveStep = 0 to collectiveSupplyBars - 1
        int collectiveOffset = pivotRight + collectiveStep
        float collectiveBarBodyHigh = math.max(open[collectiveOffset], close[collectiveOffset])
        float collectiveBarVolumeAverage = volumeAverage[collectiveOffset]
        float collectiveBarRelativeVolume = not na(volume[collectiveOffset]) and
             not na(collectiveBarVolumeAverage) and collectiveBarVolumeAverage > 0.0 ?
             volume[collectiveOffset] / collectiveBarVolumeAverage : na
        bool collectiveBarDataReady = not na(high[collectiveOffset]) and
             not na(close[collectiveOffset]) and not na(fastEma[collectiveOffset]) and
             not na(slowEma[collectiveOffset]) and not na(sessionVwap[collectiveOffset]) and
             not na(collectiveBarRelativeVolume)

        collectiveDataReady := collectiveDataReady and collectiveBarDataReady
        collectiveTop := na(collectiveTop) ? high[collectiveOffset] : math.max(collectiveTop, high[collectiveOffset])
        collectiveBottom := na(collectiveBottom) ? close[collectiveOffset] : math.max(collectiveBottom, close[collectiveOffset])
        collectiveMinimumHigh := na(collectiveMinimumHigh) ? high[collectiveOffset] : math.min(collectiveMinimumHigh, high[collectiveOffset])
        collectiveMinimumClose := na(collectiveMinimumClose) ? close[collectiveOffset] : math.min(collectiveMinimumClose, close[collectiveOffset])
        collectiveMaximumBodyHigh := na(collectiveMaximumBodyHigh) ?
             collectiveBarBodyHigh : math.max(collectiveMaximumBodyHigh, collectiveBarBodyHigh)
        collectiveVolumeSum += nz(volume[collectiveOffset])
        collectiveVolumeAverageSum += nz(collectiveBarVolumeAverage)
        collectivePeakVolume := math.max(collectivePeakVolume, nz(volume[collectiveOffset]))
        collectiveHighVolumeBars += not na(collectiveBarRelativeVolume) and
             collectiveBarRelativeVolume >= minSupplyRelativeVolume ? 1 : 0
        collectiveTrendCloses += collectiveBarDataReady and
             close[collectiveOffset] > fastEma[collectiveOffset] and
             close[collectiveOffset] > slowEma[collectiveOffset] and
             close[collectiveOffset] > sessionVwap[collectiveOffset] ? 1 : 0
        collectiveAllClosesAboveVwap := collectiveAllClosesAboveVwap and
             collectiveBarDataReady and close[collectiveOffset] > sessionVwap[collectiveOffset]

    float collectiveAggregateRelativeVolume = collectiveVolumeAverageSum > 0.0 ?
         collectiveVolumeSum / collectiveVolumeAverageSum : na
    float collectivePriorClose = close[pivotRight + collectiveSupplyBars]
    bool collectiveHighSpreadOk = collectiveDataReady and
         collectiveTop - collectiveMinimumHigh <= pivotAtr * collectiveMaxHighSpreadAtr
    bool collectiveCloseSpreadOk = collectiveDataReady and
         collectiveBottom - collectiveMinimumClose <= pivotAtr * collectiveMaxCloseSpreadAtr
    bool collectiveVolumeOk = not requireSupplyVolume or
         (not na(collectiveAggregateRelativeVolume) and
         collectiveAggregateRelativeVolume >= collectiveMinAggregateRelativeVolume and
         collectiveHighVolumeBars >= 1)
    bool collectiveTrendOk = not requireBullishTrend or
         (trendDataReady and bullishStack and risingEmas and risingVwap and extensionOk and
         collectiveAllClosesAboveVwap and
         collectiveTrendCloses >= math.min(collectiveMinClosesAboveTrend, collectiveSupplyBars))
    bool collectivePriorAdvanceOk = collectiveMinPriorAdvanceAtr <= 0.0 or
         (not na(collectivePriorClose) and
         collectiveBottom - collectivePriorClose >= pivotAtr * collectiveMinPriorAdvanceAtr)
    bool collectiveRejectionOk = collectiveDataReady and
         collectiveTop - collectiveMaximumBodyHigh >= pivotAtr * minUpperWickAtr
    bool collectiveDepartureOk = collectiveDataReady and
         collectiveBottom - postPivotLow >= pivotAtr * minBearishDepartureAtr and
         postPivotClose < collectiveBottom
    bool collectiveZoneValid = collectiveDataReady and collectiveTop > collectiveBottom
    bool collectiveSupplyQualified = enableCollectiveSupplyShelves and
         collectiveHighSpreadOk and collectiveCloseSpreadOk and collectiveVolumeOk and
         collectiveTrendOk and collectivePriorAdvanceOk and collectiveRejectionOk and
         collectiveDepartureOk and collectiveZoneValid
    bool useCollectiveSupplyOrigin = not standardSupplyQualified and collectiveSupplyQualified

    if standardSupplyQualified or useCollectiveSupplyOrigin
        int originBar = bar_index - pivotRight
        int supplyStructureStartBar = useCollectiveSupplyOrigin ?
             originBar - collectiveSupplyBars + 1 : originBar
        int supplyStructureBars = useCollectiveSupplyOrigin ? collectiveSupplyBars : 1

        // The pivot defines the vertical zone. Expand only the temporal origin,
        // walking backward contiguously through the pivot's left-side confirmation
        // window. A failed bar ends the expansion; the scan never jumps across gaps.
        if expandSupplyStructure and not useCollectiveSupplyOrigin
            for backwardStep = 1 to pivotLeft
                int structureOffset = pivotRight + backwardStep
                float structureBodyHigh = math.max(open[structureOffset], close[structureOffset])
                float structureVolumeAverage = volumeAverage[structureOffset]
                float structureRelativeVolume = not na(volume[structureOffset]) and
                     not na(structureVolumeAverage) and structureVolumeAverage > 0.0 ?
                     volume[structureOffset] / structureVolumeAverage : na
                bool structureDataReady = not na(high[structureOffset]) and not na(close[structureOffset]) and
                     not na(atr[structureOffset]) and not na(fastEma[structureOffset]) and
                     not na(slowEma[structureOffset]) and not na(sessionVwap[structureOffset])
                bool structureTouches = structureDataReady and
                     high[structureOffset] >= actionableZoneBottom - pivotAtr * structureTouchBufferAtr and
                     high[structureOffset] <= pivotHigh + syminfo.mintick * 2.0
                bool structureRejects = structureDataReady and
                     close[structureOffset] <= actionableZoneBottom + pivotAtr * structureCloseBufferAtr and
                     high[structureOffset] - structureBodyHigh >= pivotAtr * minUpperWickAtr
                bool structureVolumeOk = not requireSupplyVolume or
                     (not na(structureRelativeVolume) and structureRelativeVolume >= minSupplyRelativeVolume)
                bool structureLocationOk = not requireBullishTrend or
                     (close[structureOffset] > fastEma[structureOffset] and
                     close[structureOffset] > slowEma[structureOffset] and
                     close[structureOffset] > sessionVwap[structureOffset] and
                     high[structureOffset] > fastEma[structureOffset] and
                     high[structureOffset] > slowEma[structureOffset] and
                     high[structureOffset] > sessionVwap[structureOffset])

                if structureTouches and structureRejects and structureVolumeOk and structureLocationOk
                    supplyStructureStartBar := originBar - backwardStep
                    supplyStructureBars += 1
                else
                    break

        if not useCollectiveSupplyOrigin
            int effectiveMinSupplyStructureBars = math.min(minSupplyStructureBars, pivotLeft + 1)
            if supplyStructureBars < effectiveMinSupplyStructureBars
                supplyStructureStartBar := originBar

        // Build the initial forward formation from the pivot through the bars already
        // required to confirm it. Scan chronologically and stop before the first
        // dramatic volume-collapse bar. This is live-safe because all inspected bars
        // are already closed when the pivot becomes confirmed.
        float formationTop = useCollectiveSupplyOrigin ? collectiveTop : pivotHigh
        float formationBottom = useCollectiveSupplyOrigin ? collectiveBottom : pivotClose
        float formationPeakVolume = useCollectiveSupplyOrigin ? collectivePeakVolume : volume[pivotRight]
        float formationLastVolume = volume[pivotRight]
        int formationEndBar = originBar
        int formationBarCount = useCollectiveSupplyOrigin ? collectiveSupplyBars : 1
        bool formationFinalized = not useForwardVolumeSupplyFormation

        if useForwardVolumeSupplyFormation and pivotRight > 0
            for formationStep = 1 to pivotRight
                int formationOffset = pivotRight - formationStep
                float formationVolumeAverage = volumeAverage[formationOffset]
                bool formationBelowAverage = not formationCollapseRequiresBelowAverage or
                     (not na(formationVolumeAverage) and volume[formationOffset] < formationVolumeAverage)
                bool formationRatioCollapse = volume[formationOffset] <= formationLastVolume * formationCollapsePreviousRatio or
                     volume[formationOffset] <= formationPeakVolume * formationCollapsePeakRatio
                bool formationCollapse = formationBelowAverage and formationRatioCollapse
                // Stop before the first candle that no longer reaches the evolving
                // supply band. This prevents a sustained seller leg from being
                // absorbed into the supply formation when volume remains elevated.
                bool formationPriceDisengaged = high[formationOffset] <
                     formationBottom - pivotAtr * structureTouchBufferAtr
                if formationCollapse or formationPriceDisengaged
                    formationFinalized := true
                    break
                formationTop := math.max(formationTop, high[formationOffset])
                formationBottom := math.max(formationBottom, close[formationOffset])
                formationPeakVolume := math.max(formationPeakVolume, volume[formationOffset])
                formationLastVolume := volume[formationOffset]
                formationEndBar := originBar + formationStep
                formationBarCount += 1
                if formationBarCount >= maxForwardSupplyFormationBars
                    formationFinalized := true
                    break

        bool duplicate = false
        int duplicateIndex = array.size(candidateTops) - 1
        while duplicateIndex >= 0
            float oldTop = array.get(candidateTops, duplicateIndex)
            float oldBottom = array.get(candidateBottoms, duplicateIndex)
            int oldOriginBar = array.get(candidateOriginBars, duplicateIndex)
            bool overlaps = formationBottom <= oldTop and formationTop >= oldBottom
            bool closeInTime = originBar - oldOriginBar <= pivotLeft + pivotRight + 2
            if overlaps and closeInTime
                duplicate := true
            duplicateIndex -= 1

        if not duplicate
            array.push(candidateTops, formationTop)
            array.push(candidateBottoms, formationBottom)
            // Keep the original body-high for measuring seller-leg decline even when
            // a bearish origin uses its deeper close as the actionable zone boundary.
            float candidateLegReference = useCollectiveSupplyOrigin ?
                 math.max(collectiveMaximumBodyHigh, formationBottom) :
                 math.max(bodyHigh, formationBottom)
            float candidateRelativeVolume = useCollectiveSupplyOrigin ?
                 collectiveAggregateRelativeVolume : supplyRelativeVolume
            array.push(candidateLegReferences, candidateLegReference)
            array.push(candidateOriginRelativeVolumes, candidateRelativeVolume)
            array.push(candidateOriginBars, originBar)
            array.push(candidateStructureStartBars, supplyStructureStartBar)
            array.push(candidateOriginAtrs, pivotAtr)
            array.push(candidateTrackedLows, postPivotLow)
            array.push(candidateLegConfirmed, false)
            array.push(candidateDemandLows, na)
            array.push(candidateDemandBars, na)
            array.push(candidateBreakCounts, 0)
            array.push(candidateBreakImpulseQualified, false)
            array.push(candidateFormationFinalized, formationFinalized)
            array.push(candidateFormationEndBars, formationEndBar)
            array.push(candidateFormationBarCounts, formationBarCount)
            array.push(candidateFormationPeakVolumes, formationPeakVolume)
            array.push(candidateFormationLastVolumes, formationLastVolume)
            array.push(candidateFirstSeparationBars, na)
            array.push(candidateProgressiveArmed, false)
            array.push(candidateProgressiveDemandLows, na)
            array.push(candidateProgressiveDemandBars, na)
            array.push(candidateProgressiveDemandAtrs, na)

            if array.size(candidateTops) > maxHiddenCandidates
                array.shift(candidateTops)
                array.shift(candidateBottoms)
                array.shift(candidateLegReferences)
                array.shift(candidateOriginRelativeVolumes)
                array.shift(candidateOriginBars)
                array.shift(candidateStructureStartBars)
                array.shift(candidateOriginAtrs)
                array.shift(candidateTrackedLows)
                array.shift(candidateLegConfirmed)
                array.shift(candidateDemandLows)
                array.shift(candidateDemandBars)
                array.shift(candidateBreakCounts)
                array.shift(candidateBreakImpulseQualified)
                array.shift(candidateFormationFinalized)
                array.shift(candidateFormationEndBars)
                array.shift(candidateFormationBarCounts)
                array.shift(candidateFormationPeakVolumes)
                array.shift(candidateFormationLastVolumes)
                array.shift(candidateFirstSeparationBars)
                array.shift(candidateProgressiveArmed)
                array.shift(candidateProgressiveDemandLows)
                array.shift(candidateProgressiveDemandBars)
                array.shift(candidateProgressiveDemandAtrs)

// ────────────── Confirm supply→demand flips ──────────────
int candidateIndex = array.size(candidateTops) - 1
while candidateIndex >= 0
    float supplyTop = array.get(candidateTops, candidateIndex)
    float supplyBottom = array.get(candidateBottoms, candidateIndex)
    float sellerLegReference = array.get(candidateLegReferences, candidateIndex)
    float supplyOriginRelativeVolume = array.get(candidateOriginRelativeVolumes, candidateIndex)
    int supplyOriginBar = array.get(candidateOriginBars, candidateIndex)
    int supplyStructureStartBar = array.get(candidateStructureStartBars, candidateIndex)
    bool isMultiBarSupplyStructure = supplyStructureStartBar < supplyOriginBar
    int effectiveMaxSellerLegBars = isMultiBarSupplyStructure ?
         math.max(maxSellerLegBars, collectiveMaxSellerLegBars) : maxSellerLegBars
    float supplyOriginAtr = array.get(candidateOriginAtrs, candidateIndex)
    float trackedLegLow = array.get(candidateTrackedLows, candidateIndex)
    bool sellerLegConfirmed = array.get(candidateLegConfirmed, candidateIndex)
    float demandLow = array.get(candidateDemandLows, candidateIndex)
    int demandBar = array.get(candidateDemandBars, candidateIndex)
    int breakCount = array.get(candidateBreakCounts, candidateIndex)
    bool breakImpulseQualified = array.get(candidateBreakImpulseQualified, candidateIndex)
    bool formationFinalized = array.get(candidateFormationFinalized, candidateIndex)
    int formationEndBar = array.get(candidateFormationEndBars, candidateIndex)
    int formationBarCount = array.get(candidateFormationBarCounts, candidateIndex)
    float formationPeakVolume = array.get(candidateFormationPeakVolumes, candidateIndex)
    float formationLastVolume = array.get(candidateFormationLastVolumes, candidateIndex)
    int firstSeparationBar = array.get(candidateFirstSeparationBars, candidateIndex)
    bool progressiveArmed = array.get(candidateProgressiveArmed, candidateIndex)
    float progressiveDemandLow = array.get(candidateProgressiveDemandLows, candidateIndex)
    int progressiveDemandBar = array.get(candidateProgressiveDemandBars, candidateIndex)
    float progressiveDemandAtr = array.get(candidateProgressiveDemandAtrs, candidateIndex)

    // Continue the forward supply formation until participation collapses. The
    // stopping candle itself is not included. A decisive close above the current
    // formation also freezes the previous bar so that a breakout cannot enlarge
    // the supply zone it is attempting to clear.
    if signalBarReady and not formationFinalized and bar_index > formationEndBar
        bool formationBelowAverage = not formationCollapseRequiresBelowAverage or
             (not na(volumeAverage) and volume < volumeAverage)
        bool formationRatioCollapse = volume <= formationLastVolume * formationCollapsePreviousRatio or
             volume <= formationPeakVolume * formationCollapsePeakRatio
        bool formationVolumeCollapsed = formationBelowAverage and formationRatioCollapse
        bool formationPriceLeftAbove = close > supplyTop + atr * breakBufferAtr
        // A bar whose high no longer reaches the evolving lower boundary proves
        // that price has left the supply auction to the downside. Exclude that bar
        // and freeze the formation immediately before it.
        bool formationPriceDisengagedBelow = high < supplyBottom - atr * structureTouchBufferAtr
        bool formationReachedCap = formationBarCount >= maxForwardSupplyFormationBars

        if formationVolumeCollapsed or formationPriceLeftAbove or formationPriceDisengagedBelow or formationReachedCap
            formationFinalized := true
        else
            supplyTop := math.max(supplyTop, high)
            supplyBottom := math.max(supplyBottom, close)
            sellerLegReference := math.max(sellerLegReference, supplyBottom)
            formationPeakVolume := math.max(formationPeakVolume, volume)
            formationLastVolume := volume
            formationEndBar := bar_index
            formationBarCount += 1
            if formationBarCount >= maxForwardSupplyFormationBars
                formationFinalized := true

        array.set(candidateTops, candidateIndex, supplyTop)
        array.set(candidateBottoms, candidateIndex, supplyBottom)
        array.set(candidateLegReferences, candidateIndex, sellerLegReference)
        array.set(candidateFormationFinalized, candidateIndex, formationFinalized)
        array.set(candidateFormationEndBars, candidateIndex, formationEndBar)
        array.set(candidateFormationBarCounts, candidateIndex, formationBarCount)
        array.set(candidateFormationPeakVolumes, candidateIndex, formationPeakVolume)
        array.set(candidateFormationLastVolumes, candidateIndex, formationLastVolume)

    bool formationReady = formationFinalized

    // A new low after demand confirmation means the seller leg has not truly ended.
    // Reset it and wait for a later demand pivot, provided the leg is still young enough.
    if sellerLegConfirmed and not na(demandLow) and low < demandLow - syminfo.mintick
        sellerLegConfirmed := false
        demandLow := na
        demandBar := na
        trackedLegLow := low
        array.set(candidateLegConfirmed, candidateIndex, false)
        array.set(candidateDemandLows, candidateIndex, na)
        array.set(candidateDemandBars, candidateIndex, na)
        array.set(candidateTrackedLows, candidateIndex, trackedLegLow)

    if not sellerLegConfirmed
        trackedLegLow := na(trackedLegLow) ? low : math.min(trackedLegLow, low)
        array.set(candidateTrackedLows, candidateIndex, trackedLegLow)

        if formationReady and signalBarReady and not na(confirmedPivotLow) and not na(atr[demandPivotRight])
            int proposedDemandBar = bar_index - demandPivotRight
            int proposedLegBars = proposedDemandBar - supplyOriginBar
            float demandAtr = atr[demandPivotRight]
            float demandBodyLow = math.min(open[demandPivotRight], close[demandPivotRight])
            float demandLowerWick = demandBodyLow - confirmedPivotLow
            bool pivotIsLegLow = math.abs(confirmedPivotLow - trackedLegLow) <= syminfo.mintick * 2.0
            bool legDurationOk = proposedLegBars >= minSellerLegBars and proposedLegBars <= effectiveMaxSellerLegBars
            bool legDeclineOk = sellerLegReference - confirmedPivotLow >= supplyOriginAtr * minSellerLegAtr
            bool demandWickOk = demandLowerWick >= demandAtr * minDemandLowerWickAtr
            bool demandReactionOk = postDemandHigh - confirmedPivotLow >= demandAtr * minDemandReactionAtr
            float maxDemandReactionRelativeVolume = na
            for demandVolumeOffset = 0 to demandPivotRight
                float reactionVolumeAverage = volumeAverage[demandVolumeOffset]
                float reactionRelativeVolume = not na(volume[demandVolumeOffset]) and
                     not na(reactionVolumeAverage) and reactionVolumeAverage > 0.0 ?
                     volume[demandVolumeOffset] / reactionVolumeAverage : na
                if not na(reactionRelativeVolume)
                    maxDemandReactionRelativeVolume := na(maxDemandReactionRelativeVolume) ?
                         reactionRelativeVolume : math.max(maxDemandReactionRelativeVolume, reactionRelativeVolume)
            bool demandVolumeOk = not na(maxDemandReactionRelativeVolume) and
                 maxDemandReactionRelativeVolume >= minDemandRelativeVolume

            if pivotIsLegLow and legDurationOk and legDeclineOk and demandWickOk and
                 demandReactionOk and demandVolumeOk
                sellerLegConfirmed := true
                demandLow := confirmedPivotLow
                demandBar := proposedDemandBar
                array.set(candidateLegConfirmed, candidateIndex, true)
                array.set(candidateDemandLows, candidateIndex, demandLow)
                array.set(candidateDemandBars, candidateIndex, demandBar)

        // Compact fallback: some strong supply candles produce a sharp one- or two-bar
        // seller leg whose low cannot satisfy the normal left-pivot requirement because
        // an earlier pre-origin candle was lower. Require exceptional origin volume,
        // a stable post-low reaction, and all normal decline/wick/reaction/volume tests.
        if formationReady and not sellerLegConfirmed and allowCompactSellerLeg and bar_index >= compactDemandRightBars
            int compactDemandBar = bar_index - compactDemandRightBars
            int compactLegBars = compactDemandBar - supplyOriginBar
            float compactDemandLow = low[compactDemandRightBars]
            float compactDemandAtr = atr[compactDemandRightBars]
            float compactDemandBodyLow = math.min(open[compactDemandRightBars], close[compactDemandRightBars])
            float compactDemandLowerWick = compactDemandBodyLow - compactDemandLow
            float compactMaxDemandRelativeVolume = na
            for compactVolumeOffset = 0 to compactDemandRightBars
                float compactVolumeAverage = volumeAverage[compactVolumeOffset]
                float compactRelativeVolume = not na(volume[compactVolumeOffset]) and
                     not na(compactVolumeAverage) and compactVolumeAverage > 0.0 ?
                     volume[compactVolumeOffset] / compactVolumeAverage : na
                if not na(compactRelativeVolume)
                    compactMaxDemandRelativeVolume := na(compactMaxDemandRelativeVolume) ?
                         compactRelativeVolume : math.max(compactMaxDemandRelativeVolume, compactRelativeVolume)

            bool compactOriginVolumeOk = not na(supplyOriginRelativeVolume) and
                 supplyOriginRelativeVolume >= minCompactSupplyRelativeVolume
            bool compactDurationOk = compactLegBars >= 1 and compactLegBars <= compactMaxSellerLegBars
            bool compactIsStableLegLow = compactDemandLow < compactPostDemandLow and
                 math.abs(compactDemandLow - trackedLegLow) <= syminfo.mintick * 2.0
            bool compactLegDeclineOk = sellerLegReference - compactDemandLow >= supplyOriginAtr * minSellerLegAtr
            bool compactDemandWickOk = not na(compactDemandAtr) and
                 compactDemandLowerWick >= compactDemandAtr * minDemandLowerWickAtr
            bool compactDemandReactionOk = not na(compactDemandAtr) and
                 compactPostDemandHigh - compactDemandLow >= compactDemandAtr * minDemandReactionAtr
            bool compactDemandVolumeOk = not na(compactMaxDemandRelativeVolume) and
                 compactMaxDemandRelativeVolume >= minDemandRelativeVolume

            if compactOriginVolumeOk and compactDurationOk and compactIsStableLegLow and
                 compactLegDeclineOk and compactDemandWickOk and compactDemandReactionOk and compactDemandVolumeOk
                sellerLegConfirmed := true
                demandLow := compactDemandLow
                demandBar := compactDemandBar
                array.set(candidateLegConfirmed, candidateIndex, true)
                array.set(candidateDemandLows, candidateIndex, demandLow)
                array.set(candidateDemandBars, candidateIndex, demandBar)

    bool legReady = formationReady and (not requireSellerControlLeg or sellerLegConfirmed)
    // Progressive takeover supplies its own lower-edge demand and preservation
    // evidence, so it must not depend on a separate classic seller-leg pivot.
    bool progressiveReady = formationReady

    // Universal leave-and-return proof. Once the supply formation and seller leg are
    // ready, record the first candle whose entire range is above the zone.
    if signalBarReady and legReady and na(firstSeparationBar) and bar_index > formationEndBar and low > supplyTop
        firstSeparationBar := bar_index
        array.set(candidateFirstSeparationBars, candidateIndex, firstSeparationBar)

    bool expired = bar_index - supplyOriginBar > maxHiddenAge
    bool legFormationExpired = requireSellerControlLeg and not sellerLegConfirmed and
         bar_index - supplyOriginBar > effectiveMaxSellerLegBars + demandPivotRight
    // Keep a candidate available for the progressive or immediate front-run path
    // until maxHiddenAge. The classic path may no longer use it after its
    // seller-leg window expires.
    bool classicLegUsable = not legFormationExpired
    bool closesAboveSupply = close > supplyTop + atr * breakBufferAtr

    float bullishBody = close - open
    bool breakBodyOk = bullishBody >= atr * minBreakBodyAtr
    bool breakVolumeOk = not requireBreakVolume or
         (not na(volume) and not na(volumeAverage) and volume >= volumeAverage * minBreakRelativeVolume)
    bool breakTrendDataReady = not na(fastEma) and not na(slowEma) and not na(sessionVwap)
    bool breakAboveTrend = close > fastEma and close > slowEma and close > sessionVwap
    bool breakBullishStack = fastEma > slowEma
    bool breakRisingEmas = not requireRisingEmas or
         (not na(fastEma[trendSlopeBars]) and not na(slowEma[trendSlopeBars]) and
         fastEma > fastEma[trendSlopeBars] and slowEma > slowEma[trendSlopeBars])
    bool breakRisingVwap = not requireRisingVwap or
         (not na(sessionVwap[trendSlopeBars]) and sessionVwap > sessionVwap[trendSlopeBars])
    bool breakTrendOk = not requireBullishTrend or
         (breakTrendDataReady and breakAboveTrend and breakBullishStack and breakRisingEmas and breakRisingVwap)
    bool currentBreakQualityOk = breakBodyOk and breakVolumeOk and breakTrendOk

    // Immediate front-run demand is intentionally independent of the classic
    // seller-leg age window. The original supply must still have produced the
    // required decline, and the preceding candle must be a complete high-quality
    // breakout from at/below the old supply top. The current candle then becomes
    // a hidden demand candidate only when its entire range is above supply, its
    // low remains very close to the top, and its lower wick shows rejection.
    bool immediateHistoryReady = bar_index > trendSlopeBars + 2 and
         not na(atr) and atr > 0.0 and not na(atr[1]) and atr[1] > 0.0 and
         not na(fastEma[1]) and not na(slowEma[1]) and not na(sessionVwap[1])
    float immediateImpulseBody = immediateHistoryReady ? close[1] - open[1] : na
    float immediateImpulseRelativeVolume = immediateHistoryReady and
         not na(volumeAverage[1]) and volumeAverage[1] > 0.0 ?
         volume[1] / volumeAverage[1] : na
    bool immediateImpulseClosesAbove = immediateHistoryReady and
         close[1] > supplyTop + atr[1] * breakBufferAtr
    bool immediateImpulseCrossesFromBelow = immediateHistoryReady and
         (open[1] <= supplyTop or close[2] <= supplyTop + atr[2] * breakBufferAtr)
    bool immediateImpulseBodyOk = immediateHistoryReady and
         immediateImpulseBody >= atr[1] * minBreakBodyAtr
    bool immediateImpulseVolumeOk = immediateHistoryReady and
         (not requireBreakVolume or
         (not na(immediateImpulseRelativeVolume) and
         immediateImpulseRelativeVolume >= minBreakRelativeVolume))
    bool immediateImpulseAboveTrend = immediateHistoryReady and
         close[1] > fastEma[1] and close[1] > slowEma[1] and close[1] > sessionVwap[1]
    bool immediateImpulseBullishStack = immediateHistoryReady and fastEma[1] > slowEma[1]
    bool immediateImpulseRisingEmas = not requireRisingEmas or
         (immediateHistoryReady and not na(fastEma[1 + trendSlopeBars]) and
         not na(slowEma[1 + trendSlopeBars]) and
         fastEma[1] > fastEma[1 + trendSlopeBars] and
         slowEma[1] > slowEma[1 + trendSlopeBars])
    bool immediateImpulseRisingVwap = not requireRisingVwap or
         (immediateHistoryReady and not na(sessionVwap[1 + trendSlopeBars]) and
         sessionVwap[1] > sessionVwap[1 + trendSlopeBars])
    bool immediateImpulseTrendOk = not requireBullishTrend or
         (immediateImpulseAboveTrend and immediateImpulseBullishStack and
         immediateImpulseRisingEmas and immediateImpulseRisingVwap)
    bool immediateStrongBreakout = immediateImpulseClosesAbove and
         immediateImpulseCrossesFromBelow and immediateImpulseBodyOk and
         immediateImpulseVolumeOk and immediateImpulseTrendOk

    float immediateFrontRunBodyLow = math.min(open, close)
    float immediateFrontRunLowerWick = immediateFrontRunBodyLow - low
    float immediateFrontRunRelativeVolume = not na(volumeAverage) and volumeAverage > 0.0 ?
         volume / volumeAverage : na
    bool immediateSellerMoveOk = not na(trackedLegLow) and
         sellerLegReference - trackedLegLow >= supplyOriginAtr * minSellerLegAtr
    bool immediateFrontRunAboveSupply = low > supplyTop and
         low <= supplyTop + atr * immediateFrontRunProximityAtr and
         close > supplyTop + atr * breakBufferAtr
    bool immediateFrontRunWickOk = immediateFrontRunLowerWick >= atr * minDemandLowerWickAtr
    bool immediateFrontRunVolumeOk = not na(immediateFrontRunRelativeVolume) and
         immediateFrontRunRelativeVolume >= minDemandRelativeVolume
    bool qualifiedImmediateFrontRunCandidate = signalBarReady and
         enableImmediateFrontRunDemand and formationReady and not expired and
         bar_index > formationEndBar and immediateSellerMoveOk and immediateStrongBreakout and
         immediateFrontRunAboveSupply and immediateFrontRunWickOk and immediateFrontRunVolumeOk

    // Progressive supply takeover path:
    //   1. A demand candle tests the lower edge and closes back above it.
    //   2. Every later low must preserve that demand low.
    //   3. Consecutive closes above the supply top confirm acceptance on renewed volume.
    if signalBarReady and enableProgressiveSupplyTakeover and progressiveReady and not expired
        float progressivePreservationTolerance = syminfo.mintick * progressivePreservationToleranceTicks

        if progressiveArmed
            bool progressiveLowBroken = bar_index > progressiveDemandBar and
                 low < progressiveDemandLow - progressivePreservationTolerance
            bool progressiveTimedOut = bar_index - progressiveDemandBar > progressiveMaxBarsToAcceptance
            if progressiveLowBroken or progressiveTimedOut
                progressiveArmed := false
                progressiveDemandLow := na
                progressiveDemandBar := na
                progressiveDemandAtr := na
                array.set(candidateProgressiveArmed, candidateIndex, false)
                array.set(candidateProgressiveDemandLows, candidateIndex, na)
                array.set(candidateProgressiveDemandBars, candidateIndex, na)
                array.set(candidateProgressiveDemandAtrs, candidateIndex, na)

        if not progressiveArmed and bar_index > formationEndBar and not na(atr) and atr > 0.0
            float progressiveBodyLow = math.min(open, close)
            float progressiveLowerWick = progressiveBodyLow - low
            float progressiveRelativeVolume = not na(volumeAverage) and volumeAverage > 0.0 ? volume / volumeAverage : na
            bool progressiveNearBottom = low <= supplyBottom + atr * progressiveBottomTestToleranceAtr and
                 low >= supplyBottom - atr * progressiveBottomTestToleranceAtr
            bool progressiveClosesBackAboveBottom = close > supplyBottom
            bool progressiveInsideSupply = high >= supplyBottom and low <= supplyTop
            bool progressiveWickOk = progressiveLowerWick >= atr * minDemandLowerWickAtr
            bool progressiveVolumeOk = not na(progressiveRelativeVolume) and
                 progressiveRelativeVolume >= minDemandRelativeVolume

            if progressiveNearBottom and progressiveClosesBackAboveBottom and progressiveInsideSupply and
                 progressiveWickOk and progressiveVolumeOk
                progressiveArmed := true
                progressiveDemandLow := low
                progressiveDemandBar := bar_index
                progressiveDemandAtr := atr
                array.set(candidateProgressiveArmed, candidateIndex, true)
                array.set(candidateProgressiveDemandLows, candidateIndex, progressiveDemandLow)
                array.set(candidateProgressiveDemandBars, candidateIndex, progressiveDemandBar)
                array.set(candidateProgressiveDemandAtrs, candidateIndex, progressiveDemandAtr)

    // Preserve a strong impulse anywhere inside the uninterrupted close-above-supply
    // sequence. A later consecutive close can confirm acceptance even when that
    // acceptance candle is neutral or bearish.
    if signalBarReady
        // Classic flips count after their seller leg is ready. Progressive
        // takeovers begin counting only after lower-edge demand has armed.
        bool breakSequenceEligible = (legReady and classicLegUsable) or progressiveArmed
        if not expired and breakSequenceEligible and closesAboveSupply
            breakCount += 1
            breakImpulseQualified := breakImpulseQualified or currentBreakQualityOk
        else
            breakCount := 0
            breakImpulseQualified := false
        array.set(candidateBreakCounts, candidateIndex, breakCount)
        array.set(candidateBreakImpulseQualified, candidateIndex, breakImpulseQualified)

    bool acceptedStrongImpulse = allowImpulseThenAcceptance and breakImpulseQualified
    bool finalBreakQualityOk = currentBreakQualityOk or acceptedStrongImpulse
    float progressiveAcceptanceRelativeVolume = not na(volumeAverage) and volumeAverage > 0.0 ? volume / volumeAverage : na
    bool progressiveAcceptanceVolumeOk = not na(progressiveAcceptanceRelativeVolume) and
         progressiveAcceptanceRelativeVolume >= progressiveMinAcceptanceRelativeVolume
    bool progressiveDemandStillPreserved = progressiveArmed and not na(progressiveDemandLow) and
         not na(progressiveDemandBar) and bar_index > progressiveDemandBar and
         bar_index - progressiveDemandBar <= progressiveMaxBarsToAcceptance and
         low >= progressiveDemandLow - syminfo.mintick * progressivePreservationToleranceTicks
    bool qualifiedProgressiveTakeover = signalBarReady and not expired and
         enableProgressiveSupplyTakeover and progressiveReady and progressiveDemandStillPreserved and
         breakCount >= requiredBreakCloses and progressiveAcceptanceVolumeOk and breakTrendOk
    bool qualifiedFlip = signalBarReady and not expired and classicLegUsable and legReady and
         breakCount >= requiredBreakCloses and finalBreakQualityOk and not qualifiedProgressiveTakeover
    bool failedBreakQuality = signalBarReady and not expired and classicLegUsable and legReady and
         breakCount >= requiredBreakCloses and not finalBreakQualityOk and not qualifiedProgressiveTakeover

    // A weak close-above sequence does not erase proven supply. Reset confirmation and
    // let the hidden candidate wait for a later sequence containing a high-quality impulse.
    if failedBreakQuality
        breakCount := 0
        breakImpulseQualified := false
        array.set(candidateBreakCounts, candidateIndex, breakCount)
        array.set(candidateBreakImpulseQualified, candidateIndex, breakImpulseQualified)

    if qualifiedProgressiveTakeover
        int progressiveVisibleStartBar = drawFromSupplyOrigin ?
             supplyStructureStartBar : progressiveDemandBar
        int progressiveVisiblePadding = drawFromSupplyOrigin ? zoneLeftPaddingBars : 0
        box newProgressiveFlipBox = box.new(
             left = f_bar_left_edge_time(progressiveVisibleStartBar, progressiveVisiblePadding),
             top = supplyTop,
             right = f_bar_right_edge_time(bar_index),
             bottom = supplyBottom,
             xloc = xloc.bar_time,
             border_color = activeBorder,
             border_width = 1,
             bgcolor = activeFill,
             text = "",
             text_color = hiddenDrawingColor,
             text_size = size.normal,
             text_halign = text.align_left)

        box newProgressiveFormationBox = na
        if showSellerControlLeg
            newProgressiveFormationBox := box.new(
                 left = f_bar_left_edge_time(supplyStructureStartBar, zoneLeftPaddingBars),
                 top = supplyTop,
                 right = f_bar_right_edge_time(formationEndBar),
                 bottom = supplyBottom,
                 xloc = xloc.bar_time,
                 border_color = sellerLegBorder,
                 border_width = 1,
                 bgcolor = sellerLegFill,
                 text = "",
                 text_color = hiddenDrawingColor,
                 text_size = size.normal,
                 text_halign = text.align_left)

        int progressiveOriginTime = time[bar_index - supplyStructureStartBar]
        string progressiveDemandTime = str.format_time(time[bar_index - progressiveDemandBar], "HH:mm", syminfo.timezone)
        // Keep a synchronized placeholder in the zone lifecycle array. Zone
        // callout text is intentionally disabled; the S→D arrow remains.
        label newProgressiveTextLabel = na

        float progressiveMarkerY = progressiveDemandLow - progressiveDemandAtr * 0.15
        string progressiveConfirmedTime = str.format_time(time, "HH:mm", syminfo.timezone)
        label progressiveDemandLabel = label.new(
             x = progressiveDemandBar,
             y = progressiveMarkerY,
             text = "S→D",
             xloc = xloc.bar_index,
             yloc = yloc.price,
             style = label.style_label_up,
             color = color.new(color.lime, 0),
             textcolor = color.black,
             size = size.normal,
             textalign = text.align_center,
             tooltip = "Progressive takeover demand " + progressiveDemandTime +
                  " • confirmed " + progressiveConfirmedTime +
                  " • original supply " + str.tostring(supplyBottom, format.mintick) +
                  "–" + str.tostring(supplyTop, format.mintick))
        array.push(confirmedSupplyFlipSupportBars, progressiveDemandBar)
        array.push(confirmedSupplyFlipSupportLabels, progressiveDemandLabel)
        if array.size(confirmedSupplyFlipSupportBars) > maxHistoricalSupportMarkers
            array.shift(confirmedSupplyFlipSupportBars)
            label oldestProgressiveSupportLabel = array.shift(confirmedSupplyFlipSupportLabels)
            if not na(oldestProgressiveSupportLabel)
                label.delete(oldestProgressiveSupportLabel)

        int progressiveFirstSeparationBar = low > supplyTop ? bar_index : na
        array.push(flipBoxes, newProgressiveFlipBox)
        array.push(flipLegBoxes, newProgressiveFormationBox)
        array.push(flipTextLabels, newProgressiveTextLabel)
        array.push(flipTops, supplyTop)
        array.push(flipBottoms, supplyBottom)
        array.push(flipDemandLows, progressiveDemandLow)
        array.push(flipDemandBars, progressiveDemandBar)
        array.push(flipConfirmationBars, bar_index)
        array.push(flipOriginTimes, progressiveOriginTime)
        array.push(flipRetested, true)
        array.push(flipWasIntersecting, false)
        array.push(flipActive, true)
        array.push(flipZoneKinds, ZONE_KIND_PROGRESSIVE_TAKEOVER)
        array.push(flipDemandConfirmed, true)
        array.push(flipEvidenceConfirmationBars, bar_index)
        array.push(flipFirstSeparationBars, progressiveFirstSeparationBar)
        flipDetected := true
        progressiveTakeoverDetected := true

        if sendDynamicAlerts
            alert("Progressive supply takeover confirmed | " + syminfo.ticker + " " + timeframe.period +
                 " | Demand: " + progressiveDemandTime +
                 " | Confirmed: " + progressiveConfirmedTime +
                 " | Zone: " + str.tostring(supplyBottom, format.mintick) + " - " +
                 str.tostring(supplyTop, format.mintick), alert.freq_once_per_bar_close)

        array.remove(candidateTops, candidateIndex)
        array.remove(candidateBottoms, candidateIndex)
        array.remove(candidateLegReferences, candidateIndex)
        array.remove(candidateOriginRelativeVolumes, candidateIndex)
        array.remove(candidateOriginBars, candidateIndex)
        array.remove(candidateStructureStartBars, candidateIndex)
        array.remove(candidateOriginAtrs, candidateIndex)
        array.remove(candidateTrackedLows, candidateIndex)
        array.remove(candidateLegConfirmed, candidateIndex)
        array.remove(candidateDemandLows, candidateIndex)
        array.remove(candidateDemandBars, candidateIndex)
        array.remove(candidateBreakCounts, candidateIndex)
        array.remove(candidateBreakImpulseQualified, candidateIndex)
        array.remove(candidateFormationFinalized, candidateIndex)
        array.remove(candidateFormationEndBars, candidateIndex)
        array.remove(candidateFormationBarCounts, candidateIndex)
        array.remove(candidateFormationPeakVolumes, candidateIndex)
        array.remove(candidateFormationLastVolumes, candidateIndex)
        array.remove(candidateFirstSeparationBars, candidateIndex)
        array.remove(candidateProgressiveArmed, candidateIndex)
        array.remove(candidateProgressiveDemandLows, candidateIndex)
        array.remove(candidateProgressiveDemandBars, candidateIndex)
        array.remove(candidateProgressiveDemandAtrs, candidateIndex)

        if array.size(flipBoxes) > maxHistoricalFlipStructures
            int evictionIndex = f_flip_retention_eviction_index()
            box evictedBox = array.remove(flipBoxes, evictionIndex)
            box evictedLegBox = array.remove(flipLegBoxes, evictionIndex)
            label evictedTextLabel = array.remove(flipTextLabels, evictionIndex)
            box.delete(evictedBox)
            if not na(evictedLegBox)
                box.delete(evictedLegBox)
            if not na(evictedTextLabel)
                label.delete(evictedTextLabel)
            array.remove(flipTops, evictionIndex)
            array.remove(flipBottoms, evictionIndex)
            array.remove(flipDemandLows, evictionIndex)
            array.remove(flipDemandBars, evictionIndex)
            array.remove(flipConfirmationBars, evictionIndex)
            array.remove(flipOriginTimes, evictionIndex)
            array.remove(flipRetested, evictionIndex)
            array.remove(flipWasIntersecting, evictionIndex)
            array.remove(flipActive, evictionIndex)
            array.remove(flipZoneKinds, evictionIndex)
            array.remove(flipDemandConfirmed, evictionIndex)
            array.remove(flipEvidenceConfirmationBars, evictionIndex)
            array.remove(flipFirstSeparationBars, evictionIndex)
    else if qualifiedImmediateFrontRunCandidate
        // Store the original supply zone invisibly while the next bars confirm
        // that the immediate front-run low was genuinely defended. This path
        // does not reveal the zone or draw an arrow before confirmation.
        box newImmediateFlipBox = box.new(
             left = drawFromSupplyOrigin ?
                  f_bar_left_edge_time(supplyStructureStartBar, zoneLeftPaddingBars) :
                  f_bar_left_edge_time(bar_index, 0),
             top = supplyTop,
             right = f_bar_right_edge_time(bar_index),
             bottom = supplyBottom,
             xloc = xloc.bar_time,
             border_color = hiddenDrawingColor,
             border_width = 1,
             bgcolor = hiddenDrawingColor,
             text = "",
             text_color = hiddenDrawingColor,
             text_size = size.normal,
             text_halign = text.align_left)

        box newImmediateFormationBox = na
        if showSellerControlLeg
            newImmediateFormationBox := box.new(
                 left = f_bar_left_edge_time(supplyStructureStartBar, zoneLeftPaddingBars),
                 top = supplyTop,
                 right = f_bar_right_edge_time(formationEndBar),
                 bottom = supplyBottom,
                 xloc = xloc.bar_time,
                 border_color = hiddenDrawingColor,
                 border_width = 1,
                 bgcolor = hiddenDrawingColor,
                 text = "",
                 text_color = hiddenDrawingColor,
                 text_size = size.normal,
                 text_halign = text.align_left)

        array.push(flipBoxes, newImmediateFlipBox)
        array.push(flipLegBoxes, newImmediateFormationBox)
        array.push(flipTextLabels, na)
        array.push(flipTops, supplyTop)
        array.push(flipBottoms, supplyBottom)
        array.push(flipDemandLows, low)
        array.push(flipDemandBars, bar_index)
        array.push(flipConfirmationBars, bar_index)
        array.push(flipOriginTimes, time[bar_index - supplyStructureStartBar])
        array.push(flipRetested, false)
        array.push(flipWasIntersecting, false)
        array.push(flipActive, true)
        array.push(flipZoneKinds, ZONE_KIND_IMMEDIATE_FRONT_RUN)
        array.push(flipDemandConfirmed, false)
        array.push(flipEvidenceConfirmationBars, na)
        array.push(flipFirstSeparationBars, bar_index)

        array.remove(candidateTops, candidateIndex)
        array.remove(candidateBottoms, candidateIndex)
        array.remove(candidateLegReferences, candidateIndex)
        array.remove(candidateOriginRelativeVolumes, candidateIndex)
        array.remove(candidateOriginBars, candidateIndex)
        array.remove(candidateStructureStartBars, candidateIndex)
        array.remove(candidateOriginAtrs, candidateIndex)
        array.remove(candidateTrackedLows, candidateIndex)
        array.remove(candidateLegConfirmed, candidateIndex)
        array.remove(candidateDemandLows, candidateIndex)
        array.remove(candidateDemandBars, candidateIndex)
        array.remove(candidateBreakCounts, candidateIndex)
        array.remove(candidateBreakImpulseQualified, candidateIndex)
        array.remove(candidateFormationFinalized, candidateIndex)
        array.remove(candidateFormationEndBars, candidateIndex)
        array.remove(candidateFormationBarCounts, candidateIndex)
        array.remove(candidateFormationPeakVolumes, candidateIndex)
        array.remove(candidateFormationLastVolumes, candidateIndex)
        array.remove(candidateFirstSeparationBars, candidateIndex)
        array.remove(candidateProgressiveArmed, candidateIndex)
        array.remove(candidateProgressiveDemandLows, candidateIndex)
        array.remove(candidateProgressiveDemandBars, candidateIndex)
        array.remove(candidateProgressiveDemandAtrs, candidateIndex)

        if array.size(flipBoxes) > maxHistoricalFlipStructures
            int evictionIndex = f_flip_retention_eviction_index()
            box evictedBox = array.remove(flipBoxes, evictionIndex)
            box evictedLegBox = array.remove(flipLegBoxes, evictionIndex)
            label evictedTextLabel = array.remove(flipTextLabels, evictionIndex)
            box.delete(evictedBox)
            if not na(evictedLegBox)
                box.delete(evictedLegBox)
            if not na(evictedTextLabel)
                label.delete(evictedTextLabel)
            array.remove(flipTops, evictionIndex)
            array.remove(flipBottoms, evictionIndex)
            array.remove(flipDemandLows, evictionIndex)
            array.remove(flipDemandBars, evictionIndex)
            array.remove(flipConfirmationBars, evictionIndex)
            array.remove(flipOriginTimes, evictionIndex)
            array.remove(flipRetested, evictionIndex)
            array.remove(flipWasIntersecting, evictionIndex)
            array.remove(flipActive, evictionIndex)
            array.remove(flipZoneKinds, evictionIndex)
            array.remove(flipDemandConfirmed, evictionIndex)
            array.remove(flipEvidenceConfirmationBars, evictionIndex)
            array.remove(flipFirstSeparationBars, evictionIndex)
    else if qualifiedFlip
        box newFlipBox = box.new(
             left = drawFromSupplyOrigin ?
                  f_bar_left_edge_time(supplyStructureStartBar, zoneLeftPaddingBars) :
                  f_bar_left_edge_time(bar_index, 0),
             top = supplyTop,
             right = f_bar_right_edge_time(bar_index),
             bottom = supplyBottom,
             xloc = xloc.bar_time,
             border_color = hiddenDrawingColor,
             border_width = 1,
             bgcolor = hiddenDrawingColor,
             text = "",
             text_color = hiddenDrawingColor,
             text_size = size.normal,
             text_halign = text.align_left)

        box newLegBox = na
        if sellerLegConfirmed and not na(demandLow) and not na(demandBar)
            newLegBox := box.new(
                 left = f_bar_left_edge_time(supplyStructureStartBar, zoneLeftPaddingBars),
                 top = supplyTop,
                 right = f_bar_right_edge_time(demandBar),
                 bottom = demandLow,
                 xloc = xloc.bar_time,
                 border_color = hiddenDrawingColor,
                 border_width = 1,
                 bgcolor = hiddenDrawingColor,
                 text = "",
                 text_color = hiddenDrawingColor,
                 text_size = size.normal,
                 text_halign = text.align_left)

        array.push(flipBoxes, newFlipBox)
        array.push(flipLegBoxes, newLegBox)
        array.push(flipTextLabels, na)
        array.push(flipTops, supplyTop)
        array.push(flipBottoms, supplyBottom)
        array.push(flipDemandLows, demandLow)
        array.push(flipDemandBars, demandBar)
        array.push(flipConfirmationBars, bar_index)
        array.push(flipOriginTimes, time[bar_index - supplyStructureStartBar])
        array.push(flipRetested, false)
        array.push(flipWasIntersecting, false)
        array.push(flipActive, true)
        array.push(flipZoneKinds, ZONE_KIND_SUPPLY_FLIP)
        array.push(flipDemandConfirmed, false)
        array.push(flipEvidenceConfirmationBars, na)
        array.push(flipFirstSeparationBars, firstSeparationBar)
        flipDetected := true

        if sendDynamicAlerts
            string legDetails = sellerLegConfirmed ?
                 " | Supply formation: " + str.tostring(formationBarCount) + " bars" +
                 " | Demand low: " + str.tostring(demandLow, format.mintick) : ""
            alert("Supply→Demand flip confirmed | " + syminfo.ticker + " " + timeframe.period +
                 " | Zone: " + str.tostring(supplyBottom, format.mintick) + " - " +
                 str.tostring(supplyTop, format.mintick) + legDetails, alert.freq_once_per_bar_close)

        array.remove(candidateTops, candidateIndex)
        array.remove(candidateBottoms, candidateIndex)
        array.remove(candidateLegReferences, candidateIndex)
        array.remove(candidateOriginRelativeVolumes, candidateIndex)
        array.remove(candidateOriginBars, candidateIndex)
        array.remove(candidateStructureStartBars, candidateIndex)
        array.remove(candidateOriginAtrs, candidateIndex)
        array.remove(candidateTrackedLows, candidateIndex)
        array.remove(candidateLegConfirmed, candidateIndex)
        array.remove(candidateDemandLows, candidateIndex)
        array.remove(candidateDemandBars, candidateIndex)
        array.remove(candidateBreakCounts, candidateIndex)
        array.remove(candidateBreakImpulseQualified, candidateIndex)
        array.remove(candidateFormationFinalized, candidateIndex)
        array.remove(candidateFormationEndBars, candidateIndex)
        array.remove(candidateFormationBarCounts, candidateIndex)
        array.remove(candidateFormationPeakVolumes, candidateIndex)
        array.remove(candidateFormationLastVolumes, candidateIndex)
        array.remove(candidateFirstSeparationBars, candidateIndex)
        array.remove(candidateProgressiveArmed, candidateIndex)
        array.remove(candidateProgressiveDemandLows, candidateIndex)
        array.remove(candidateProgressiveDemandBars, candidateIndex)
        array.remove(candidateProgressiveDemandAtrs, candidateIndex)

        if array.size(flipBoxes) > maxHistoricalFlipStructures
            int evictionIndex = f_flip_retention_eviction_index()
            box evictedBox = array.remove(flipBoxes, evictionIndex)
            box evictedLegBox = array.remove(flipLegBoxes, evictionIndex)
            label evictedTextLabel = array.remove(flipTextLabels, evictionIndex)
            box.delete(evictedBox)
            if not na(evictedLegBox)
                box.delete(evictedLegBox)
            if not na(evictedTextLabel)
                label.delete(evictedTextLabel)
            array.remove(flipTops, evictionIndex)
            array.remove(flipBottoms, evictionIndex)
            array.remove(flipDemandLows, evictionIndex)
            array.remove(flipDemandBars, evictionIndex)
            array.remove(flipConfirmationBars, evictionIndex)
            array.remove(flipOriginTimes, evictionIndex)
            array.remove(flipRetested, evictionIndex)
            array.remove(flipWasIntersecting, evictionIndex)
            array.remove(flipActive, evictionIndex)
            array.remove(flipZoneKinds, evictionIndex)
            array.remove(flipDemandConfirmed, evictionIndex)
            array.remove(flipEvidenceConfirmationBars, evictionIndex)
            array.remove(flipFirstSeparationBars, evictionIndex)
    else if expired or (legFormationExpired and
         not enableProgressiveSupplyTakeover and not enableImmediateFrontRunDemand)
        array.remove(candidateTops, candidateIndex)
        array.remove(candidateBottoms, candidateIndex)
        array.remove(candidateLegReferences, candidateIndex)
        array.remove(candidateOriginRelativeVolumes, candidateIndex)
        array.remove(candidateOriginBars, candidateIndex)
        array.remove(candidateStructureStartBars, candidateIndex)
        array.remove(candidateOriginAtrs, candidateIndex)
        array.remove(candidateTrackedLows, candidateIndex)
        array.remove(candidateLegConfirmed, candidateIndex)
        array.remove(candidateDemandLows, candidateIndex)
        array.remove(candidateDemandBars, candidateIndex)
        array.remove(candidateBreakCounts, candidateIndex)
        array.remove(candidateBreakImpulseQualified, candidateIndex)
        array.remove(candidateFormationFinalized, candidateIndex)
        array.remove(candidateFormationEndBars, candidateIndex)
        array.remove(candidateFormationBarCounts, candidateIndex)
        array.remove(candidateFormationPeakVolumes, candidateIndex)
        array.remove(candidateFormationLastVolumes, candidateIndex)
        array.remove(candidateFirstSeparationBars, candidateIndex)
        array.remove(candidateProgressiveArmed, candidateIndex)
        array.remove(candidateProgressiveDemandLows, candidateIndex)
        array.remove(candidateProgressiveDemandBars, candidateIndex)
        array.remove(candidateProgressiveDemandAtrs, candidateIndex)

    candidateIndex -= 1

// ───────────── Confirm bullish continuation-base zones ─────────────
// This path is intentionally separate from supply qualification. It looks for:
//   prior bullish impulse → compact high-volume acceptance shelf → decisive close above the shelf.
// The resulting demand zone remains hidden until its first later retest, matching the supply-flip lifecycle.
if enableContinuationBases and signalBarReady and continuationMaxBaseBars >= continuationMinBaseBars and
     bar_index > continuationMaxBaseBars + continuationPriorImpulseLookback + trendSlopeBars and not na(atr)
    bool continuationBreakTrendDataReady = not na(fastEma) and not na(slowEma) and not na(sessionVwap)
    bool continuationBreakAboveTrend = close > fastEma and close > slowEma and close > sessionVwap
    bool continuationBreakBullishStack = fastEma > slowEma
    bool continuationBreakRisingEmas = not requireRisingEmas or
         (not na(fastEma[trendSlopeBars]) and not na(slowEma[trendSlopeBars]) and
         fastEma > fastEma[trendSlopeBars] and slowEma > slowEma[trendSlopeBars])
    bool continuationBreakRisingVwap = not requireRisingVwap or
         (not na(sessionVwap[trendSlopeBars]) and sessionVwap > sessionVwap[trendSlopeBars])
    bool continuationBreakTrendOk = not requireBullishTrend or
         (continuationBreakTrendDataReady and continuationBreakAboveTrend and continuationBreakBullishStack and
         continuationBreakRisingEmas and continuationBreakRisingVwap)

    int selectedBaseBars = 0
    float selectedBaseTop = na
    float selectedBaseBottom = na
    int selectedBaseStartBar = na
    int selectedBaseEndBar = na

    int continuationLengthsToTest = continuationMaxBaseBars - continuationMinBaseBars
    for continuationLengthIndex = 0 to continuationLengthsToTest
        int testedBaseBars = continuationMaxBaseBars - continuationLengthIndex
        if selectedBaseBars == 0 and bar_index > testedBaseBars + continuationPriorImpulseLookback
            float baseAtr = atr[1]
            float baseTop = na
            float baseLowestClose = na
            float baseHighestClose = na
            float baseHighestBodyLow = na
            float relativeVolumeSum = 0.0
            int relativeVolumeSamples = 0
            int highVolumeBaseBars = 0
            bool eachBaseBarVolumeOk = true
            bool eachBaseBarTrendOk = true
            bool baseDataReady = not na(baseAtr) and baseAtr > 0.0

            for baseOffset = 1 to testedBaseBars
                float baseBodyLow = math.min(open[baseOffset], close[baseOffset])
                float baseVolumeAverage = volumeAverage[baseOffset]
                float baseRelativeVolume = not na(volume[baseOffset]) and not na(baseVolumeAverage) and
                     baseVolumeAverage > 0.0 ? volume[baseOffset] / baseVolumeAverage : na

                baseTop := na(baseTop) ? high[baseOffset] : math.max(baseTop, high[baseOffset])
                baseLowestClose := na(baseLowestClose) ? close[baseOffset] : math.min(baseLowestClose, close[baseOffset])
                baseHighestClose := na(baseHighestClose) ? close[baseOffset] : math.max(baseHighestClose, close[baseOffset])
                baseHighestBodyLow := na(baseHighestBodyLow) ? baseBodyLow : math.max(baseHighestBodyLow, baseBodyLow)

                bool baseBarDataReady = not na(high[baseOffset]) and not na(close[baseOffset]) and
                     not na(fastEma[baseOffset]) and not na(slowEma[baseOffset]) and not na(sessionVwap[baseOffset]) and
                     not na(baseRelativeVolume)
                baseDataReady := baseDataReady and baseBarDataReady
                if not na(baseRelativeVolume)
                    relativeVolumeSum += baseRelativeVolume
                    relativeVolumeSamples += 1
                    highVolumeBaseBars += baseRelativeVolume >= continuationHighVolumeThreshold ? 1 : 0
                eachBaseBarVolumeOk := eachBaseBarVolumeOk and not na(baseRelativeVolume) and
                     baseRelativeVolume >= continuationMinBarRelativeVolume
                eachBaseBarTrendOk := eachBaseBarTrendOk and (not requireBullishTrend or
                     (close[baseOffset] > slowEma[baseOffset] and close[baseOffset] > sessionVwap[baseOffset] and
                     fastEma[baseOffset] > slowEma[baseOffset]))

            float baseBottom = continuationZoneFloor == "Lowest close" ? baseLowestClose : baseHighestBodyLow
            float averageBaseRelativeVolume = relativeVolumeSamples == testedBaseBars ?
                 relativeVolumeSum / testedBaseBars : na
            float baseZoneWidth = baseTop - baseBottom
            float baseCloseSpread = baseHighestClose - baseLowestClose
            bool validBaseZone = baseDataReady and not na(baseBottom) and baseTop > baseBottom and
                 baseZoneWidth <= baseAtr * continuationMaxZoneWidthAtr and
                 baseCloseSpread <= baseAtr * continuationMaxCloseSpreadAtr
            bool baseVolumeOk = eachBaseBarVolumeOk and not na(averageBaseRelativeVolume) and
                 averageBaseRelativeVolume >= continuationMinAverageRelativeVolume and
                 highVolumeBaseBars >= math.min(continuationMinHighVolumeBars, testedBaseBars)
            bool baseNetProgressOk = close[1] >= close[testedBaseBars] - baseAtr * continuationMaxNetPullbackAtr

            float priorImpulseLow = na
            for priorOffset = testedBaseBars + 1 to testedBaseBars + continuationPriorImpulseLookback
                priorImpulseLow := na(priorImpulseLow) ? low[priorOffset] : math.min(priorImpulseLow, low[priorOffset])
            bool priorImpulseOk = continuationMinPriorImpulseAtr <= 0.0 or
                 (not na(priorImpulseLow) and baseBottom - priorImpulseLow >= baseAtr * continuationMinPriorImpulseAtr)

            bool baseQualified = validBaseZone and baseVolumeOk and eachBaseBarTrendOk and
                 baseNetProgressOk and priorImpulseOk
            if baseQualified
                selectedBaseBars := testedBaseBars
                selectedBaseTop := baseTop
                selectedBaseBottom := baseBottom
                selectedBaseStartBar := bar_index - testedBaseBars
                selectedBaseEndBar := bar_index - 1

    if selectedBaseBars > 0
        float continuationBreakBody = close - open
        float continuationBreakUpperWick = high - math.max(open, close)
        bool continuationClosesAboveBase = close > selectedBaseTop + atr * continuationBreakBufferAtr
        bool continuationBreakBodyOk = continuationBreakBody >= atr * continuationMinBreakBodyAtr
        bool continuationBreakVolumeOk = not na(volume) and not na(volumeAverage) and volumeAverage > 0.0 and
             volume / volumeAverage >= continuationMinBreakRelativeVolume
        bool continuationBreakWickOk = continuationBreakUpperWick <= atr * continuationMaxBreakUpperWickAtr
        bool continuationBreakQualified = continuationClosesAboveBase and continuationBreakBodyOk and
             continuationBreakVolumeOk and continuationBreakWickOk and continuationBreakTrendOk

        bool continuationDuplicate = false
        int continuationDuplicateIndex = array.size(flipTops) - 1
        while continuationDuplicateIndex >= 0
            float oldZoneTop = array.get(flipTops, continuationDuplicateIndex)
            float oldZoneBottom = array.get(flipBottoms, continuationDuplicateIndex)
            int oldConfirmationBar = array.get(flipConfirmationBars, continuationDuplicateIndex)
            bool continuationOverlap = selectedBaseBottom <= oldZoneTop and selectedBaseTop >= oldZoneBottom
            bool continuationCloseInTime = bar_index - oldConfirmationBar <= continuationDuplicateWindowBars
            if continuationOverlap and continuationCloseInTime
                continuationDuplicate := true
            continuationDuplicateIndex -= 1

        if continuationBreakQualified and not continuationDuplicate
            box newContinuationZoneBox = box.new(
                 left = drawFromSupplyOrigin ?
                      f_bar_left_edge_time(selectedBaseStartBar, zoneLeftPaddingBars) :
                      f_bar_left_edge_time(bar_index, 0),
                 top = selectedBaseTop,
                 right = f_bar_right_edge_time(bar_index),
                 bottom = selectedBaseBottom,
                 xloc = xloc.bar_time,
                 border_color = hiddenDrawingColor,
                 border_width = 1,
                 bgcolor = hiddenDrawingColor,
                 text = "",
                 text_color = hiddenDrawingColor,
                 text_size = size.normal,
                 text_halign = text.align_left)

            box newContinuationBaseBox = box.new(
                 left = f_bar_left_edge_time(selectedBaseStartBar, zoneLeftPaddingBars),
                 top = selectedBaseTop,
                 right = f_bar_right_edge_time(selectedBaseEndBar),
                 bottom = selectedBaseBottom,
                 xloc = xloc.bar_time,
                 border_color = hiddenDrawingColor,
                 border_width = 1,
                 bgcolor = hiddenDrawingColor,
                 text = "",
                 text_color = hiddenDrawingColor,
                 text_size = size.normal,
                 text_halign = text.align_left)

            array.push(flipBoxes, newContinuationZoneBox)
            array.push(flipLegBoxes, newContinuationBaseBox)
            array.push(flipTextLabels, na)
            array.push(flipTops, selectedBaseTop)
            array.push(flipBottoms, selectedBaseBottom)
            array.push(flipDemandLows, selectedBaseBottom)
            array.push(flipDemandBars, selectedBaseEndBar)
            array.push(flipConfirmationBars, bar_index)
            array.push(flipOriginTimes, time[bar_index - selectedBaseStartBar])
            array.push(flipRetested, false)
            array.push(flipWasIntersecting, false)
            array.push(flipActive, true)
            array.push(flipZoneKinds, ZONE_KIND_CONTINUATION_BASE)
            array.push(flipDemandConfirmed, true)
            array.push(flipEvidenceConfirmationBars, na)
            int continuationFirstSeparationBar = low > selectedBaseTop ? bar_index : na
            array.push(flipFirstSeparationBars, continuationFirstSeparationBar)
            flipDetected := true

            if sendDynamicAlerts
                alert("Bullish continuation base confirmed | " + syminfo.ticker + " " + timeframe.period +
                     " | Base bars: " + str.tostring(selectedBaseBars) +
                     " | Zone: " + str.tostring(selectedBaseBottom, format.mintick) + " - " +
                     str.tostring(selectedBaseTop, format.mintick), alert.freq_once_per_bar_close)

            if array.size(flipBoxes) > maxHistoricalFlipStructures
                int evictionIndex = f_flip_retention_eviction_index()
                box evictedBox = array.remove(flipBoxes, evictionIndex)
                box evictedLegBox = array.remove(flipLegBoxes, evictionIndex)
                label evictedTextLabel = array.remove(flipTextLabels, evictionIndex)
                box.delete(evictedBox)
                if not na(evictedLegBox)
                    box.delete(evictedLegBox)
                if not na(evictedTextLabel)
                    label.delete(evictedTextLabel)
                array.remove(flipTops, evictionIndex)
                array.remove(flipBottoms, evictionIndex)
                array.remove(flipDemandLows, evictionIndex)
                array.remove(flipDemandBars, evictionIndex)
                array.remove(flipConfirmationBars, evictionIndex)
                array.remove(flipOriginTimes, evictionIndex)
                array.remove(flipRetested, evictionIndex)
                array.remove(flipWasIntersecting, evictionIndex)
                array.remove(flipActive, evictionIndex)
                array.remove(flipZoneKinds, evictionIndex)
                array.remove(flipDemandConfirmed, evictionIndex)
                array.remove(flipEvidenceConfirmationBars, evictionIndex)
                array.remove(flipFirstSeparationBars, evictionIndex)

// ───────── Extend, retest, and close zone lifecycles ─────────
int zoneIndex = 0
while zoneIndex < array.size(flipBoxes)
    box zoneBox = array.get(flipBoxes, zoneIndex)
    box sellerLegBox = array.get(flipLegBoxes, zoneIndex)
    label zoneTextLabel = array.get(flipTextLabels, zoneIndex)
    float zoneTop = array.get(flipTops, zoneIndex)
    float zoneBottom = array.get(flipBottoms, zoneIndex)
    float sellerLegDemandLow = array.get(flipDemandLows, zoneIndex)
    int sellerLegDemandBar = array.get(flipDemandBars, zoneIndex)
    int confirmationBar = array.get(flipConfirmationBars, zoneIndex)
    int originTime = array.get(flipOriginTimes, zoneIndex)
    bool alreadyRetested = array.get(flipRetested, zoneIndex)
    bool wasIntersecting = array.get(flipWasIntersecting, zoneIndex)
    bool isActive = array.get(flipActive, zoneIndex)
    int zoneKind = array.get(flipZoneKinds, zoneIndex)
    bool demandConfirmed = array.get(flipDemandConfirmed, zoneIndex)
    int evidenceConfirmationBar = array.get(flipEvidenceConfirmationBars, zoneIndex)
    int firstSeparationBar = array.get(flipFirstSeparationBars, zoneIndex)
    bool isContinuationBase = zoneKind == ZONE_KIND_CONTINUATION_BASE
    bool isProgressiveTakeover = zoneKind == ZONE_KIND_PROGRESSIVE_TAKEOVER
    bool isImmediateFrontRun = zoneKind == ZONE_KIND_IMMEDIATE_FRONT_RUN
    bool immediateFrontRunPending = isImmediateFrontRun and not demandConfirmed
    bool removed = false

    // An immediate front-run setup is stored invisibly on the first complete
    // separation candle after the breakout. Confirm it only after the configured
    // number of actual bars preserve that low and produce the normal demand
    // reaction/volume evidence. If preservation or confirmation fails, discard
    // the hidden setup without leaving any historical drawing.
    if signalBarReady and isActive and immediateFrontRunPending
        box.set_right(zoneBox, f_bar_right_edge_time(bar_index))
        int immediateBarsSinceDemand = bar_index - sellerLegDemandBar
        float immediatePreservationTolerance = syminfo.mintick * immediateFrontRunPreservationTicks
        bool immediateLowBroken = immediateBarsSinceDemand > 0 and
             low < sellerLegDemandLow - immediatePreservationTolerance
        bool immediateConfirmationReached = immediateBarsSinceDemand >= immediateFrontRunConfirmationBars

        if immediateLowBroken or immediateConfirmationReached
            bool immediateDemandQualified = false
            float immediateDemandAtr = na
            float immediatePostDemandHigh = na
            float immediateMaxRelativeVolume = na

            if not immediateLowBroken and
                 immediateBarsSinceDemand == immediateFrontRunConfirmationBars and
                 not na(atr[immediateFrontRunConfirmationBars])
                immediateDemandAtr := atr[immediateFrontRunConfirmationBars]
                float immediateStoredLow = low[immediateFrontRunConfirmationBars]
                float immediateDemandBodyLow = math.min(
                     open[immediateFrontRunConfirmationBars],
                     close[immediateFrontRunConfirmationBars])
                float immediateDemandLowerWick = immediateDemandBodyLow - immediateStoredLow
                float immediateRightLowest = na

                for immediateRightOffset = 0 to immediateFrontRunConfirmationBars - 1
                    immediateRightLowest := na(immediateRightLowest) ?
                         low[immediateRightOffset] :
                         math.min(immediateRightLowest, low[immediateRightOffset])
                    immediatePostDemandHigh := na(immediatePostDemandHigh) ?
                         high[immediateRightOffset] :
                         math.max(immediatePostDemandHigh, high[immediateRightOffset])

                for immediateVolumeOffset = 0 to immediateFrontRunConfirmationBars
                    float immediateVolumeAverage = volumeAverage[immediateVolumeOffset]
                    float immediateRelativeVolume = not na(volume[immediateVolumeOffset]) and
                         not na(immediateVolumeAverage) and immediateVolumeAverage > 0.0 ?
                         volume[immediateVolumeOffset] / immediateVolumeAverage : na
                    if not na(immediateRelativeVolume)
                        immediateMaxRelativeVolume := na(immediateMaxRelativeVolume) ?
                             immediateRelativeVolume :
                             math.max(immediateMaxRelativeVolume, immediateRelativeVolume)

                bool immediateStoredBarMatches = sellerLegDemandBar ==
                     bar_index - immediateFrontRunConfirmationBars and
                     math.abs(immediateStoredLow - sellerLegDemandLow) <= syminfo.mintick * 2.0
                bool immediateLowPreserved = not na(immediateRightLowest) and
                     immediateRightLowest >= sellerLegDemandLow - immediatePreservationTolerance
                bool immediateWickConfirmed = immediateDemandLowerWick >=
                     immediateDemandAtr * minDemandLowerWickAtr
                bool immediateReactionConfirmed = not na(immediatePostDemandHigh) and
                     immediatePostDemandHigh - sellerLegDemandLow >=
                     immediateDemandAtr * minDemandReactionAtr
                bool immediateVolumeConfirmed = not na(immediateMaxRelativeVolume) and
                     immediateMaxRelativeVolume >= minDemandRelativeVolume
                immediateDemandQualified := immediateStoredBarMatches and immediateLowPreserved and
                     immediateWickConfirmed and immediateReactionConfirmed and immediateVolumeConfirmed

            if immediateDemandQualified
                array.set(flipRetested, zoneIndex, true)
                array.set(flipDemandConfirmed, zoneIndex, true)
                array.set(flipEvidenceConfirmationBars, zoneIndex, bar_index)
                alreadyRetested := true
                demandConfirmed := true
                evidenceConfirmationBar := bar_index
                immediateFrontRunPending := false
                box.set_bgcolor(zoneBox, activeFill)
                box.set_border_color(zoneBox, activeBorder)
                box.set_text(zoneBox, "")

                if showSellerControlLeg and not na(sellerLegBox)
                    box.set_bgcolor(sellerLegBox, sellerLegFill)
                    box.set_border_color(sellerLegBox, sellerLegBorder)
                    box.set_text(sellerLegBox, "")

                string immediateDemandTime = str.format_time(
                     time[immediateFrontRunConfirmationBars], "HH:mm", syminfo.timezone)
                string immediateConfirmedTime = str.format_time(time, "HH:mm", syminfo.timezone)
                bool immediateSupportIsNew = array.indexof(
                     confirmedSupplyFlipSupportBars, sellerLegDemandBar) == -1
                if immediateSupportIsNew
                    label immediateDemandLabel = na
                    if showConfirmedSupplyFlipSupports
                        float immediateMarkerY = sellerLegDemandLow - immediateDemandAtr * 0.15
                        immediateDemandLabel := label.new(
                             x = sellerLegDemandBar,
                             y = immediateMarkerY,
                             text = "S→D",
                             xloc = xloc.bar_index,
                             yloc = yloc.price,
                             style = label.style_label_up,
                             color = color.new(color.lime, 0),
                             textcolor = color.black,
                             size = size.normal,
                             textalign = text.align_center,
                             tooltip = "Immediate front-run demand " + immediateDemandTime +
                                  " • confirmed " + immediateConfirmedTime +
                                  " • original supply " + str.tostring(zoneBottom, format.mintick) +
                                  "–" + str.tostring(zoneTop, format.mintick))

                    array.push(confirmedSupplyFlipSupportBars, sellerLegDemandBar)
                    array.push(confirmedSupplyFlipSupportLabels, immediateDemandLabel)
                    confirmedSupplyFlipSupportDetected := true
                    if array.size(confirmedSupplyFlipSupportBars) > maxHistoricalSupportMarkers
                        array.shift(confirmedSupplyFlipSupportBars)
                        label oldestImmediateSupportLabel = array.shift(confirmedSupplyFlipSupportLabels)
                        if not na(oldestImmediateSupportLabel)
                            label.delete(oldestImmediateSupportLabel)

                    if sendDynamicAlerts
                        alert("Immediate front-run S→D demand confirmed | " + syminfo.ticker + " " + timeframe.period +
                             " | Demand: " + immediateDemandTime +
                             " | Confirmed: " + immediateConfirmedTime +
                             " | Zone: " + str.tostring(zoneBottom, format.mintick) + " - " +
                             str.tostring(zoneTop, format.mintick), alert.freq_once_per_bar_close)
            else
                box.delete(zoneBox)
                if not na(sellerLegBox)
                    box.delete(sellerLegBox)
                if not na(zoneTextLabel)
                    label.delete(zoneTextLabel)
                array.remove(flipBoxes, zoneIndex)
                array.remove(flipLegBoxes, zoneIndex)
                array.remove(flipTextLabels, zoneIndex)
                array.remove(flipTops, zoneIndex)
                array.remove(flipBottoms, zoneIndex)
                array.remove(flipDemandLows, zoneIndex)
                array.remove(flipDemandBars, zoneIndex)
                array.remove(flipConfirmationBars, zoneIndex)
                array.remove(flipOriginTimes, zoneIndex)
                array.remove(flipRetested, zoneIndex)
                array.remove(flipWasIntersecting, zoneIndex)
                array.remove(flipActive, zoneIndex)
                array.remove(flipZoneKinds, zoneIndex)
                array.remove(flipDemandConfirmed, zoneIndex)
                array.remove(flipEvidenceConfirmationBars, zoneIndex)
                array.remove(flipFirstSeparationBars, zoneIndex)
                removed := true

    // Keep checking every active zone until one complete candle trades entirely
    // above it. A later return is not a valid retest without this separation proof.
    if not removed and signalBarReady and isActive and not immediateFrontRunPending and
         na(firstSeparationBar) and bar_index > confirmationBar and low > zoneTop
        firstSeparationBar := bar_index
        array.set(flipFirstSeparationBars, zoneIndex, firstSeparationBar)
    bool hasFullSeparation = not na(firstSeparationBar)

    // A confirmed pivot low inside an already flipped original supply zone is a
    // confirmed S→D support point. Place only an arrow on the actual support candle;
    // the price area remains the original supply zone.
    if not removed and signalBarReady and isActive and not immediateFrontRunPending and
         not isContinuationBase and
         not na(confirmedPivotLow) and not na(atr[demandPivotRight])
        int confirmedSupportBar = bar_index - demandPivotRight
        float confirmedSupportHigh = high[demandPivotRight]
        float confirmedSupportAtr = atr[demandPivotRight]
        float confirmedSupportBodyLow = math.min(open[demandPivotRight], close[demandPivotRight])
        float confirmedSupportLowerWick = confirmedSupportBodyLow - confirmedPivotLow
        bool confirmedSupportAfterFlip = confirmedSupportBar > confirmationBar
        bool confirmedSupportAfterSeparation = hasFullSeparation and confirmedSupportBar > firstSeparationBar
        float confirmedSupportProximityTop = zoneTop + confirmedSupportAtr * supplyRetestProximityAtr
        bool confirmedSupportInsideZone = confirmedPivotLow <= confirmedSupportProximityTop and
             confirmedSupportHigh >= zoneBottom
        bool confirmedSupportWickOk = confirmedSupportLowerWick >= confirmedSupportAtr * minDemandLowerWickAtr
        bool confirmedSupportReactionOk = postDemandHigh - confirmedPivotLow >= confirmedSupportAtr * minDemandReactionAtr
        float confirmedSupportMaxRelativeVolume = na
        for confirmedSupportVolumeOffset = 0 to demandPivotRight
            float confirmedSupportVolumeAverage = volumeAverage[confirmedSupportVolumeOffset]
            float confirmedSupportRelativeVolume = not na(volume[confirmedSupportVolumeOffset]) and
                 not na(confirmedSupportVolumeAverage) and confirmedSupportVolumeAverage > 0.0 ?
                 volume[confirmedSupportVolumeOffset] / confirmedSupportVolumeAverage : na
            if not na(confirmedSupportRelativeVolume)
                confirmedSupportMaxRelativeVolume := na(confirmedSupportMaxRelativeVolume) ?
                     confirmedSupportRelativeVolume : math.max(confirmedSupportMaxRelativeVolume, confirmedSupportRelativeVolume)
        bool confirmedSupportVolumeOk = not na(confirmedSupportMaxRelativeVolume) and
             confirmedSupportMaxRelativeVolume >= minDemandRelativeVolume
        bool confirmedSupportQualified = confirmedSupportAfterFlip and confirmedSupportAfterSeparation and
             confirmedSupportInsideZone and confirmedSupportWickOk and confirmedSupportReactionOk and confirmedSupportVolumeOk

        if confirmedSupportQualified
            array.set(flipDemandConfirmed, zoneIndex, true)
            demandConfirmed := true
            if na(evidenceConfirmationBar)
                evidenceConfirmationBar := bar_index
                array.set(flipEvidenceConfirmationBars, zoneIndex, evidenceConfirmationBar)

            bool confirmedSupportIsNew = array.indexof(
                 confirmedSupplyFlipSupportBars, confirmedSupportBar) == -1
            if confirmedSupportIsNew
                float confirmedSupportMarkerY = confirmedPivotLow - confirmedSupportAtr * 0.15
                string confirmedSupportTime = str.format_time(time[demandPivotRight], "HH:mm", syminfo.timezone)
                string confirmedSupportConfirmedTime = str.format_time(time, "HH:mm", syminfo.timezone)
                label confirmedSupportLabel = na
                if showConfirmedSupplyFlipSupports
                    confirmedSupportLabel := label.new(
                         x = confirmedSupportBar,
                         y = confirmedSupportMarkerY,
                         text = "S→D",
                         xloc = xloc.bar_index,
                         yloc = yloc.price,
                         style = label.style_label_up,
                         color = color.new(color.lime, 0),
                         textcolor = color.black,
                         size = size.normal,
                         textalign = text.align_center,
                         tooltip = "Confirmed S→D support " + confirmedSupportTime +
                              " • confirmed " + confirmedSupportConfirmedTime +
                              " • original supply " + str.tostring(zoneBottom, format.mintick) +
                              "–" + str.tostring(zoneTop, format.mintick))
                array.push(confirmedSupplyFlipSupportBars, confirmedSupportBar)
                array.push(confirmedSupplyFlipSupportLabels, confirmedSupportLabel)
                confirmedSupplyFlipSupportDetected := true
                if array.size(confirmedSupplyFlipSupportBars) > maxHistoricalSupportMarkers
                    array.shift(confirmedSupplyFlipSupportBars)
                    label oldestConfirmedSupportLabel = array.shift(confirmedSupplyFlipSupportLabels)
                    if not na(oldestConfirmedSupportLabel)
                        label.delete(oldestConfirmedSupportLabel)
                if sendDynamicAlerts
                    alert("Confirmed S→D support inside original supply zone | " + syminfo.ticker + " " + timeframe.period +
                         " | Support: " + confirmedSupportTime +
                         " | Zone: " + str.tostring(zoneBottom, format.mintick) + " - " +
                         str.tostring(zoneTop, format.mintick), alert.freq_once_per_bar_close)

    if not removed and isActive and not immediateFrontRunPending
        box.set_right(zoneBox, f_bar_right_edge_time(bar_index))
        float invalidationThreshold = zoneBottom - atr * invalidationBufferAtr
        bool invalidated = invalidationMode == "Close" ? close < invalidationThreshold : low < invalidationThreshold

        if signalBarReady and invalidated and bar_index > confirmationBar
            invalidationDetected := true

            // A hidden zone that fails before its first retest, or a visible
            // supply-flip retest that fails before confirmed S→D demand, must
            // leave no historical price area. BASE zones already carry their
            // own confirmed BASE retest, while progressive and immediate paths
            // set demandConfirmed when their S→D arrow is created.
            bool failedBeforeConfirmedSupplyDemand =
                 not isContinuationBase and not demandConfirmed
            int barsSurvivedAfterEvidence = na(evidenceConfirmationBar) ?
                 na : bar_index - evidenceConfirmationBar
            bool failedBeforeMinimumEvidenceSurvival =
                 not na(barsSurvivedAfterEvidence) and
                 barsSurvivedAfterEvidence < minimumEvidenceSurvivalBars
            bool discardInvalidatedZone =
                 not alreadyRetested or failedBeforeConfirmedSupplyDemand or
                 failedBeforeMinimumEvidenceSurvival

            if discardInvalidatedZone
                if sendDynamicAlerts
                    string failedZoneName = failedBeforeMinimumEvidenceSurvival ?
                         (isContinuationBase ?
                         "Continuation-base evidence failed before minimum survival" :
                         "Supply→Demand evidence failed before minimum survival") :
                         not alreadyRetested ?
                         (isContinuationBase ?
                         "Continuation-base zone failed before first retest" :
                         "Supply→Demand zone failed before first retest") :
                         "Supply→Demand retest failed before confirmed demand"
                    alert(failedZoneName + " | " + syminfo.ticker + " " + timeframe.period +
                         " | Zone: " + str.tostring(zoneBottom, format.mintick) + " - " +
                         str.tostring(zoneTop, format.mintick), alert.freq_once_per_bar_close)
                box.delete(zoneBox)
                if not na(sellerLegBox)
                    box.delete(sellerLegBox)
                if not na(zoneTextLabel)
                    label.delete(zoneTextLabel)
                array.remove(flipBoxes, zoneIndex)
                array.remove(flipLegBoxes, zoneIndex)
                array.remove(flipTextLabels, zoneIndex)
                array.remove(flipTops, zoneIndex)
                array.remove(flipBottoms, zoneIndex)
                array.remove(flipDemandLows, zoneIndex)
                array.remove(flipDemandBars, zoneIndex)
                array.remove(flipConfirmationBars, zoneIndex)
                array.remove(flipOriginTimes, zoneIndex)
                array.remove(flipRetested, zoneIndex)
                array.remove(flipWasIntersecting, zoneIndex)
                array.remove(flipActive, zoneIndex)
                array.remove(flipZoneKinds, zoneIndex)
                array.remove(flipDemandConfirmed, zoneIndex)
                array.remove(flipEvidenceConfirmationBars, zoneIndex)
                array.remove(flipFirstSeparationBars, zoneIndex)
                removed := true
            else
                // Confirmed demand existed before this later break. Freeze that
                // successful green history and mark the later failure separately.
                array.set(flipActive, zoneIndex, false)
                laterBreakDetected := true
                box.set_right(zoneBox, time)
                box.set_bgcolor(zoneBox, activeFill)
                box.set_border_color(zoneBox, activeBorder)
                box.set_text(zoneBox, "")

                if sendDynamicAlerts
                    string laterBreakName = isContinuationBase ? "Retested continuation-base zone later broken" :
                         "Retested supply→demand zone later broken"
                    alert(laterBreakName + " | " + syminfo.ticker + " " + timeframe.period +
                         " | Zone: " + str.tostring(zoneBottom, format.mintick) + " - " +
                         str.tostring(zoneTop, format.mintick), alert.freq_once_per_bar_close)
        else
            // Supply retests may be front-run by a small ATR distance. Continuation
            // bases retain exact intersection behavior.
            float retestProximityTop = isContinuationBase ?
                 zoneTop : zoneTop + atr * supplyRetestProximityAtr
            bool intersectsZone = low <= retestProximityTop and high >= zoneBottom
            bool firstRetest = signalBarReady and hasFullSeparation and bar_index > firstSeparationBar and intersectsZone and not alreadyRetested
            if firstRetest
                array.set(flipRetested, zoneIndex, true)
                array.set(flipWasIntersecting, zoneIndex, true)
                if isContinuationBase and na(evidenceConfirmationBar)
                    evidenceConfirmationBar := bar_index
                    array.set(flipEvidenceConfirmationBars, zoneIndex, evidenceConfirmationBar)
                firstRetestDetected := true
                // A supply-zone touch reveals the zone but is not evidence of demand.
                // Only the confirmed pivot-support block above may draw an S→D arrow.
                continuationBaseRetestDetected := continuationBaseRetestDetected or isContinuationBase
                box.set_bgcolor(zoneBox, activeFill)
                box.set_border_color(zoneBox, activeBorder)
                box.set_text(zoneBox, "")

                bool showOriginStructure = isContinuationBase ? showContinuationBaseStructure : showSellerControlLeg
                if showOriginStructure and not na(sellerLegBox)
                    color originFill = isContinuationBase ? continuationBaseFill : sellerLegFill
                    color originBorder = isContinuationBase ? continuationBaseBorder : sellerLegBorder
                    box.set_bgcolor(sellerLegBox, originFill)
                    box.set_border_color(sellerLegBox, originBorder)
                    box.set_text(sellerLegBox, "")
                if sendDynamicAlerts
                    string firstRetestName = isContinuationBase ? "Bullish continuation-base first retest" :
                         "Supply→Demand zone retest started"
                    string structureDetailName = isContinuationBase ? " | Base floor: " : " | Structure demand: "
                    alert(firstRetestName + " | " + syminfo.ticker + " " + timeframe.period +
                         " | Zone: " + str.tostring(zoneBottom, format.mintick) + " - " +
                         str.tostring(zoneTop, format.mintick) +
                         (not na(sellerLegDemandLow) ? structureDetailName +
                         str.tostring(sellerLegDemandLow, format.mintick) : ""), alert.freq_once_per_bar_close)
            else if signalBarReady and alreadyRetested
                // Track a fresh return after price leaves the zone, but do not draw an S→D arrow.
                // The arrow is reserved for a later confirmed demand pivot inside the original zone.
                bool freshRetestEntry = intersectsZone and not wasIntersecting
                if freshRetestEntry and not isContinuationBase and showAdditionalSupplyRetests
                    additionalSupplyFlipRetestDetected := true
                    if sendDynamicAlerts
                        alert("Additional Supply→Demand zone re-entry | " + syminfo.ticker + " " + timeframe.period +
                             " | Awaiting confirmed demand inside zone: " +
                             str.tostring(zoneBottom, format.mintick) + " - " +
                             str.tostring(zoneTop, format.mintick), alert.freq_once_per_bar_close)
                array.set(flipWasIntersecting, zoneIndex, intersectsZone)

    if not removed
        zoneIndex += 1

// ───────────── Broadest overlapping zone display ─────────────
// Recalculate visual dominance after all lifecycle changes on the bar. A
// narrower zone is hidden only when a wider visible zone of any supported type
// covers the configured fraction of its price range while both rectangles also
// overlap in time. No zone state, marker, alert, or invalidation logic is removed
// by this display filter.
int displayZoneCount = array.size(flipBoxes)
// One final pass is sufficient because box properties persist. Avoid an
// all-pairs comparison on every historical bar.
if displayZoneCount > 0 and barstate.islast and (barstate.ishistory or barstate.isconfirmed)
    for displayZoneIndex = 0 to displayZoneCount - 1
        box displayZoneBox = array.get(flipBoxes, displayZoneIndex)
        box displayStructureBox = array.get(flipLegBoxes, displayZoneIndex)
        float displayZoneTop = array.get(flipTops, displayZoneIndex)
        float displayZoneBottom = array.get(flipBottoms, displayZoneIndex)
        int displayZoneLeft = box.get_left(displayZoneBox)
        int displayZoneRight = box.get_right(displayZoneBox)
        bool displayZoneVisible = array.get(flipRetested, displayZoneIndex)
        int displayZoneKind = array.get(flipZoneKinds, displayZoneIndex)
        bool displayIsContinuationBase = displayZoneKind == ZONE_KIND_CONTINUATION_BASE
        bool displayDemandConfirmed = array.get(flipDemandConfirmed, displayZoneIndex)
        bool displayLifecycleConfirmed = displayDemandConfirmed or
             (displayIsContinuationBase and displayZoneVisible)
        bool displaySuppressed = false

        if showOnlyBroadestOverlappingZone and displayZoneVisible
            float displayZoneWidth = displayZoneTop - displayZoneBottom

            for comparisonIndex = 0 to displayZoneCount - 1
                if comparisonIndex != displayZoneIndex and not displaySuppressed
                    bool comparisonVisible = array.get(flipRetested, comparisonIndex)

                    if comparisonVisible
                        int comparisonZoneKind = array.get(flipZoneKinds, comparisonIndex)
                        bool comparisonIsContinuationBase =
                             comparisonZoneKind == ZONE_KIND_CONTINUATION_BASE
                        bool comparisonDemandConfirmed =
                             array.get(flipDemandConfirmed, comparisonIndex)
                        bool comparisonLifecycleConfirmed = comparisonDemandConfirmed or
                             comparisonIsContinuationBase
                        box comparisonZoneBox = array.get(flipBoxes, comparisonIndex)
                        int comparisonZoneLeft = box.get_left(comparisonZoneBox)
                        int comparisonZoneRight = box.get_right(comparisonZoneBox)
                        bool comparisonOverlapsInTime =
                             displayZoneLeft <= comparisonZoneRight and
                             displayZoneRight >= comparisonZoneLeft
                        float comparisonTop = array.get(flipTops, comparisonIndex)
                        float comparisonBottom = array.get(flipBottoms, comparisonIndex)
                        float comparisonWidth = comparisonTop - comparisonBottom
                        float overlapHeight = math.max(
                             0.0,
                             math.min(displayZoneTop, comparisonTop) -
                             math.max(displayZoneBottom, comparisonBottom))
                        float narrowerWidth = math.min(displayZoneWidth, comparisonWidth)
                        float overlapFraction = narrowerWidth > 0.0 ?
                             overlapHeight / narrowerWidth : 0.0
                        bool comparisonIsBroader = comparisonWidth >
                             displayZoneWidth + syminfo.mintick * 2.0
                        bool comparisonSubstantiallyOverlaps =
                             overlapFraction >= broadZoneMinimumOverlap
                        bool comparisonHasEnoughConfirmation =
                             comparisonLifecycleConfirmed or not displayLifecycleConfirmed

                        if comparisonOverlapsInTime and comparisonIsBroader and
                             comparisonSubstantiallyOverlaps and
                             comparisonHasEnoughConfirmation
                            displaySuppressed := true

        bool drawDisplayZone = displayZoneVisible and not displaySuppressed
        if drawDisplayZone
            box.set_bgcolor(displayZoneBox, activeFill)
            box.set_border_color(displayZoneBox, activeBorder)
            box.set_text(displayZoneBox, "")
        else
            box.set_bgcolor(displayZoneBox, hiddenDrawingColor)
            box.set_border_color(displayZoneBox, hiddenDrawingColor)
            box.set_text(displayZoneBox, "")

        if not na(displayStructureBox)
            bool showDisplayStructure = displayIsContinuationBase ?
                 showContinuationBaseStructure : showSellerControlLeg
            if drawDisplayZone and showDisplayStructure
                color displayStructureFill = displayIsContinuationBase ?
                     continuationBaseFill : sellerLegFill
                color displayStructureBorder = displayIsContinuationBase ?
                     continuationBaseBorder : sellerLegBorder
                box.set_bgcolor(displayStructureBox, displayStructureFill)
                box.set_border_color(displayStructureBox, displayStructureBorder)
                box.set_text(displayStructureBox, "")
            else
                box.set_bgcolor(displayStructureBox, hiddenDrawingColor)
                box.set_border_color(displayStructureBox, hiddenDrawingColor)
                box.set_text(displayStructureBox, "")

// ───────────────────── Markers and alerts ─────────────────────
// S→D arrows are created only after confirmed pivot support or confirmed immediate
// front-run demand, so a bearish first touch such as OMH 09:40 cannot be
// mislabeled as demand.
plotshape(showFlipMarkers and continuationBaseRetestDetected, title = "Retested bullish continuation base", style = shape.arrowup,
     location = location.belowbar, color = color.new(color.aqua, 0), text = "BASE", textcolor = color.black, size = size.normal, display = display.all - display.status_line)
plotshape(showLaterBreakMarkers and laterBreakDetected, title = "Retested demand zone later broken", style = shape.xcross,
     location = location.belowbar, color = invalidTextColor, text = "INVALID", textcolor = invalidTextColor, size = size.normal, display = display.all - display.status_line)

alertcondition(firstRetestDetected or continuationBaseRetestDetected or additionalSupplyFlipRetestDetected or confirmedSupplyFlipSupportDetected or progressiveTakeoverDetected, title = "Bullish demand-zone event",
     message = "A bullish demand-zone event occurred on {{ticker}} {{interval}}.")
