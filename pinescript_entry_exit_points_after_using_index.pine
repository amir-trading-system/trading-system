//@version=6
indicator(title="Momentum Indicator for Day Trading", overlay = true)
import TradingView/ta/10

last_bars = 4
min_momentun_vol_avg = 5000
positive_sign = "✅"
positive_sign_without_ema = "📈"
relevant_timezone = "America/New_York"

////           Positive indications           ////

current_bar_is_bullish(index, high_src, close_src, low_src, ema_9, ema_20, with_certainty) =>
    result = high_src[index] - close_src[index] < close_src[index] - low_src[index]
    if with_certainty
        result := result and low_src[index] > ema_9[index] and low_src[index] > ema_20[index]
    else
        result := result and (low_src[index] > ema_9[index] or low_src[index] > ema_20[index])
    result

current_bar_volume_is_higher_than_last_ones(index, last_bars, close_src, open_src, volume_src) =>
    sum_of_buyers = 0.0
    sum_of_sellers = 0.0
    volume_is_higher_than_last_ones = true
    for i = 1 to last_bars
        if close_src[index+i] > open_src[index+i]
            sum_of_buyers += volume_src[index+i]
            continue
        else
            sum_of_sellers += volume_src[index+i]
            if volume_src[index+i] > volume_src[index]
                volume_is_higher_than_last_ones := false

    volume_is_higher_than_last_ones or (sum_of_buyers > sum_of_sellers)

current_bar_is_above_vwap(index, vwap_src, close_src, high_src) =>
    close_src[index] > vwap_src[index] and high_src[index] > vwap_src[index]

current_ema_is_above_vwap(index, ema_9_src, vwap_src, open_src) =>
    rounded_vwap = (math.round(vwap_src[index] * 100) / 100)
    rounded_9_ema = (math.round(ema_9_src[index] * 100) / 100)
    rounded_open = (math.round(open_src[index] * 100) / 100)

    rounded_9_ema >= rounded_vwap and rounded_open > rounded_vwap

last_bars_emas_higher(index, last_bars, ema_9_src, ema_20_src, vwap_src) =>
    last_bars_emas_higher = true
    for i = index to last_bars
        if not (math.max(ema_9_src[index+i], ema_20_src[index+i]) == ema_9_src[index+i])
            last_bars_emas_higher := false
            break

    last_bars_emas_higher

buyers_coming_in(index, last_bars, close_src, open_src, volume_src) =>
    vol_avg = ta.sma(volume_src[last_bars], 20)[index]
    sellers_are_still_in_the_game = false
    green_bars_volume = 0.0
    red_bars_volume = 0.0

    for i = 0 to last_bars
        bar_is_negative = close_src[index+i] < open_src[index+i]
        if bar_is_negative
            red_bars_volume += volume_src[i]
        else
            green_bars_volume += volume_src[i]
        if bar_is_negative and volume_src[i] > vol_avg
            sellers_are_still_in_the_game := true
            break

    negative_condition = sellers_are_still_in_the_game and (green_bars_volume / (green_bars_volume + red_bars_volume)) < 0.6

    not negative_condition

current_bar_has_new_high(index, high_src) =>
    bars_back = 5
    current_timeframe = str.tonumber(timeframe.period)
    if current_timeframe > 1 and current_timeframe < 5
        bars_back := 3
    if current_timeframe >= 5
        bars_back := 2

    highest_high = 0.0
    for i = 1 to bars_back
        if high_src[index+i] > highest_high
            highest_high := high_src[index+i]

    high_src[index] > highest_high

inside_momentum(index, last_bars, close_src, open_src, volume_src, with_certainty) =>
    under_avg_vol_bars_counter = 0
    above_avg_vol_bars_counter = 0
    vol_avg = ta.sma(volume_src[last_bars], 20)[index]
    current_bar_volume_is_higher_than_last_ones = current_bar_volume_is_higher_than_last_ones(index, last_bars, close_src, open_src, volume_src)

    for i = 0 to last_bars
        if vol_avg[i] < min_momentun_vol_avg and with_certainty
            under_avg_vol_bars_counter += 1
        else if close_src < open_src
            under_avg_vol_bars_counter += 1
        else if current_bar_volume_is_higher_than_last_ones
            above_avg_vol_bars_counter += 1

    above_avg_vol_bars_counter > under_avg_vol_bars_counter and volume_src[index] > vol_avg

current_bar_must_be_positive_and_volatile(index, last_bars, low_src, high_src, volume_src, close_src, open_src) =>
    current_bar_volume_is_higher_than_last_ones = current_bar_volume_is_higher_than_last_ones(index, last_bars, close_src, open_src, volume_src)
    rounded_low = math.round(low_src[index] * 100) / 100
    rounded_high = math.round(high_src[index] * 100) / 100
    vol_avg = ta.sma(volume_src, 20)[index]
    close_src[index] > open_src[index] and volume_src[index] > vol_avg and current_bar_volume_is_higher_than_last_ones

current_bar_closes_where_buyers_still_in(index, close_src, low_src, high_src) =>
    close_src[index] - low_src[index] > high_src[index] - close_src[index]

current_bar_has_at_least_one_weak_bar_before(index, last_bars, close_src, open_src, high_src, low_src) =>
    has_weak_bar_before = false

    for i = 1 to last_bars
        if close_src[index+i] < open_src[index+i] or ((high_src[index+i] - close_src[index+i]) >= close_src[index+i] - low_src[index+i])
            has_weak_bar_before := true
            break
    has_weak_bar_before

current_bar_is_above_support_line(index, last_bars, low_src) =>
    current_bar_above_support_line = true
    for i = 1 to last_bars
        if low_src[index] < low_src[index+i] - 2
            current_bar_above_support_line := false
            break
    current_bar_above_support_line

current_bar_close_to_nine_ema_by_avg(index, last_bars, close_src, low_src, high_src, ema_9, ema_20) =>
    current_bar_close_to_nine_ema_by_avg = false
    highest_distance = 0.0


    for i = last_bars to index
        current_distance = low_src[index+i] - ema_9[index+i]
        if highest_distance < current_distance
            highest_distance := current_distance

    bar_size = high_src[index] - low_src[index]
    low_distance_from_ema = low_src[index] - ema_9[index]

    low_distance_from_ema_is_less_than_highest_distance = low_distance_from_ema <= highest_distance

    (low_distance_from_ema / bar_size <= 0.5) or
      (low_src[index] > ema_20[index] and low_src[index] < ema_9[index])

current_macd_has_new_high_and_came_as_change_point(index, close_src) =>
    [macdLine, signalLine, histogram] = ta.macd(close_src, 12, 26, 9)
    previous_bars_has_change_in_momentum = false

    histogram_was_negative_before = false
    for i = index+10 to index
        if histogram[i] < 0.01
            histogram_was_negative_before := true
            break

    highest_histogram = 0.0
    for i = index to 8
        if histogram[index+i] > highest_histogram
            highest_histogram := histogram[index+i]

    for i = index to 3
        if histogram[index+i] < 0
            continue

        current_histogram_is_high = true
        for j = index to 3
            current_histogram_is_high := histogram[index] > histogram[index+j] and histogram[index+j] > 0
            if not current_histogram_is_high
                break
        if not current_histogram_is_high
            false

        last_histogram_is_between_two_highs = histogram[index+i] < histogram[index+i+1] and histogram[index+i] < histogram[index+i-1] and histogram[index+i] > 0 and histogram[index+i+1] > 0 and histogram[index+i+1] < histogram[index]
        current_histogram_has_changed_significantly = last_histogram_is_between_two_highs and histogram[index+i] / histogram[0] < 0.6
        all_are_in_the_same_session = dayofmonth[index] == dayofmonth[index+i] and dayofmonth[index+i] == dayofmonth[index+i+1] and dayofmonth[index+i+1] == dayofmonth[index+i-1]
        macd_is_positive = macdLine[index+i] > 0
        histogram_is_positive = histogram[index+i] > 0
        current_macd_is_bigger = macdLine[index] > macdLine[index+i]
        current_histogram_is_bigger = histogram[index] > histogram[index+i] and histogram[index] / highest_histogram > 0.75
        if last_histogram_is_between_two_highs and macd_is_positive and histogram_is_positive and current_macd_is_bigger and current_histogram_is_bigger and all_are_in_the_same_session and current_histogram_is_high and current_histogram_has_changed_significantly and histogram_was_negative_before
            previous_bars_has_change_in_momentum := true
            break

    previous_bars_has_change_in_momentum

current_bar_touching_9_ema(index, low_src, ema_9) =>
    low_src[index] <= ema_9[index] or (math.abs(low_src[index] - ema_9[index]) <= 0.10)

current_bar_is_at_the_beginning_of_the_day(index, bars_back, is_long_momentum) =>
    pre_market_start_time = timestamp(relevant_timezone, year, month, dayofmonth, 6, 00)
    market_start_time = timestamp(relevant_timezone, year, month, dayofmonth, 9, 30)
    three_hours_after_market_start_time = timestamp(relevant_timezone, year, month, dayofmonth, 12, 30)
    market_end_time = timestamp(relevant_timezone, year, month, dayofmonth, 12, 30)

    still_in_the_beginning = false
    current_timeframe = str.tonumber(timeframe.period)
    bigger_than_period = current_timeframe * 2

    for i = bars_back to 1
        if index+i-1 < 0
            continue
        if (time[index+i-1] - time[index+i])/1000/60/current_timeframe >= bigger_than_period and time <= market_end_time
            still_in_the_beginning := true
            break

    time_between_market_opening_to_3_hours_later = time >= market_start_time and time <= three_hours_after_market_start_time
    time_between_pre_market_hours = time >= pre_market_start_time and time <= market_start_time
    if not still_in_the_beginning and (time_between_market_opening_to_3_hours_later or (time_between_pre_market_hours and not is_long_momentum))
        still_in_the_beginning := true

    still_in_the_beginning

current_bar_gets_50_percent_above_9_ema(index, close_src, low_src, ema_9) =>
    close_src[index] - ema_9[index] > ema_9[index] - low_src[index]

last_bars_volume_is_higher(index, volume_src) =>
    vol_avg = ta.sma(volume_src, 20)

    last_highest_vol_avg = 0.0
    last_bars_back = 10
    current_timeframe = str.tonumber(timeframe.period)
    if current_timeframe > 1 and current_timeframe < 5
        last_bars_back := 5
    if current_timeframe >= 5
        last_bars_back := 2

    start_vol_avg = vol_avg[index+last_bars_back]
    middle_vol_avg = vol_avg[index+(last_bars_back / 2)]
    end_vol_avg = vol_avg[index]

    volumer_is_getting_higher = (end_vol_avg > middle_vol_avg and middle_vol_avg > start_vol_avg) or end_vol_avg > start_vol_avg * 5 or (end_vol_avg > start_vol_avg and end_vol_avg > middle_vol_avg and volume_src[index] > vol_avg[index] * 2)
    current_bar_volume_is_much_bigger_than_previous_bar = false
    if volume_src[index+1] / volume_src[0] < 0.8
        current_bar_volume_is_much_bigger_than_previous_bar := true

    current_vol_avg_is_biggest_by_multiply_from_lowest = false
    highest_vol = 0.0
    // instead of ta.highest function which does not work properly always
    for i = 0 to last_bars_back
        if volume_src[i] > highest_vol
            highest_vol := volume_src[i]

    // instead of ta.lowest function which does not work properly always
    lowest_vol = highest_vol
    for i = 0 to last_bars_back
        if volume_src[i] < lowest_vol
            lowest_vol := volume_src[i]

    if highest_vol / lowest_vol >= 1.3 or lowest_vol / highest_vol <= 0.5
        current_vol_avg_is_biggest_by_multiply_from_lowest := true

    volumer_is_getting_higher and current_vol_avg_is_biggest_by_multiply_from_lowest and current_bar_volume_is_much_bigger_than_previous_bar

current_bar_volume_is_higher_for_fast_change(index, volume_src, high_src, low_src) =>
    minimum_volume_per_bar = 5000
    volume_src[index] >= minimum_volume_per_bar and high_src[index] - low_src[index] >= 0.1

last_biggest_volume_bar_was_green(index, volume_src, close_src, open_src, high_src, low_src, last_bars, with_certainty) =>
    start_index = 0
    if with_certainty
        start_index := 1

    highest_bar_volume = 0.0
    for i = start_index to last_bars
        if volume_src[index+i] > highest_bar_volume
            highest_bar_volume := volume_src[index+i]

    highest_volume_bar_is_green = false

    for i = start_index to last_bars
        if volume_src[index+i] == highest_bar_volume and close_src[index+i] > open_src[index+i] and ((high_src[index+i] - close_src[index+i]) / (high_src[index+i] - low_src[index+i]) < 0.6)
            highest_volume_bar_is_green := true
            break

    highest_volume_bar_is_green

current_bar_close_to_9_ema_on_other_timeframes_as_well(index, ema_9, low_src, close_src, vwap_src) =>
    ema_9_at_2_minute_timeframe = request.security(syminfo.tickerid, "2", ema_9, lookahead=barmerge.lookahead_on)
    vwap_at_2_minute_timeframe = request.security(syminfo.tickerid, "2", vwap_src, lookahead=barmerge.lookahead_on)

    low_2_min = request.security(syminfo.tickerid, "2", low_src, lookahead=barmerge.lookahead_on)

    not_far_from_9_ema_on_bigger_timeframes = true
    close_distance = 0.20

    m_2_distance = math.abs(low_2_min - ema_9_at_2_minute_timeframe)
    m_1_distance = math.abs(low_src[index] - ema_9[index])
    m_2_vwap_distance = math.abs(low_2_min - vwap_at_2_minute_timeframe)
    two_minute_chart_is_close_to_9_ema = m_2_distance <= close_distance or m_1_distance <= close_distance
    two_minute_chart_is_close_to_vwap = m_2_vwap_distance <= close_distance

    if timeframe.period == "1"
        not_far_from_9_ema_on_bigger_timeframes := two_minute_chart_is_close_to_9_ema or two_minute_chart_is_close_to_vwap

    not_far_from_9_ema_on_bigger_timeframes

macd_check(index, close_src, bars_back) =>
    [macdLine, signalLine, histogram] = ta.macd(close_src, 12, 26, 9)
    macd_is_positive = false

    current_macd_is_positive = macdLine[index] > 0 and macdLine[index] > signalLine[index]

    // Check that macd changed direction in the last bars towards up
    macd_crossed_recently = false
    for i = bars_back to index+1
        if index+i-1 < 0
            continue
        macd_crossed = (macdLine[index+i] > signalLine[index+i] and macdLine[index+i+1] < signalLine[index+i+1]) or histogram[index+i] < 0.001
        macd_direction_changed = macdLine[index+i] < macdLine[index+i-1] and macdLine[index+i] < macdLine[index+i+1]
        if macd_crossed or macd_direction_changed
            macd_crossed_recently := true
            break

    // Gets the lowest and highest macd in the last bars.
    highest_macdLine_before = 0.0
    highest_macdLine_index_before = 0

    for i = bars_back to 1
        if index+i-1 < 0
            continue

        macd_between_two_lows = macdLine[index+i] > macdLine[index+i+1] and macdLine[index+i] > macdLine[index+i-1] and signalLine[index+i+1] > 0 and signalLine[index+i-1] > 0 and histogram[index+i] > 0
        if macd_between_two_lows and highest_macdLine_before < macdLine[index+i]
            highest_macdLine_before := macdLine[index+i]
            highest_macdLine_index_before := index+i

    there_is_highest_macdLine = highest_macdLine_index_before != 0 and highest_macdLine_before <= macdLine[index]
    if there_is_highest_macdLine
        lowest_macdLine = highest_macdLine_before
        lowest_macdLine_index = highest_macdLine_index_before
        for i = index to highest_macdLine_index_before
            if macdLine[index+i] < lowest_macdLine
                lowest_macdLine := macdLine[index+i]
                lowest_macdLine_index := index+i

        lowest_came_after_highest = lowest_macdLine_index < highest_macdLine_index_before
        macd_fixed_less_than_50_percent = lowest_macdLine/highest_macdLine_before >= 0.4 and lowest_macdLine/highest_macdLine_before < 0.999 and not (highest_macdLine_before * 4 < macdLine[index])
        macd_is_positive := current_macd_is_positive and macd_crossed_recently and macd_fixed_less_than_50_percent and lowest_came_after_highest

    macd_is_positive

histogram_check(index, close_src, bars_back) =>
    [macdLine, signalLine, histogram] = ta.macd(close_src, 12, 26, 9)
    histogram_is_above_threshold = histogram[index] > 0.005

    // Check that histogram changed direction in the last bars towards up
    histogram_direction_changed_index = 0
    histogram_crossed_recently = false
    for i = bars_back to index+1
        if index+i-1 < 0
            continue

        macd_is_above_zero = macdLine[index+i] > 0 and macdLine[index+i+1] > 0 and macdLine[index+i-1] > 0
        middle_histogram = histogram[index+i]
        current_histogram_is_between_2_highes_and_changed_direction = middle_histogram < histogram[index+i-1] and middle_histogram < histogram[index+i+1]

        if macd_is_above_zero and current_histogram_is_between_2_highes_and_changed_direction
            histogram_direction_changed_index := index+i
            histogram_crossed_recently := true
            break

    // Get highest and lowest histogram in the last bars for up trending changed check.
    highest_histogram_in_the_last_bars = 0.0
    highest_histogram_in_the_last_bars_index = 0
    for i = bars_back to index
        if histogram[index+i] > highest_histogram_in_the_last_bars
            highest_histogram_in_the_last_bars := histogram[index+i]
            highest_histogram_in_the_last_bars_index := index+i

    lowest_histogram_in_the_last_bars = highest_histogram_in_the_last_bars
    lowest_histogram_in_the_last_bars_index = 0
    for i = bars_back to index
        if histogram[index+i] < lowest_histogram_in_the_last_bars
            lowest_histogram_in_the_last_bars := histogram[index+i]
            lowest_histogram_in_the_last_bars_index := index+i

    // Lowest histogram happend before it got high and it changed more than 50%
    low_histogram_is_before_high_histogram = lowest_histogram_in_the_last_bars_index > highest_histogram_in_the_last_bars_index and histogram_direction_changed_index > highest_histogram_in_the_last_bars_index
    histogram_changed_significantly = low_histogram_is_before_high_histogram and lowest_histogram_in_the_last_bars / highest_histogram_in_the_last_bars < 0.5
    current_histogram_is_strong = histogram[index]/highest_histogram_in_the_last_bars >= 0.5 and histogram[index] >= histogram[index+1] * 1.2 and highest_histogram_in_the_last_bars > 0.002

    // Check that most of the momentum didnt finish already
    highgest_histogram_before = 0.0
    highgest_histogram_before_index = 0
    start_momentum_histogram_index = 0
    end_momentum_histogram_index = 0
    start_momentum_histogram = 0.0
    end_momentum_histogram = 0.0
    for i = bars_back to index+1
        if histogram[index+i] > 0 and start_momentum_histogram == 0 and (histogram[index+i+1] < 0 or histogram[index+i] > histogram[index+i+1] * 2)
            start_momentum_histogram := histogram[index+i]
            start_momentum_histogram_index := index+i
        if index+i-1 > 0 and histogram[index+i] > histogram[index+i+1] and histogram[index+i] > histogram[index+i-1] and index+i < start_momentum_histogram_index and histogram[index+i] > highgest_histogram_before
            highgest_histogram_before := histogram[index+i]
            highgest_histogram_before_index := index+i
        if index+i-1 > 0 and  (histogram[index+i] < 0 or (histogram[index+i] < histogram[index+i+1] and histogram[index+i] < histogram[index+i-1])) and start_momentum_histogram_index > index+i
            end_momentum_histogram_index := index+i
            end_momentum_histogram := histogram[index+i]

    // Check that the current highest is bigger than the last highest negative histogram before the momentum.
    highest_negative_histogram_is_bigger_than_positive_highest_histogram = false
    for i = start_momentum_histogram_index to start_momentum_histogram_index+10
        if math.abs(histogram[i]) > highest_histogram_in_the_last_bars and histogram[i] < 0
            highest_negative_histogram_is_bigger_than_positive_highest_histogram := true

    // Check that most of the histogram has not finished already after 2 or 3 bars - usually in those cases it has quick up trend and thats it for today - we want to prevent such cases.
    most_process_already_finished = false
    correct_histogram_structure = end_momentum_histogram_index < start_momentum_histogram_index and start_momentum_histogram_index > highest_histogram_in_the_last_bars_index
    if correct_histogram_structure
        most_process_already_finished := math.abs(start_momentum_histogram_index - highgest_histogram_before_index) * 1.5 < math.abs(end_momentum_histogram_index - highgest_histogram_before_index) and highest_histogram_in_the_last_bars <= highgest_histogram_before

    histogram_pattern_is_good = histogram_is_above_threshold and correct_histogram_structure and histogram_crossed_recently and histogram_changed_significantly and current_histogram_is_strong and not most_process_already_finished and not highest_negative_histogram_is_bigger_than_positive_highest_histogram
    // if time == timestamp(relevant_timezone, year, 5, 22, 9, 16) and str.tonumber(timeframe.period) == 2
    //     log.info("r: {0}", histogram_pattern_is_good)

    histogram_pattern_is_good

///////// run indicators /////////

run_positive_indicator(with_certainty) =>
    index = 0
    vwap_values = ta.vwap(hlc3)
    ema_9_values = ta.ema(close, 9)
    ema_20_values = ta.ema(close, 20)

    open_values = open
    close_values = close
    low_values = low
    high_values = high
    volume_values = volume

    vwap_i = vwap_values[index]
    ema_9_i = ema_9_values[index]
    ema_20_i = ema_20_values[index]

    open_i = open_values[index]
    close_i = close_values[index]
    low_i = low_values[index]
    high_i = high_values[index]
    volume_i = volume_values[index]


    if with_certainty
        current_bar_is_above_vwap = current_bar_is_above_vwap(index, vwap_i, close_i, high_i)
        last_bars_emas_higher = last_bars_emas_higher(index, last_bars, ema_9_i, ema_20_i, vwap_i)
        current_ema_is_above_vwap = current_ema_is_above_vwap(index, ema_9_i, vwap_i, open_i)
        current_bar_has_new_high = current_bar_has_new_high(index, high_i)
        buyers_coming_in = buyers_coming_in(index, last_bars, close_i, open_i, volume_i)
        inside_momentum = inside_momentum(index, last_bars, close_i, open_i, volume_i, true)
        current_bar_has_at_least_one_weak_bar_before = current_bar_has_at_least_one_weak_bar_before(index, last_bars, close_i, open_i, high_i, low_i)
        current_bar_must_be_positive_and_volatile = current_bar_must_be_positive_and_volatile(index, last_bars, low_i, high_i, volume_i, close_i, open_i)
        current_bar_is_above_support_line = current_bar_is_above_support_line(index, 3, low_i)
        current_bar_close_to_nine_ema_by_avg = current_bar_close_to_nine_ema_by_avg(index, last_bars, close_i, low_i, high_i, ema_9_i, ema_20_i)
        current_bar_gets_50_percent_above_9_ema = current_bar_gets_50_percent_above_9_ema(index, close_i, low_i, ema_9_i)
        current_bar_closes_where_buyers_still_in = current_bar_closes_where_buyers_still_in(index, close_i, low_i, high_i)
        current_bar_is_bullish = current_bar_is_bullish(index, high_i, close_i, low_i, ema_9_i, ema_20_i, true)
        last_bars_volume_is_higher = last_bars_volume_is_higher(index, volume_i)
        last_biggest_volume_bar_was_green = last_biggest_volume_bar_was_green(index, volume_i, close_i, open_i, high_i, low_i, 5, true)
        current_bar_close_to_9_ema_on_other_timeframes_as_well = current_bar_close_to_9_ema_on_other_timeframes_as_well(index, ema_9_i, low_i, close_i, vwap_i)

        bars_back = 60
        if str.tonumber(timeframe.period) > 1 and str.tonumber(timeframe.period) < 5
            bars_back := 30
        if str.tonumber(timeframe.period) >= 5
            bars_back := 12

        current_bar_is_at_the_beginning_of_the_day = current_bar_is_at_the_beginning_of_the_day(index, bars_back, true)

        macd_bars_back = 0
        if str.tonumber(timeframe.period) == 1
            macd_bars_back := 20
        if str.tonumber(timeframe.period) > 1 and str.tonumber(timeframe.period) < 5
            macd_bars_back := 10
        if str.tonumber(timeframe.period) >= 5
            macd_bars_back := 4

        histogram_check = histogram_check(index, close_i, macd_bars_back)
        macd_check = macd_check(index, close_i, macd_bars_back)


        current_bar_is_above_vwap
          and current_ema_is_above_vwap
          and last_bars_emas_higher
          and current_bar_has_new_high
          and buyers_coming_in
          and inside_momentum
          and current_bar_has_at_least_one_weak_bar_before
          and current_bar_must_be_positive_and_volatile
          and current_bar_is_above_support_line
          and current_bar_close_to_nine_ema_by_avg
          and current_bar_gets_50_percent_above_9_ema
          and current_bar_closes_where_buyers_still_in
          and current_bar_is_bullish
          and last_bars_volume_is_higher
          and last_biggest_volume_bar_was_green
          and current_bar_close_to_9_ema_on_other_timeframes_as_well
          and current_bar_is_at_the_beginning_of_the_day
          and histogram_check
          and macd_check
    else
        last_index = index+1

        last_bar_is_above_vwap = current_bar_is_above_vwap(last_index, vwap_i, close_i, high_i)
        last_bars_emas_higher = last_bars_emas_higher(last_index, last_bars, ema_9_i, ema_20_i, vwap_i)
        last_bar_has_new_high = current_bar_has_new_high(last_index, high_i)
        last_bar_buyers_coming_in = buyers_coming_in(last_index, last_bars, close_i, open_i, volume_i)
        last_bar_has_at_least_one_weak_bar_before = current_bar_has_at_least_one_weak_bar_before(last_index, last_bars, close_i, open_i, high_i, low_i)
        last_bar_must_be_positive_and_volatile = current_bar_must_be_positive_and_volatile(last_index, last_bars, low_i, high_i, volume_i, close_i, open_i)
        last_bar_is_above_support_line = current_bar_is_above_support_line(last_index, last_bars, low_i)
        last_bar_close_to_nine_ema_by_avg = current_bar_close_to_nine_ema_by_avg(last_index, last_bars, close_i, low_i, high_i, ema_9_i, ema_20_i)
        last_bar_gets_50_percent_above_9_ema = current_bar_gets_50_percent_above_9_ema(last_index, close_i, low_i, ema_9_i)
        last_bar_closes_where_buyers_still_in = current_bar_closes_where_buyers_still_in(last_index, close_i, low_i, high_i)
        last_bars_volume_is_higher = last_bars_volume_is_higher(last_index, volume_i)

        last_bar_touching_9_ema = current_bar_touching_9_ema(last_index, low_i, ema_9_i)
        last_bar_macd_has_new_high_and_came_as_change_point = current_macd_has_new_high_and_came_as_change_point(last_index, close_i)
        last_bar_is_bullish_without_ema_certainty = current_bar_is_bullish(last_index, high_i, close_i, low_i, ema_9_i, ema_20_i, false)
        last_biggest_volume_bar_was_green_without_certainty = last_biggest_volume_bar_was_green(last_index, volume_i, close_i, open_i, high_i, low_i, 5, false)
        last_bar_inside_momentum_without_certainty = inside_momentum(last_index, last_bars, close_i, open_i, volume_i, false)
        last_bar_volume_is_higher_for_fast_change = current_bar_volume_is_higher_for_fast_change(last_index, volume_i, high_i, low_i)

        bars_back = 30
        if str.tonumber(timeframe.period) > 1 and str.tonumber(timeframe.period) < 5
            bars_back := 15
        if str.tonumber(timeframe.period) >= 5
            bars_back := 6

        last_bar_is_at_the_beginning_of_the_day = current_bar_is_at_the_beginning_of_the_day(last_index, bars_back, false)

        last_bar_results = last_bar_is_above_vwap
          and last_bar_touching_9_ema
          and last_bars_emas_higher
          and last_bar_has_new_high
          and last_bar_buyers_coming_in
          and last_bar_inside_momentum_without_certainty
          and last_bar_has_at_least_one_weak_bar_before
          and last_bar_must_be_positive_and_volatile
          and last_bar_is_above_support_line
          and last_bar_close_to_nine_ema_by_avg
          and last_bar_macd_has_new_high_and_came_as_change_point
          and last_bar_gets_50_percent_above_9_ema
          and last_bar_closes_where_buyers_still_in
          and last_bar_is_bullish_without_ema_certainty
          and last_bars_volume_is_higher
          and last_biggest_volume_bar_was_green_without_certainty
          and last_bar_is_at_the_beginning_of_the_day
         and last_bar_volume_is_higher_for_fast_change
          and close[index] > open[index]

positive_indication = run_positive_indicator(true)
positive_indication_for_short_momentum = run_positive_indicator(false)

plotshape(positive_indication, title="Positive indication for long momentum", color=color.green, display = display.pane, style = shape.arrowup, size = size.small, location = location.abovebar, text = positive_sign)
plotshape(positive_indication_for_short_momentum, title="Positive indication for short momentum", color=color.blue, display = display.pane, style = shape.arrowup, size = size.small, location = location.belowbar, text = positive_sign_without_ema)

alertcondition(positive_indication or positive_indication_for_short_momentum, title="Positive indication for long/short momentum", message="Positive indication for long/short momentum")
