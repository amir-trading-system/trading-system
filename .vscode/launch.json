    "version": "0.2.0",
    "configurations": [
        {
            "name": "prod main",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "main.py",
            "args": [
                "prod",
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "prod on specific symbol",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "main.py",
            "args": [
                "test",
                "--symbol=IVF",
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "test specific bar",
            "args": [
                "test",
                "--symbol=KUST",
                "--specific_bar_time=2026-01-23 09:30:00",
                "--timeframe=15",
            ],
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "main.py",
            "console": "integratedTerminal"
        },
        {
            "name": "test retroactive",
            "args": [
                "test",
                "--symbol=KUST",
                "--retroactive_from=2026-01-23",
                "--timeframe=15",
            ],
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "main.py",
            "console": "integratedTerminal"
        }
    ]
}
