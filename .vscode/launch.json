{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "prod main",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "main.py",
            "args": [
                "prod",
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "prod on specific symbol",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "main.py",
            "args": [
                "test",
                "--symbol=BNAI",
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "manual main",
            "args": [
                "--on_specific_bar_time=true"
            ],
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "main.py",
            "console": "integratedTerminal"
        },
        {
            "name": "retroactive main",
            "args": [
                "--retroactive_from=2025-12-30"
            ],
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "main.py",
            "console": "integratedTerminal"
        }
    ]
}
