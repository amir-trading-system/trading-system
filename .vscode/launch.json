    "version": "0.2.0",
    "configurations": [
        {
            "name": "prod main",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "main.py",
            "args": [
                "prod",
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "prod on specific symbol",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "main.py",
            "args": [
                "test",
                "--symbol=BNAI",
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "test specific bar",
            "args": [
                "test",
                "--symbol=IBIO",
                "--specific_bar_time=2026-01-06 09:55:00",
                "--timeframe=5",
            ],
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "main.py",
            "console": "integratedTerminal"
        },
        {
            "name": "retroactive main",
            "args": [
                "test",
                "--symbol=BNAI",
                "--retroactive_from=2026-01-02",
                "--timeframe=5",
            ],
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "main.py",
            "console": "integratedTerminal"
        }
    ]
}
