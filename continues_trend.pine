indicator(title="Continues Trend", overlay = true, max_bars_back = 5000)
import TradingView/ta/10

//@version=6

relevant_timezone = "America/New_York"

ema_9 = ta.ema(close, 9)
vwap = ta.vwap(hlc3)
vol_avg = ta.sma(volume, 20)
[macd, signal_line, histogram] = ta.macd(close, 12, 26, 9)
current_timeframe = str.tonumber(timeframe.period)
if timeframe.period == "10S"
    current_timeframe := 10

// if time == timestamp(relevant_timezone, 2025, 9, 18, 11, 50) and current_timeframe == 5
//     log.info("some log")

_made_more_than_usual_percentage_already(index, percentage) =>
    yesterday_close = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_on)
    (close[index] - yesterday_close)/open[index] > percentage

_get_starting_index(index) =>
    starting_index = 0
    bars_back = ((hour[index] - 7) * 60)/current_timeframe
    min_bars_back = math.min(bars_back, 20)
    for i = index+1 to index+min_bars_back
        if i < 0
            continue
        is_first_bar_to_pop_up = close[i] > open[i]
         and volume[i] > volume[i+1] * 2
         and volume[i] > vol_avg[i]
         and close[i] > ema_9[i]
         and close[i] > vwap[i]
         and high[i] - low[i] > high[i+1] - low[i+1]
         and (close[i] - open[i])/(high[i] - low[i]) >= 0.4
         and (histogram[i+1] < 0 or volume[i] > volume[i+1] * 10)

        if ema_9[i] < vwap[i]
            is_first_bar_to_pop_up := is_first_bar_to_pop_up
             and macd[i] > 0
             and signal_line[i] > 0

        if is_first_bar_to_pop_up
            starting_index := i
            break

    starting_index

_get_top_index(index, starting_index) =>
    highest_high = 0.0
    highest_high_index = 0
    for i = index+1 to starting_index
        if high[i] > highest_high
            highest_high := high[i]
            highest_high_index := i

    top_index = 0
    for i = index to starting_index
        if i-1 < 0
            continue

        if high[i] > high[i+1]
         and high[i] > high[i-1]
         and close[i] > ema_9[i]
         and volume[i] > vol_avg[i]
         and high[i] == highest_high
            top_index := i
            break

    top_index

_move_is_still_strong_due_to_fibonacci_retracement(index, starting_index, top_index, lowest_point_from_top_point_index) =>
    fibonacci_retracement = (high[top_index] - low[lowest_point_from_top_point_index])/(high[top_index] - low[starting_index])
    move_is_still_strong_due_to_fibonacci_retracement = starting_index > top_index
     and fibonacci_retracement <= 0.62
     and fibonacci_retracement >= 0.236

    if not move_is_still_strong_due_to_fibonacci_retracement and top_index-1 > 0
        move_is_still_strong_due_to_fibonacci_retracement := close[index] > high[top_index-1]

    [move_is_still_strong_due_to_fibonacci_retracement, fibonacci_retracement]

_get_lowest_point_from_top_point_index(index, top_index) =>
    lowest_point_from_top_point_value = 1000.0
    lowest_point_from_top_point_index = 0
    for i = index+1 to top_index-1
        if i < 0
            continue
        if low[i] < lowest_point_from_top_point_value
            lowest_point_from_top_point_value := low[i]
            lowest_point_from_top_point_index := i

    lowest_point_from_top_point_index

trend_continues(index) =>
    percentage = 0.1
    made_more_than_usual_percentage_already = _made_more_than_usual_percentage_already(index, percentage)
    movement_is_after_market_start = (hour[index] == 9 and minute[index] >= 30) or (hour[index] > 9 and hour[index] <= 20)

    starting_index = _get_starting_index(index)
    top_index = _get_top_index(index, starting_index)
    lowest_point_from_top_point_index = _get_lowest_point_from_top_point_index(index, top_index)
    [move_is_still_strong_due_to_fibonacci_retracement, fibonacci_retracement] = _move_is_still_strong_due_to_fibonacci_retracement(index, starting_index, top_index, lowest_point_from_top_point_index)

    coming_after_fall = false
    if top_index > 0
        coming_after_fall := true
        for i = top_index to index+1
            if i-1 < 0 or i-2 < 0
                continue
            if high[i] < high[i-1]
             and high[i] >= close[index]
             and high[i-1] > high[i-2]
             and i-1 > index
             and i-2 > index
                coming_after_fall := false
                break

    macd_is_biggest_until_now = false
    if movement_is_after_market_start
        macd_is_biggest_until_now := true
        macd_bars_back = (((hour[index] - 9) * 60) + (minute[index] - 30))/current_timeframe
        for i = index+1 to index+macd_bars_back
            if macd[i] > macd[index]
                macd_is_biggest_until_now := false
                break

    histogram_is_strong = false
    positive_histogram_start_index = 0
    histogram_bars_back = ((hour[index] - 4) * 60)/current_timeframe
    for i = index+1 to index+histogram_bars_back
        if histogram[i] > 0
         and histogram[i+1] < 0
            positive_histogram_start_index := i
            break

    if positive_histogram_start_index == 0
        positive_histogram_start_index := 1

    highest_histogram_until_now = ta.highest(histogram, positive_histogram_start_index)
    if positive_histogram_start_index > 0
        histogram_is_strong := histogram[index]/highest_histogram_until_now >= 0.5

    close_to_ema_9_than_top_index = math.abs(low[index] - ema_9[index]) < math.abs(low[top_index] - ema_9[top_index])

    if low[index] < ema_9[index]
     and close[index] > ema_9[index]
        close_to_ema_9_than_top_index := true

    no_bar_from_top_closed_under_ema_9 = true
    no_bar_has_flushed_more_than_30_percent = true
    for i = top_index-1 to index
        if i < 0
            continue
        current_bar_is_weaker = high[index] - low[index] < high[i] - low[i]

        if close[i] < ema_9[i] and current_bar_is_weaker
            no_bar_from_top_closed_under_ema_9 := false

        is_strong_negative = close[i] < open[i]
         and (close[i] - low[i])/(high[i] - low[i]) <= 0.2

        if is_strong_negative
            flushed_more_than_30_percent = (high[i] - low[i])/(high[top_index] - low[starting_index]) >= 0.3

            if flushed_more_than_30_percent and current_bar_is_weaker
                no_bar_has_flushed_more_than_30_percent := false

    all_milestone_bars_are_volatile = volume[index] >= 50000
     and volume[top_index] >= 50000


    result = true
     and made_more_than_usual_percentage_already
     and movement_is_after_market_start
     and coming_after_fall
     and high[index] > close[index+1]
     and macd[index] > 0
     and signal_line[index] > 0
     and histogram[index] > 0
     and macd_is_biggest_until_now
     and histogram_is_strong
     and close_to_ema_9_than_top_index
     and move_is_still_strong_due_to_fibonacci_retracement
     and no_bar_from_top_closed_under_ema_9
     and no_bar_has_flushed_more_than_30_percent
     and all_milestone_bars_are_volatile
     and current_timeframe >= 5

    [result, top_index, lowest_point_from_top_point_index, starting_index, fibonacci_retracement]

///////////// indications /////////////
continues_trend_indication() =>
    var float index = na
    var int top_index = na
    var int lowest_point_from_top_point_index = na
    var int starting_index = na
    var float fibonacci_retracement = na
    already_happend_before = false
    [trend_continues_result_0, top_index_0, lowest_point_from_top_point_index_0, starting_index_0, fibonacci_retracement_0] = trend_continues(0)
    [trend_continues_result_1, top_index_1, lowest_point_from_top_point_index_1, starting_index_1, fibonacci_retracement_1] = trend_continues(1)
    [trend_continues_result_2, top_index_2, lowest_point_from_top_point_index_2, starting_index_2, fibonacci_retracement_2] = trend_continues(2)
    [trend_continues_result_3, top_index_3, lowest_point_from_top_point_index_3, starting_index_3, fibonacci_retracement_3] = trend_continues(3)
    if trend_continues_result_0
        index := 0
        top_index := top_index_0
        lowest_point_from_top_point_index := lowest_point_from_top_point_index_0
        starting_index := starting_index_0
        fibonacci_retracement := fibonacci_retracement_0
        already_happend_before := true
    if na(index)
        if trend_continues_result_1 and na(index)
            index := 1
            top_index := top_index_1
            lowest_point_from_top_point_index := lowest_point_from_top_point_index_1
            starting_index := starting_index_1
            fibonacci_retracement := fibonacci_retracement_1
            already_happend_before := true
    if na(index)
        if trend_continues_result_2 and na(index)
            index := 2
            top_index := top_index_2
            lowest_point_from_top_point_index := lowest_point_from_top_point_index_2
            starting_index := starting_index_2
            fibonacci_retracement := fibonacci_retracement_2
            already_happend_before := true
    if na(index)
        if trend_continues_result_3 and na(index)
            index := 3
            top_index := top_index_3
            lowest_point_from_top_point_index := lowest_point_from_top_point_index_3
            starting_index := starting_index_3
            fibonacci_retracement := fibonacci_retracement_3
            already_happend_before := true

    close_to_9_ema_than_before = math.abs(low[0] - ema_9[0])/(high[0] - low[0]) <= 0.5

    result = already_happend_before
     and histogram[0] > histogram[1]
     and histogram[1] < histogram[2]
     and close_to_9_ema_than_before
     and volume[0] > 50000
     and histogram[0]/histogram[top_index] >= 0.5

    if result and not na(index)
        log.info("index: {0}, top_index: {1}. lowest_point_from_top_point_index: {2}. starting_index: {3}", index, top_index, lowest_point_from_top_point_index, starting_index)

    [result and not na(index), fibonacci_retracement, starting_index, top_index]

price_goes_up(index) =>
    percentage = 0.1
    made_more_than_usual_percentage_already = _made_more_than_usual_percentage_already(index, percentage)
    movement_is_after_market_start = (hour[index] == 9 and minute[index] > 30) or (hour[index] > 9 and hour[index] <= 20)

    bars_back = (((hour[index] - 9) * 60) + (minute[index] - 30))/current_timeframe

    current_bar_is_highest_in_volume = true
     and close[index] > open[index]
     and high[index] > high[index+1]
     and macd[index] > 0
     and signal_line[index] > 0
     and histogram[index] > 0
     and close[index] > vwap[index]
     and close[index] > ema_9[index]
     and volume[index+1]/volume[index] < 0.7
     and high[index] - low[index] > high[index+1] - low[index+1]
     and volume[index+1] >= 100000

    if current_bar_is_highest_in_volume
     and movement_is_after_market_start
        for i = index+1 to index+bars_back
            if volume[i] > volume[index]
                current_bar_is_highest_in_volume := false
                break

    starting_index = _get_starting_index(index)
    top_index = _get_top_index(index, starting_index)
    lowest_point_from_top_point_index = _get_lowest_point_from_top_point_index(index, top_index)
    [move_is_still_strong_due_to_fibonacci_retracement, fibonacci_retracement] = _move_is_still_strong_due_to_fibonacci_retracement(index, starting_index, top_index, lowest_point_from_top_point_index)

    result = true
     and made_more_than_usual_percentage_already
     and movement_is_after_market_start
     and current_bar_is_highest_in_volume
     and move_is_still_strong_due_to_fibonacci_retracement

    [result, fibonacci_retracement, starting_index, top_index]

[price_goes_up, fibonacci_retracement_price_goes_up, starting_index_price_goes_up, top_index_price_goes_up] = price_goes_up(0)
[continues_trend_indication, fibonacci_retracement, starting_index, top_index] = continues_trend_indication()

if not continues_trend_indication and price_goes_up
    fibonacci_retracement := fibonacci_retracement_price_goes_up
    starting_index := starting_index_price_goes_up
    top_index := top_index_price_goes_up

plotshape(price_goes_up, title="Price Goes Up", color=color.green, display = display.pane, style = shape.arrowup, size = size.small, location = location.abovebar, text = "🛫")

plotshape(continues_trend_indication, title="Continues Trend", color=color.green, display = display.pane, style = shape.arrowup, size = size.small, location = location.belowbar, text = "💰")
plot(continues_trend_indication or price_goes_up ? fibonacci_retracement : 0, "fibonacci_retracement", display = display.status_line)
plot(continues_trend_indication or price_goes_up ? starting_index : 0, "starting_index", display = display.status_line)
plot(continues_trend_indication or price_goes_up ? top_index : 0, "top_index", display = display.status_line)

alertcondition(continues_trend_indication or price_goes_up, title="Positive indication for long/short momentum", message="Positive indication for long/short momentum")
