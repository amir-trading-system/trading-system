indicator(title="Continues Trend", overlay = true, max_bars_back = 5000)
import TradingView/ta/10

//@version=6

relevant_timezone = "America/New_York"

////           Reversal Indication           ////
reversal_sign = "🌠"
ema_9 = ta.ema(close, 9)
ema_20 = ta.ema(close, 20)
vwap = ta.vwap(hlc3)
vol_avg = ta.sma(volume, 20)
ema_200_days = request.security(syminfo.tickerid, "D", ema_9, lookahead = barmerge.lookahead_on)

bar_is_acting_as_reversal_upwards(index) =>
    [macd, signal, histogram] = ta.macd(close, 12, 26, 9)

    ema_9_is_above_all = ema_9[index] >= vwap[index] and ema_9[index] > ema_20[index]
    close_is_above_all = close[index] > open[index] and close[index] > ema_9[index]
    bar_before_is_red = close[index+1] < open[index+1]
    bar_volume_is_similar_to_bar_before = (high[index] - low[index])/(high[index+1]-low[index+1]) >= 0.65
    current_bar_is_positive = close[index] > open[index] and high[index] > close[index]
    current_bar_is_still_lower_than_bar_before = high[index] <= high[index+1]
    bar_has_inverted_hammer_pattern = (open[index] == low[index] or (open[index] - low[index])/(high[index] - low[index]) <= 0.2) and (high[index] - close[index])/(close[index] - low[index]) >= 0.3
    current_bar_is_close_to_9_ema = (low[index] - ema_9[index]) < (high[index]-low[index])
    most_of_the_bar_is_above_ema_9 = (math.abs(ema_9[index] - open[index])/(close[index] - open[index]) <= 0.5) or open[index] >= ema_9[index]
    bar_is_volatile = volume[index] > 50000
    macd_is_positive = histogram[index] > 0 and macd[index] > 0

    current_timeframe = str.tonumber(timeframe.period)
    bars_back = int(30/current_timeframe)

    weak_bar_found = false
    for i = index+bars_back to index
        bar_is_under_9_ema = open[i] < ema_9[i] and close[i] < ema_9[i] and volume[i] > volume[index]
        bar_is_under_vwap = open[i] < vwap[i] and close[i] < vwap[i] and volume[i] > volume[index]
        if bar_is_under_9_ema or bar_is_under_vwap
            weak_bar_found := true
            break

    high_before_is_low_than_high_before = true
    if current_timeframe <= 2
        high_before_is_low_than_high_before := high[index+1] < high[index+2]

    result = bar_before_is_red
     and bar_volume_is_similar_to_bar_before
     and current_bar_is_positive
     and current_bar_is_still_lower_than_bar_before
     and bar_has_inverted_hammer_pattern
     and current_bar_is_close_to_9_ema
     and most_of_the_bar_is_above_ema_9
     and bar_is_volatile
     and not weak_bar_found
     and high_before_is_low_than_high_before
     and macd_is_positive

    if current_timeframe <= 5
        result := result
         and ema_9_is_above_all
         and close_is_above_all

    result


///          Buyers Coming In Indication          ///

_get_trend_started_bar_index(index, vwap, ema_9, vol_avg) =>
    [macd, signal_line, histogram] = ta.macd(close, 12, 26, 9)
    trend_started_bar_index = 0

    for i = index+49 to index+1
        before_7_am = hour[i] < 7
        volume_is_low = volume[i] < 5000
        histogram_is_negative = histogram[i] < 0
        high_before_is_higher = high[i+1] >= high[i]

        if before_7_am
         or volume_is_low
         or high_before_is_higher
            continue

        if i-1 < 0
            continue
        if low[i-1] < low[i]
            continue

        current_bar_is_weak = false
        volume_avg_has_been_changed = true

        for j = i+10 to i+1
            price_is_higher = high[j] - low[j] > high[i] - low[i] and high[i] < high[j]
            volume_is_higher = volume[j] > vol_avg[j] and volume[j] > volume[i]
            if price_is_higher or volume_is_higher
                current_bar_is_weak := true
            if vol_avg[j] * 2 > vol_avg[i] and j - 2 > i
                volume_avg_has_been_changed := false

        if current_bar_is_weak or not volume_avg_has_been_changed
            continue

        if dayofmonth[i] != dayofmonth[index]
            continue

        crossed_vwap_upwards = (low[i] < vwap[i] and close[i] > vwap[i] and vwap[i] > ema_9[i])
         or (low[i+1] < vwap[i+1] and close[i+1] > vwap[i+1] and vwap[i+1] > ema_9[i+1])
         or (low[i+2] < vwap[i+2] and close[i+2] > vwap[i+2] and vwap[i+2] > ema_9[i+2])

        bar_is_strong = (close[i] - open[i])/(high[i] - low[i]) >= 0.4
        if i-1 > 0 and not bar_is_strong
            bar_is_strong := (close[i-1] - open[i-1])/(high[i-1] - low[i-1]) >= 0.4
        bar_is_positive = close[i] > open[i]
        bar_is_volatile = volume[i] > vol_avg[i] and volume[i] > volume[i+1] and vol_avg[i] > vol_avg[i+1]
        bar_value_is_volatile = (high[i]-low[i]) > (high[i+1]-low[i+1]) * 2 or (close[i] - open[i]) > (close[i+1] - open[i+1])

        if crossed_vwap_upwards
         and bar_is_positive
         and bar_is_volatile
         and bar_value_is_volatile
         and bar_is_strong
            trend_started_bar_index := i
            break

        close_is_above_vwap = close[i] > vwap[i]
        if not crossed_vwap_upwards
         and close_is_above_vwap
         and hour[i] >= 9
         and bar_is_positive
         and bar_is_volatile
         and bar_value_is_volatile
         and bar_is_strong
            trend_started_bar_index := i
            break

        if close_is_above_vwap
         and bar_value_is_volatile
         and close[i] > open[i]
         and volume[i] > volume[i+1] * 8
         and volume[i] >= 50000
         and bar_is_strong
            trend_started_bar_index := i
            break

    trend_started_bar_index

_bar_is_strong(index) =>
    there_are_buyers_at_the_bottom = (open[index] - low[index])/(high[index]-low[index]) < 0.5
    bar_closes_with_buyers = (close[index] - open[index])/(high[index]-low[index]) >= 0.5
    bar_higher_than_bar_before = high[index] > high[index+1]
    bar_stronger_than_bar_before = volume[index] > volume[index+1] * 2

    there_are_buyers_at_the_bottom
     and bar_closes_with_buyers
     and bar_higher_than_bar_before
     and bar_stronger_than_bar_before

_ema_change_is_highest_on_current_bar(index, trend_started_bar_index) =>
    bar_ema_9_sum = 0.0
    volume_is_highest = true
    bar_is_weak = false
    no_bar_is_higher = true
    for i = trend_started_bar_index-1 to index
        if i < 0
            continue

        if high[i] > close[index] and i > index
            no_bar_is_higher := false

        bar_ema_9_sum += ema_9[i] - ema_9[i+1]
        if (vol_avg[i] > vol_avg[index] and volume[i] > volume[index]) or vol_avg[index] > volume[index]
            volume_is_highest := false

        if close[i] < ema_20[i]
            bar_is_weak := true

    bar_ema_9_avg = bar_ema_9_sum/trend_started_bar_index
    bar_ema_change_is_highest = ema_9[index] - ema_9[index+1] > bar_ema_9_avg
    current_bar_closes_to_9_ema = true
    if low[index] > ema_9[index]
        distance_lower_than_last_bar = true
        if close[index+1] != open[index+1]
            distance_lower_than_last_bar := low[index] - ema_9[index] < math.abs(high[index+1] - low[index+1])
        current_bar_closes_to_9_ema := (low[index] - ema_9[index])/ema_9[index] <= 0.05 and distance_lower_than_last_bar

    bar_ema_change_is_highest
     and not bar_is_weak
     and volume_is_highest
     and no_bar_is_higher
     and current_bar_closes_to_9_ema

_most_of_bars_above_volume_average(index, trend_started_bar_index) =>
    above_volume_average_counter = 0
    for i = trend_started_bar_index to index
        if volume[i] > vol_avg[i]
            above_volume_average_counter += 1

    most_of_bars_above_volume_average = above_volume_average_counter/(trend_started_bar_index+1) > 0.5

// try to use it to remove false positive
_biggest_bar_is_positive(index, trend_started_bar_index) =>
    biggest_bar_value = 0.0
    biggest_bar_index = 0

    for i = trend_started_bar_index to index
        if biggest_bar_value < high[i] - low[i]
            biggest_bar_value := high[i] - low[i]
            biggest_bar_index := i

    close[biggest_bar_index] > open[biggest_bar_index]

buyers_coming_in_indication(index) =>
    yesterday_close = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_on)

    bar_is_strong = _bar_is_strong(index)
    trend_started_bar_index = _get_trend_started_bar_index(index, vwap, ema_9, vol_avg)
    moved_already_at_least_20_percent_since_yesterday = (close[index] - yesterday_close)/close[index] >= 0.2
    ema_change_is_highest_on_current_bar = _ema_change_is_highest_on_current_bar(index, trend_started_bar_index)
    most_of_bars_above_volume_average = _most_of_bars_above_volume_average(index, trend_started_bar_index)
    biggest_bar_is_positive = _biggest_bar_is_positive(index, trend_started_bar_index)

    red_before_is_weak = true
    bar_before_is_red = close[index+1] < open[index+1]
    bar_before_that_is_green = close[index+2] > open[index+2]
    if bar_before_is_red and bar_before_that_is_green
        red_before_is_weak := (open[index+1] - close[index+1])/(close[index+2]-open[index+2]) <= 0.5

    price_is_volatile = high[index] - low[index] > 0.05

    result = bar_is_strong
     and moved_already_at_least_20_percent_since_yesterday
     and trend_started_bar_index >= 4
     and ema_change_is_highest_on_current_bar
     and red_before_is_weak
     and price_is_volatile
     and most_of_bars_above_volume_average
     and close[index] > 1
     and biggest_bar_is_positive

    if result
        log.info("Buyers Coming In!. start_index: {0}", trend_started_bar_index)
        l = label.new(x=bar_index-1, y=high + 3, textcolor = color.yellow, size = size.small, style = label.style_label_lower_right)
        label.set_text(id=l, text=str.format("s: {0}.", trend_started_bar_index))

    result


///          Indications          ///
bar_is_acting_as_reversal_upwards = bar_is_acting_as_reversal_upwards(0)
buyers_coming_in_indication = buyers_coming_in_indication(0)

plotshape(bar_is_acting_as_reversal_upwards, title="Reversal pattern", color=color.green, display = display.pane, style = shape.arrowup, size = size.small, location = location.abovebar, text = reversal_sign)
plotshape(buyers_coming_in_indication, title="Buyers Coming In", color=color.green, display = display.pane, style = shape.arrowup, size = size.small, location = location.abovebar, text = "🛫")

alertcondition(bar_is_acting_as_reversal_upwards or buyers_coming_in_indication, title="Positive indication for long/short momentum", message="Positive indication for long/short momentum")
