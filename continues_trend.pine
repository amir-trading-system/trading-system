indicator(title="Continues Trend", overlay = true, max_bars_back = 5000)
import TradingView/ta/10

//@version=6

relevant_timezone = "America/New_York"

ema_9 = ta.ema(close, 9)
ema_20 = ta.ema(close, 20)
vwap = ta.vwap(hlc3)
vol_avg = ta.sma(volume, 20)
ema_200_days = request.security(syminfo.tickerid, "D", ema_9, lookahead = barmerge.lookahead_on)
yesterday_close = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_on)
current_timeframe = str.tonumber(timeframe.period)


_made_more_than_usual_percentage_already(index, percentage) =>
    (open[index] - yesterday_close)/open[index] > percentage

_close_to_9_ema(index, allowed_distance_threshold) =>
    distance_from_9_ema = math.abs(low[index] - ema_9[index])/(high[index] - low[index])

    crossed_9_ema_up = low[index] <= ema_9[index] and (ema_9[index] - low[index])/(close[index] - ema_9[index]) < 0.1

    close_to_9_ema = distance_from_9_ema < allowed_distance_threshold
     or crossed_9_ema_up

    [close_to_9_ema, distance_from_9_ema]

_9_ema_above_all(index) =>
    most_of_bar_above_9_ema = (close[index] - ema_9[index])/(high[index] - low[index]) > 0.6

    ema_9[index] > vwap[index]
     and ema_9[index] > ema_20[index]
     and most_of_bar_above_9_ema

_volume_is_significantly_higher_than_previous(index) =>
    volume[index] > vol_avg[index]
     and volume[index] > volume[index+1] * 2

_current_bar_is_strong(index) =>
    bar_is_positive = close[index] > open[index]
    bar_is_strong = (close[index] - open[index])/(high[index] - low[index]) >= 0.75

_last_strongest_bar(index) =>
    strongest_bar_value = 0.0
    strongest_bar_index = 0

    for i = index+50 to index+5
        if high[i] > strongest_bar_value and volume[i] > volume[i+1] and volume[i] > vol_avg[i]
            strongest_bar_value := high[i]
            strongest_bar_index := i

    strongest_bar_index

_most_bars_are_overlapping(index, last_strongest_bar) =>
    overlapped_bars_counter = 0
    overlapped_bars_after_market_open_counter = 0

    for i = last_strongest_bar to index+1
        if i < 0
            continue
        above_vwap = high[i] > vwap[i]
        previous_bar_middle_point = high[i+1] - (high[i+1] - low[i+1])/2
        current_bar_deleted_more_than_50_percent_of_previous = low[i] < previous_bar_middle_point
        current_bar_did_not_make_any_real_progress = (close[i] - close[i+1])/(high[i+1] - low[i+1]) <= 0.5
        current_bar_didnt_make_progress_at_all = close[i] < close[i+1] and open[i] < close[i+1] and open[i] > low[i+1]
        after_pre_market = (hour[i] == 9 and minute[i] >= 30) or hour[i] > 9

        if above_vwap
         and after_pre_market
         and ((current_bar_deleted_more_than_50_percent_of_previous and current_bar_did_not_make_any_real_progress) or current_bar_didnt_make_progress_at_all)
            overlapped_bars_counter += 1
            if hour[index] >= 10 and ((hour[i] == 9 and minute[i] > 30) or hour[i] > 9)
                overlapped_bars_after_market_open_counter += 1

    most_of_bars_are_overlapping = overlapped_bars_counter/last_strongest_bar >= 0.4

    most_of_bars_are_overlapping

_macd_crossed_up_meanwhile(index, last_strongest_bar) =>
    [macd, signal_line, histogram] = ta.macd(close, 12, 26, 9)

    macd_crossed_upwards = false
    for i = last_strongest_bar to index+1
        was_down_but_positive = histogram[i+1] < 0 and macd[i+1] > 0 and signal_line[i+1] > 0
        now_crossed_and_positive = histogram[i] > 0 and macd[i] > 0 and signal_line[i] > 0
        if was_down_but_positive and now_crossed_and_positive
            macd_crossed_upwards := true
            break

    macd_crossed_upwards

_volume_is_the_highest_until_now(index, last_strongest_bar) =>
    volume_is_the_highest_until_now = true
    for i = last_strongest_bar-1 to index+1
        if i < 0
            continue

        if volume[i] > volume[index]
            volume_is_the_highest_until_now := false
            break

    volume_is_the_highest_until_now

momentum_trend_continue(index) =>
    percentage = 0.2
    made_more_than_usual_percentage_already = _made_more_than_usual_percentage_already(index, percentage)
    allowed_distance_threshold = 0.2
    [close_to_9_ema, real_distance] = _close_to_9_ema(index, allowed_distance_threshold)
    ema_9_above_all = _9_ema_above_all(index)
    volume_is_significantly_higher_than_previous = _volume_is_significantly_higher_than_previous(index)
    current_bar_is_strong = _current_bar_is_strong(index)
    last_strongest_bar_index = _last_strongest_bar(index)
    last_strongest_bar_is_positive = close[last_strongest_bar_index] > open[last_strongest_bar_index]
    most_bars_are_overlapping = _most_bars_are_overlapping(index, last_strongest_bar_index)
    macd_crossed_up_meanwhile = _macd_crossed_up_meanwhile(index, last_strongest_bar_index)
    volume_is_the_highest_until_now = _volume_is_the_highest_until_now(index, last_strongest_bar_index)

    previous_made_more_than_usual_percentage_already = _made_more_than_usual_percentage_already(index+1, percentage)
    [previous_close_to_9_ema, previous_real_distance] = _close_to_9_ema(index+1, allowed_distance_threshold)
    previous_ema_9_above_all = _9_ema_above_all(index+1)
    previous_current_bar_is_strong = _current_bar_is_strong(index+1)
    previous_last_strongest_bar = _last_strongest_bar(index+1)
    previous_most_bars_are_overlapping = _most_bars_are_overlapping(index+1, last_strongest_bar_index)
    previous_macd_crossed_up_meanwhile = _macd_crossed_up_meanwhile(index+1, last_strongest_bar_index)


    result = true
     and made_more_than_usual_percentage_already
     and ema_9_above_all
     and volume_is_significantly_higher_than_previous
     and current_bar_is_strong
     and most_bars_are_overlapping
     and close_to_9_ema
     and volume_is_the_highest_until_now
     and last_strongest_bar_is_positive

    if not result
        result := previous_close_to_9_ema
         and previous_ema_9_above_all
         and previous_current_bar_is_strong
         and previous_most_bars_are_overlapping
         and previous_macd_crossed_up_meanwhile
         and current_bar_is_strong
         and volume_is_the_highest_until_now
         and last_strongest_bar_is_positive

    if result
        log.info("Trend Continue!")

    result

momentum_trend_continue = momentum_trend_continue(0)

plotshape(momentum_trend_continue, title="Trend Continue", color=color.green, display = display.pane, style = shape.arrowup, size = size.small, location = location.abovebar, text = "✅")

alertcondition(momentum_trend_continue, title="Positive indication for long/short momentum", message="Positive indication for long/short momentum")
