indicator(title="Continues Trend", overlay = true)
import TradingView/ta/10

//@version=6

relevant_timezone = "America/New_York"

////           Continues Trend Indication           ////
continues_trend_sign_3_pattern = "🛫3️⃣"
continues_trend_sign_4_pattern = "🛫4️⃣"
reversal_sign = "🌠"

is_crossed_up(l, v, c) =>
    l < v and c > v

had_at_least_one_pullback_and_less_than_three(index, ema_9, vwap, trend_started_bar_index) =>
    pullbacks_counter = 0
    previous_pullback_low = 0.0
    previous_pullback_index = 100
    for i = trend_started_bar_index to index
        previous_bar_is_red = (close[i+1] < open[i+1] and i+1 < trend_started_bar_index) or (close[i+2] < open[i+2] and i+2 < trend_started_bar_index)
        current_high_is_higher = high[i] > high[i+1]
        current_bar_close_to_9_ema = open[i] > ema_9[i] and math.abs(low[i] - ema_9[i]) < (high[i] - low[i])
        current_bar_is_positive = close[i] > open[i] and volume[i] > volume[i+1]
        bar_is_strong = (close[i] - open[i])/(high[i]-low[i]) >= 0.1
        price_is_above_vwap = open[i] > vwap[i]

        if previous_bar_is_red
         and current_high_is_higher
         and current_bar_close_to_9_ema
         and current_bar_is_positive
         and bar_is_strong
         and price_is_above_vwap
            current_pullback_low = low[i+1] < low[i+2] ? low[i+1] : low[i+2]
            if current_pullback_low > previous_pullback_low and previous_pullback_index != i+1
                pullbacks_counter += 1
                previous_pullback_low := current_pullback_low
                previous_pullback_index := i
                // if time == timestamp(relevant_timezone, 2025, 6, 17, 10, 25) and timeframe.period == "5"
                //     log.info("i: {0}. trend_started_bar_index: {1}", i, trend_started_bar_index)

    [pullbacks_counter >= 1 and pullbacks_counter <= 4, pullbacks_counter]

pattern_occurred(index, ema_9, vwap, histogram, vol_avg, bars_count_pattern) =>
    min_volume_threshold_for_first_strong_bar = 30000

    pattern_occurred = false
    if bars_count_pattern == 3
        lows_above_vwap = open[index+2] > vwap[index+2] and open[index+1] > vwap[index+1] and open[index] > vwap[index]
        highs_above_vwap = high[index+2] > vwap[index+2] and high[index+1] > vwap[index+1] and high[index] > vwap[index]

        no_under_ema_bars_before = true
        for i = index+5 to index
            if close[i] < ema_9[i] and str.tonumber(timeframe.period) == 1
                no_under_ema_bars_before := false
                break

        previous_negative_bar_is_weak = open[index+1] > close[index+1] and (open[index+1] - close[index+1])/(high[index+1]-low[index+1]) <= 0.5
        current_bar_is_positive_and_strong = close[index] > open[index] and high[index] > high[index+1] and (volume[index] >= vol_avg[index] * 2 or volume[index] >= min_volume_threshold_for_first_strong_bar)

        at_least_one_bar_is_red_before = false
        for i = index+7 to index+2
            if close[i] < open[i]
                at_least_one_bar_is_red_before := true
                break

        red_bars_are_weak = true
        for i = index+4 to index+1
            is_red_bar = close[i] < open[i]
            has_green_bar_before = close[i+1] > open[i+1]
            if is_red_bar and has_green_bar_before and (close[i] < ema_9[i] or close[i] < vwap[i])
                red_bars_are_weak := false
                break

        weak_bar_crossed_green_bar = low[index+1] < high[index+2]

        pattern_occurred := lows_above_vwap
         and highs_above_vwap
         and previous_negative_bar_is_weak
         and current_bar_is_positive_and_strong
         and no_under_ema_bars_before
         and at_least_one_bar_is_red_before
         and red_bars_are_weak
         and weak_bar_crossed_green_bar
    else
        four_pattern_close_above_vwap = close[index] > vwap[index]
        four_pattern_previous_positive_bar_is_stronger_than_before = high[index+3] > high[index+4] and high[index+3] > high[index+5] and ((volume[index+3] > volume[index+4] and open[index+4] > close[index+4]) or open[index+4] < close[index+4]) and (histogram[index+3]/histogram[index+4] >= 0.75 or histogram[index+3] > histogram[index+4]) and (histogram[index]/histogram[index+3] >= 0.8 or histogram[index] > histogram[index+3])
        four_pattern_third_bar_is_stronger = (close[index+1] > open[index+1] and close[index+1] - open[index+1] > 0.1 and volume[index+1] < volume[index] and (close[index]-open[index]) > (close[index+1]-open[index+1])) or (open[index+1] > close[index+1] and volume[index+1] < volume[index+2])
        four_pattern_current_bar_is_positive_and_strong = close[index] > open[index] and high[index] > high[index+1]
        four_pattern_weak_bar_before_is_really_weak = low[index+1] < low[index+2] and low[index+1] < low[index+3] and volume[index+1] > vol_avg[index+1]

        previous_positive_bar_is_stronger_than_before = true
        for i = index+9 to index+4
            if volume[i]/volume[index+3] >= 0.75
                previous_positive_bar_is_stronger_than_before := false
                break

        at_least_one_bar_is_red = close[index+2] < open[index+2] or close[index+1] < open[index+1]

        at_least_one_bar_is_red_before = false
        for i = index+8 to index+3
            if close[i] < open[i] or volume[i] < vol_avg[i] or volume[i] * 10 < volume[index]
                at_least_one_bar_is_red_before := true
                break

        red_bars_are_weak = true
        for i = index+4 to index+1
            is_red_bar = close[i] < open[i]
            has_green_bar_before = close[i+1] >= open[i+1]
            if is_red_bar and has_green_bar_before and low[i] < low[i+1]
                red_bars_are_weak := false
                break

        pattern_occurred := four_pattern_close_above_vwap
         and four_pattern_current_bar_is_positive_and_strong
         and four_pattern_third_bar_is_stronger
         and (four_pattern_previous_positive_bar_is_stronger_than_before or previous_positive_bar_is_stronger_than_before)
         and not four_pattern_weak_bar_before_is_really_weak
         and at_least_one_bar_is_red
         and at_least_one_bar_is_red_before
         and red_bars_are_weak

    pattern_occurred

macd_is_positive(index, macdLine, signalLine, histogram) =>
    macdLine[index] > 0 and signalLine[index] > 0 and histogram[index] > 0

get_trend_started_bar_index(index, current_timeframe, vwap, vol_avg) =>
    trend_started_bar_index = 0
    back = index+20
    if current_timeframe >= 5
        back := index+30

    for i = back to index+1
        if hour[i] < 7
            continue

        low_i = low[i]
        close_i = close[i]
        high_i = high[i]
        open_i = open[i]
        volume_i = volume[i]
        vwap_i = vwap[i]

        volume_i1 = volume[i+1]
        low_i1 = low[i+1]
        vwap_i1 = vwap[i+1]
        close_i1 = close[i+1]
        high_i1 = high[i+1]

        low_i2 = low[i+2]
        close_i2 = close[i+2]
        vwap_i2 = vwap[i+1]

        crossed_vwap_upwards = is_crossed_up(low_i, vwap_i, close_i)
         or is_crossed_up(low_i1, vwap_i1, close_i1)
         or is_crossed_up(low_i2, vwap_i2, close_i2)
        if crossed_vwap_upwards
            bar_is_positive = close_i > open_i
            if bar_is_positive
                bar_is_volatile = volume_i > vol_avg[i] and volume_i > volume_i1 and vol_avg[i] > vol_avg[i+1] and volume_i > 2000
                if bar_is_volatile
                    bar_value_is_volatile = (high_i-low_i) > (high_i1-low_i1) * 2

                    if bar_is_positive and bar_is_volatile and crossed_vwap_upwards and bar_value_is_volatile
                        trend_started_bar_index := i
                        break

    trend_started_bar_index

current_bar_continues_up_trend(index) =>
    bars_back = 20
    lowest_price_in_last_bars = ta.lowest(low, bars_back)
    highest_price_in_last_bars = ta.highest(close, bars_back)

    (highest_price_in_last_bars-lowest_price_in_last_bars) / close[index] >= 0.05

current_bar_above_vwap_for_the_last_bars(index, trend_started_bar_index, vwap, vol_avg, ema_20) =>
    above_vwap_for_the_last_bars = true
    for i = trend_started_bar_index to index
        price_is_under_half_of_started_bar = close[i]/(high[trend_started_bar_index] - low[trend_started_bar_index]) < 0.5
        if (vwap[i] > close[i] or vwap[i] > open[i]) and close[i] < open[i] and volume[i] > vol_avg[i] and close[i] < ema_20[i] and price_is_under_half_of_started_bar
            above_vwap_for_the_last_bars := false

    above_vwap_for_the_last_bars

current_bar_is_highest_in_the_last_bars(index) =>
    highest_in_the_last_bars = 0.0
    highest_in_the_last_bars_index = 0
    for i = 5 to index+1
        if high[index+i] > highest_in_the_last_bars
            highest_in_the_last_bars := high[index+i]
            highest_in_the_last_bars_index := index+i

    [high[index] > highest_in_the_last_bars, highest_in_the_last_bars_index]

price_is_above_ema(index, highest_in_the_last_bars_index, ema_9) =>
    price_is_above_ema = true
    for i = highest_in_the_last_bars_index-1 to index
        if i < 0
            continue
        if close[i] < ema_9[i] or open[i] < ema_9[i]
            price_is_above_ema := false
            break
    price_is_above_ema

current_bar_is_weaker(index) =>
    current_bar_is_weaker = false
    weak_finder_bars_back = 10
    if str.tonumber(timeframe.period) >= 5
        weak_finder_bars_back := 5
    for i = weak_finder_bars_back to 1
        if high[i] - low[i] > high[index] - low[index] and open[i] > close[i] and volume[i] > volume[index]
            current_bar_is_weaker := true

    current_bar_is_weaker

current_bar_is_too_strong(index, vol_avg) =>
    current_bar_is_too_strong = volume[index] > vol_avg[index] * 3
    for i = index+5 to index+1
        if volume[i] > vol_avg[i] * 3
            current_bar_is_too_strong := false
            break

    current_bar_is_too_strong

current_bar_value_is_volatile(index) =>
    (math.abs(close[index+1]-open[index+1])/(close[index]-open[index]) <= 0.5 and close[index+1] < open[index+1]) or (math.abs(close[index+2]-open[index+2])/(close[index]-open[index]) <= 0.5 and close[index+2] < open[index+2])

already_moved_up(index, current_timeframe) =>
    already_moved_up = false
    bars_back = int(120/current_timeframe)
    for i = index+bars_back to index+1
        if volume[i] > volume[index] and close[i] > high[index]
            already_moved_up := true
            break

    already_moved_up

current_bar_touches_9_ema(index, ema_9) =>
    low[index] <= ema_9[index] or (low[index] - ema_9[index]) < (high[index+1] - low[index+1])

previous_bar_touches_9_ema(index, ema_9) =>
    low[index+1] <= ema_9[index+1] or (low[index+1] - ema_9[index+1])/(high[index+1] - low[index+1]) <= 0.5

previous_low_is_weak(index, ema_9) =>
    previous_low_is_weak = low[index+1] <= low[index+2] and math.abs(close[index+1] - open[index+1])/(high[index+1] - low[index+1]) <= 0.3
    if close[index+2] < open[index+2]
        previous_low_is_weak := previous_low_is_weak and math.abs(low[index+1] - ema_9[index+1]) < (low[index+1] - ema_9[index+2])

    previous_low_is_weak

start_of_trend_bar_too_strong(index, trend_started_bar_index) =>
    start_of_trend_bar_too_strong = true
    start_of_trend_bar_value = high[trend_started_bar_index] - low[trend_started_bar_index]
    for i = trend_started_bar_index+1 to index
        if high[i] - low[i] > start_of_trend_bar_value
            start_of_trend_bar_too_strong := false
            break

    start_of_trend_bar_too_strong

weak_bars_before_are_strong(index, trend_started_bar_index) =>
    (((open[index+1] - close[index+1])/(high[index+1] - low[index+1]) <= 0.5 or (open[index+1] - close[index+1])/(high[index+2] - low[trend_started_bar_index+2]) <= 0.5) and close[index+1] < open[index+1]) or (((open[index+2] - close[index+2])/(high[index+2] - low[index+2]) <= 0.5 or (open[index+2] - close[index+2])/(high[index+3] - low[trend_started_bar_index+3]) <= 0.5) and close[index+2] < open[index+2])

current_bar_is_strong_bar(index, bars_count_pattern) =>
    vol_avg = ta.sma(volume, 20)
    ema_9 = ta.ema(close, 9)
    ema_20 = ta.ema(close, 20)
    vwap = ta.vwap(hlc3)
    [macdLine, signalLine, histogram] = ta.macd(close, 12, 26, 9)
    current_timeframe = str.tonumber(timeframe.period)

    macd_is_positive = false
    current_bar_continues_up_trend = false
    current_bar_is_weaker = true
    current_bar_is_too_strong = true
    bar_value_is_volatile = false
    already_moved_up = true
    current_bar_touches_9_ema = false
    previous_bar_touches_9_ema = false
    previous_low_is_weak = false
    trend_started_bar_index = 0
    above_vwap_for_the_last_bars = false
    start_of_trend_bar_too_strong = true
    weak_bars_before_are_strong = false

    pattern_occurred = pattern_occurred(index, ema_9, vwap, histogram, vol_avg, bars_count_pattern)
    if pattern_occurred
        macd_is_positive := macd_is_positive(index, macdLine, signalLine, histogram)
        if macd_is_positive
            current_bar_continues_up_trend := current_bar_continues_up_trend(index)
            if current_bar_continues_up_trend
                current_bar_is_weaker := current_bar_is_weaker(index)
                if not current_bar_is_weaker
                    current_bar_is_too_strong := current_bar_is_too_strong(index, vol_avg)
                    if not current_bar_is_too_strong
                        bar_value_is_volatile := current_bar_value_is_volatile(index)
                        if bar_value_is_volatile
                            already_moved_up := already_moved_up(index, current_timeframe)
                            if not already_moved_up
                                current_bar_touches_9_ema := current_bar_touches_9_ema(index, ema_9)
                                previous_bar_touches_9_ema := previous_bar_touches_9_ema(index, ema_9)
                                previous_low_is_weak := previous_low_is_weak(index, ema_9)

    trend_started_bar_index := get_trend_started_bar_index(index, current_timeframe, vwap, vol_avg)
    [pullbacks_are_looks_good, pullbacks_counter] = had_at_least_one_pullback_and_less_than_three(index, ema_9, vwap, trend_started_bar_index)
    above_vwap_for_the_last_bars := current_bar_above_vwap_for_the_last_bars(index, trend_started_bar_index, vwap, vol_avg, ema_20)
    start_of_trend_bar_too_strong := start_of_trend_bar_too_strong(index, trend_started_bar_index)
    weak_bars_before_are_strong := weak_bars_before_are_strong(index, trend_started_bar_index)

    [current_bar_is_highest_in_the_last_bars, highest_in_the_last_bars_index] = current_bar_is_highest_in_the_last_bars(index)
    price_is_above_ema = price_is_above_ema(index, highest_in_the_last_bars_index, ema_9)

    result = pattern_occurred
     and not current_bar_is_weaker
     and macd_is_positive
     and current_bar_is_highest_in_the_last_bars
     and current_bar_continues_up_trend
     and price_is_above_ema
     and above_vwap_for_the_last_bars
     and not current_bar_is_too_strong
     and bar_value_is_volatile
     and volume[index] >= 50000
     and pullbacks_are_looks_good
     and not already_moved_up
     and (current_bar_touches_9_ema or previous_bar_touches_9_ema or previous_low_is_weak)
     and not (start_of_trend_bar_too_strong and pullbacks_counter < 1)
     and weak_bars_before_are_strong

    if result
        at_least_one_bar_touched_ema_9 = false
        closest_to_ema_until_now_index = 0
        closest_to_ema_until_now_distance = 100.0
        for i = trend_started_bar_index-1 to index
            if trend_started_bar_index-1 < 1
                continue

            if low[i] > ema_9[i] and low[i] - ema_9[i] < closest_to_ema_until_now_distance
                closest_to_ema_until_now_distance := low[i] - ema_9[i]
                closest_to_ema_until_now_index := i

            if low[i] <= ema_9[i]
                at_least_one_bar_touched_ema_9 := true
                break

        bars_back = 0
        back = 0
        lower_timeframe = ""

        if not at_least_one_bar_touched_ema_9
            switch timeframe.period
                "15" =>
                    bars_back := 15/5
                    back := closest_to_ema_until_now_index * (bars_back)
                    lower_timeframe := "5"
                "5" =>
                    bars_back := 5/1
                    back := closest_to_ema_until_now_index * (bars_back)
                    lower_timeframe := "1"
                "2" =>
                    bars_back := 2/1
                    back := closest_to_ema_until_now_index * (bars_back)
                    lower_timeframe := "1"
                "1" =>
                    bars_back := 10/1
                    back := closest_to_ema_until_now_index * (bars_back)
                    lower_timeframe := "10S"

            [lows, ema_9s] = request.security_lower_tf(syminfo.tickerid, lower_timeframe, [low[back], ta.ema(close, 9)[back]])
            if array.size(lows) == bars_back
                for i = array.size(lows) to 1
                    l = array.get(lows, i-1)
                    e = array.get(ema_9s, i-1)
                    if i <= e
                        at_least_one_bar_touched_ema_9 := true
                        break

        result := result and at_least_one_bar_touched_ema_9

    // if time == timestamp(relevant_timezone, 2025, 6, 26, 10, 45) and timeframe.period == "15"
    //     log.info("pullbacks_counter: {0}. s_i: {1}", pullbacks_counter, trend_started_bar_index)

    [result, trend_started_bar_index, pullbacks_counter]

bar_is_acting_as_reversal_upwards(index) =>
    vwap = ta.vwap(hlc3)
    vol_avg = ta.sma(volume, 20)
    ema_9 = ta.ema(close, 9)
    ema_20 = ta.ema(close, 20)
    [macd, signal, histogram] = ta.macd(close, 12, 26, 9)

    ema_9_is_above_all = ema_9[index] >= vwap[index] and ema_9[index] > ema_20[index]
    close_is_above_all = close[index] > open[index] and close[index] > ema_9[index]
    bar_before_is_red = close[index+1] < open[index+1]
    bar_volume_is_similar_to_bar_before = (high[index] - low[index])/(high[index+1]-low[index+1]) >= 0.65
    current_bar_is_positive = close[index] > open[index] and high[index] > close[index]
    current_bar_is_still_lower_than_bar_before = high[index] <= high[index+1]
    bar_has_inverted_hammer_pattern = (open[index] == low[index] or (open[index] - low[index])/(high[index] - low[index]) <= 0.2) and (high[index] - close[index])/(close[index] - low[index]) >= 0.3
    current_bar_is_close_to_9_ema = (low[index] - ema_9[index]) < (high[index]-low[index])
    most_of_the_bar_is_above_ema_9 = (math.abs(ema_9[index] - open[index])/(close[index] - open[index]) <= 0.5) or open[index] >= ema_9[index]
    bar_is_volatile = volume[index] > 50000
    macd_is_positive = histogram[index] > 0 and macd[index] > 0

    current_timeframe = str.tonumber(timeframe.period)
    bars_back = int(30/current_timeframe)

    weak_bar_found = false
    for i = index+bars_back to index
        bar_is_under_9_ema = open[i] < ema_9[i] and close[i] < ema_9[i] and volume[i] > volume[index]
        bar_is_under_vwap = open[i] < vwap[i] and close[i] < vwap[i] and volume[i] > volume[index]
        if bar_is_under_9_ema or bar_is_under_vwap
            weak_bar_found := true
            break

    high_before_is_low_than_high_before = true
    if current_timeframe <= 2
        high_before_is_low_than_high_before := high[index+1] < high[index+2]

    result = bar_before_is_red
     and bar_volume_is_similar_to_bar_before
     and current_bar_is_positive
     and current_bar_is_still_lower_than_bar_before
     and bar_has_inverted_hammer_pattern
     and current_bar_is_close_to_9_ema
     and most_of_the_bar_is_above_ema_9
     and bar_is_volatile
     and not weak_bar_found
     and high_before_is_low_than_high_before
     and macd_is_positive

    if current_timeframe <= 5
        result := result
         and ema_9_is_above_all
         and close_is_above_all

    result

run_continues_trend_indication() =>
    index = 0
    trend_started_bar_index = 0
    pullbacks_counter = 0

    [current_bar_is_strong_in_3_bars_pattern, t_3, pb_3] = current_bar_is_strong_bar(index, 3)
    [current_bar_is_strong_in_4_bars_pattern, t_4, pb_4] = current_bar_is_strong_bar(index, 4)
    if t_3 != 0
        trend_started_bar_index := t_3
    if t_4 != 0
        trend_started_bar_index := t_4
    if pb_3 != 0
        pullbacks_counter := pb_3
    if pb_4 != 0
        pullbacks_counter := pb_4
    bar_is_acting_as_reversal_upwards = bar_is_acting_as_reversal_upwards(index)

    if bar_is_acting_as_reversal_upwards and hour >= 9 and hour < 16
        log.info("Shooting Star!")

    if (current_bar_is_strong_in_3_bars_pattern or current_bar_is_strong_in_4_bars_pattern) and hour >= 9 and hour < 16
        log.info("continues trend. start_index: {0}. pb_counter: {1}", trend_started_bar_index, pullbacks_counter)

    [current_bar_is_strong_in_3_bars_pattern, current_bar_is_strong_in_4_bars_pattern, bar_is_acting_as_reversal_upwards]

[current_bar_is_strong_in_3_bars_pattern, current_bar_is_strong_in_4_bars_pattern, bar_is_acting_as_reversal_upwards] = run_continues_trend_indication()

plotshape(hour >= 8 and hour < 16 ? current_bar_is_strong_in_3_bars_pattern : false, title="Continues trend indication 3 pattern", color=color.green, display = display.pane, style = shape.arrowup, size = size.small, location = location.abovebar, text = continues_trend_sign_3_pattern)
plotshape(hour >= 8 and hour < 16 ? current_bar_is_strong_in_4_bars_pattern : false, title="Continues trend indication 4 pattern", color=color.green, display = display.pane, style = shape.arrowup, size = size.small, location = location.abovebar, text = continues_trend_sign_4_pattern)
plotshape(hour >= 8 and hour < 16 ? bar_is_acting_as_reversal_upwards : false, title="Reversal pattern", color=color.green, display = display.pane, style = shape.arrowup, size = size.small, location = location.abovebar, text = reversal_sign)

alertcondition(bar_is_acting_as_reversal_upwards, title="Positive indication for long/short momentum", message="Positive indication for long/short momentum")
