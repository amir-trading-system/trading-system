indicator(title="Continues Trend", overlay = true, max_bars_back = 5000)
import TradingView/ta/10

//@version=6

relevant_timezone = "America/New_York"

ema_9 = ta.ema(close, 9)
vwap = ta.vwap(hlc3)
vol_avg = ta.sma(volume, 20)
[macd, signal_line, histogram] = ta.macd(close, 12, 26, 9)
current_timeframe = str.tonumber(timeframe.period)
if timeframe.period == "10S"
    current_timeframe := 10

_made_more_than_usual_percentage_already(index, percentage) =>
    yesterday_close = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_on)
    (close[index] - yesterday_close)/open[index] > percentage

trend_continues(index) =>
    percentage = 0.1
    made_more_than_usual_percentage_already = _made_more_than_usual_percentage_already(index, percentage)
    movement_is_after_market_start = (hour[index] == 9 and minute[index] > 30) or (hour[index] > 9 and hour[index] <= 14)

    top_point_index = 0
    for i = index to index+5
        if i-1 < 0
            continue
        if high[i] > high[i+1]
         and high[i] > high[i-1]
         and low[i] > ema_9[i]
         and volume[i] > vol_avg[i]
            top_point_index := i
            break

    coming_after_fall = false
    if top_point_index > 0
        coming_after_fall := true
        for i = top_point_index to index+1
            if i-1 < 0 or i-2 < 0
                continue
            if high[i] < high[i-1]
             and high[i-1] > high[i-2]
             and i-1 > index
             and i-2 > index
                coming_after_fall := false
                break

    buyers_coming_in = (open[index] - low[index])/(high[index] - low[index]) >= 0.3
     or (close[index] - open[index])/(high[index] - low[index]) <= 0.5
    if close[index] < open[index]
        buyers_coming_in := (close[index] - low[index])/(high[index] - low[index]) >= 0.5

    result = true
     and made_more_than_usual_percentage_already
     and movement_is_after_market_start
     and coming_after_fall
     and high[index] > close[index+1]
     and macd[index] > 0
     and signal_line[index] > 0
     and histogram[index] > 0

    [result, top_point_index]

///////////// indications /////////////
continues_trend_indication() =>
    var float index = na
    var int top_point_index = na
    already_happend_before = false
    [trend_continues_result_0, top_point_index_0] = trend_continues(0)
    [trend_continues_result_1, top_point_index_1] = trend_continues(1)
    [trend_continues_result_2, top_point_index_2] = trend_continues(2)
    [trend_continues_result_3, top_point_index_3] = trend_continues(3)
    if trend_continues_result_0
        index := 0
        top_point_index := top_point_index_0
        already_happend_before := true
    if na(index)
        if trend_continues_result_1 and na(index)
            index := 1
            top_point_index := top_point_index_1
            already_happend_before := true
    if na(index)
        if trend_continues_result_2 and na(index)
            index := 2
            top_point_index := top_point_index_2
            already_happend_before := true
    if na(index)
        if trend_continues_result_3 and na(index)
            index := 3
            top_point_index := top_point_index_3
            already_happend_before := true

    close_to_9_ema_than_before = math.abs(low[0] - ema_9[0])/(high[0] - low[0]) <= 0.5
    indicators_looks_good = ema_9[0] > vwap[0]

    result = already_happend_before
     and histogram[0] > histogram[1]
     and histogram[1] < histogram[2]
     and close_to_9_ema_than_before
     and volume[0] > 500000
     and volume[0] >= volume[1]
     and histogram[0]/histogram[top_point_index] >= 0.5
     and top_point_index >= 3

    if result and not na(index)
        log.info("buyers coming in, ready for change! index: {0}. top_point_index: {1}", index, top_point_index)
        label.new(bar_index-top_point_index, high[top_point_index], text="top", size = size.small, style = label.style_label_lower_right)

    result and not na(index)

continues_trend_indication = continues_trend_indication()

plotshape(continues_trend_indication, title="Continues Trend", color=color.green, display = display.pane, style = shape.arrowup, size = size.small, location = location.belowbar, text = "💰")

alertcondition(continues_trend_indication, title="Positive indication for long/short momentum", message="Positive indication for long/short momentum")
