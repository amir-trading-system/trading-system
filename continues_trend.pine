indicator(title="Continues Trend", overlay = true, max_bars_back = 5000)
import TradingView/ta/10

//@version=6

relevant_timezone = "America/New_York"

ema_9 = ta.ema(close, 9)
ema_20 = ta.ema(close, 20)
ema_200 = ta.ema(close, 200)
vwap = ta.vwap(hlc3)
vol_avg = ta.sma(volume, 20)
[macd, signal_line, histogram] = ta.macd(close, 12, 26, 9)
ema_200_days = request.security(syminfo.tickerid, "D", ema_200, lookahead = barmerge.lookahead_on)
yesterday_close = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_on)
current_timeframe = str.tonumber(timeframe.period)


_made_more_than_usual_percentage_already(index, percentage) =>
    (close[index] - yesterday_close)/open[index] > percentage

_close_to_9_ema(index, allowed_distance_threshold) =>
    distance_from_9_ema = math.abs(low[index] - ema_9[index])/(high[index] - low[index])
    previous_distance_from_9_ema = math.abs(low[index+1] - ema_9[index+1])/(high[index+1] - low[index+1])

    current_distance_smaller_than_previous_and_strong_bar = distance_from_9_ema < previous_distance_from_9_ema and volume[index] > volume[index+1] * 1.2

    crossed_9_ema_up = low[index] <= ema_9[index] and (ema_9[index] - low[index])/(close[index] - ema_9[index]) < 0.1

    close_to_9_ema = distance_from_9_ema < allowed_distance_threshold
     or crossed_9_ema_up
     or current_distance_smaller_than_previous_and_strong_bar

    close_to_9_ema

_price_above_all_indicators_for_last_bars(index, last_bars) =>
    price_above_all_indicators_for_last_bars = true

    for i = index+last_bars to index
        after_market_open = (hour[i] == 9 and minute[i] >= 30) or hour[i] > 9

        if true
         and close[i] < vwap[i]
         and close[i] < ema_9[i]
         and low[i] < low[i+1]
         and after_market_open
         and volume[i] > 10000
         and vol_avg[i] > 10000
            price_above_all_indicators_for_last_bars := false
            break

    price_above_all_indicators_for_last_bars

_not_too_close_to_ema_200_day(index) =>
    not_too_close_to_ema_200_day = ema_200_days[index] < low[index]
    if ema_200_days[index] > high[index]
        not_too_close_to_ema_200_day := ema_200_days - high[index] > 0.5

    not_too_close_to_ema_200_day

_ema_to_price_ratio_looks_good(index, allowed_distance_threshold) =>
    last_bars = 2

    close_to_9_ema = _close_to_9_ema(index, allowed_distance_threshold)
    price_above_all_indicators_for_last_bars = _price_above_all_indicators_for_last_bars(index, last_bars)
    not_too_close_to_ema_200_day = _not_too_close_to_ema_200_day(index)

    true
     and close_to_9_ema
     and price_above_all_indicators_for_last_bars
     and not_too_close_to_ema_200_day

_current_bar_is_strong(index) =>
    bar_is_positive = close[index] > open[index]
    bar_strong = (close[index] - open[index])/(high[index] - low[index])
    bar_is_strong = (close[index] - open[index])/(high[index] - low[index]) >= 0.2
     and open[index] >= low[index+1]
     and high[index] > vwap[index]
    bar_is_highest_in_the_last_bars = true
    for i = index+10 to index+1
        if high[i] > high[index] and volume[i] > volume[index]
            bar_is_highest_in_the_last_bars := false
            break

    bar_is_positive
     and bar_is_strong
     and bar_is_highest_in_the_last_bars

_most_bars_are_overlapping(index) =>
    overlapped_bars_counter = 0
    overlapped_bars_after_market_open_counter = 0

    for i = index+6 to index+1
        if i < 0
            continue
        above_vwap = high[i] > vwap[i]
        previous_bar_middle_point = high[i+1] - (high[i+1] - low[i+1])/2
        current_bar_deleted_more_than_50_percent_of_previous = low[i] < previous_bar_middle_point
        current_bar_did_not_make_any_real_progress = (close[i] - close[i+1])/(high[i+1] - low[i+1]) <= 0.5
        current_bar_didnt_make_progress_at_all = close[i] < close[i+1] and open[i] < close[i+1] and open[i] > low[i+1]
        after_pre_market = (hour[i] == 9 and minute[i] >= 30) or hour[i] > 9

        if above_vwap
         and after_pre_market
         and ((current_bar_deleted_more_than_50_percent_of_previous and current_bar_did_not_make_any_real_progress) or current_bar_didnt_make_progress_at_all)
            overlapped_bars_counter += 1
            if hour[index] >= 10 and ((hour[i] == 9 and minute[i] > 30) or hour[i] > 9)
                overlapped_bars_after_market_open_counter += 1

    most_of_bars_are_overlapping = overlapped_bars_counter/index+6 >= 0.4

    most_of_bars_are_overlapping

_macd_trend_goes_up(index, macd, histogram) =>
    bars_back_for_30_minutes_before = int(30/current_timeframe)
    last_highest_histogram = ta.highest(histogram[index], bars_back_for_30_minutes_before)
    last_highest_macd = ta.highest(macd[index], bars_back_for_30_minutes_before)
    histogram[index] > last_highest_histogram/1.5
     and macd[index] > last_highest_macd/1.5

_macd_looks_positive(index) =>
    macd_looks_positive = true
    macd_trend_goes_up = _macd_trend_goes_up(index, macd, histogram)
    previous_histogram_lower_than_current = histogram[index+1] < histogram[index]

    if macd_trend_goes_up
     and previous_histogram_lower_than_current
        for i = index+10 to index
            if macd[i] < 0
             and signal_line[i] < 0
             and volume[i] > vol_avg[i]
             and vol_avg[i] > 20000
                macd_looks_positive := false
                break
    true
     and macd_looks_positive
     and macd[index] > 0
     and signal_line[index] > 0
     and macd_trend_goes_up
     and previous_histogram_lower_than_current

_volume_is_the_highest_until_now(index) =>
    volume_is_the_highest_until_now = true
    for i = index+6 to index+1
        if i < 0
            continue

        if volume[index] < volume[index+1]
            volume_is_the_highest_until_now := false
            break

        if (volume[i] > volume[index] and high[i] > high[index])
            volume_is_the_highest_until_now := false
            break

        if volume[index]/volume[i] < 0.75
            volume_is_the_highest_until_now := false
            break

    volume_is_the_highest_until_now

_volume_average_indicate_on_trend(index) =>
    volume_average_indicate_on_trend = true
    for i = index+5 to index
        if vol_avg[i] < 10000
            volume_average_indicate_on_trend := false
            break

    true
     and (volume[index] > vol_avg[index] * 1.5 or (volume[index] > vol_avg[index] and volume[index] > volume[index+1] * 1.5))
     and vol_avg[index] > 20000
     and volume_average_indicate_on_trend

_price_movement_is_big(index) =>
    price_movement_is_big = true
    for i = index+6 to index+1
        if (close[i] - low[i]) > (high[index] - low[index])
         and (close[i+1] - low[i+1])/(close[i] - low[i]) > 0.6
            price_movement_is_big := false
            break

    price_movement_is_big
     and high[index] - low[index] > 0.1

_only_on_market_movement_time(index) =>
    result = false
    if hour[index] == 9
        result := minute[index] >= 30
    if hour[index] > 9
        result := hour[index] > 9 and hour[index] <= 16

    result

_has_volatility_smile_pattern(index, good_to_go_for_check) =>
    has_volatility_smile_pattern = false
    first_pick_bar_index = 0
    if good_to_go_for_check
        bars_back = int(360/current_timeframe)
        for i = index + bars_back to index+1
            if i-1 < 0 or i-2 < 0
                continue

            if dayofmonth[i] != dayofmonth[index]
                continue

            is_volume_first_pick = volume[i] > vol_avg[i] * 2
             and (volume[i+1] > vol_avg[i+1] or volume[i] > volume[i+1] * 10)
             and volume[i] > volume[i+1]
             and volume[i] > volume[i+2]
             and volume[i] > volume[i-1]

            first_pick_bars_back = int(120/current_timeframe)
            highest_high_until_now = 0.0
            highest_volume_until_now = 0.0
            for j = first_pick_bars_back to i
                if high[j] > highest_high_until_now
                    highest_high_until_now := high[j]
                if volume[j] > highest_volume_until_now
                    highest_volume_until_now := volume[j]

            // if time == timestamp(relevant_timezone, year, 8, 20, 9, 45) and current_timeframe == 15
            //     log.info("is_volume_first_pick: {0}", is_volume_first_pick)

            if true
             and is_volume_first_pick
             and highest_high_until_now == high[i]
             and highest_volume_until_now == volume[i]
             and volume[i] > 10000
                first_pick_bar_index := i
                break

        no_negative_bar_is_stronger = true
        if first_pick_bar_index != 0
            bars_with_low_volume_counter = 0
            for i = first_pick_bar_index+1 to index
                if volume[i] < volume[first_pick_bar_index]
                 and volume[i] < volume[index]
                    bars_with_low_volume_counter += 1

                if close[i] < open[i]
                 and volume[i] > volume[index]
                    no_negative_bar_is_stronger := false

            // if time == timestamp(relevant_timezone, year, 8, 20, 9, 45) and current_timeframe == 15
            //     log.info("bars_with_low_volume_counter: {0}. first_pick_bar_index: {1}", bars_with_low_volume_counter, first_pick_bar_index)
            has_volatility_smile_pattern := bars_with_low_volume_counter/first_pick_bar_index >= 0.6
             and no_negative_bar_is_stronger

    [has_volatility_smile_pattern, first_pick_bar_index]

momentum_trend_continue(index) =>
    percentage = 0.2
    made_more_than_usual_percentage_already = _made_more_than_usual_percentage_already(index, percentage)
    current_bar_is_strong = _current_bar_is_strong(index)
    macd_looks_positive = _macd_looks_positive(index)
    volume_is_the_highest_until_now = _volume_is_the_highest_until_now(index)
    volume_average_indicate_on_trend = _volume_average_indicate_on_trend(index)
    price_movement_is_big = _price_movement_is_big(index)
    allowed_distance_threshold = 0.2
    ema_to_price_ratio_looks_good = _ema_to_price_ratio_looks_good(index, allowed_distance_threshold)

    result = true
     and made_more_than_usual_percentage_already
     and current_bar_is_strong
     and macd_looks_positive
     and volume_average_indicate_on_trend
     and (price_movement_is_big or volume_is_the_highest_until_now)
     and ema_to_price_ratio_looks_good

    good_to_go_for_check = false
    if result
        good_to_go_for_check := true

    [has_volatility_smile_pattern, first_pick_bar_index] = _has_volatility_smile_pattern(index, good_to_go_for_check)

    result
     and has_volatility_smile_pattern

just_crossed_last_high(index) =>
    is_positive = close[index] > open[index]
    after_market_open = (hour[index] == 9 and minute[index] >= 30) or hour[index] > 9
    bars_back = int(360/current_timeframe)
    today_highest = ta.highest(high, bars_back)
    just_crossed_last_high = false
    if today_highest == high[index]
        just_crossed_last_high := true
    else
        just_crossed_last_high := close[index] > today_highest and today_highest != high[index+1]

    momentum_trend_continue_0 = momentum_trend_continue(index)
    momentum_trend_continue_1 = momentum_trend_continue(index+1)
    momentum_trend_continue_2 = momentum_trend_continue(index+2)
    momentum_trend_continue_3 = momentum_trend_continue(index+3)
    momentum_trend_continue_4 = momentum_trend_continue(index+4)
    momentum_trend_continue_5 = momentum_trend_continue(index+5)
    momentum_trend_continue_6 = momentum_trend_continue(index+6)
    momentum_trend_continue_7 = momentum_trend_continue(index+7)
    momentum_trend_continue_8 = momentum_trend_continue(index+8)
    momentum_trend_continue_9 = momentum_trend_continue(index+9)
    momentum_trend_continue_10 = momentum_trend_continue(index+10)

    momentum_happend_before = momentum_trend_continue_0
     or momentum_trend_continue_1
     or momentum_trend_continue_2
     or momentum_trend_continue_3
     or momentum_trend_continue_4
     or momentum_trend_continue_5
     or momentum_trend_continue_6
     or momentum_trend_continue_7
     or momentum_trend_continue_8
     or momentum_trend_continue_9
     or momentum_trend_continue_10

    just_crossed_last_high
     and after_market_open
     and momentum_happend_before
     and is_positive

momentum_trend_continue = momentum_trend_continue(0)
just_crossed_last_high = just_crossed_last_high(0)
if just_crossed_last_high
    log.info("Get In!!")

plotshape(momentum_trend_continue, title="Trend Continue", color=color.green, display = display.pane, style = shape.arrowup, size = size.small, location = location.abovebar, text = "✅")
plotshape(just_crossed_last_high, title="Just crossed last high", color=color.green, display = display.pane, style = shape.arrowup, size = size.small, location = location.belowbar, text = "🆙")

alertcondition(just_crossed_last_high, title="Positive indication for long/short momentum", message="Positive indication for long/short momentum")
