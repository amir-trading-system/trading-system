    case_26 = _analyze_case(
     base_indication,
     array.from(
        current_bar_crossed_finally_highest_high,
        current_bar_is_the_first_one_to_cross_top,
        current_high_is_highest,
        current_session_has_at_least_one_red_bar,
        current_volume_is_strong_with_high_volume,
        milestones_are_valid,
        most_of_current_body_is_above_9_ema,
        move_is_still_strong_due_to_fibonacci_retracement,
        negative_bars_volume_is_going_down,
        no_bars_closed_under_vwap,
        no_more_than_2_retracements_until_now,
        volume_sum_is_positive
     ),
     "26")

    if case_26
        main_case := case_26

    // case_x = _analyze_case(
    //  base_indication,
    //  array.from(true),
    //  "x")

    // if case_x
    //     main_case := case_x

    // case_x = _analyze_case(
    //  base_indication,
    //  array.from(true),
    //  "x")

    // if case_x
    //     main_case := case_x

// all_bars_are_positive_with_own_retracement
// current_bar_crossed_finally_highest_high
// current_bar_has_histogram_wave
// current_bar_is_highest_and_full
// current_bar_is_the_first_one_to_cross_top
// current_bar_is_top_and_after_own_retracement
// current_high_is_highest
// current_session_has_at_least_one_red_bar
// current_volume_is_strong_with_high_volume
// first_retracement_came_too_late
// has_classic_bars_wave
// histogram_changed_direction
// histogram_is_positive_until_now
// histogram_mostly_positive_except_small_retracement
// histogram_top_appears_less_than_twice
// milestones_are_valid
// most_of_bars_are_volatile
// most_of_current_body_is_above_9_ema
// most_of_volume_are_stuck_between_top_index_to_current
// most_session_is_before_top_index
// move_is_still_strong_due_to_fibonacci_retracement
// negative_bars_are_weak
// negative_bars_volume_is_going_down
// no_bars_closed_under_vwap
// no_more_than_2_retracements_until_now
// not big_retracement_between_top_to_start
// not too_many_tops_with_rejections_in_range_of_current_bar
// retracement_is_strong_but_graph_still_good
// retracement_should_be_long_enough
// starting_index_is_not_the_biggest_bar_in_term_of_price
// starting_index_is_not_the_biggest_bar_in_term_of_volume
// volume_sum_is_positive

    ////////////       HALTED CASE       ////////////
    made_more_than_usual_percentage_already = _made_more_than_usual_percentage_already(index, 0.1)
    movement_is_after_market_start = hour[index] >= 9 and hour[index] < 16
    _most_of_current_body_is_above_9_ema = _most_of_current_body_is_above_9_ema(index, true)
    current_bar_is_halted = _current_bar_is_halted(index)
    if starting_index == 0
        top_index := top_index_if_no_started_index
    has_retracement_from_top_index = _has_retracement_from_top_index(index, top_index)
    just_crossed_top_index = true
     and low[index] < high[top_index]
     and high[top_index]/high[index] < 0.95

    halted_case = true
     and made_more_than_usual_percentage_already
     and movement_is_after_market_start
     and _most_of_current_body_is_above_9_ema
     and current_bar_is_halted
     and histogram[index] > 0

    case_name = "HALTED - **NO TOP**"

    if top_index != 0
        halted_case := halted_case
         and top_index > 0
         and just_crossed_top_index

        case_name := "HALTED"

    if halted_case
        array.push(winning_cases, case_name)
        main_case := halted_case

    [main_case, fibonacci_retracement, starting_index, top_index, top_histogram_index, lowest_point_from_top_point_index, attempts_indexes, retracement_indexes, volume_percentage_from_top, bars_percentage_from_top, tops_with_rejection_indexes, highest_high, is_base_indication_full]

[main_case, fibonacci_retracement, starting_index, top_index, top_histogram_index, lowest_point_from_top_point_index, attempts_indexes, retracement_indexes, volume_percentage_from_top, bars_percentage_from_top, tops_with_rejection_indexes, highest_high, is_base_indication_full] = cases(0)

if main_case
    if high[0] > highest_high
        highest_high := high[0]
    joined_winning_cases_str = str.format("✅ - Exit on {0}", close[0] * 1.15)
    cases_under_1_counter = 0
    complete_cases = array.new_string()
    partial_cases = array.new_string()
    for case in winning_cases
        str_case = str.replace(case, "case ", "")
        if str.endswith(case, "- 1") or str.startswith(case, "HALTED")
            joined_winning_cases_str += str.format("\n{0}", str_case)
            array.push(complete_cases, case)
            log.info("{0}. starting_index: {1}. top_index: {2}.", case, starting_index, top_index)
        else
            array.push(partial_cases, case)
            cases_under_1_counter += 1

    if cases_under_1_counter > 0
        joined_winning_cases_str += str.format("\n+{0} high prob cases", cases_under_1_counter)

    if not is_base_indication_full
        joined_winning_cases_str += "\nBase except one"

    confirmation_label = label.new(bar_index, highest_high, text = joined_winning_cases_str, size = size.small, style = label.style_label_lower_right, force_overlay = true)
    label.set_tooltip(confirmation_label, str.format("complete_cases: {0}. partial_cases: {1}. starting_index: {2}. top_index: {3}. fibonacci_retracement: {4}. lowest_point_from_top_point_index: {5}. top_histogram_index: {6}. attempts_indexes: {7}. retracement_indexes: {8}. volume_percentage_from_top: {9}. bars_percentage_from_top: {10}. tops_with_rejection_indexes: {11}.", complete_cases, partial_cases, starting_index, top_index, fibonacci_retracement, lowest_point_from_top_point_index, top_histogram_index, attempts_indexes, retracement_indexes, volume_percentage_from_top, bars_percentage_from_top, tops_with_rejection_indexes))

plotshape(main_case, title="winning case", color=color.green, display = display.pane, style = shape.arrowup, size = size.small, location = location.belowbar, text = "💰", force_overlay = true)

plot(fibonacci_retracement, "fibonacci_retracement", display = display.status_line)
plot(starting_index, "starting_index", display = display.status_line)
plot(top_index, "top_index", display = display.status_line)

alertcondition(main_case, title="Positive indication for long/short momentum", message="Positive indication for long/short momentum")
