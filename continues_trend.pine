indicator(title="Continues Trend", overlay = true, max_bars_back = 5000)
import TradingView/ta/10

//@version=6

relevant_timezone = "America/New_York"

ema_9 = ta.ema(close, 9)
ema_20 = ta.ema(close, 20)
vwap = ta.vwap(hlc3)
vol_avg = ta.sma(volume, 20)
ema_200_days = request.security(syminfo.tickerid, "D", ema_9, lookahead = barmerge.lookahead_on)
yesterday_close = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_on)
current_timeframe = str.tonumber(timeframe.period)

///          Buyers Coming In Indication          ///

_get_trend_started_bar_index(index) =>
    [macd, signal_line, histogram] = ta.macd(close, 12, 26, 9)
    trend_started_bar_index = 0

    for i = index+49 to index+1
        before_7_am = hour[i] < 7
        volume_is_low = volume[i] < 5000
        histogram_is_negative = histogram[i] < 0
        high_before_is_higher = high[i+1] >= high[i]

        if before_7_am
         or volume_is_low
         or high_before_is_higher
            continue

        if i-1 < 0
            continue
        if low[i-1] < low[i]
            continue

        current_bar_is_weak = false
        volume_avg_has_been_changed = true
        highest_since_now = 0.0
        highest_since_now_index = 0

        for j = i+10 to i+1
            price_is_higher = high[j] - low[j] > high[i] - low[i] and high[i] < high[j]
            volume_is_higher = volume[j] > vol_avg[j] and volume[j] > volume[i]
            if price_is_higher or volume_is_higher
                current_bar_is_weak := true
            if high[j] > highest_since_now
                highest_since_now := high[j]
                highest_since_now_index := j
            if i-1 < 0
                continue
            if vol_avg[j] * 2 > vol_avg[i-1] and j - 2 > i or vol_avg[i-1] < 8000
                volume_avg_has_been_changed := false

        lowest_since_now = highest_since_now
        for j = highest_since_now_index-1 to i+1
            if j < 0
                continue
            if low[j] < lowest_since_now
                lowest_since_now := low[j]

        if current_bar_is_weak
         or not volume_avg_has_been_changed
            continue

        if dayofmonth[i] != dayofmonth[index]
            continue

        crossed_vwap_upwards = low[i] < vwap[i]
         and close[i] > vwap[i]
         and vwap[i] > ema_9[i]

        bar_is_strong = (close[i] - open[i])/(high[i] - low[i]) >= 0.4
        if i-1 > 0 and not bar_is_strong
            bar_is_strong := (close[i-1] - open[i-1])/(high[i-1] - low[i-1]) >= 0.4
        bar_is_positive = close[i] > open[i]
        bar_is_volatile = volume[i] > vol_avg[i] and volume[i] > volume[i+1] and vol_avg[i] > vol_avg[i+1]
        bar_value_is_volatile = (high[i]-low[i]) > (high[i+1]-low[i+1]) * 2 or (close[i] - open[i]) > (close[i+1] - open[i+1])

        if crossed_vwap_upwards
         and bar_is_positive
         and bar_is_volatile
         and bar_value_is_volatile
         and bar_is_strong
            trend_started_bar_index := i
            break

    trend_started_bar_index

_ema_change_is_highest_on_current_bar(index, trend_started_bar_index) =>
    bar_ema_9_sum = 0.0
    for i = trend_started_bar_index-1 to index
        if i < 0
            continue
        bar_ema_9_sum += ema_9[i] - ema_9[i+1]

    bar_ema_9_avg = bar_ema_9_sum/trend_started_bar_index
    bar_ema_change_is_highest = ema_9[index] - ema_9[index+1] > bar_ema_9_avg
    current_bar_closes_to_9_ema = true
    current_bar_closes_to_9_ema_than_bar_before = true
    if low[index] > ema_9[index]
        distance_lower_than_last_bar = true
        if close[index+1] != open[index+1]
            distance_lower_than_last_bar := low[index] - ema_9[index] < math.abs(high[index+1] - low[index+1])
        current_bar_closes_to_9_ema := (low[index] - ema_9[index])/ema_9[index] <= 0.05 and distance_lower_than_last_bar
        current_bar_closes_to_9_ema_than_bar_before := (low[index] - ema_9[index])/ema_9[index] < (low[index+1] - ema_9[index+1])/ema_9[index+1]

    result = bar_ema_change_is_highest and current_bar_closes_to_9_ema
    if high[index+1] > high[index+2]
        result := result and current_bar_closes_to_9_ema_than_bar_before

    result

_bar_is_strong(index) =>
    there_are_buyers_at_the_bottom = (open[index] - low[index])/(high[index]-low[index]) < 0.5
    bar_closes_with_buyers = (close[index] - open[index])/(high[index]-low[index]) >= 0.5
    bar_higher_than_bar_before = high[index] > high[index+1]
    bar_stronger_than_bar_before = volume[index] > volume[index+1] and volume[index] > volume[index+2]
    most_of_bar_is_above_vwap = (vwap[index] - low[index])/(high[index] - low[index]) < 0.5
    // if time == timestamp(relevant_timezone, year, 7, 28, 10, 56) and timeframe.period == "2"
    //     log.info("most_of_bar_is_above_vwap: {0}", (vwap[index] - low[index])/(high[index] - low[index]))

    next_timeframe_current_bar_closes_to_9_ema = true
    if current_timeframe == 1 or current_timeframe == 2
        [n_ema_9, n_low, n_open, n_close, n_high] = request.security(syminfo.tickerid, "5", [ema_9, low, open, close, high], lookahead = barmerge.lookahead_on)
        if n_low[index] > n_ema_9[index]
            next_timeframe_distance_lower_than_last_bar = true
            if n_close[index+1] != n_open[index+1]
                next_timeframe_distance_lower_than_last_bar := n_low[index] - n_ema_9[index] < math.abs(n_high[index+1] - n_low[index+1])
            next_timeframe_current_bar_closes_to_9_ema := (low[index] - n_ema_9[index])/n_ema_9[index] <= 0.05 and next_timeframe_distance_lower_than_last_bar
            // if time == timestamp(relevant_timezone, year, 3, 17, 10, 20) and timeframe.period == "1"
            //     log.info("distance: {0}", (low[index] - n_ema_9[index])/n_ema_9[index])

    there_are_buyers_at_the_bottom
     and bar_closes_with_buyers
     and bar_higher_than_bar_before
     and bar_stronger_than_bar_before
     and next_timeframe_current_bar_closes_to_9_ema
     and most_of_bar_is_above_vwap

_current_volume_is_highest(index, trend_started_bar_index) =>
    start_index = trend_started_bar_index
    if trend_started_bar_index > 10
        if current_timeframe == 1 or current_timeframe == 2
            start_index := 10
        if current_timeframe >= 5
            start_index := 5

    volume_is_highest = true
    for i = start_index to index+1
        if (vol_avg[i] > vol_avg[index] and volume[i] > volume[index])
         or vol_avg[index] > volume[index]
         or (vol_avg[index+1]/vol_avg[index] > 0.95 and volume[index+1] > vol_avg[index+1])
            volume_is_highest := false

    volume_is_highest

_more_buyers_than_sellers(index, trend_started_bar_index) =>
    buyers_bars_sum = 0.0
    sellers_bars_sum = 0.0

    for i = trend_started_bar_index to index
        if close[i] > open[i]
            buyers_bars_sum += volume[i]
        else
            sellers_bars_sum += volume[i]

    there_are_more_buyers_than_sellers = buyers_bars_sum > sellers_bars_sum
    // if time == timestamp(relevant_timezone, year, 7, 28, 13, 15) and timeframe.period == "15"
    //     log.info("buyers_bars_sum: {0}. sellers_bars_sum: {1}", buyers_bars_sum, sellers_bars_sum)

    there_are_more_buyers_than_sellers

_biggest_bar_is_positive(index, trend_started_bar_index) =>
    biggest_bar_value = 0.0
    biggest_bar_index = 0

    for i = trend_started_bar_index to index
        if biggest_bar_value < high[i] - low[i]
            biggest_bar_value := high[i] - low[i]
            biggest_bar_index := i

    result = close[biggest_bar_index] > open[biggest_bar_index]
     or (close[biggest_bar_index] < open[biggest_bar_index] and (open[biggest_bar_index]-close[biggest_bar_index])/(high[biggest_bar_index]-low[biggest_bar_index]) < 0.5)

    result

_at_least_one_red_bar_until_now(index, trend_started_bar_index) =>
    is_there_red_bar = false
    for i = trend_started_bar_index-1 to index+1
        if i < 0
            continue
        if close[i] < open[i]
            is_there_red_bar := true

    is_there_red_bar

_bar_before_is_not_strong(index) =>
    math.abs(close[index+1] - open[index+1])/(close[index]-open[index]) <= 0.5 and volume[index+1] < volume[index]
     or math.abs(close[index+2] - open[index+2])/(close[index]-open[index]) <= 0.5 and volume[index+2] < volume[index] and volume[index] > volume[index+1]

_fixed_less_than_half_from_trend_start(index, trend_started_bar_index) =>
    fixed_less_than_half_from_trend_start = true
    allowed_distance_to_fix = (high[trend_started_bar_index] - low[trend_started_bar_index])/2
    for i = trend_started_bar_index-1 to index
        if i < 0
            continue

        green_bar_fixed_more_than_allowed = close[i] > open[i] and open[i] < (high[trend_started_bar_index] - allowed_distance_to_fix)
        red_bar_fixed_more_than_allowed = close[i] < open[i] and close[i] < (high[trend_started_bar_index] - allowed_distance_to_fix)
        if green_bar_fixed_more_than_allowed or red_bar_fixed_more_than_allowed
            fixed_less_than_half_from_trend_start := false
            break

    fixed_less_than_half_from_trend_start

_is_red_bar(index) =>
    close[index] < open[index]

_red_bar_starting_to_get_weak(index, trend_started_bar_index) =>
    red_bar_starting_to_get_weak = true
    for i = index+5 to index+1
        if i > trend_started_bar_index
            continue
        is_red_bar = _is_red_bar(i)
        pervious_is_red_bar = _is_red_bar(i+1)
        if is_red_bar and pervious_is_red_bar
            if volume[i] > volume[i+1] and high[i] > high[i+1]
                red_bar_starting_to_get_weak := false
            break

    red_bar_starting_to_get_weak

buyers_coming_in_indication(index) =>
    bar_is_strong = _bar_is_strong(index)
    trend_started_bar_index = _get_trend_started_bar_index(index)
    moved_already_at_least_20_percent_since_yesterday = (close[index] - yesterday_close)/close[index] >= 0.2
    ema_change_is_highest_on_current_bar = _ema_change_is_highest_on_current_bar(index, trend_started_bar_index)
    more_buyers_than_sellers = _more_buyers_than_sellers(index, trend_started_bar_index)
    biggest_bar_is_positive = _biggest_bar_is_positive(index, trend_started_bar_index)
    at_least_one_red_bar_until_now = _at_least_one_red_bar_until_now(index, trend_started_bar_index)
    bar_before_is_not_strong = _bar_before_is_not_strong(index)
    current_volume_is_highest = _current_volume_is_highest(index, trend_started_bar_index)
    fixed_less_than_half_from_trend_start = _fixed_less_than_half_from_trend_start(index, trend_started_bar_index)
    red_bar_starting_to_get_weak = _red_bar_starting_to_get_weak(index, trend_started_bar_index)

    red_before_is_weak = true
    bar_before_is_red = close[index+1] < open[index+1]
    bar_before_that_is_green = close[index+2] > open[index+2]
    if bar_before_is_red and bar_before_that_is_green
        red_before_is_weak := (open[index+1] - close[index+1])/(close[index+2]-open[index+2]) <= 0.5

    current_price_action_stronger_than_bar_before = close[index] - open[index] > (close[index+1] - open[index+1]) * 1.5
    price_is_volatile = high[index] - low[index] > 0.05 and current_price_action_stronger_than_bar_before
    distance_from_trend_start = 240
    minimum_volume = 20000
    if current_timeframe == 2
        distance_from_trend_start := 120
        minimum_volume := 40000
    if current_timeframe == 5
        distance_from_trend_start := 48
        minimum_volume := 100000
    if current_timeframe == 15
        distance_from_trend_start := 16
        minimum_volume := 300000

    result = bar_is_strong
     and moved_already_at_least_20_percent_since_yesterday
     and trend_started_bar_index >= 2
     and trend_started_bar_index - index <= distance_from_trend_start
     and ema_change_is_highest_on_current_bar
     and red_before_is_weak
     and price_is_volatile
     and more_buyers_than_sellers
     and close[index] > 1
     and biggest_bar_is_positive
     and at_least_one_red_bar_until_now
     and bar_before_is_not_strong
     and current_volume_is_highest
     and high[index] > high[trend_started_bar_index]
     and fixed_less_than_half_from_trend_start
     and volume[index] > minimum_volume
     and red_bar_starting_to_get_weak

    if result
        log.info("Buyers Coming In!. start_index: {0}", trend_started_bar_index)
        l = label.new(x=bar_index-trend_started_bar_index, y=high, textcolor = color.yellow, size = size.small, style = label.style_label_down)
        label.set_text(id=l, text=str.format("s: {0}.", trend_started_bar_index))

    result

ema_support_near_start_of_trend(index) =>
    result = false
    after_market_open = (hour[0] == 9 and minute[0] >= 30) or hour[0] > 9
    on_higher_timeframes_only = current_timeframe >= 5
    trend_started_bar_index = _get_trend_started_bar_index(index)

    if after_market_open and on_higher_timeframes_only
        has_trend = trend_started_bar_index > 0
        bar_is_positive = close[index] > open[index]
        bar_has_more_volume = volume[index] > vol_avg[index] and volume[index]/volume[index+1] >= 0.8
        bar_continues_last_bar = open[index] == close[index+1] or math.abs(close[index+1] - open[index])/(close[index+1] - open[index+1]) < 0.10
        above_ema = close[index] > ema_9[index]
        above_vwap = close[index] > vwap[index]
        low_under_vwap = low[index] <= vwap[index]

        whole_bar_value = high[index] - low[index]
        lower_bar_value = open[index] - low[index]
        bar_body_value = close[index] - open[index]
        bar_fix_value = lower_bar_value/whole_bar_value
        upper_bar_value = high[index] - close[index]
        previous_bar_value = high[index+1] - low[index+1]
        bar_continues_strong_bar = high[index+1] == close[index+1] or (high[index+1] - close[index+1])/(high[index+1]-low[index+1]) < 0.1
        current_bar_is_strong = bar_body_value/whole_bar_value >= 0.3

        bar_made_good_fix = true
         and lower_bar_value/whole_bar_value <= 0.75
         and lower_bar_value/whole_bar_value >= 0.2
         and lower_bar_value < previous_bar_value
         and bar_continues_strong_bar
         and current_bar_is_strong

        has_at_least_one_negative_bar_before = false
        for i = trend_started_bar_index to index+1
            if close[i] < open[i]
                has_at_least_one_negative_bar_before := true

        // if time == timestamp(relevant_timezone, year, 4, 4, 12, 5) and timeframe.period == "5"
        //     log.info("trend_started_bar_index: {0}", trend_started_bar_index)

        result := has_trend
         and bar_is_positive
         and bar_has_more_volume
         and bar_continues_last_bar
         and bar_made_good_fix
         and above_ema
         and above_vwap
         and after_market_open
         and on_higher_timeframes_only

        if not has_at_least_one_negative_bar_before
            result := result
             and low_under_vwap

    if result
        log.info("Ema support! trend_started_bar_index: {0}", trend_started_bar_index)
        l = label.new(x=bar_index-trend_started_bar_index, y=high, textcolor = color.yellow, size = size.small, style = label.style_label_down)
        label.set_text(id=l, text=str.format("s: {0}.", trend_started_bar_index))

    result

///          Indications          ///
buyers_coming_in_indication = buyers_coming_in_indication(0)
ema_support_near_start_of_trend = ema_support_near_start_of_trend(0)

plotshape(buyers_coming_in_indication, title="Buyers Coming In", color=color.green, display = display.pane, style = shape.arrowup, size = size.small, location = location.abovebar, text = "🛫")
plotshape(ema_support_near_start_of_trend, title="Ema Support", color=color.green, display = display.pane, style = shape.arrowup, size = size.small, location = location.belowbar, text = "📈")

alertcondition(buyers_coming_in_indication or ema_support_near_start_of_trend, title="Positive indication for long/short momentum", message="Positive indication for long/short momentum")
