indicator(title="Continues Trend", overlay = true, max_bars_back = 5000)
import TradingView/ta/10

//@version=6

relevant_timezone = "America/New_York"

ema_9 = ta.ema(close, 9)
ema_20 = ta.ema(close, 20)
vwap = ta.vwap(hlc3)
vol_avg = ta.sma(volume, 20)
ema_200_days = request.security(syminfo.tickerid, "D", ema_9, lookahead = barmerge.lookahead_on)
yesterday_close = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_on)
current_timeframe = str.tonumber(timeframe.period)

///          Buyers Coming In Indication          ///

_get_trend_started_bar_index(index) =>
    [macd, signal_line, histogram] = ta.macd(close, 12, 26, 9)
    trend_started_bar_index = 0

    for i = index+49 to index+1
        before_7_am = hour[i] < 7
        volume_is_low = volume[i] < 5000
        histogram_is_negative = histogram[i] < 0
        high_before_is_higher = high[i+1] >= high[i]

        if before_7_am
         or volume_is_low
         or high_before_is_higher
            continue

        if i-1 < 0
            continue
        if low[i-1] < low[i]
            continue

        current_bar_is_weak = false
        volume_avg_has_been_changed = true
        highest_since_now = 0.0
        highest_since_now_index = 0

        for j = i+10 to i+1
            price_is_higher = high[j] - low[j] > high[i] - low[i] and high[i] < high[j]
            volume_is_higher = volume[j] > vol_avg[j] and volume[j] > volume[i]
            if price_is_higher or volume_is_higher
                current_bar_is_weak := true
            if high[j] > highest_since_now
                highest_since_now := high[j]
                highest_since_now_index := j
            if i-1 < 0
                continue
            if vol_avg[j] * 2 > vol_avg[i-1] and j - 2 > i or vol_avg[i-1] < 8000
                volume_avg_has_been_changed := false

        lowest_since_now = highest_since_now
        for j = highest_since_now_index-1 to i+1
            if j < 0
                continue
            if low[j] < lowest_since_now
                lowest_since_now := low[j]

        if current_bar_is_weak
         or not volume_avg_has_been_changed
            continue

        if dayofmonth[i] != dayofmonth[index]
            continue

        crossed_vwap_upwards = low[i] < vwap[i]
         and close[i] > vwap[i]
         and vwap[i] > ema_9[i]

        bar_is_strong = (close[i] - open[i])/(high[i] - low[i]) >= 0.4
        if i-1 > 0 and not bar_is_strong
            bar_is_strong := (close[i-1] - open[i-1])/(high[i-1] - low[i-1]) >= 0.4
        bar_is_positive = close[i] > open[i]
        bar_is_volatile = volume[i] > vol_avg[i] and volume[i] > volume[i+1] and vol_avg[i] > vol_avg[i+1]
        bar_value_is_volatile = (high[i]-low[i]) > (high[i+1]-low[i+1]) * 2 or (close[i] - open[i]) > (close[i+1] - open[i+1])


        if (crossed_vwap_upwards or volume[i] > volume[i+1] * 20)
         and bar_is_positive
         and bar_is_volatile
         and bar_value_is_volatile
         and bar_is_strong
            trend_started_bar_index := i
            break

    trend_started_bar_index

_ema_change_is_highest_on_current_bar(index, trend_started_bar_index) =>
    bar_ema_9_sum = 0.0
    for i = trend_started_bar_index-1 to index
        if i < 0
            continue
        bar_ema_9_sum += ema_9[i] - ema_9[i+1]

    bar_ema_9_avg = bar_ema_9_sum/trend_started_bar_index
    bar_ema_change_is_highest = ema_9[index] - ema_9[index+1] > bar_ema_9_avg
    current_bar_closes_to_9_ema = true
    current_bar_closes_to_9_ema_than_bar_before = true
    if low[index] > ema_9[index]
        distance_lower_than_last_bar = true
        if close[index+1] != open[index+1]
            distance_lower_than_last_bar := low[index] - ema_9[index] < math.abs(high[index+1] - low[index+1])
        current_bar_closes_to_9_ema := (low[index] - ema_9[index])/ema_9[index] <= 0.05 and distance_lower_than_last_bar
        current_bar_closes_to_9_ema_than_bar_before := (low[index] - ema_9[index])/ema_9[index] < (low[index+1] - ema_9[index+1])/ema_9[index+1]

    result = bar_ema_change_is_highest and current_bar_closes_to_9_ema
    if high[index+1] > high[index+2]
        result := result and current_bar_closes_to_9_ema_than_bar_before

    result

_more_buyers_than_sellers(index, trend_started_bar_index) =>
    buyers_bars_sum = 0.0
    sellers_bars_sum = 0.0

    for i = trend_started_bar_index to index
        if close[i] > open[i]
            buyers_bars_sum += volume[i]
        else
            sellers_bars_sum += volume[i]

    buyers_bars_sum > sellers_bars_sum

_current_bar_has_decent_amount_of_volume(index, trend_started_bar_index) =>
    current_bar_has_decent_amount_of_volume = false
    if trend_started_bar_index > 0
        highest_value = 0.0
        for i = trend_started_bar_index to index+1
            if high[i] > highest_value
                highest_value := high[i]
        current_bar_has_decent_amount_of_volume := volume[index]/highest_value >= 0.6

    current_bar_has_decent_amount_of_volume

ema_support_near_start_of_trend_indication(index) =>
    result = false
    after_market_open = hour >= 8 and hour <= 13
    on_higher_timeframes_only = current_timeframe >= 5
    trend_started_bar_index = _get_trend_started_bar_index(index)
    current_bar_has_decent_amount_of_volume = _current_bar_has_decent_amount_of_volume(index, trend_started_bar_index)

    if after_market_open and on_higher_timeframes_only
        has_trend = trend_started_bar_index > 0
        bar_is_positive = close[index] > open[index]
        bar_has_more_volume = volume[index] > vol_avg[index] and volume[index]/volume[index+1] >= 0.8
        bar_continues_last_bar = open[index] == close[index+1] or math.abs(close[index+1] - open[index])/(close[index+1] - open[index+1]) < 0.10
        above_ema = close[index] > ema_9[index]
        above_vwap = close[index] > vwap[index]
        low_under_vwap = low[index] <= vwap[index]
        current_tail_is_higher_than_previous_open = low[index] > open[index+1]
        current_bar_is_strong_at_least_the_previous = (close[index] - open[index])/(close[index+1]-open[index+1]) >= 0.7

        current_bar_value = high[index] - low[index]
        previous_bar_value = high[index+1] - low[index+1]
        previous_upper_bar_value = high[index+1] - close[index+1]
        lower_bar_value = open[index] - low[index]
        bar_body_value = close[index] - open[index]
        bar_fix_value = lower_bar_value/current_bar_value
        upper_bar_value = high[index] - close[index]
        bar_continues_strong_bar = high[index+1] == close[index+1] or (high[index+1] - close[index+1])/(high[index+1]-low[index+1]) < 0.4 or close[index+1] >= high[index+2]
        current_bar_is_strong = (bar_body_value/current_bar_value >= 0.3 and high[index] > close[index]) or bar_body_value/current_bar_value >= 0.5
        bars_values_are_similar = current_bar_value/previous_bar_value >= 0.6 and previous_bar_value/current_bar_value >= 0.6

        bar_made_good_fix = true
         and lower_bar_value/current_bar_value <= 0.75
         and (lower_bar_value/current_bar_value >= 0.2 or (previous_upper_bar_value/previous_bar_value <= 0.6 and upper_bar_value/current_bar_value <= 0.2))
         and lower_bar_value < previous_bar_value
         and bar_continues_strong_bar
         and current_bar_is_strong

        has_at_least_one_negative_bar_before = false
        for i = trend_started_bar_index to index+1
            if close[i] < open[i] and trend_started_bar_index - i >= i - index
                has_at_least_one_negative_bar_before := true

        highest_high = 0.0
        for i = trend_started_bar_index to index+1
            if high[i] > highest_high
                highest_high := high[i]

        current_bar_is_highest = high[index] > highest_high

        // if time == timestamp(relevant_timezone, year, 7, 22, 9, 45) and timeframe.period == "5"
        //     log.info("trend_started_bar_index: {0}", trend_started_bar_index)

        result := has_trend
         and bar_is_positive
         and bar_has_more_volume
         and bar_continues_last_bar
         and bar_made_good_fix
         and above_ema
         and above_vwap
         and current_bar_is_highest
         and current_tail_is_higher_than_previous_open
         and current_bar_has_decent_amount_of_volume
         and close[index] > 1
         and current_bar_is_strong_at_least_the_previous

        if not has_at_least_one_negative_bar_before
            result := result
             and low_under_vwap

    if result
        log.info("Ema support! trend_started_bar_index: {0}", trend_started_bar_index)
        l = label.new(x=bar_index-trend_started_bar_index-1, y=high[index+1], textcolor = color.yellow, size = size.small, style = label.style_label_lower_right)
        label.set_text(id=l, text=str.format("s: {0}.", trend_started_bar_index))

    result

full_bar_continues_indication(index) =>
    result = false
    after_market_open = hour >= 8 and hour <= 13
    on_higher_timeframes_only = current_timeframe >= 5
    trend_started_bar_index = _get_trend_started_bar_index(index)
    current_bar_has_decent_amount_of_volume = _current_bar_has_decent_amount_of_volume(index, trend_started_bar_index)

    if after_market_open and on_higher_timeframes_only
        has_trend = trend_started_bar_index > 0
        bars_are_positive = close[index] > open[index] and close[index+1] > open[index+1]
        bars_are_full = (close[index] - open[index])/(close[index]-low[index]) >= 0.7 and (close[index+1] - open[index+1])/(close[index+1]-open[index+1]) >= 0.7
        bars_closes_strong = high[index] - close[index] < close[index] - open[index] and high[index+1] - close[index+1] < close[index+1] - open[index+1]
        bar_has_more_volume = volume[index] > vol_avg[index] and volume[index]/volume[index+1] >= 0.8
        bar_continues_last_bar = open[index] >= close[index+1] or math.abs(close[index+1] - open[index])/(close[index+1] - open[index+1]) < 0.10
        above_ema = close[index] > ema_9[index] and close[index+1] > ema_9[index+1]
        above_vwap = close[index] > vwap[index] and close[index+1] > vwap[index+1]
        low_under_vwap = low[index] <= vwap[index] and low[index+1] <= vwap[index+1]
        bar_starts_strong = (open[index] - low[index])/(high[index]-low[index]) < 0.10
        current_tail_is_higher_than_previous_open = low[index] > open[index+1]
        current_bar_is_strong_at_least_the_previous = (high[index] - open[index])/(high[index+1]-open[index+1]) >= 0.7

        current_bar_value = high[index] - low[index]
        previous_bar_value = high[index+1] - low[index+1]

        bars_much_bigger_than_before = true
        current_bar_full_size = high[index] - low[index]
        previous_bar_full_size = high[index+1] - low[index+1]
        for i = trend_started_bar_index+10 to trend_started_bar_index+1
            bar_size = high[i] - low[i]
            if current_bar_full_size/2 < bar_size
                bars_much_bigger_than_before := false
                break

        result := has_trend
         and bars_are_positive
         and bar_has_more_volume
         and bar_continues_last_bar
         and above_ema
         and above_vwap
         and low_under_vwap
         and bar_starts_strong
         and bars_much_bigger_than_before
         and bars_are_full
         and bars_closes_strong
         and current_tail_is_higher_than_previous_open
         and current_bar_has_decent_amount_of_volume
         and close[index] > 1
         and current_bar_is_strong_at_least_the_previous

    if result
        log.info("Full Bar Continues! trend_started_bar_index: {0}", trend_started_bar_index)
        l = label.new(x=bar_index-trend_started_bar_index-1, y=high[index+1], textcolor = color.yellow, size = size.small, style = label.style_label_lower_right)
        label.set_text(id=l, text=str.format("s: {0}.", trend_started_bar_index))

    result

///          Indications          ///
ema_support_near_start_of_trend_indication = ema_support_near_start_of_trend_indication(0)
full_bar_continues_indication = full_bar_continues_indication(0)

plotshape(ema_support_near_start_of_trend_indication, title="Ema Support", color=color.green, display = display.pane, style = shape.arrowup, size = size.small, location = location.belowbar, text = "📈")
plotshape(full_bar_continues_indication, title="Full bar Continues", color=color.green, display = display.pane, style = shape.arrowup, size = size.small, location = location.abovebar, text = "📊")

alertcondition(ema_support_near_start_of_trend_indication or full_bar_continues_indication, title="Positive indication for long/short momentum", message="Positive indication for long/short momentum")
