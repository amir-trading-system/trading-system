     maxval = 100,
     group = GROUP_PROFILE,
     display = display.none,
     tooltip = "30 rows reproduces the resolution used for the initial AKAN study.")

float valueAreaPercent = input.float(
     70.0,
     "Value area volume (%)",
     minval = 50.0,
     maxval = 95.0,
     step = 1.0,
     group = GROUP_PROFILE,
     display = display.none)

float valMinimumLowerWickToBody = input.float(
     0.25,
     "VAL defense minimum lower wick / body",
