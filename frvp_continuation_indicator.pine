     minval = 0.00,
     maxval = 1.00,
     step = 0.05,
     group = GROUP_POC,
     display = display.none,
     tooltip = "0.25 requires the lower wick to occupy at least 25% of the candle's high-low range. Wick is open-low on positive candles and close-low on negative candles.")

float pocDefenseCloseBufferATR = input.float(
     0.00,
     "POC defense close-above buffer (ATR)",
     minval = 0.00,
     step = 0.05,
