     "Carry dominant after-hours FRVP (trading dates)",
     minval = 0,
     maxval = 3,
     group = GROUP_VAL,
     display = display.none,
     tooltip = "One transition carries Friday after-hours value into Monday. Premarket and regular-session profiles reset at a new trading date.")

float dominantVALFrontRunATR = input.float(
