     minval = 1,
     maxval = 5,
     group = GROUP_VAL,
     display = display.none)

float pocMinimumPenetrationATR = input.float(
     0.00,
     "POC attempt minimum penetration (ATR)",
     minval = 0.00,
     step = 0.05,
     group = GROUP_POC,
     display = display.none)

float pocFailedCloseBandATR = input.float(
     0.15,
     "POC rejection maximum close above POC (ATR)",
     minval = 0.00,
     step = 0.05,
     group = GROUP_POC,
     display = display.none,
     tooltip = "Allows a rejection candle to finish slightly above POC when it clearly moved downward from its high.")

float pocMinimumDownwardRejectionATR = input.float(
     0.10,
     "Minimum downward rejection from high (ATR)",
     minval = 0.00,
     step = 0.05,
