     minval = 1,
     maxval = 30,
     group = GROUP_POC,
     display = display.none)

float pocAttemptLabelDistanceATR = input.float(
     0.50,
     "POC fail label distance above bar (ATR)",
     minval = 0.00,
     maxval = 5.00,
     step = 0.05,
     group = GROUP_POC,
