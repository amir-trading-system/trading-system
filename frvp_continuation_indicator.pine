float breakoutVAHBufferATR = input.float(
     0.03,
     "Close above VAH buffer (ATR)",
     minval = 0.00,
     step = 0.01,
     group = GROUP_BREAKOUT,
     display = display.none)

float breakoutBodyATR = input.float(
     0.80,
     "Minimum bullish body (ATR)",
     minval = 0.10,
     step = 0.05,
     group = GROUP_BREAKOUT,
     display = display.none)

float breakoutCloseLocation = input.float(
     0.75,
     "Minimum close location",
     minval = 0.50,
     maxval = 1.00,
     step = 0.05,
     group = GROUP_BREAKOUT,
     display = display.none)

float breakoutRelativeVolume = input.float(
     1.80,
     "Minimum breakout relative volume",
     minval = 1.00,
     step = 0.05,
     group = GROUP_BREAKOUT,
     display = display.none)

int breakoutHoldBars = input.int(
     2,
     "Bars required to hold after breakout",
     minval = 0,
     maxval = 10,
     group = GROUP_BREAKOUT,
     display = display.none,
     tooltip = "The arrow is placed on the breakout candle after this many later bars avoid a close back below POC.")

float breakoutFailureBelowPOCATR = input.float(
     0.05,
     "Hold failure below POC (ATR)",
     minval = 0.00,
     step = 0.05,
     group = GROUP_BREAKOUT,
     display = display.none)

bool showMovementBox = input.bool(
     true,
     "Shade frozen movement",
     group = GROUP_DISPLAY,
     display = display.none)

bool showFrozenProfileLabel = input.bool(
     true,
