//------------------------------------------------------------------------------
// Additional frozen profiles
//------------------------------------------------------------------------------

// The original profile continues to use the long-established scalar lifecycle
// below. Later same-session profiles use this object so their support, failure,
// recovery, and entry states can be evaluated independently on every bar.
type AdditionalProfile
    int number = 0
    int dateKey = 0
    int sessionId = 0
    int movementStartTime = na
    int movementEndTime = na
    int readyBarIndex = na
    int lastVisibleTime = na
    float movementLow = na
    float movementHigh = na
    float val = na
    float poc = na
    float vah = na
    float freezeVWAP = na
    bool valDefended = false
    bool valEntryCandidateActive = false
    int valEntryCandidateBarIndex = na
    int valEntryCandidateTime = na
    float valEntryCandidateHigh = na
    float valEntryCandidateLow = na
    bool invalidated = false
    bool pocExtensionStopped = false
    bool invalidationMarked = false
    int closesBelowMovementLow = 0
    int recoveryStage = 0
    bool pocDefenseArmed = true
    int lastPOCDefenseBarIndex = na
    bool vahDefenseArmed = true
    int lastVAHDefenseBarIndex = na
    int failedPOCAttempts = 0
    int internalFailedPOCAttempts = 0
    int lastPOCAttemptBarIndex = na
    bool vahCandidateActive = false
    int vahCandidateBarIndex = na
    int vahCandidateTime = na
    float vahCandidateOpen = na
    float vahCandidateHigh = na
    float vahCandidateLow = na
    float vahCandidateClose = na
    float vahCandidateVolume = na
    float vahCandidateLowerWickShare = na
    bool breakoutPending = false
    bool breakoutConfirmed = false
    int breakoutBarIndex = na
    int breakoutTime = na
    float breakoutLow = na
    float breakoutHigh = na
    float breakoutATR = na
    string breakoutPath = ""
    line valLine = na
    line pocLine = na
    line vahLine = na
    box movementBox = na
    label entryLabel = na

type RetrospectiveProfileCandidate
    int dateKey = 0
    int sessionId = 0
    int startTime = na
    int endTime = na
    int startBarIndex = na
    int endBarIndex = na
    int expiryBarIndex = na
    float movementLow = na
    float movementHigh = na
    float val = na
    float poc = na
    float vah = na
    float cumulativeVolume = na
    bool pocTestActive = false
    int pocTestBarIndex = na
    int pocTestTime = na
    float pocTestLow = na

// Meaningful value areas have a separate lightweight lifecycle. The first
// meaningful profile is a foundation. Every later profile whose VAL is higher
// than an active lower VAL is stacked above that foundation and must prove a
// post-freeze departure to VAH before its own VAL becomes actionable.
type MeaningfulVALProfile
    int dateKey = 0
    int sessionId = 0
    int movementStartTime = na
    int movementEndTime = na
    int readyBarIndex = na
    int ageTradingDates = 0
    float movementLow = na
    float movementHigh = na
    float val = na
    float poc = na
    float vah = na
    float cumulativeVolume = na
    float score = na
    bool invalidated = false
    bool pocExtensionStopped = false
    int closesBelowMovementLow = 0
    int closesBelowVAL = 0
    bool stackedAboveLower = false
    int lowerProfileStartTime = na
    float lowerProfileVAL = na
    bool departureProven = false
    bool defenseArmed = false
    bool testActive = false
    int testBarIndex = na
    int testTime = na
    float testLow = na
    line valLine = na
    line pocLine = na
    line vahLine = na

type DefenseScoreResult
    int score = 0
    int referenceCount = 0
    bool highParticipationReference = false
    bool cleanBreak = false
    bool cleanOwnership = false
    bool meaningfulFRVP = false
    bool emaAnchor = false
    bool emaConfluence = false
    bool strongImpulse = false
    bool wickQualified = false
    bool volumeQualified = false
    int referenceTime = na
    int breakTime = na

f_registerMeaningfulVALProfile(
     array<MeaningfulVALProfile> profiles,
     int profileDateKey,
     int profileSessionId,
     int profileStartTime,
     int profileEndTime,
     int profileReadyBarIndex,
     float profileMovementLow,
     float profileMovementHigh,
     float profileVAL,
     float profilePOC,
     float profileVAH,
     float profileVolume,
     float profileFreezeATR,
     line profileVALLine,
     line profilePOCLine,
     line profileVAHLine,
     bool profilePOCExtensionStopped) =>
    float profileRange = profileMovementHigh - profileMovementLow
    float valAdvance = profileVAL - profileMovementLow
    float valElevation =
         profileRange > syminfo.mintick ?
         valAdvance / profileRange : 0.0
    float valAdvanceATR =
         not na(profileFreezeATR) and profileFreezeATR > 0.0 ?
         valAdvance / profileFreezeATR : 0.0
    float valAdvancePercent =
         profileMovementLow > 0.0 ?
         valAdvance / profileMovementLow * 100.0 : 0.0
    bool meaningfulProfile =
         valElevation >=
              dominantMinimumVALElevationPercent / 100.0 or
         (
              valAdvanceATR >= meaningfulVALMinimumAdvanceATR and
              valAdvancePercent >=
                   meaningfulVALMinimumAdvancePricePercent
         )

    bool duplicateProfile = false
    if array.size(profiles) > 0
        for profileIndex = 0 to array.size(profiles) - 1
            MeaningfulVALProfile existingProfile =
                 array.get(profiles, profileIndex)
            if existingProfile.movementStartTime == profileStartTime
                duplicateProfile := true

    if meaningfulProfile and not duplicateProfile
        int lowerProfileStartTime = na
        float lowerProfileVAL = na
        if array.size(profiles) > 0
            for lowerProfileIndex = 0 to array.size(profiles) - 1
                MeaningfulVALProfile lowerCandidate =
                     array.get(profiles, lowerProfileIndex)
                bool betterActiveLowerProfile =
                     not lowerCandidate.invalidated and
                     lowerCandidate.val < profileVAL and
                     (
                          na(lowerProfileVAL) or
                          lowerCandidate.val > lowerProfileVAL
                     )
                if betterActiveLowerProfile
                    lowerProfileStartTime :=
                         lowerCandidate.movementStartTime
                    lowerProfileVAL := lowerCandidate.val

        bool stackedAboveLower = not na(lowerProfileVAL)
        float profileScore =
             profileVolume *
             math.max(profileRange, syminfo.mintick)
        MeaningfulVALProfile newProfile = MeaningfulVALProfile.new(
             dateKey = profileDateKey,
             sessionId = profileSessionId,
             movementStartTime = profileStartTime,
             movementEndTime = profileEndTime,
             readyBarIndex = profileReadyBarIndex,
             movementLow = profileMovementLow,
             movementHigh = profileMovementHigh,
             val = profileVAL,
             poc = profilePOC,
             vah = profileVAH,
             cumulativeVolume = profileVolume,
             score = profileScore,
             pocExtensionStopped = profilePOCExtensionStopped,
             stackedAboveLower = stackedAboveLower,
             lowerProfileStartTime = lowerProfileStartTime,
             lowerProfileVAL = lowerProfileVAL,
             departureProven = not stackedAboveLower,
             defenseArmed = not stackedAboveLower,
             valLine = profileVALLine,
             pocLine = profilePOCLine,
             vahLine = profileVAHLine)
        array.push(profiles, newProfile)
        while array.size(profiles) > maximumStackedMeaningfulVALProfiles
            array.shift(profiles)

    array.size(profiles)

// Every frozen profile, including one whose VAL is not elevated enough for the
// pure meaningful-VAL path, may participate in this independent lifecycle.
// The profile must keep its original movement low intact until one candle
// sweeps VAL and reclaims POC with decisive price and volume.
type VALSweepPOCProfile
    int number = 0
    int dateKey = 0
    int sessionId = 0
    int movementStartTime = na
    int movementEndTime = na
    int readyBarIndex = na
    int ageTradingDates = 0
    float movementLow = na
    float movementHigh = na
    float val = na
    float poc = na
    float vah = na
    bool invalidated = false
    int closesBelowMovementLow = 0
    bool armed = true
    int lastSignalBarIndex = na

f_registerVALSweepPOCProfile(
     array<VALSweepPOCProfile> profiles,
     int profileNumber,
     int profileDateKey,
     int profileSessionId,
     int profileStartTime,
     int profileEndTime,
     int profileReadyBarIndex,
     float profileMovementLow,
     float profileMovementHigh,
     float profileVAL,
     float profilePOC,
     float profileVAH) =>
    bool duplicateProfile = false
    if array.size(profiles) > 0
        for profileIndex = 0 to array.size(profiles) - 1
            VALSweepPOCProfile existingProfile =
                 array.get(profiles, profileIndex)
            if existingProfile.movementStartTime == profileStartTime
                duplicateProfile := true

    if not duplicateProfile
        VALSweepPOCProfile newProfile = VALSweepPOCProfile.new(
             number = profileNumber,
             dateKey = profileDateKey,
             sessionId = profileSessionId,
             movementStartTime = profileStartTime,
             movementEndTime = profileEndTime,
             readyBarIndex = profileReadyBarIndex,
             movementLow = profileMovementLow,
             movementHigh = profileMovementHigh,
             val = profileVAL,
             poc = profilePOC,
             vah = profileVAH)
        array.push(profiles, newProfile)
        while array.size(profiles) > maximumStackedMeaningfulVALProfiles
            array.shift(profiles)

    array.size(profiles)

f_rangeOverlapFraction(
     float firstLow,
     float firstHigh,
     float secondLow,
     float secondHigh) =>
    float overlap =
         math.max(
              0.0,
              math.min(firstHigh, secondHigh) -
              math.max(firstLow, secondLow))
    float smallerRange =
         math.min(firstHigh - firstLow, secondHigh - secondLow)
    smallerRange > syminfo.mintick ? overlap / smallerRange : 1.0

f_initiativeOverlapException(
     float candidateLow,
     float candidateHigh,
     float referenceHigh,
     float triggerRelativeVolume,
     float triggerBodyATR,
     float triggerCloseLocation,
     float comparisonATR) =>
    float candidateRange = candidateHigh - candidateLow
    float extensionAboveReference = candidateHigh - referenceHigh
    float requiredExtension =
         math.max(
              comparisonATR * initiativeOverlapMinimumExtensionATR,
              candidateRange * initiativeOverlapMinimumExtensionShare)
    allowInitiativeBreakoutOverlap and
         candidateRange > syminfo.mintick and
         not na(triggerRelativeVolume) and
         triggerRelativeVolume >=
              initiativeOverlapMinimumRelativeVolume and
         not na(triggerBodyATR) and
         triggerBodyATR >= initiativeOverlapMinimumBodyATR and
         not na(triggerCloseLocation) and
         triggerCloseLocation >=
              initiativeOverlapMinimumCloseLocation and
         not na(comparisonATR) and
         comparisonATR > 0.0 and
         extensionAboveReference >= requiredExtension

//------------------------------------------------------------------------------
// Approximate fixed-range volume profile
//------------------------------------------------------------------------------

f_calculateProfile(
     array<float> storedLows,
     array<float> storedHighs,
     array<float> storedVolumes,
     float rangeLow,
     float rangeHigh,
     int rowCount,
     float valueAreaFraction) =>
    array<float> result = array.new_float(3, na)
    int storedBarCount = array.size(storedLows)
    float profileRange = rangeHigh - rangeLow

    if storedBarCount > 0 and profileRange > syminfo.mintick
        float rowHeight = profileRange / rowCount
        array<float> rowVolumes = array.new_float(rowCount, 0.0)

        for storedBarIndex = 0 to storedBarCount - 1
            float storedLow = array.get(storedLows, storedBarIndex)
            float storedHigh = array.get(storedHighs, storedBarIndex)
            float storedVolume = array.get(storedVolumes, storedBarIndex)
            float storedRange = storedHigh - storedLow

            if storedRange <= syminfo.mintick
                int singleRow = int(math.floor((storedLow - rangeLow) / rowHeight))
                singleRow := math.max(0, math.min(rowCount - 1, singleRow))
                array.set(rowVolumes, singleRow, array.get(rowVolumes, singleRow) + storedVolume)
            else
                for rowIndex = 0 to rowCount - 1
                    float rowLow = rangeLow + rowIndex * rowHeight
                    float rowHigh = rowLow + rowHeight
                    float overlap = math.max(0.0, math.min(storedHigh, rowHigh) - math.max(storedLow, rowLow))
                    if overlap > 0.0
                        float allocatedVolume = storedVolume * overlap / storedRange
                        array.set(rowVolumes, rowIndex, array.get(rowVolumes, rowIndex) + allocatedVolume)

        int pocRow = 0
        float pocRowVolume = array.get(rowVolumes, 0)
        for rowIndex = 1 to rowCount - 1
            float candidateVolume = array.get(rowVolumes, rowIndex)
            if candidateVolume > pocRowVolume
                pocRow := rowIndex
                pocRowVolume := candidateVolume

        float totalProfileVolume = array.sum(rowVolumes)
        float targetValueAreaVolume = totalProfileVolume * valueAreaFraction
        int valueAreaLowRow = pocRow
        int valueAreaHighRow = pocRow
        float includedVolume = pocRowVolume
        int expansionCount = 0

        while includedVolume < targetValueAreaVolume and expansionCount < rowCount - 1
            float lowerCandidateVolume = valueAreaLowRow > 0 ? array.get(rowVolumes, valueAreaLowRow - 1) : -1.0
            float upperCandidateVolume = valueAreaHighRow < rowCount - 1 ? array.get(rowVolumes, valueAreaHighRow + 1) : -1.0

            if upperCandidateVolume > lowerCandidateVolume
                valueAreaHighRow += 1
                includedVolume += math.max(0.0, upperCandidateVolume)
            else if valueAreaLowRow > 0
                valueAreaLowRow -= 1
                includedVolume += math.max(0.0, lowerCandidateVolume)
            else if valueAreaHighRow < rowCount - 1
                valueAreaHighRow += 1
                includedVolume += math.max(0.0, upperCandidateVolume)

            expansionCount += 1

        float calculatedVAL = rangeLow + valueAreaLowRow * rowHeight
        float calculatedPOC = rangeLow + (pocRow + 0.5) * rowHeight
        float calculatedVAH = rangeLow + (valueAreaHighRow + 1.0) * rowHeight

        array.set(result, 0, calculatedVAL)
        array.set(result, 1, calculatedPOC)
        array.set(result, 2, calculatedVAH)

    result

//------------------------------------------------------------------------------
// Series calculations
//------------------------------------------------------------------------------

float atrValue = ta.atr(atrLength)
float volumeAverage = ta.sma(volume, volumeAverageLength)
float contractionVolumeAverage = ta.sma(volume, contractionBars)
float sessionVWAP = ta.vwap(hlc3)
float intradayEMA9 = ta.ema(close, 9)
float candleRange = high - low
float candleBody = math.abs(close - open)
float candleCloseLocation = candleRange > 0.0 ? (close - low) / candleRange : 0.5
float relativeVolume = not na(volumeAverage) and volumeAverage > 0.0 ? volume / volumeAverage : na
float exceptionalPreviousVolumeAverage =
     ta.sma(volume, exceptionalVolumeLookback)[1]
float additionalTrendPriorLow =
     ta.lowest(low, additionalTrendResetLookbackBars)[1]
float additionalTrendPriorVolumeAverage =
     ta.sma(volume, additionalTrendResetLookbackBars)[1]
float recentEMA9MinimumCloseDifference =
     ta.lowest(
          close - intradayEMA9,
          additionalTrendResetLookbackBars)
float recentEMA9MinimumLowDistance =
     ta.lowest(
          math.abs(low - intradayEMA9),
          additionalTrendResetLookbackBars)
float dailyEMA20 = request.security(
     syminfo.tickerid,
     "D",
     ta.ema(close, 20),
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off)
float dailyEMA200 = request.security(
     syminfo.tickerid,
     "D",
     ta.ema(close, 200),
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off)

f_defenseGrade(int defenseScore) =>
    defenseScore >= 80 ? "STRONG" :
     defenseScore >= 65 ? "GOOD" :
     defenseScore >= 50 ? "MODERATE" : "WEAK"

f_calculateDefenseScore(
     float defendedLevel,
     float defendedLow,
     int testBarIndex,
     float sourceMovementLow,
     float sourceMovementHigh,
     bool meaningfulFRVP,
     bool emaAnchor,
     bool allowRecentEMA200Impulse,
     float scoreATR,
     float scoreVolumeAverage,
     float scoreDailyEMA20,
     float scoreDailyEMA200) =>
    int score = 0
    int referenceCount = 0
    bool highParticipationReference = false
    bool cleanBreak = false
    bool cleanOwnership = false
    bool emaConfluence = false
    bool strongImpulse = false
    bool fullStrongImpulse = false
    bool recentEMAImpulse = false
    bool wickQualified = false
    bool volumeQualified = false
    int referenceTime = na
    int breakTime = na

    bool scoreInputsReady =
         enableDefenseConfidenceScore and
         not na(defendedLevel) and
         defendedLevel > 0.0 and
         not na(scoreATR) and
         scoreATR > 0.0

    if scoreInputsReady
        // The technical anchor may be front-run. Match market memory to the
        // actual defended low while retaining the real VAL/EMA as the anchor.
        float referenceLevel =
             not na(defendedLow) ? defendedLow : defendedLevel
        int testBarsAgo =
             not na(testBarIndex) ?
             math.max(0, bar_index - testBarIndex) : 0
        float referenceTolerance =
             math.max(
                  referenceLevel *
                       defenseReferenceTolerancePercent / 100.0,
                  scoreATR * defenseReferenceToleranceATR)
        int breakoutOffset = na

        // Use the most recent accepted transition above the defended market
        // memory. Bars after this point must preserve ownership into defense.
        for referenceOffset = 1 to defenseReferenceLookbackBars
            bool offsetReady =
                 referenceOffset > testBarsAgo and
                 not na(close[referenceOffset + 1])
            bool crossedFromBelow =
                 offsetReady and
                 close[referenceOffset] >
                      referenceLevel + referenceTolerance * 0.25 and
                 close[referenceOffset + 1] <=
                      referenceLevel + referenceTolerance
            if na(breakoutOffset) and crossedFromBelow
                breakoutOffset := referenceOffset
                breakTime := time[referenceOffset]

        if not na(breakoutOffset)
            cleanBreak := true
            cleanOwnership := true
            float ownershipFloor =
                 referenceLevel *
                 (1.0 -
                      defenseMaximumOwnershipUndercutPercent /
                      100.0)
            float postBreakHigh = referenceLevel

            for ownershipOffset = 0 to defenseReferenceLookbackBars
                bool betweenBreakAndDefense =
                     ownershipOffset < breakoutOffset
                if betweenBreakAndDefense
                    postBreakHigh :=
                         math.max(
                              postBreakHigh,
                              nz(high[ownershipOffset], postBreakHigh))
                    if not na(low[ownershipOffset]) and
                         low[ownershipOffset] < ownershipFloor
                        cleanOwnership := false

            fullStrongImpulse :=
                 (
                      not na(sourceMovementHigh) and
                      sourceMovementHigh >=
                           referenceLevel * 1.20
                 ) or postBreakHigh >=
                      referenceLevel * 1.20
            recentEMAImpulse :=
                 allowRecentEMA200Impulse and
                 breakoutOffset <= 30 and
                 postBreakHigh >= referenceLevel * 1.10

            // Only candles older than the ownership break may prove historical
            // market memory. They must visibly reject or support the level.
            for memoryOffset = 1 to defenseReferenceLookbackBars
                bool olderThanBreak = memoryOffset > breakoutOffset
                bool rejectsDown =
                     olderThanBreak and
                     not na(high[memoryOffset]) and
                     math.abs(
                          high[memoryOffset] - referenceLevel) <=
                          referenceTolerance and
                     close[memoryOffset] < referenceLevel and
                     high[memoryOffset] - close[memoryOffset] >=
                          referenceTolerance * 0.25
                bool supportsUp =
                     olderThanBreak and
                     not na(low[memoryOffset]) and
                     math.abs(
                          low[memoryOffset] - referenceLevel) <=
                          referenceTolerance and
                     low[memoryOffset] >=
                          referenceLevel *
                          (1.0 -
                               defenseMaximumOwnershipUndercutPercent /
                               100.0) and
                     close[memoryOffset] > referenceLevel and
                     close[memoryOffset] - low[memoryOffset] >=
                          referenceTolerance * 0.25
                bool meaningfulMemory = rejectsDown or supportsUp
                if meaningfulMemory
                    referenceCount += 1
                    if na(referenceTime)
                        referenceTime := time[memoryOffset]
                    bool memoryVolumeQualified =
                         not na(scoreVolumeAverage[memoryOffset]) and
                         scoreVolumeAverage[memoryOffset] > 0.0 and
                         volume[memoryOffset] >=
                              scoreVolumeAverage[memoryOffset]
                    if memoryVolumeQualified
                        highParticipationReference := true

        float emaTolerance =
             math.max(
                  defendedLevel * 0.02,
                  scoreATR * defenseReferenceToleranceATR)
        emaConfluence :=
             not emaAnchor and
             (
                  (
                       not na(scoreDailyEMA20) and
                       scoreDailyEMA20 > 0.0 and
                       math.abs(defendedLevel - scoreDailyEMA20) <=
                            emaTolerance
                  ) or
                  (
                       not na(scoreDailyEMA200) and
                       scoreDailyEMA200 > 0.0 and
                       math.abs(defendedLevel - scoreDailyEMA200) <=
                            emaTolerance
                  )
             )

        float defenseApproachAllowance =
             math.max(
                  scoreATR * scoredEMAFrontRunATR,
                  defendedLevel * scoredEMAFrontRunPercent / 100.0)
        bool approachQualified =
             not na(defendedLow) and
             defendedLow <= defendedLevel + defenseApproachAllowance and
             defendedLow >=
                  defendedLevel *
                  (1.0 - scoredEMAMaximumUndercutPercent / 100.0)
        float scoreCandleRange = high - low
        float scoreLowerWick = math.min(open, close) - low
        wickQualified :=
             scoreCandleRange > syminfo.mintick and
             scoreLowerWick >= scoreCandleRange * 0.25
        volumeQualified :=
             not na(scoreVolumeAverage) and
             scoreVolumeAverage > 0.0 and
             volume >= scoreVolumeAverage
        strongImpulse :=
             fullStrongImpulse or
             (
                  recentEMAImpulse and
                  wickQualified and
                  volumeQualified
             )
        bool closesAboveLevel = close > defendedLevel
        bool buyerConfirmation =
             closesAboveLevel and
             (
                  (
                       not na(testBarIndex) and
                       bar_index > testBarIndex and
                       low >= defendedLow
                  ) or
                  (
                       close > open and
                       scoreCandleRange > syminfo.mintick and
                       (close - low) / scoreCandleRange >= 0.60
                  )
             )

        score += meaningfulFRVP ? 10 : 0
        score += emaAnchor or emaConfluence ? 10 : 0
        score += referenceCount > 0 ? 15 : 0
        score +=
             highParticipationReference or referenceCount >= 2 ?
             10 : 0
        score += cleanBreak ? 10 : 0
        score += cleanOwnership ? 10 : 0
        score += approachQualified ? 10 : 0
        score += wickQualified ? 5 : 0
        score += closesAboveLevel ? 5 : 0
        score += buyerConfirmation ? 5 : 0
        score += volumeQualified ? 5 : 0
        score += strongImpulse ? 5 : 0
        score := math.min(100, score)

    DefenseScoreResult.new(
         score = score,
         referenceCount = referenceCount,
         highParticipationReference =
              highParticipationReference,
         cleanBreak = cleanBreak,
         cleanOwnership = cleanOwnership,
         meaningfulFRVP = meaningfulFRVP,
         emaAnchor = emaAnchor,
         emaConfluence = emaConfluence,
         strongImpulse = strongImpulse,
         wickQualified = wickQualified,
         volumeQualified = volumeQualified,
         referenceTime = referenceTime,
         breakTime = breakTime)

bool timeframeSupported = timeframe.isminutes and timeframe.multiplier <= maximumChartMinutes
bool inPremarketSession = includePremarket and
     not na(time(timeframe.period, premarketSession, syminfo.timezone))
bool inRegularMarketSession = includeRegularSession and
     not na(time(timeframe.period, regularMarketSession, syminfo.timezone))
bool inAfterHoursSession = includeAfterHours and
     not na(time(timeframe.period, afterHoursSession, syminfo.timezone))
int activeMarketSession = inPremarketSession ? 1 :
     inRegularMarketSession ? 2 :
     inAfterHoursSession ? 3 : 0
bool inAnalysisSession = activeMarketSession != 0
bool inAutoStartWindow = not na(time(timeframe.period, autoStartWindow, syminfo.timezone))
bool inManualMoveWindow = not na(time(timeframe.period, manualMoveWindow, syminfo.timezone))

int currentDateKey = year * 10000 + month * 100 + dayofmonth
bool newTradingDate = bar_index > 0 and currentDateKey != currentDateKey[1]
bool dailyEMA20NearCurrentPrice =
     not na(dailyEMA20) and
     dailyEMA20 > 0.0 and
     math.abs(close - dailyEMA20) / dailyEMA20 * 100.0 <
          dailyEMAMaximumDisplayDistancePercent
bool dailyEMA200NearCurrentPrice =
     not na(dailyEMA200) and
     dailyEMA200 > 0.0 and
     math.abs(close - dailyEMA200) / dailyEMA200 * 100.0 <
          dailyEMAMaximumDisplayDistancePercent

plot(
     showDailyEMALevels and dailyEMA20NearCurrentPrice ?
          dailyEMA20 : na,
     title = "Daily EMA 20",
     color = dailyEMA20Color,
     linewidth = 2,
     display = display.all - display.status_line)
plot(
     showDailyEMALevels and dailyEMA200NearCurrentPrice ?
          dailyEMA200 : na,
     title = "Daily EMA 200",
     color = dailyEMA200Color,
     linewidth = 2,
     display = display.all - display.status_line)
bool newEnabledMarketSession =
     activeMarketSession != 0 and
     (bar_index == 0 or activeMarketSession != activeMarketSession[1])

//------------------------------------------------------------------------------
// Persistent state and drawing retention
//------------------------------------------------------------------------------

var int lifecycleState = STATE_SEARCHING

var array<float> movementLows = array.new_float()
var array<float> movementHighs = array.new_float()
var array<float> movementVolumes = array.new_float()
var array<float> movementOpens = array.new_float()
var array<float> movementCloses = array.new_float()
var array<float> movementATRs = array.new_float()
var array<int> movementTimes = array.new_int()
var array<int> movementBarIndices = array.new_int()

var float movementLow = na
var float movementHigh = na
var float movementPeakVolume = na
var int movementStartTime = na
var int movementEndTime = na
var int movementHighBarIndex = na
var int movementAcceptedEndBarIndex = na
var int movementAcceptedEndTime = na
var float movementAcceptedHigh = na
var float movementAcceptedClose = na
var int movementTriggerBarIndex = na
var int movementTriggerTime = na
var bool movementStartedExceptionally = false
var bool movementWasStitched = false
var bool movementExceptionalProvisionalStitchUsed = false
var int movementStitchDeadlineBarIndex = na
var float movementStitchReferenceHigh = na
var float movementStitchReferenceLow = na
var float movementStitchPullbackLow = na
var bool movementStitchMaySplitRestart = false
var bool movementCompactGraceActive = false
var bool movementQualifiedAsCompact = false
var bool movementRecoveredThroughCompactGrace = false
var bool movementFreshParticipationResetUsed = false

var float profileVAL = na
var float profilePOC = na
var float profileVAH = na
var float profileVWAPAtFreeze = na
var int profileReadyBarIndex = na
var int profileLastVisibleTime = na
var bool profilePOCExtensionStopped = false

var bool valDefended = false
var bool valEntryCandidateActive = false
var int valEntryCandidateBarIndex = na
var int valEntryCandidateTime = na
var float valEntryCandidateHigh = na
var float valEntryCandidateLow = na
var bool valInvalidated = false
var bool valInvalidationMarked = false
var int consecutiveClosesBelowProfileLow = 0
var int profileRecoveryStage = 0

var bool pocDefenseArmed = true
var int lastPOCDefenseBarIndex = na
var int failedPOCAttempts = 0
var int profileInternalFailedPOCAttempts = 0
var int lastPOCAttemptBarIndex = na
var bool vahDefenseArmed = true
var int lastVAHDefenseBarIndex = na
var bool vahDefenseCandidateActive = false
var int vahDefenseCandidateBarIndex = na
var int vahDefenseCandidateTime = na
var float vahDefenseCandidateOpen = na
var float vahDefenseCandidateHigh = na
var float vahDefenseCandidateLow = na
var float vahDefenseCandidateClose = na
var float vahDefenseCandidateVolume = na
var float vahDefenseCandidateLowerWickShare = na

var bool breakoutPending = false
var bool breakoutConfirmed = false
var int breakoutBarIndex = na
var int breakoutTime = na
var float breakoutLow = na
var float breakoutHigh = na
var float breakoutATRAtSignal = na
var string breakoutPath = ""

var line activeVALLine = na
var line activePOCLine = na
var line activeVAHLine = na
var box activeMovementBox = na
var label activeEntryLabel = na

// One independently preserved reference profile drives the new VAL-entry
// lifecycle. It is fed by both the primary and additional movement scanners,
// but it does not disturb their established POC/VAH continuation state.
var bool dominantReferenceReady = false
var bool dominantReferenceInvalidated = false
var int dominantReferenceDateKey = na
var int dominantReferenceSessionId = 0
var int dominantReferenceStartTime = na
var int dominantReferenceEndTime = na
var int dominantReferenceReadyBarIndex = na
var int dominantReferenceAgeTradingDates = 0
var float dominantReferenceMovementLow = na
var float dominantReferenceMovementHigh = na
var float dominantReferenceVAL = na
var float dominantReferencePOC = na
var float dominantReferenceVAH = na
var float dominantReferenceCumulativeVolume = na
var float dominantReferenceScore = na
var int dominantReferenceClosesBelowLow = 0
var bool dominantReferencePOCExtensionStopped = false
var bool dominantReferenceDefenseArmed = true
var bool dominantReferenceTestActive = false
var int dominantReferenceTestBarIndex = na
var int dominantReferenceTestTime = na
var float dominantReferenceTestLow = na
var line dominantReferenceVALLine = na
var line dominantReferencePOCLine = na
var line dominantReferenceVAHLine = na

var array<line> retainedProfileLines = array.new_line()
var array<box> retainedMovementBoxes = array.new_box()
var array<label> retainedMarkers = array.new_label()
var array<label> retainedEntryMarkers = array.new_label()
var array<label> retainedDailyEMAWarningMarkers = array.new_label()

var array<AdditionalProfile> additionalProfiles =
     array.new<AdditionalProfile>()
var array<RetrospectiveProfileCandidate> retrospectiveCandidates =
     array.new<RetrospectiveProfileCandidate>()
var int retrospectiveProfilesConfirmedInSession = 0
var array<MeaningfulVALProfile> meaningfulVALProfiles =
     array.new<MeaningfulVALProfile>()
var array<VALSweepPOCProfile> valSweepPOCProfiles =
     array.new<VALSweepPOCProfile>()
var int additionalScannerState = STATE_SEARCHING
var int additionalScannerSessionId = 0
var int profilesCreatedInCurrentSession = 0
var int nextProfileNumber = 2
var int lastProfileStartBarIndex = na
var int lastProfileFreezeBarIndex = na
var float highestAcceptedTrendHigh = na
var bool additionalScannerResetArmed = false

var array<float> additionalMovementLows = array.new_float()
var array<float> additionalMovementHighs = array.new_float()
var array<float> additionalMovementVolumes = array.new_float()
var array<float> additionalMovementOpens = array.new_float()
var array<float> additionalMovementCloses = array.new_float()
var array<float> additionalMovementATRs = array.new_float()
var array<int> additionalMovementTimes = array.new_int()
var array<int> additionalMovementBarIndices = array.new_int()
var float additionalMovementLow = na
var float additionalMovementHigh = na
var float additionalMovementPeakVolume = na
var int additionalMovementStartTime = na
var int additionalMovementEndTime = na
var int additionalMovementHighBarIndex = na
var int additionalMovementHighEndTime = na
var int additionalAcceptedEndBarIndex = na
var int additionalAcceptedEndTime = na
var float additionalAcceptedHigh = na
var float additionalAcceptedClose = na
var float additionalMovementTriggerRelativeVolume = na
var float additionalMovementTriggerBodyATR = na
var float additionalMovementTriggerCloseLocation = na
var int additionalMovementTriggerBarIndex = na
var int additionalMovementTriggerTime = na
var bool additionalMovementUsedAdaptiveOrigin = false
var bool additionalMovementWasStitched = false
var bool additionalExceptionalProvisionalStitchUsed = false
var int additionalStitchDeadlineBarIndex = na
var float additionalStitchReferenceHigh = na
var float additionalStitchReferenceLow = na
var float additionalStitchPullbackLow = na
var bool additionalStitchMaySplitRestart = false
var bool additionalCompactGraceActive = false
var bool additionalMovementQualifiedAsCompact = false
var bool additionalRecoveredThroughCompactGrace = false
var bool additionalFreshParticipationResetUsed = false

bool entryTriggeredThisBar = false
bool valEntryConfirmedThisBar = false
bool valDefendedThisBar = false
bool pocDefendedThisBar = false
bool vahDefendedThisBar = false
bool emaDefendedThisBar = false
bool profileReactivatedThisBar = false
float defenseScoreThisBar = na

if newTradingDate
    array.clear(retrospectiveCandidates)
    retrospectiveProfilesConfirmedInSession := 0
else if newEnabledMarketSession
    retrospectiveProfilesConfirmedInSession := 0

// A frozen premarket profile always survives the 09:30 boundary, even if its
// earlier entry lifecycle completed. Other session changes carry only an
// unfinished profile.
bool frozenProfileExists =
     lifecycleState == STATE_PROFILE
bool frozenProfileStillActionable =
     frozenProfileExists and
     (
          (not valInvalidated and not breakoutConfirmed) or
          (valInvalidated and enableProfileReactivation)
     )
bool unfinishedMovementExists =
     lifecycleState == STATE_BUILDING or
     lifecycleState == STATE_STITCHING
bool enteringRegularFromPremarket =
     newEnabledMarketSession and
     bar_index > 0 and
     activeMarketSession == 2 and
     activeMarketSession[1] == 1
bool preserveProfileAtSessionBoundary =
     carryActiveProfileAcrossSessions and
     newEnabledMarketSession and
     (
          unfinishedMovementExists or
          (
               frozenProfileExists and
               (enteringRegularFromPremarket or frozenProfileStillActionable)
          )
     )
bool resetLifecycleNow =
     newTradingDate or
     (newEnabledMarketSession and not preserveProfileAtSessionBoundary)

// Only after-hours profiles may carry into the next trading date. Each carried
// profile is rearmed for the new date when its departure had already been
// proven; this preserves a Friday postmarket VAL as support on Monday.
if newTradingDate and array.size(meaningfulVALProfiles) > 0
    int meaningfulCleanupIndex =
         array.size(meaningfulVALProfiles) - 1
    while meaningfulCleanupIndex >= 0
        MeaningfulVALProfile cleanupProfile =
             array.get(
                  meaningfulVALProfiles,
                  meaningfulCleanupIndex)
        bool carryMeaningfulAfterHours =
             enableStackedMeaningfulVALProfiles and
             not cleanupProfile.invalidated and
             cleanupProfile.sessionId == 3 and
             cleanupProfile.ageTradingDates <
                  dominantAfterHoursCarryTradingDates
        if carryMeaningfulAfterHours
            cleanupProfile.ageTradingDates += 1
            cleanupProfile.closesBelowMovementLow := 0
            cleanupProfile.closesBelowVAL := 0
            cleanupProfile.defenseArmed :=
                 cleanupProfile.departureProven
            cleanupProfile.testActive := false
            cleanupProfile.testBarIndex := na
            cleanupProfile.testTime := na
            cleanupProfile.testLow := na
            array.set(
                 meaningfulVALProfiles,
                 meaningfulCleanupIndex,
                 cleanupProfile)
        else
            array.remove(
                 meaningfulVALProfiles,
                 meaningfulCleanupIndex)
        meaningfulCleanupIndex -= 1

// Mirror the established one-date carry rule for the new reclaim lifecycle.
// This keeps a valid after-hours profile available on the next premarket while
// discarding older or already-invalidated references.
if newTradingDate and array.size(valSweepPOCProfiles) > 0
    int sweepCleanupIndex = array.size(valSweepPOCProfiles) - 1
    while sweepCleanupIndex >= 0
        VALSweepPOCProfile sweepCleanupProfile =
             array.get(valSweepPOCProfiles, sweepCleanupIndex)
        bool carrySweepAfterHours =
             enableVALSweepPOCReclaim and
             not sweepCleanupProfile.invalidated and
             sweepCleanupProfile.sessionId == 3 and
             sweepCleanupProfile.ageTradingDates <
                  dominantAfterHoursCarryTradingDates
        if carrySweepAfterHours
            sweepCleanupProfile.ageTradingDates += 1
            sweepCleanupProfile.closesBelowMovementLow := 0
            sweepCleanupProfile.armed := true
            sweepCleanupProfile.lastSignalBarIndex := na
            array.set(
                 valSweepPOCProfiles,
                 sweepCleanupIndex,
                 sweepCleanupProfile)
        else
            array.remove(valSweepPOCProfiles, sweepCleanupIndex)
        sweepCleanupIndex -= 1

// The ordinary primary lifecycle still resets by date. The dominant reference
// is intentionally separate so a valid after-hours auction can remain the
// controlling value structure on the next trading date.
if newTradingDate and dominantReferenceReady
    bool carryDominantAfterHours =
         enableDominantProfileVALReference and
         not dominantReferenceInvalidated and
         dominantReferenceSessionId == 3 and
         dominantReferenceAgeTradingDates <
              dominantAfterHoursCarryTradingDates

    if carryDominantAfterHours
        dominantReferenceAgeTradingDates += 1
        dominantReferenceClosesBelowLow := 0
        dominantReferenceDefenseArmed := true
        dominantReferenceTestActive := false
        dominantReferenceTestBarIndex := na
        dominantReferenceTestTime := na
        dominantReferenceTestLow := na
    else
        dominantReferenceReady := false
        dominantReferenceInvalidated := false
        dominantReferenceDateKey := na
        dominantReferenceSessionId := 0
        dominantReferenceStartTime := na
        dominantReferenceEndTime := na
        dominantReferenceReadyBarIndex := na
        dominantReferenceAgeTradingDates := 0
        dominantReferenceMovementLow := na
        dominantReferenceMovementHigh := na
        dominantReferenceVAL := na
        dominantReferencePOC := na
        dominantReferenceVAH := na
        dominantReferenceCumulativeVolume := na
        dominantReferenceScore := na
        dominantReferenceClosesBelowLow := 0
        dominantReferencePOCExtensionStopped := false
        dominantReferenceDefenseArmed := true
        dominantReferenceTestActive := false
        dominantReferenceTestBarIndex := na
        dominantReferenceTestTime := na
        dominantReferenceTestLow := na
        if not na(dominantReferenceVALLine)
            line.delete(dominantReferenceVALLine)
        if not na(dominantReferencePOCLine)
            line.delete(dominantReferencePOCLine)
        if not na(dominantReferenceVAHLine)
            line.delete(dominantReferenceVAHLine)
        dominantReferenceVALLine := na
        dominantReferencePOCLine := na
        dominantReferenceVAHLine := na

//------------------------------------------------------------------------------
// Reset at a new date or at an enabled session boundary where no frozen profile
// qualifies for carry-forward. Historical drawings remain on the chart.
//------------------------------------------------------------------------------

if resetLifecycleNow
    lifecycleState := STATE_SEARCHING
    array.clear(movementLows)
    array.clear(movementHighs)
    array.clear(movementVolumes)
    array.clear(movementOpens)
    array.clear(movementCloses)
    array.clear(movementATRs)
    array.clear(movementTimes)
    array.clear(movementBarIndices)

    movementLow := na
    movementHigh := na
    movementPeakVolume := na
    movementStartTime := na
    movementEndTime := na
    movementHighBarIndex := na
    movementAcceptedEndBarIndex := na
    movementAcceptedEndTime := na
    movementAcceptedHigh := na
    movementAcceptedClose := na
    movementTriggerBarIndex := na
    movementTriggerTime := na
    movementStartedExceptionally := false
    movementWasStitched := false
    movementExceptionalProvisionalStitchUsed := false
    movementStitchDeadlineBarIndex := na
    movementStitchReferenceHigh := na
    movementStitchReferenceLow := na
    movementStitchPullbackLow := na
    movementStitchMaySplitRestart := false
    movementCompactGraceActive := false
    movementQualifiedAsCompact := false
    movementRecoveredThroughCompactGrace := false
    movementFreshParticipationResetUsed := false

    profileVAL := na
    profilePOC := na
    profileVAH := na
    profileVWAPAtFreeze := na
    profileReadyBarIndex := na
    profileLastVisibleTime := na
    profilePOCExtensionStopped := false

    valDefended := false
    valEntryCandidateActive := false
    valEntryCandidateBarIndex := na
    valEntryCandidateTime := na
    valEntryCandidateHigh := na
    valEntryCandidateLow := na
    valInvalidated := false
    valInvalidationMarked := false
    consecutiveClosesBelowProfileLow := 0
    profileRecoveryStage := 0

    pocDefenseArmed := true
    lastPOCDefenseBarIndex := na
    failedPOCAttempts := 0
    profileInternalFailedPOCAttempts := 0
    lastPOCAttemptBarIndex := na
    vahDefenseArmed := true
    lastVAHDefenseBarIndex := na
    vahDefenseCandidateActive := false
    vahDefenseCandidateBarIndex := na
    vahDefenseCandidateTime := na
    vahDefenseCandidateOpen := na
    vahDefenseCandidateHigh := na
    vahDefenseCandidateLow := na
    vahDefenseCandidateClose := na
    vahDefenseCandidateVolume := na
    vahDefenseCandidateLowerWickShare := na

    breakoutPending := false
    breakoutConfirmed := false
    breakoutBarIndex := na
    breakoutTime := na
    breakoutLow := na
    breakoutHigh := na
    breakoutATRAtSignal := na
    breakoutPath := ""

    activeVALLine := na
    activePOCLine := na
    activeVAHLine := na
    activeMovementBox := na
    activeEntryLabel := na

//------------------------------------------------------------------------------
// Detect/build/freeze the first movement.
// All lifecycle decisions occur on confirmed bars.
//------------------------------------------------------------------------------

bool freezeMovementNow = false
bool discardMovementNow = false
bool splitPrimaryRestartNow = false
int splitPrimaryMinimumOriginBarIndex = na

if barstate.isconfirmed and timeframeSupported
    if detectionMode == "Manual window"
        if lifecycleState == STATE_SEARCHING and inAnalysisSession and inManualMoveWindow
            array.clear(movementLows)
            array.clear(movementHighs)
            array.clear(movementVolumes)
            array.clear(movementOpens)
            array.clear(movementCloses)
            array.clear(movementATRs)
            array.clear(movementTimes)
            array.clear(movementBarIndices)
            array.push(movementLows, low)
            array.push(movementHighs, high)
            array.push(movementVolumes, nz(volume))
            array.push(movementOpens, open)
            array.push(movementCloses, close)
            array.push(movementATRs, atrValue)
            array.push(movementTimes, time)
            array.push(movementBarIndices, bar_index)

            movementLow := low
            movementHigh := high
            movementPeakVolume := nz(volume)
            movementStartTime := time
            movementEndTime := time_close
            movementHighBarIndex := bar_index
            movementAcceptedEndBarIndex := bar_index
            movementAcceptedEndTime := time_close
            movementAcceptedHigh := high
            movementAcceptedClose := close
            movementTriggerBarIndex := bar_index
            movementTriggerTime := time
            movementStartedExceptionally := false
            movementWasStitched := false
            movementExceptionalProvisionalStitchUsed := false
            movementStitchDeadlineBarIndex := na
            movementStitchReferenceHigh := na
            movementStitchReferenceLow := na
            movementStitchPullbackLow := na
            movementStitchMaySplitRestart := false
            movementCompactGraceActive := false
            movementQualifiedAsCompact := false
            movementRecoveredThroughCompactGrace := false
            movementFreshParticipationResetUsed := false
            lifecycleState := STATE_BUILDING

        else if lifecycleState == STATE_BUILDING
            if inAnalysisSession and inManualMoveWindow
                array.push(movementLows, low)
                array.push(movementHighs, high)
                array.push(movementVolumes, nz(volume))
                array.push(movementOpens, open)
                array.push(movementCloses, close)
                array.push(movementATRs, atrValue)
                array.push(movementTimes, time)
                array.push(movementBarIndices, bar_index)

                movementLow := math.min(movementLow, low)
                if high >= movementHigh
                    movementHigh := high
                    movementHighBarIndex := bar_index
                movementPeakVolume := math.max(movementPeakVolume, nz(volume))
                movementEndTime := time_close
                movementAcceptedEndBarIndex := bar_index
                movementAcceptedEndTime := time_close
                movementAcceptedHigh := movementHigh
                movementAcceptedClose := close
            else
                freezeMovementNow := array.size(movementLows) >= 2 and movementHigh > movementLow
                discardMovementNow := not freezeMovementNow

    else
        bool ordinaryBullishMovementStart =
             lifecycleState == STATE_SEARCHING and
             inAnalysisSession and
             inAutoStartWindow and
             not na(atrValue) and
             not na(relativeVolume) and
             close > open and
             candleBody >= atrValue * startBodyATR and
             candleCloseLocation >= startCloseLocation and
             relativeVolume >= startRelativeVolume

        bool exceptionalBullishMovementStart =
             lifecycleState == STATE_SEARCHING and
             inAnalysisSession and
             inAutoStartWindow and
             enableExceptionalLaunchStart and
             not na(atrValue) and
             not na(relativeVolume) and
             close > open and
             candleBody >= atrValue * exceptionalLaunchBodyATR and
             candleCloseLocation >= exceptionalLaunchCloseLocation and
             relativeVolume >= exceptionalLaunchRelativeVolume

        bool bullishMovementStart =
             ordinaryBullishMovementStart or
             exceptionalBullishMovementStart

        bool freshParticipationResetNow =
             enableFreshParticipationReset and
             (
                  lifecycleState == STATE_BUILDING or
                  lifecycleState == STATE_STITCHING
             ) and
             inAnalysisSession and
             not movementFreshParticipationResetUsed and
             bar_index > 0 and
             not na(atrValue) and
             not na(movementPeakVolume) and
             time - time[1] >=
                  freshParticipationResetMinimumGapMinutes * 60000 and
             nz(volume) >=
                  freshParticipationResetMinimumAbsoluteVolume and
             movementPeakVolume <
                  freshParticipationResetMinimumAbsoluteVolume and
             nz(volume) >=
                  movementPeakVolume *
                  freshParticipationResetPeakVolumeRatio and
             close > open and
             candleBody >= atrValue * freshParticipationResetBodyATR and
             candleCloseLocation >=
                  freshParticipationResetCloseLocation and
             close > movementHigh

        if bullishMovementStart
            array.clear(movementLows)
            array.clear(movementHighs)
            array.clear(movementVolumes)
            array.clear(movementOpens)
            array.clear(movementCloses)
            array.clear(movementATRs)
            array.clear(movementTimes)
            array.clear(movementBarIndices)

            movementLow := low
            movementHigh := high
            movementPeakVolume := nz(volume)
            movementStartTime := time
            movementEndTime := time_close
            movementHighBarIndex := bar_index
            movementTriggerBarIndex := bar_index
            movementTriggerTime := time
            movementStartedExceptionally :=
                 exceptionalBullishMovementStart
            movementWasStitched := false
            movementExceptionalProvisionalStitchUsed := false
            movementStitchDeadlineBarIndex := na
            movementStitchReferenceHigh := na
            movementStitchReferenceLow := na
            movementStitchPullbackLow := na
            movementStitchMaySplitRestart := false
            movementCompactGraceActive := false
            movementQualifiedAsCompact := false
            movementRecoveredThroughCompactGrace := false
            movementFreshParticipationResetUsed := false

            // A fully qualified trigger can arrive after the actual initiative
            // candle. Search backward for the earliest still-preserved bullish
            // origin, then fall back to the ordinary fixed context setting.
            int contextBarsToInclude = autoPreTriggerBars
            bool adaptiveOriginFound = false
            int originSearchOffset = adaptiveMovementOriginLookbackBars
            while enableAdaptiveMovementOrigin and
                 originSearchOffset > autoPreTriggerBars
                float originRange =
                     high[originSearchOffset] - low[originSearchOffset]
                float originBody =
                     close[originSearchOffset] - open[originSearchOffset]
                float originCloseLocation =
                     originRange > 0.0 ?
                     (close[originSearchOffset] -
                          low[originSearchOffset]) / originRange :
                     0.5
                float originRelativeVolume =
                     not na(volumeAverage[originSearchOffset]) and
                     volumeAverage[originSearchOffset] > 0.0 ?
                     volume[originSearchOffset] /
                          volumeAverage[originSearchOffset] :
                     na
                bool originSequenceContiguous =
                     inAnalysisSession[originSearchOffset] and
                     activeMarketSession[originSearchOffset] ==
                          activeMarketSession and
                     currentDateKey[originSearchOffset] == currentDateKey and
                     time - time[originSearchOffset] <=
                          timeframe.in_seconds(timeframe.period) *
                          1000 * originSearchOffset +
                          adaptiveOriginMaximumGapMinutes * 60000
                bool originFloorHeld = true
                int floorCheckOffset = originSearchOffset - 1
                while floorCheckOffset >= 0 and originFloorHeld
                    if low[floorCheckOffset] <
                         low[originSearchOffset] -
                         atrValue[originSearchOffset] *
                         adaptiveOriginFloorToleranceATR
                        originFloorHeld := false
                    floorCheckOffset -= 1
                bool originBreaksPriorHigh =
                     not adaptiveOriginMustBreakPriorHigh or
                     (
                          not na(high[originSearchOffset + 1]) and
                          close[originSearchOffset] >
                               high[originSearchOffset + 1]
                     )
                bool originAuctionStructureHeld = true
                float originSequencePeakHigh =
                     high[originSearchOffset]
                int originStructureOffset = originSearchOffset - 1
                while originStructureOffset >= 0 and
                     originAuctionStructureHeld
                    float originStructureRange =
                         originSequencePeakHigh -
                         low[originSearchOffset]
                    if high[originStructureOffset] >
                         originSequencePeakHigh
                        originSequencePeakHigh :=
                             high[originStructureOffset]
                    else if originStructureRange > syminfo.mintick and
                         low[originStructureOffset] <
                              originSequencePeakHigh -
                              originStructureRange *
                              adaptiveOriginMaximumRetracementShare
                        originAuctionStructureHeld := false
                    originStructureOffset -= 1
                bool adaptiveOriginCandidate =
                     not adaptiveOriginFound and
                     originSequenceContiguous and
                     originFloorHeld and
                     originBreaksPriorHigh and
                     originAuctionStructureHeld and
                     not na(atrValue[originSearchOffset]) and
                     not na(originRelativeVolume) and
                     volume[originSearchOffset] >=
                          adaptiveOriginMinimumAbsoluteVolume and
                     originBody >=
                          atrValue[originSearchOffset] *
                          adaptiveOriginMinimumBodyATR and
                     originCloseLocation >= startCloseLocation and
                     originRelativeVolume >=
                          adaptiveOriginMinimumRelativeVolume and
                     close > high[originSearchOffset]
                if adaptiveOriginCandidate
                    contextBarsToInclude := originSearchOffset
                    adaptiveOriginFound := true
                originSearchOffset -= 1

            int contextOffset = contextBarsToInclude
            while contextOffset >= 1
                bool contextBarEligible =
                     inAnalysisSession[contextOffset] and
                     activeMarketSession[contextOffset] == activeMarketSession and
                     currentDateKey[contextOffset] == currentDateKey and
                     time - time[contextOffset] <=
                          timeframe.in_seconds(timeframe.period) *
                          1000 * contextOffset +
                          adaptiveOriginMaximumGapMinutes * 60000
                if contextBarEligible
                    array.push(movementLows, low[contextOffset])
                    array.push(movementHighs, high[contextOffset])
                    array.push(movementVolumes, nz(volume[contextOffset]))
                    array.push(movementOpens, open[contextOffset])
                    array.push(movementCloses, close[contextOffset])
                    array.push(movementATRs, atrValue[contextOffset])
                    array.push(movementTimes, time[contextOffset])
                    array.push(movementBarIndices, bar_index - contextOffset)
                    movementLow := math.min(movementLow, low[contextOffset])
                    if high[contextOffset] > movementHigh
                        movementHigh := high[contextOffset]
                        movementHighBarIndex := bar_index - contextOffset
                    movementPeakVolume := math.max(movementPeakVolume, nz(volume[contextOffset]))
                    movementStartTime := math.min(movementStartTime, time[contextOffset])
                contextOffset -= 1

            array.push(movementLows, low)
            array.push(movementHighs, high)
            array.push(movementVolumes, nz(volume))
            array.push(movementOpens, open)
            array.push(movementCloses, close)
            array.push(movementATRs, atrValue)
            array.push(movementTimes, time)
            array.push(movementBarIndices, bar_index)

            // Prefer the current bar when it ties or exceeds the seeded high,
            // matching the normal movement-high tracking behavior.
            if high >= movementHigh
                movementHigh := high
                movementHighBarIndex := bar_index
            movementAcceptedEndBarIndex := bar_index
            movementAcceptedEndTime := time_close
            movementAcceptedHigh := movementHigh
            movementAcceptedClose := close
            lifecycleState := STATE_BUILDING

        else if freshParticipationResetNow
            array.clear(movementLows)
            array.clear(movementHighs)
            array.clear(movementVolumes)
            array.clear(movementOpens)
            array.clear(movementCloses)
            array.clear(movementATRs)
            array.clear(movementTimes)
            array.clear(movementBarIndices)

            array.push(movementLows, low)
            array.push(movementHighs, high)
            array.push(movementVolumes, nz(volume))
            array.push(movementOpens, open)
            array.push(movementCloses, close)
            array.push(movementATRs, atrValue)
            array.push(movementTimes, time)
            array.push(movementBarIndices, bar_index)

            movementLow := low
            movementHigh := high
            movementPeakVolume := nz(volume)
            movementStartTime := time
            movementEndTime := time_close
            movementHighBarIndex := bar_index
            movementAcceptedEndBarIndex := bar_index
            movementAcceptedEndTime := time_close
            movementAcceptedHigh := high
            movementAcceptedClose := close
            movementTriggerBarIndex := bar_index
            movementTriggerTime := time
            movementStartedExceptionally := true
            movementWasStitched := false
            movementExceptionalProvisionalStitchUsed := false
            movementStitchDeadlineBarIndex := na
            movementStitchReferenceHigh := na
            movementStitchReferenceLow := na
            movementStitchPullbackLow := na
            movementStitchMaySplitRestart := false
            movementCompactGraceActive := false
            movementQualifiedAsCompact := false
            movementRecoveredThroughCompactGrace := false
            movementFreshParticipationResetUsed := true
            lifecycleState := STATE_BUILDING

        else if lifecycleState == STATE_BUILDING
            if inAnalysisSession
                float movementHighBeforeCurrentBar = movementHigh
                array.push(movementLows, low)
                array.push(movementHighs, high)
                array.push(movementVolumes, nz(volume))
                array.push(movementOpens, open)
                array.push(movementCloses, close)
                array.push(movementATRs, atrValue)
                array.push(movementTimes, time)
                array.push(movementBarIndices, bar_index)

                movementLow := math.min(movementLow, low)
                if high >= movementHigh
                    movementHigh := high
                    movementHighBarIndex := bar_index
                movementPeakVolume := math.max(movementPeakVolume, nz(volume))
                movementEndTime := time_close

                bool movementAcceptedHighExtension =
                     not na(movementAcceptedHigh) and
                     not na(movementAcceptedClose) and
                     high >
                          movementAcceptedHigh +
                          atrValue *
                          acceptedDevelopmentHighExtensionATR and
                     close >=
                          movementAcceptedClose -
                          atrValue * acceptedDevelopmentCloseBackoffATR and
                     candleCloseLocation >=
                          acceptedDevelopmentMinimumCloseLocation
                bool movementAcceptedNearHighRecovery =
                     not na(movementAcceptedHigh) and
                     not na(relativeVolume) and
                     close > open and
                     candleBody >=
                          atrValue *
                          acceptedDevelopmentRecoveryBodyATR and
                     candleCloseLocation >=
                          acceptedDevelopmentRecoveryCloseLocation and
                     relativeVolume >=
                          acceptedDevelopmentRecoveryRelativeVolume and
                     close >=
                          movementAcceptedHigh -
                          atrValue * extendedStitchNearHighATR
                bool movementAcceptedDevelopment =
                     (
                          movementFreshParticipationResetUsed and
                          high > movementHighBeforeCurrentBar +
                               atrValue *
                               acceptedDevelopmentAbsoluteHighATR
                     ) or
                     movementAcceptedHighExtension or
                     movementAcceptedNearHighRecovery
                if movementAcceptedDevelopment
                    movementAcceptedEndBarIndex := bar_index
                    movementAcceptedEndTime := time_close
                    movementAcceptedHigh :=
                         math.max(movementAcceptedHigh, high)
                    movementAcceptedClose := close

                int movementBarCount = array.size(movementLows)
                int barsSinceMovementDevelopment =
                     bar_index - movementAcceptedEndBarIndex
                float movementCumulativeVolumeNow =
                     array.sum(movementVolumes)
                bool movementIsStandardLargeEnough =
                     movementBarCount >= minimumMoveBars and
                     not na(atrValue) and
                     movementHigh - movementLow >= atrValue * minimumMoveRangeATR
                bool movementIsCompactLargeEnough =
                     enableCompactHighParticipationProfiles and
                     movementBarCount >= minimumMoveBars and
                     not na(atrValue) and
                     movementHigh - movementLow >=
                          atrValue * compactProfileMinimumRangeATR and
                     movementCumulativeVolumeNow >=
                          compactProfileMinimumCumulativeVolume
                bool movementIsLargeEnough =
                     movementIsStandardLargeEnough or
                     movementIsCompactLargeEnough
                if movementIsStandardLargeEnough
                    movementQualifiedAsCompact := false
                bool movementOrdinarySupportedPause =
                     movementBarCount >= minimumMoveBars and
                     not na(atrValue) and
                     movementHigh - movementLow >=
                          atrValue * developingMovePauseMinimumRangeATR
                int primaryTriggerOffset =
                     not na(movementTriggerBarIndex) ?
                     bar_index - movementTriggerBarIndex : na
                int primaryLeadInOffset =
                     not na(primaryTriggerOffset) ?
                     primaryTriggerOffset + 1 : na
                float primaryLeadInRange =
                     not na(primaryLeadInOffset) ?
                     high[primaryLeadInOffset] -
                          low[primaryLeadInOffset] : na
                float primaryLeadInBody =
                     not na(primaryLeadInOffset) ?
                     close[primaryLeadInOffset] -
                          open[primaryLeadInOffset] : na
                float primaryLeadInCloseLocation =
                     not na(primaryLeadInRange) and
                     primaryLeadInRange > 0.0 ?
                     (close[primaryLeadInOffset] -
                          low[primaryLeadInOffset]) /
                          primaryLeadInRange : 0.5
                float primaryLeadInRelativeVolume =
                     not na(primaryLeadInOffset) and
                     not na(volumeAverage[primaryLeadInOffset]) and
                     volumeAverage[primaryLeadInOffset] > 0.0 ?
                     volume[primaryLeadInOffset] /
                          volumeAverage[primaryLeadInOffset] : na
                bool primaryExceptionalLeadInQualified =
                     enableExceptionalProvisionalStitch and
                     movementStartedExceptionally and
                     not na(primaryTriggerOffset) and
                     not na(primaryLeadInOffset) and
                     primaryLeadInOffset + 1 <= bar_index and
                     array.size(movementBarIndices) > 0 and
                     array.first(movementBarIndices) ==
                          movementTriggerBarIndex and
                     inAnalysisSession[primaryLeadInOffset] and
                     activeMarketSession[primaryLeadInOffset] ==
                          activeMarketSession[primaryTriggerOffset] and
                     currentDateKey[primaryLeadInOffset] ==
                          currentDateKey[primaryTriggerOffset] and
                     time[primaryTriggerOffset] -
                          time[primaryLeadInOffset] <=
                          timeframe.in_seconds(timeframe.period) * 1000 +
                          adaptiveOriginMaximumGapMinutes * 60000 and
                     movementLow >=
                          low[primaryLeadInOffset] -
                          atrValue[primaryLeadInOffset] *
                          adaptiveOriginFloorToleranceATR and
                     not na(atrValue[primaryLeadInOffset]) and
                     not na(primaryLeadInRelativeVolume) and
                     primaryLeadInBody >=
                          atrValue[primaryLeadInOffset] *
                          exceptionalLaunchBodyATR and
                     primaryLeadInCloseLocation >= startCloseLocation and
                     primaryLeadInRelativeVolume >=
                          exceptionalProvisionalLeadInRelativeVolume and
                     close[primaryLeadInOffset] >
                          high[primaryLeadInOffset + 1] and
                     close[primaryTriggerOffset] >
                          high[primaryLeadInOffset]
                bool primaryExceptionalProvisionalPause =
                     primaryExceptionalLeadInQualified and
                     movementBarCount >= math.max(2, minimumMoveBars - 1) and
                     not na(atrValue) and
                     movementHigh - movementLow >=
                          atrValue * developingMovePauseMinimumRangeATR and
                     movementCumulativeVolumeNow >=
                          minimumMoveCumulativeVolume
                int primaryAcceptedDevelopmentBarCount =
                     not na(movementAcceptedEndBarIndex) and
                     not na(movementTriggerBarIndex) ?
                     movementAcceptedEndBarIndex -
                          movementTriggerBarIndex + 1 : 0
                bool primaryExceptionalAcceptedWindowStillProvisional =
                     primaryExceptionalLeadInQualified and
                     primaryAcceptedDevelopmentBarCount < minimumMoveBars
                bool movementCanWaitThroughSupportedPause =
                     movementOrdinarySupportedPause or
                     primaryExceptionalProvisionalPause
                bool movementCompactGraceEligible =
                     enableCompactHighParticipationProfiles and
                     not movementIsLargeEnough and
                     movementCanWaitThroughSupportedPause and
                     movementCumulativeVolumeNow >=
                          compactProfileMinimumCumulativeVolume
                float primaryPauseReferenceRange =
                     movementAcceptedHigh - movementLow
                float primaryPauseRecentLow =
                     ta.lowest(low, contractionBars)
                bool primaryPauseStructureHeld =
                     primaryPauseReferenceRange > syminfo.mintick and
                     primaryPauseRecentLow >=
                          movementAcceptedHigh -
                          primaryPauseReferenceRange *
                          extendedStitchMaximumRetracementShare
                bool movementHasStalled =
                     barsSinceMovementDevelopment >= contractionBars
                bool movementReachedMaximum = movementBarCount >= maximumMoveBars
                bool primaryPauseHeldEMA9 =
                     enableEMA9MovementStitching and
                     movementCanWaitThroughSupportedPause and
                     (
                          movementIsStandardLargeEnough and
                          not primaryExceptionalAcceptedWindowStillProvisional ?
                          (
                               not na(recentEMA9MinimumCloseDifference) and
                               not na(recentEMA9MinimumLowDistance) and
                               recentEMA9MinimumCloseDifference >=
                                    -atrValue * ema9StitchCloseToleranceATR and
                               recentEMA9MinimumLowDistance <=
                                    atrValue * ema9StitchTouchDistanceATR
                          ) :
                          primaryPauseStructureHeld
                     ) and
                     movementHasStalled and
                     not movementReachedMaximum and
                     not na(atrValue)

                if movementRecoveredThroughCompactGrace and
                     movementIsCompactLargeEnough and
                     not movementIsStandardLargeEnough and
                     movementHasStalled and
                     not movementReachedMaximum
                    movementQualifiedAsCompact := true
                    freezeMovementNow := true
                else if primaryPauseHeldEMA9
                    movementExceptionalProvisionalStitchUsed :=
                         movementExceptionalProvisionalStitchUsed or
                         primaryExceptionalProvisionalPause or
                         primaryExceptionalAcceptedWindowStillProvisional
                    movementQualifiedAsCompact :=
                         movementQualifiedAsCompact or
                         (
                              movementIsCompactLargeEnough and
                              not movementIsStandardLargeEnough
                         )
                    lifecycleState := STATE_STITCHING
                    movementStitchDeadlineBarIndex :=
                         bar_index +
                         (
                              enableExtendedSupportedPause ?
                              extendedStitchRestartWindowBars :
                              ema9StitchRestartWindowBars
                         )
                    movementStitchReferenceHigh := movementAcceptedHigh
                    movementStitchReferenceLow := movementLow
                    movementStitchPullbackLow := low
                    movementStitchMaySplitRestart :=
                         movementIsStandardLargeEnough
                    movementCompactGraceActive := false
                else if movementCompactGraceEligible and
                     movementHasStalled and
                     not movementReachedMaximum
                    lifecycleState := STATE_STITCHING
                    movementStitchDeadlineBarIndex :=
                         bar_index + compactProfileRecoveryGraceBars
                    movementStitchReferenceHigh := movementAcceptedHigh
                    movementStitchReferenceLow := movementLow
                    movementStitchPullbackLow := low
                    movementStitchMaySplitRestart := false
                    movementCompactGraceActive := true
                else
                    movementQualifiedAsCompact :=
                         movementQualifiedAsCompact or
                         (
                              movementIsCompactLargeEnough and
                              not movementIsStandardLargeEnough
                         )
                    freezeMovementNow :=
                         movementIsLargeEnough and
                         (movementHasStalled or movementReachedMaximum)
                    discardMovementNow :=
                         not movementIsLargeEnough and
                         (movementHasStalled or movementReachedMaximum)
            else
                int movementBarCount = array.size(movementLows)
                bool movementIsLargeEnough =
                     movementBarCount >= minimumMoveBars and
                     not na(atrValue[1]) and
                     movementHigh - movementLow >= atrValue[1] * minimumMoveRangeATR
                freezeMovementNow := movementIsLargeEnough
                discardMovementNow := not movementIsLargeEnough

        else if lifecycleState == STATE_STITCHING
            if inAnalysisSession
                array.push(movementLows, low)
                array.push(movementHighs, high)
                array.push(movementVolumes, nz(volume))
                array.push(movementOpens, open)
                array.push(movementCloses, close)
                array.push(movementATRs, atrValue)
                array.push(movementTimes, time)
                array.push(movementBarIndices, bar_index)

                movementLow := math.min(movementLow, low)
                if high >= movementHigh
                    movementHigh := high
                    movementHighBarIndex := bar_index
                movementPeakVolume :=
                     math.max(movementPeakVolume, nz(volume))
                movementEndTime := time_close
                movementStitchPullbackLow :=
                     na(movementStitchPullbackLow) ?
                     low :
                     math.min(movementStitchPullbackLow, low)

                bool ordinaryPrimaryStitchRestart =
                     not na(atrValue) and
                     not na(relativeVolume) and
                     close > open and
                     candleBody >= atrValue * startBodyATR and
                     candleCloseLocation >= startCloseLocation and
                     relativeVolume >= startRelativeVolume
                bool exceptionalPrimaryStitchRestart =
                     enableExceptionalLaunchStart and
                     not na(atrValue) and
                     not na(relativeVolume) and
                     close > open and
                     candleBody >=
                          atrValue * exceptionalLaunchBodyATR and
                     candleCloseLocation >=
                          exceptionalLaunchCloseLocation and
                     relativeVolume >=
                          exceptionalLaunchRelativeVolume
                bool strongPrimaryStitchRestart =
                     not na(movementStitchReferenceHigh) and
                     high > movementStitchReferenceHigh and
                     close > movementStitchReferenceHigh and
                     (
                          ordinaryPrimaryStitchRestart or
                          exceptionalPrimaryStitchRestart
                     )
                bool compactPrimaryStitchRestart =
                     movementCompactGraceActive and
                     not na(movementStitchReferenceHigh) and
                     not na(atrValue) and
                     not na(relativeVolume) and
                     close > open and
                     high > movementStitchReferenceHigh and
                     close > movementStitchReferenceHigh and
                     candleBody >=
                          atrValue * compactProfileRecoveryBodyATR and
                     candleCloseLocation >=
                          compactProfileRecoveryCloseLocation and
                     relativeVolume >=
                          compactProfileRecoveryRelativeVolume
                float primaryStitchReferenceRange =
                     movementStitchReferenceHigh -
                     movementStitchReferenceLow
                bool primaryStitchStructureHeld =
                     not na(primaryStitchReferenceRange) and
                     primaryStitchReferenceRange > syminfo.mintick and
                     not na(movementStitchPullbackLow) and
                     movementStitchPullbackLow >=
                          movementStitchReferenceHigh -
                          primaryStitchReferenceRange *
                          extendedStitchMaximumRetracementShare
                bool primaryNearHighRecovery =
                     enableExtendedSupportedPause and
                     primaryStitchStructureHeld and
                     not na(atrValue) and
                     not na(relativeVolume) and
                     close > open and
                     candleBody >= atrValue * startBodyATR and
                     candleCloseLocation >=
                          extendedStitchMinimumCloseLocation and
                     relativeVolume >=
                          extendedStitchMinimumRelativeVolume and
                     close >=
                          movementStitchReferenceHigh -
                          atrValue * extendedStitchNearHighATR
                bool primaryStitchSupportFailed =
                     na(intradayEMA9) or
                     close <
                          intradayEMA9 -
                          atrValue * ema9StitchCloseToleranceATR
                bool primaryStitchWindowExpired =
                     not na(movementStitchDeadlineBarIndex) and
                     bar_index >= movementStitchDeadlineBarIndex
                bool primaryStitchReachedMaximum =
                     array.size(movementLows) >= maximumMoveBars
                bool primaryStitchMustEnd =
                     (
                          not enableExtendedSupportedPause and
                          primaryStitchSupportFailed
                     ) or
                     (
                          enableExtendedSupportedPause and
                          not primaryStitchStructureHeld
                     ) or
                     primaryStitchWindowExpired or
                     primaryStitchReachedMaximum

                if strongPrimaryStitchRestart and
                     movementStitchMaySplitRestart
                    splitPrimaryRestartNow := true
                    splitPrimaryMinimumOriginBarIndex :=
                         movementAcceptedEndBarIndex + 1
                    freezeMovementNow := true
                else if strongPrimaryStitchRestart or
                     compactPrimaryStitchRestart or
                     primaryNearHighRecovery
                    movementRecoveredThroughCompactGrace :=
                         movementRecoveredThroughCompactGrace or
                         movementCompactGraceActive
                    movementWasStitched := true
                    movementAcceptedEndBarIndex := bar_index
                    movementAcceptedEndTime := time_close
                    movementAcceptedHigh :=
                         math.max(movementAcceptedHigh, high)
                    movementAcceptedClose := close
                    lifecycleState := STATE_BUILDING
                    movementStitchDeadlineBarIndex := na
                    movementStitchReferenceHigh := na
                    movementStitchReferenceLow := na
                    movementStitchPullbackLow := na
                    movementStitchMaySplitRestart := false
                    movementCompactGraceActive := false
                else if primaryStitchMustEnd
                    if movementCompactGraceActive and
                         not movementStitchMaySplitRestart
                        discardMovementNow := true
                    else
                        freezeMovementNow := true
            else
                freezeMovementNow :=
                     array.size(movementLows) >= minimumMoveBars

if discardMovementNow
    lifecycleState := STATE_SEARCHING
    array.clear(movementLows)
    array.clear(movementHighs)
    array.clear(movementVolumes)
    array.clear(movementOpens)
    array.clear(movementCloses)
    array.clear(movementATRs)
    array.clear(movementTimes)
    array.clear(movementBarIndices)
    movementLow := na
    movementHigh := na
    movementPeakVolume := na
    movementStartTime := na
    movementEndTime := na
    movementHighBarIndex := na
    movementAcceptedEndBarIndex := na
    movementAcceptedEndTime := na
    movementAcceptedHigh := na
    movementAcceptedClose := na
    movementTriggerBarIndex := na
    movementTriggerTime := na
    movementStartedExceptionally := false
    movementWasStitched := false
    movementExceptionalProvisionalStitchUsed := false
    movementStitchDeadlineBarIndex := na
    movementStitchReferenceHigh := na
    movementStitchReferenceLow := na
    movementStitchPullbackLow := na
    movementStitchMaySplitRestart := false
    movementCompactGraceActive := false
    movementQualifiedAsCompact := false
    movementRecoveredThroughCompactGrace := false
    movementFreshParticipationResetUsed := false

if freezeMovementNow
    int compactPrimaryConfirmationStartBarIndex =
         not na(movementAcceptedEndBarIndex) ?
         movementAcceptedEndBarIndex + 1 : na
    int compactPrimaryConfirmationEndBarIndex = bar_index
    bool primaryProvisionalLeadInCompleted =
         not movementExceptionalProvisionalStitchUsed

    // Stop the profile at the last bar where accepted prices were still
    // developing upward. Bars needed to prove the stall remain live-safe
    // confirmation evidence, but they never alter the frozen auction.
    if detectionMode == "Auto" and
         not na(movementAcceptedEndBarIndex)
        while array.size(movementBarIndices) > 0 and
             array.last(movementBarIndices) >
                  movementAcceptedEndBarIndex
            array.pop(movementLows)
            array.pop(movementHighs)
            array.pop(movementVolumes)
            array.pop(movementOpens)
            array.pop(movementCloses)
            array.pop(movementATRs)
            array.pop(movementTimes)
            array.pop(movementBarIndices)

        if movementExceptionalProvisionalStitchUsed and
             array.size(movementBarIndices) > 0
            int primaryFreezeTriggerOffset =
                 bar_index - movementTriggerBarIndex
            int primaryFreezeLeadInOffset =
                 primaryFreezeTriggerOffset + 1
            float primaryFreezeLeadInRange =
                 high[primaryFreezeLeadInOffset] -
                 low[primaryFreezeLeadInOffset]
            float primaryFreezeLeadInBody =
                 close[primaryFreezeLeadInOffset] -
                 open[primaryFreezeLeadInOffset]
            float primaryFreezeLeadInCloseLocation =
                 primaryFreezeLeadInRange > 0.0 ?
                 (close[primaryFreezeLeadInOffset] -
                      low[primaryFreezeLeadInOffset]) /
                      primaryFreezeLeadInRange : 0.5
            float primaryFreezeLeadInRelativeVolume =
                 not na(volumeAverage[primaryFreezeLeadInOffset]) and
                 volumeAverage[primaryFreezeLeadInOffset] > 0.0 ?
                 volume[primaryFreezeLeadInOffset] /
                      volumeAverage[primaryFreezeLeadInOffset] : na
            bool primaryFreezeLeadInQualified =
                 primaryFreezeLeadInOffset + 1 <= bar_index and
                 array.first(movementBarIndices) ==
                      movementTriggerBarIndex and
                 inAnalysisSession[primaryFreezeLeadInOffset] and
                 activeMarketSession[primaryFreezeLeadInOffset] ==
                      activeMarketSession[primaryFreezeTriggerOffset] and
                 currentDateKey[primaryFreezeLeadInOffset] ==
                      currentDateKey[primaryFreezeTriggerOffset] and
                 time[primaryFreezeTriggerOffset] -
                      time[primaryFreezeLeadInOffset] <=
                      timeframe.in_seconds(timeframe.period) * 1000 +
                      adaptiveOriginMaximumGapMinutes * 60000 and
                 array.min(movementLows) >=
                      low[primaryFreezeLeadInOffset] -
                      atrValue[primaryFreezeLeadInOffset] *
                      adaptiveOriginFloorToleranceATR and
                 not na(atrValue[primaryFreezeLeadInOffset]) and
                 not na(primaryFreezeLeadInRelativeVolume) and
                 primaryFreezeLeadInBody >=
                      atrValue[primaryFreezeLeadInOffset] *
                      exceptionalLaunchBodyATR and
                 primaryFreezeLeadInCloseLocation >= startCloseLocation and
                 primaryFreezeLeadInRelativeVolume >=
                      exceptionalProvisionalLeadInRelativeVolume and
                 close[primaryFreezeLeadInOffset] >
                      high[primaryFreezeLeadInOffset + 1] and
                 close[primaryFreezeTriggerOffset] >
                      high[primaryFreezeLeadInOffset]
            if primaryFreezeLeadInQualified
                array.unshift(
                     movementLows,
                     low[primaryFreezeLeadInOffset])
                array.unshift(
                     movementHighs,
                     high[primaryFreezeLeadInOffset])
                array.unshift(
                     movementVolumes,
                     nz(volume[primaryFreezeLeadInOffset]))
                array.unshift(
                     movementOpens,
                     open[primaryFreezeLeadInOffset])
                array.unshift(
                     movementCloses,
                     close[primaryFreezeLeadInOffset])
                array.unshift(
                     movementATRs,
                     atrValue[primaryFreezeLeadInOffset])
                array.unshift(
                     movementTimes,
                     time[primaryFreezeLeadInOffset])
                array.unshift(
                     movementBarIndices,
                     bar_index - primaryFreezeLeadInOffset)
                primaryProvisionalLeadInCompleted := true
        if array.size(movementLows) > 0
            movementLow := array.min(movementLows)
            movementHigh := array.max(movementHighs)
            movementPeakVolume := array.max(movementVolumes)
            movementStartTime := array.first(movementTimes)
            movementEndTime := movementAcceptedEndTime

    float movementCumulativeVolume = array.sum(movementVolumes)
    bool movementVolumeQualified = movementCumulativeVolume >= minimumMoveCumulativeVolume

    array<float> calculatedProfile = f_calculateProfile(
         movementLows,
         movementHighs,
         movementVolumes,
         movementLow,
         movementHigh,
         profileRows,
         valueAreaPercent / 100.0)

    float calculatedVAL = array.get(calculatedProfile, 0)
    float calculatedPOC = array.get(calculatedProfile, 1)
    float calculatedVAH = array.get(calculatedProfile, 2)

    bool matureTopHeavyProfile =
         array.size(movementLows) >= matureTopHeavyProfileMinimumBars and
         movementCumulativeVolume >= matureTopHeavyProfileMinimumVolume

    bool primaryProvisionalStructureCompleted =
         primaryProvisionalLeadInCompleted and
         (
              not movementExceptionalProvisionalStitchUsed or
              (
                   array.size(movementLows) >= minimumMoveBars and
                   array.size(movementATRs) > 0 and
                   movementHigh - movementLow >=
                        array.last(movementATRs) * minimumMoveRangeATR
              )
         )

    bool profileValuesReady =
         movementVolumeQualified and
         primaryProvisionalStructureCompleted and
         not na(calculatedVAL) and
         not na(calculatedPOC) and
         not na(calculatedVAH) and
         movementHigh > movementLow and
         (
              detectionMode == "Manual window" or
              (movementHigh - calculatedVAH) /
                   (movementHigh - movementLow) >=
                   minimumProfileUpperExcessShare or
              matureTopHeavyProfile
         )
    if profileValuesReady
        int primaryInitialPOCExtensionEndTime = time_close
        bool primaryPOCStoppedBeforeFreeze = false
        int primaryPOCStopScanOffset =
             bar_index - movementAcceptedEndBarIndex - 1
        while primaryPOCStopScanOffset >= 0 and
             not primaryPOCStoppedBeforeFreeze
            if close[primaryPOCStopScanOffset] <
                 calculatedPOC *
                 (1.0 - pocExtensionStopBelowPercent / 100.0)
                primaryInitialPOCExtensionEndTime :=
                     time[primaryPOCStopScanOffset]
                primaryPOCStoppedBeforeFreeze := true
            primaryPOCStopScanOffset -= 1

        profileVAL := calculatedVAL
        profilePOC := calculatedPOC
        profileVAH := calculatedVAH
        profileVWAPAtFreeze := sessionVWAP
        profileReadyBarIndex := bar_index
        profileLastVisibleTime := primaryInitialPOCExtensionEndTime
        profilePOCExtensionStopped := primaryPOCStoppedBeforeFreeze
        lifecycleState := STATE_PROFILE

        valDefended := false
        valInvalidated := false
        valInvalidationMarked := false
        consecutiveClosesBelowProfileLow := 0
        profileRecoveryStage := 0
        pocDefenseArmed := true
        lastPOCDefenseBarIndex := na
        failedPOCAttempts := 0
        profileInternalFailedPOCAttempts := 0
        lastPOCAttemptBarIndex := na
        vahDefenseArmed := true
        lastVAHDefenseBarIndex := na
        vahDefenseCandidateActive := false
        vahDefenseCandidateBarIndex := na
        vahDefenseCandidateTime := na
        vahDefenseCandidateOpen := na
        vahDefenseCandidateHigh := na
        vahDefenseCandidateLow := na
        vahDefenseCandidateClose := na
        vahDefenseCandidateVolume := na
        vahDefenseCandidateLowerWickShare := na
        breakoutPending := false
        breakoutConfirmed := false
        breakoutPath := ""
        activeEntryLabel := na

        if showMovementBox
            activeMovementBox := box.new(
                 left = movementStartTime,
                 top = movementHigh,
                 right = movementEndTime,
                 bottom = movementLow,
                 xloc = xloc.bar_time,
                 border_color = color.new(vahColor, 45),
                 border_width = 1,
                 bgcolor = color.new(vahColor, 91))
            array.push(retainedMovementBoxes, activeMovementBox)
            if array.size(retainedMovementBoxes) > maximumHistoricalProfiles
                box.delete(array.shift(retainedMovementBoxes))

        activeVALLine := line.new(
             x1 = movementStartTime,
             y1 = profileVAL,
             x2 = movementEndTime,
             y2 = profileVAL,
             xloc = xloc.bar_time,
             extend = extend.none,
             color = valColor,
             width = 2)

        activePOCLine := line.new(
             x1 = movementStartTime,
             y1 = profilePOC,
             x2 = profileLastVisibleTime,
             y2 = profilePOC,
             xloc = xloc.bar_time,
             extend = extend.none,
             color = pocColor,
             width = 2,
             style = line.style_dashed)

        activeVAHLine := line.new(
             x1 = movementStartTime,
             y1 = profileVAH,
             x2 = movementEndTime,
             y2 = profileVAH,
             xloc = xloc.bar_time,
             extend = extend.none,
             color = vahColor,
             width = 2)

        array.push(retainedProfileLines, activeVALLine)
        array.push(retainedProfileLines, activePOCLine)
        array.push(retainedProfileLines, activeVAHLine)
        while array.size(retainedProfileLines) > maximumHistoricalProfiles * 3
            line.delete(array.shift(retainedProfileLines))

        if enableVALSweepPOCReclaim
            f_registerVALSweepPOCProfile(
                 valSweepPOCProfiles,
                 1,
                 currentDateKey,
                 activeMarketSession,
                 movementStartTime,
                 movementEndTime,
                 bar_index,
                 movementLow,
                 movementHigh,
                 profileVAL,
                 profilePOC,
                 profileVAH)

        float primaryVALElevation =
             movementHigh > movementLow ?
             (profileVAL - movementLow) /
                  (movementHigh - movementLow) :
             0.0
        float primaryDominanceScore =
             movementCumulativeVolume *
             math.max(movementHigh - movementLow, syminfo.mintick)
        if enableStackedMeaningfulVALProfiles
            f_registerMeaningfulVALProfile(
                 meaningfulVALProfiles,
                 currentDateKey,
                 activeMarketSession,
                 movementStartTime,
                 movementEndTime,
                 bar_index,
                 movementLow,
                 movementHigh,
                 profileVAL,
                 profilePOC,
                 profileVAH,
                 movementCumulativeVolume,
                 atrValue,
                 activeVALLine,
                 activePOCLine,
                 activeVAHLine,
                 primaryPOCStoppedBeforeFreeze)
        bool primaryDominantElevationQualified =
             primaryVALElevation >=
                  dominantMinimumVALElevationPercent / 100.0
        bool primaryDominantIsLater =
             na(dominantReferenceEndTime) or
             movementEndTime > dominantReferenceEndTime
        bool primaryDominantScoreQualified =
             not dominantReferenceReady or
             dominantReferenceInvalidated or
             primaryDominanceScore >=
                  dominantReferenceScore *
                  dominantReplacementScoreRatio
        bool selectPrimaryAsDominant =
             enableDominantProfileVALReference and
             not enableStackedMeaningfulVALProfiles and
             primaryDominantElevationQualified and
             primaryDominantIsLater and
             primaryDominantScoreQualified

        if selectPrimaryAsDominant
            if not na(dominantReferenceVALLine)
                line.delete(dominantReferenceVALLine)
            if not na(dominantReferencePOCLine)
                line.delete(dominantReferencePOCLine)
            if not na(dominantReferenceVAHLine)
                line.delete(dominantReferenceVAHLine)

            dominantReferenceReady := true
            dominantReferenceInvalidated := false
            dominantReferenceDateKey := currentDateKey
            dominantReferenceSessionId := activeMarketSession
            dominantReferenceStartTime := movementStartTime
            dominantReferenceEndTime := movementEndTime
            dominantReferenceReadyBarIndex := bar_index
            dominantReferenceAgeTradingDates := 0
            dominantReferenceMovementLow := movementLow
            dominantReferenceMovementHigh := movementHigh
            dominantReferenceVAL := profileVAL
            dominantReferencePOC := profilePOC
            dominantReferenceVAH := profileVAH
            dominantReferenceCumulativeVolume :=
                 movementCumulativeVolume
            dominantReferenceScore := primaryDominanceScore
            dominantReferenceClosesBelowLow := 0
            dominantReferencePOCExtensionStopped :=
                 primaryPOCStoppedBeforeFreeze
            dominantReferenceDefenseArmed := true
            dominantReferenceTestActive := false
            dominantReferenceTestBarIndex := na
            dominantReferenceTestTime := na
            dominantReferenceTestLow := na

            dominantReferenceVALLine := line.new(
                 x1 = movementStartTime,
                 y1 = profileVAL,
                 x2 = movementEndTime,
                 y2 = profileVAL,
                 xloc = xloc.bar_time,
                 extend = extend.none,
                 color = color.new(valColor, 0),
                 width = 4)
            dominantReferencePOCLine := line.new(
                 x1 = movementStartTime,
                 y1 = profilePOC,
                 x2 = primaryInitialPOCExtensionEndTime,
                 y2 = profilePOC,
                 xloc = xloc.bar_time,
                 extend = extend.none,
                 color = pocColor,
                 width = 3,
                 style = line.style_dashed)
            dominantReferenceVAHLine := line.new(
                 x1 = movementStartTime,
                 y1 = profileVAH,
                 x2 = movementEndTime,
                 y2 = profileVAH,
                 xloc = xloc.bar_time,
                 extend = extend.none,
                 color = vahColor,
                 width = 3)

        // A compact auction can finish only after its first support test has
        // already occurred. Replay the excluded confirmation bars against the
        // now-frozen POC, while keeping the alert live-safe on this freeze bar.
        if movementQualifiedAsCompact and
             not na(compactPrimaryConfirmationStartBarIndex) and
             compactPrimaryConfirmationStartBarIndex <=
                  compactPrimaryConfirmationEndBarIndex
            bool compactPrimaryPOCDefenseArmed = true
            int compactPrimaryLastPOCDefenseBarIndex = na
            for compactPrimaryDefenseBarIndex =
                 compactPrimaryConfirmationStartBarIndex to
                 compactPrimaryConfirmationEndBarIndex
                int compactPrimaryDefenseOffset =
                     bar_index - compactPrimaryDefenseBarIndex
                float compactPrimaryOpen =
                     open[compactPrimaryDefenseOffset]
                float compactPrimaryHigh =
                     high[compactPrimaryDefenseOffset]
                float compactPrimaryLow =
                     low[compactPrimaryDefenseOffset]
                float compactPrimaryClose =
                     close[compactPrimaryDefenseOffset]
                float compactPrimaryATR =
                     atrValue[compactPrimaryDefenseOffset]
                float compactPrimaryVolumeAverage =
                     volumeAverage[compactPrimaryDefenseOffset]
                float compactPrimaryRelativeVolume =
                     not na(compactPrimaryVolumeAverage) and
                     compactPrimaryVolumeAverage > 0.0 ?
                     volume[compactPrimaryDefenseOffset] /
                          compactPrimaryVolumeAverage : na
                float compactPrimaryRange =
                     compactPrimaryHigh - compactPrimaryLow
                bool compactPrimaryPositiveBar =
                     compactPrimaryClose >= compactPrimaryOpen
                float compactPrimaryLowerWick =
                     (
                          compactPrimaryPositiveBar ?
                          compactPrimaryOpen : compactPrimaryClose
                     ) - compactPrimaryLow
                bool compactPrimaryBandCleared =
                     compactPrimaryLow >
                          profilePOC +
                          compactPrimaryATR * pocDefenseApproachATR
                if not compactPrimaryPOCDefenseArmed and
                     compactPrimaryBandCleared
                    compactPrimaryPOCDefenseArmed := true
                bool compactPrimarySpacingOk =
                     na(compactPrimaryLastPOCDefenseBarIndex) or
                     compactPrimaryDefenseBarIndex -
                          compactPrimaryLastPOCDefenseBarIndex >=
                          pocDefenseSpacingBars
                bool compactPrimaryHistoricalPOCDefense =
                     compactPrimaryPOCDefenseArmed and
                     close[compactPrimaryDefenseOffset + 1] > profilePOC and
                     compactPrimaryOpen > profilePOC and
                     compactPrimaryLow <=
                          profilePOC +
                          compactPrimaryATR * pocDefenseApproachATR and
                     compactPrimaryLow <
                          low[compactPrimaryDefenseOffset + 1] and
                     compactPrimaryOpen <
                          high[compactPrimaryDefenseOffset + 1] and
                     compactPrimaryClose >
                          profilePOC +
                          compactPrimaryATR * pocDefenseCloseBufferATR and
                     compactPrimaryLowerWick > 0.0 and
                     compactPrimaryRange > 0.0 and
                     compactPrimaryLowerWick >=
                          compactPrimaryRange *
                          pocDefenseMinimumLowerWickFraction and
                     not na(compactPrimaryRelativeVolume) and
                     compactPrimaryRelativeVolume >=
                          pocDefenseMinimumRelativeVolume and
                     compactPrimarySpacingOk
                if compactPrimaryHistoricalPOCDefense
                    compactPrimaryPOCDefenseArmed := false
                    compactPrimaryLastPOCDefenseBarIndex :=
                         compactPrimaryDefenseBarIndex
                    pocDefendedThisBar := true
                    line.set_color(activePOCLine, pocColor)
                    line.set_width(activePOCLine, 3)
                    if showPOCDefenseMarkers
                        label compactPrimaryPOCDefenseLabel = label.new(
                             x = time[compactPrimaryDefenseOffset],
                             y = compactPrimaryLow,
                             text = "POC\nDEFENDED",
                             xloc = xloc.bar_time,
                             yloc = yloc.price,
                             style = label.style_label_up,
                             color = pocColor,
                             textcolor = color.rgb(30, 30, 30),
                             size = size.tiny,
                             tooltip =
                                  "COMPACT PROFILE POC DEFENDED\n" +
                                  "Defense: " +
                                  str.format_time(
                                       time[compactPrimaryDefenseOffset],
                                       "HH:mm",
                                       syminfo.timezone) +
                                  "\nKnown when profile froze: " +
                                  str.format_time(
                                       time,
                                       "HH:mm",
                                       syminfo.timezone) +
                                  "\nPOC: " +
                                  str.tostring(profilePOC, format.mintick) +
                                  "\nVolume / average: " +
                                  str.tostring(
                                       compactPrimaryRelativeVolume,
                                       "#.##") + "×")
                        array.push(
                             retainedMarkers,
                             compactPrimaryPOCDefenseLabel)
            pocDefenseArmed := compactPrimaryPOCDefenseArmed
            lastPOCDefenseBarIndex :=
                 compactPrimaryLastPOCDefenseBarIndex

        // POC failures inside the movement cannot be known while the profile
        // is still building. Once the profile freezes, replay its stored bars
        // against the final POC and place qualifying labels on their true bars.
        int storedMovementBarCount = array.size(movementLows)
        if storedMovementBarCount > 0
            for storedMovementIndex = 0 to storedMovementBarCount - 1
                float storedOpen = array.get(
                     movementOpens,
                     storedMovementIndex)
                float storedHigh = array.get(
                     movementHighs,
                     storedMovementIndex)
                float storedClose = array.get(
                     movementCloses,
                     storedMovementIndex)
                float storedATR = array.get(
                     movementATRs,
                     storedMovementIndex)
                int storedTime = array.get(
                     movementTimes,
                     storedMovementIndex)
                int storedBarIndex = array.get(
                     movementBarIndices,
                     storedMovementIndex)

                bool storedATRReady =
                     not na(storedATR) and
                     storedATR > 0.0
                bool historicalOpensBelowPOC =
                     storedOpen < profilePOC
                bool historicalReachesPOC =
                     storedATRReady and
                     storedHigh >=
                     profilePOC +
                     storedATR * pocMinimumPenetrationATR
                bool historicalClosesNearOrBelowPOC =
                     storedATRReady and
                     storedClose <=
                     profilePOC +
                     storedATR * pocFailedCloseBandATR
                bool historicalRejectsDown =
                     storedATRReady and
                     storedHigh - storedClose >=
                     storedATR * pocMinimumDownwardRejectionATR
                bool historicalSpacingOk =
                     na(lastPOCAttemptBarIndex) or
                     storedBarIndex - lastPOCAttemptBarIndex >=
                     pocAttemptSpacingBars
                bool historicalPOCFail =
                     historicalOpensBelowPOC and
                     historicalReachesPOC and
                     historicalClosesNearOrBelowPOC and
                     historicalRejectsDown and
                     historicalSpacingOk

                if historicalPOCFail
                    failedPOCAttempts += 1
                    lastPOCAttemptBarIndex := storedBarIndex

                    if showPOCAttemptMarkers
                        string historicalAttemptTooltip =
                             "FAILED POC ATTEMPT #" +
                             str.tostring(failedPOCAttempts) +
                             "\nAttempt: " +
                             str.format_time(
                                  storedTime,
                                  "HH:mm",
                                  syminfo.timezone) +
                             "\nKnown when profile froze: " +
                             str.format_time(
                                  time,
                                  "HH:mm",
                                  syminfo.timezone) +
                             "\nPOC: " +
                             str.tostring(
                                  profilePOC,
                                  format.mintick) +
                             "\nOpen: " +
                             str.tostring(
                                  storedOpen,
                                  format.mintick) +
                             "\nHigh: " +
                             str.tostring(
                                  storedHigh,
                                  format.mintick) +
                             "\nClose: " +
                             str.tostring(
                                  storedClose,
                                  format.mintick) +
                             "\nDownward rejection: " +
                             str.tostring(
                                  storedHigh - storedClose,
                                  format.mintick)
                        float historicalAttemptY =
                             storedHigh +
                             storedATR * pocAttemptLabelDistanceATR
                        label historicalAttemptLabel = label.new(
                             x = storedTime,
                             y = historicalAttemptY,
                             text = "POC\nFAIL " +
                                  str.tostring(failedPOCAttempts),
                             xloc = xloc.bar_time,
                             yloc = yloc.price,
                             style = label.style_label_down,
                             color = color.new(pocColor, 5),
                             textcolor = color.rgb(30, 30, 30),
                             size = size.tiny,
                             tooltip = historicalAttemptTooltip)
                        array.push(
                             retainedMarkers,
                             historicalAttemptLabel)

        profileInternalFailedPOCAttempts := failedPOCAttempts

        if showFrozenProfileLabel
            string profileWindow =
                 str.format_time(movementStartTime, "HH:mm", syminfo.timezone) +
                 "–" +
                 str.format_time(movementEndTime, "HH:mm", syminfo.timezone)
            string profileSummary =
                 "FRVP FROZEN\n" +
                 profileWindow +
                 "\nVAL " + str.tostring(profileVAL, format.mintick) +
                 "  •  POC " + str.tostring(profilePOC, format.mintick) +
                 "  •  VAH " + str.tostring(profileVAH, format.mintick) +
                 "\nCumulative volume " + str.tostring(math.round(movementCumulativeVolume)) +
                 "\nStart trigger " +
                 (movementStartedExceptionally ? "exceptional" : "ordinary") +
                 "\nEMA-9 stitched " +
                 (movementWasStitched ? "yes" : "no") +
                 "\nFreeze VWAP " + str.tostring(profileVWAPAtFreeze, format.mintick)
            label profileLabel = label.new(
                 x = movementEndTime,
                 y = movementHigh,
                 text = "FRVP\nFROZEN",
                 xloc = xloc.bar_time,
                 yloc = yloc.price,
                 style = label.style_label_down,
                 color = color.new(vahColor, 5),
                 textcolor = color.white,
                 size = size.tiny,
                 tooltip = profileSummary)
            array.push(retainedMarkers, profileLabel)

    else
        lifecycleState := STATE_SEARCHING

//------------------------------------------------------------------------------
// Frozen-profile continuation lifecycle
//------------------------------------------------------------------------------

bool profileCanBeEvaluated =
     barstate.isconfirmed and
     timeframeSupported and
     lifecycleState == STATE_PROFILE and
     bar_index > profileReadyBarIndex and
     inAnalysisSession

bool confirmBreakoutNow = false

if profileCanBeEvaluated
    if not profilePOCExtensionStopped
        if close <
             profilePOC *
             (1.0 - pocExtensionStopBelowPercent / 100.0)
            profilePOCExtensionStopped := true
        else
            profileLastVisibleTime := time_close
            line.set_x2(activePOCLine, profileLastVisibleTime)

    // Trading below VAL does not invalidate the profile while price remains
    // inside its original range. Only sustained closes beneath the first
    // movement's absolute low invalidate the profile.
    bool closeAcceptedBelowProfileLow = close < movementLow
    consecutiveClosesBelowProfileLow :=
         closeAcceptedBelowProfileLow ? consecutiveClosesBelowProfileLow + 1 : 0

    bool profileInvalidatedThisBar =
         consecutiveClosesBelowProfileLow >= valInvalidationCloses and
         not valInvalidated

    if profileInvalidatedThisBar
        valInvalidated := true
        valEntryCandidateActive := false
        valEntryCandidateBarIndex := na
        valEntryCandidateTime := na
        valEntryCandidateHigh := na
        valEntryCandidateLow := na
        breakoutPending := false
        breakoutConfirmed := false
        activeEntryLabel := na
        profileRecoveryStage := 0

        if showVALInvalidation and not valInvalidationMarked
            label valLostLabel = label.new(
                 x = time,
                 y = low,
                 text = "FRVP\nLOST",
                 xloc = xloc.bar_time,
                 yloc = yloc.price,
                 style = label.style_label_up,
                 color = color.new(color.red, 5),
                 textcolor = color.white,
                 size = size.tiny,
                 tooltip =
                      "Price was accepted below the FRVP low " +
                      str.tostring(movementLow, format.mintick) +
                      " at " +
                      str.format_time(time, "HH:mm", syminfo.timezone))
            array.push(retainedMarkers, valLostLabel)
            valInvalidationMarked := true

    // An invalidated profile remains stored as market memory. It can return to
    // active use only through an ordered recovery: first regain VAL, then show
    // acceptance above POC on completed bars, and finally launch from inside
    // value through VAH with strong price and volume. Requiring the POC stage
    // to exist before the launch prevents one isolated candle from restoring
    // an obsolete profile.
    if valInvalidated and enableProfileReactivation
        int recoveryStageBeforeBar = profileRecoveryStage
        float recoveryBodyToRange =
             candleRange > 0.0 ? candleBody / candleRange : 0.0
        bool recoveryHadPriorPOCAcceptance =
             recoveryStageBeforeBar >= 2
        bool recoveryStartsInsideUpperValue =
             close[1] > profilePOC and
             close[1] <= profileVAH and
             open > profilePOC and
             open <= profileVAH
        bool recoveryHoldsAbovePOC =
             low >= profilePOC
        bool recoveryClosesDecisivelyAboveVAH =
             close >
             profileVAH +
             atrValue * pocFightVAHClearanceATR
        bool recoveryPriceQuality =
             close > open and
             candleBody >= atrValue * breakoutBodyATR and
             recoveryBodyToRange >= pocFightMinimumBodyRange and
             candleCloseLocation >= pocFightMinimumCloseLocation
        bool recoveryVolumeQuality =
             not na(relativeVolume) and
             relativeVolume >= breakoutRelativeVolume and
             not na(volume[1]) and
             volume[1] > 0.0 and
             volume >= volume[1] * pocFightPreviousVolumeMultiple
        bool orderedProfileRecovery =
             recoveryHadPriorPOCAcceptance and
             failedPOCAttempts >= minimumFailedPOCAttempts and
             recoveryStartsInsideUpperValue and
             recoveryHoldsAbovePOC and
             recoveryClosesDecisivelyAboveVAH and
             recoveryPriceQuality and
             recoveryVolumeQuality

        if orderedProfileRecovery
            valInvalidated := false
            valInvalidationMarked := false
            valDefended := true
            consecutiveClosesBelowProfileLow := 0
            profileRecoveryStage := 0
            profileReactivatedThisBar := true
            pocDefenseArmed := true
            vahDefenseArmed := true
        else
            profileRecoveryStage :=
                 close < profileVAL ? 0 :
                 close < profilePOC ? 1 : 2

    // Every completed candle is evaluated independently. A valid VAL defense
    // trades below VAL, recovers to close above it, and shows a lower wick that
    // is at least the configured fraction of its body. Its open is unrestricted.
    if not valInvalidated
        float valDefenseLowerWick = math.min(open, close) - low

        // The entry lifecycle is deliberately stricter than the general VAL
        // defense marker. A candidate may touch/undercut VAL or front-run it
        // slightly, but it must show participation, a meaningful rejection
        // wick, and a lower low. Entry is confirmed only on a later close above
        // the defense candle's high while every intervening low preserves its
        // floor.
        bool primaryVALEntryConfirmedNow = false
        if enableVALEntryConfirmation and
             not enableDominantProfileVALReference and
             valEntryCandidateActive
            int barsSinceVALEntryCandidate =
                 bar_index - valEntryCandidateBarIndex
            bool valEntryFloorBroken =
                 low < valEntryCandidateLow
            bool valEntryReachedPOC =
                 high >= profilePOC
            bool valEntryHighConfirmed =
                 barsSinceVALEntryCandidate >= 1 and
                 barsSinceVALEntryCandidate <=
                      valEntryConfirmationBars and
                 close > valEntryCandidateHigh

            if valEntryFloorBroken or valEntryReachedPOC
                valEntryCandidateActive := false
            else if valEntryHighConfirmed
                primaryVALEntryConfirmedNow := true
                valEntryConfirmedThisBar := true
                valEntryCandidateActive := false

                float valEntryLabelY =
                     low -
                     math.max(
                          atrValue * valEntryLabelDistanceATR,
                          high * 0.003)
                string valEntryTooltip =
                     "VAL ENTRY CONFIRMED\n" +
                     "Defense: " +
                     str.format_time(
                          valEntryCandidateTime,
                          "HH:mm",
                          syminfo.timezone) +
                     "\nConfirmed: " +
                     str.format_time(time, "HH:mm", syminfo.timezone) +
                     "\nVAL: " +
                     str.tostring(profileVAL, format.mintick) +
                     "\nDefended low: " +
                     str.tostring(
                          valEntryCandidateLow,
                          format.mintick) +
                     "\nDefense high: " +
                     str.tostring(
                          valEntryCandidateHigh,
                          format.mintick)

                if showEntryMarkers
                    label valEntryLabel = label.new(
                         x = time,
                         y = valEntryLabelY,
                         text = "VAL ENTRY\nCONFIRMED",
                         xloc = xloc.bar_time,
                         yloc = yloc.price,
                         style = label.style_label_up,
                         color = continuationColor,
                         textcolor = color.white,
                         size = size.tiny,
                         tooltip = valEntryTooltip)
                    array.push(retainedEntryMarkers, valEntryLabel)
            else if barsSinceVALEntryCandidate >=
                 valEntryConfirmationBars
                valEntryCandidateActive := false

        bool valEntryCandidateNearVAL =
             not na(atrValue) and
             atrValue > 0.0 and
             low >=
                  profileVAL -
                  atrValue * valEntryMaximumUndercutATR and
             low <=
                  profileVAL +
                  atrValue * valEntryMaximumFrontRunATR
        bool valEntryCandidateWickQuality =
             candleRange > 0.0 and
             valDefenseLowerWick >=
                  candleRange * valEntryMinimumLowerWickRange and
             valDefenseLowerWick >=
                  candleBody * valEntryMinimumLowerWickBody
        bool valEntryCandidateVolumeQuality =
             not na(relativeVolume) and
             relativeVolume > valEntryMinimumRelativeVolume
        bool primaryVALEntryCandidate =
             enableVALEntryConfirmation and
             not enableDominantProfileVALReference and
             not valEntryCandidateActive and
             not primaryVALEntryConfirmedNow and
             open > profileVAL and
             valEntryCandidateNearVAL and
             close > profileVAL and
             valEntryCandidateWickQuality and
             valEntryCandidateVolumeQuality and
             low < low[1]

        if primaryVALEntryCandidate
            valEntryCandidateActive := true
            valEntryCandidateBarIndex := bar_index
            valEntryCandidateTime := time
            valEntryCandidateHigh := high
            valEntryCandidateLow := low
            valDefended := true
            valDefendedThisBar := true
            line.set_color(activeVALLine, color.new(valColor, 0))
            line.set_width(activeVALLine, 3)

        bool valDefenseClosesAbove = close > profileVAL
        bool valDefenseTradesBelow = low < profileVAL
        bool valDefenseHasBody = candleBody > 0.0
        bool valDefenseLowerWickOk =
             valDefenseHasBody and
             valDefenseLowerWick >= candleBody * valMinimumLowerWickToBody
        bool directVALDefense =
             open > profileVAL and
             valDefenseClosesAbove and
             valDefenseTradesBelow and
             valDefenseLowerWickOk

        if directVALDefense
            valDefended := true
            line.set_color(activeVALLine, color.new(valColor, 0))
            line.set_width(activeVALLine, 3)

            if not enableDominantProfileVALReference
                valDefendedThisBar := true

            if showVALDefenseMarkers and
                 not enableDominantProfileVALReference
                string defenseTooltip =
                     "VAL DEFENDED\n" +
                     "Defense: " + str.format_time(time, "HH:mm", syminfo.timezone) +
                     "\nVAL: " + str.tostring(profileVAL, format.mintick) +
                     "\nOpen: " + str.tostring(open, format.mintick) +
                     "\nLow: " + str.tostring(low, format.mintick) +
                     "\nClose: " + str.tostring(close, format.mintick) +
                     "\nLower wick: " + str.tostring(valDefenseLowerWick, format.mintick) +
                     "\nBody: " + str.tostring(candleBody, format.mintick) +
                     "\nWick / body: " +
                     str.tostring(valDefenseLowerWick / candleBody * 100.0, "#.##") + "%"
                label defenseLabel = label.new(
                     x = time,
                     y = low,
                     text = "VAL\nDEFENDED",
                     xloc = xloc.bar_time,
                     yloc = yloc.price,
                     style = label.style_label_up,
                     color = color.new(valColor, 0),
                     textcolor = color.white,
                     size = size.tiny,
                     tooltip = defenseTooltip)
                array.push(retainedMarkers, defenseLabel)

    // A POC defense is the opposite of a POC FAIL. After each defense, price
    // must first leave the approach band above POC before another return can
    // produce a fresh label and alert.
    bool pocDefenseBandCleared =
         low > profilePOC + atrValue * pocDefenseApproachATR
    if not pocDefenseArmed and pocDefenseBandCleared
        pocDefenseArmed := true

    if pocDefenseArmed
        bool pocWasPreviouslyAcceptedAbove = close[1] > profilePOC
        bool pocDefenseOpensAbove = open > profilePOC
        bool pocDefenseTouchesOrApproachesPOC =
             low <= profilePOC + atrValue * pocDefenseApproachATR
        bool pocDefenseMakesLowerLow =
             low < low[1]
        bool pocDefenseOpensBelowPreviousHigh =
             open < high[1]
        bool pocDefenseClosesAbove =
             close > profilePOC + atrValue * pocDefenseCloseBufferATR
        bool pocDefensePositiveBar = close >= open
        float pocDefenseLowerWick =
             (pocDefensePositiveBar ? open : close) - low
        bool pocDefenseHasLowerWick =
             pocDefenseLowerWick > 0.0
        bool pocDefenseLowerWickShareOk =
             candleRange > 0.0 and
             pocDefenseLowerWick >=
             candleRange * pocDefenseMinimumLowerWickFraction
        bool pocDefenseVolumeQualified =
             not na(volume) and
             not na(volumeAverage) and
             volumeAverage > 0.0 and
             volume / volumeAverage >= pocDefenseMinimumRelativeVolume
        bool enoughBarsSinceLastPOCDefense =
             na(lastPOCDefenseBarIndex) or
             bar_index - lastPOCDefenseBarIndex >= pocDefenseSpacingBars
        bool directPOCDefense =
             pocWasPreviouslyAcceptedAbove and
             pocDefenseOpensAbove and
             pocDefenseTouchesOrApproachesPOC and
             pocDefenseMakesLowerLow and
             pocDefenseOpensBelowPreviousHigh and
             pocDefenseClosesAbove and
             pocDefenseHasLowerWick and
             pocDefenseLowerWickShareOk and
             pocDefenseVolumeQualified and
             enoughBarsSinceLastPOCDefense

        if directPOCDefense
            pocDefenseArmed := false
            lastPOCDefenseBarIndex := bar_index
            pocDefendedThisBar := true
            line.set_color(activePOCLine, pocColor)
            line.set_width(activePOCLine, 3)

            if showPOCDefenseMarkers
                string pocDefenseTooltip =
                     "POC DEFENDED\n" +
                     "Time: " + str.format_time(time, "HH:mm", syminfo.timezone) +
                     "\nPOC: " + str.tostring(profilePOC, format.mintick) +
                     "\nOpen: " + str.tostring(open, format.mintick) +
                     "\nPrevious high: " + str.tostring(high[1], format.mintick) +
                     "\nPrevious low: " + str.tostring(low[1], format.mintick) +
                     "\nLow: " + str.tostring(low, format.mintick) +
                     "\nClose: " + str.tostring(close, format.mintick) +
                     "\nLower wick: " + str.tostring(pocDefenseLowerWick, format.mintick) +
                     "\nWick / range: " +
                     str.tostring(pocDefenseLowerWick / candleRange * 100.0, "#.##") + "%" +
                     "\nVolume / average: " +
                     str.tostring(volume / volumeAverage, "#.##") + "×"
                label pocDefenseLabel = label.new(
                     x = time,
                     y = low,
                     text = "POC\nDEFENDED",
                     xloc = xloc.bar_time,
                     yloc = yloc.price,
                     style = label.style_label_up,
                     color = pocColor,
                     textcolor = color.rgb(30, 30, 30),
                     size = size.tiny,
                     tooltip = pocDefenseTooltip)
                array.push(retainedMarkers, pocDefenseLabel)

    // VAH defense mirrors POC defense, but permits a small close beneath VAH.
    // A test with a smaller lower wick or reduced volume can remain pending for
    // a short confirmation window. Its floor must remain preserved until a
    // high-quality buyer response confirms the defense.
    bool vahDefenseBandCleared =
         low > profileVAH + atrValue * vahDefenseApproachATR
    if not vahDefenseArmed and vahDefenseBandCleared
        vahDefenseArmed := true

    if valInvalidated
        vahDefenseCandidateActive := false

    bool confirmedTwoBarVAHDefense = false
    if vahDefenseCandidateActive
        int candidateConfirmationAge =
             bar_index - vahDefenseCandidateBarIndex
        bool candidateInsideConfirmationWindow =
             candidateConfirmationAge >= 1 and
             candidateConfirmationAge <=
                  vahDefenseConfirmationWindowBars
        bool candidateFloorPreserved =
             low >= vahDefenseCandidateLow
        bool candidateVAHRecoveryPreserved =
             close >=
             profileVAH -
             atrValue * vahDefenseCloseToleranceATR
        bool candidateResponseStartsAboveVAH =
             open > profileVAH
        bool candidateResponseClosesAboveTest =
             close > vahDefenseCandidateHigh
        bool candidateResponsePriceQuality =
             close > open and
             candleBody >=
                  atrValue * twoBarVAHConfirmationBodyATR and
             candleCloseLocation >=
                  twoBarVAHConfirmationCloseLocation
        bool candidateResponseVolumeQuality =
             not na(volume) and
             not na(volumeAverage) and
             volumeAverage > 0.0 and
             volume > volumeAverage and
             volume >=
                  vahDefenseCandidateVolume *
                  twoBarVAHConfirmationVolumeMultiple
        confirmedTwoBarVAHDefense :=
             candidateInsideConfirmationWindow and
             not valInvalidated and
             candidateFloorPreserved and
             candidateVAHRecoveryPreserved and
             candidateResponseStartsAboveVAH and
             candidateResponseClosesAboveTest and
             candidateResponsePriceQuality and
             candidateResponseVolumeQuality

        if confirmedTwoBarVAHDefense
            vahDefenseArmed := false
            lastVAHDefenseBarIndex := bar_index
            vahDefendedThisBar := true
            line.set_color(activeVAHLine, vahColor)
            line.set_width(activeVAHLine, 3)

            if showVAHDefenseMarkers
                string twoBarVAHDefenseTooltip =
                     "VAH DEFENDED\n" +
                     "Test: " +
                     str.format_time(
                          vahDefenseCandidateTime,
                          "HH:mm",
                          syminfo.timezone) +
                     "\nConfirmed: " +
                     str.format_time(
                          time,
                          "HH:mm",
                          syminfo.timezone) +
                     "\nVAH: " +
                     str.tostring(
                          profileVAH,
                          format.mintick) +
                     "\nTest open: " +
                     str.tostring(
                          vahDefenseCandidateOpen,
                          format.mintick) +
                     "\nTest low: " +
                     str.tostring(
                          vahDefenseCandidateLow,
                          format.mintick) +
                     "\nTest close: " +
                     str.tostring(
                          vahDefenseCandidateClose,
                          format.mintick) +
                     "\nTest wick / range: " +
                     str.tostring(
                          vahDefenseCandidateLowerWickShare * 100.0,
                          "#.##") +
                     "%" +
                     "\nConfirmation close: " +
                     str.tostring(
                          close,
                          format.mintick) +
                     "\nConfirmation volume / average: " +
                     str.tostring(
                          volume / volumeAverage,
                          "#.##") +
                     "×"
                label twoBarVAHDefenseLabel = label.new(
                     x = vahDefenseCandidateTime,
                     y = vahDefenseCandidateLow,
                     text = "VAH\nDEFENDED",
                     xloc = xloc.bar_time,
                     yloc = yloc.price,
                     style = label.style_label_up,
                     color = vahColor,
                     textcolor = color.white,
                     size = size.tiny,
                     tooltip = twoBarVAHDefenseTooltip)
                array.push(
                     retainedMarkers,
                     twoBarVAHDefenseLabel)

        bool candidateConfirmationExpired =
             candidateConfirmationAge >=
             vahDefenseConfirmationWindowBars
        bool candidateStructureFailed =
             not candidateFloorPreserved or
             not candidateVAHRecoveryPreserved
        if confirmedTwoBarVAHDefense or
             candidateConfirmationExpired or
             candidateStructureFailed
            vahDefenseCandidateActive := false
            vahDefenseCandidateBarIndex := na
            vahDefenseCandidateTime := na
            vahDefenseCandidateOpen := na
            vahDefenseCandidateHigh := na
            vahDefenseCandidateLow := na
            vahDefenseCandidateClose := na
            vahDefenseCandidateVolume := na
            vahDefenseCandidateLowerWickShare := na

    if vahDefenseArmed and not vahDefenseCandidateActive
        bool vahWasPreviouslyAcceptedAbove = close[1] > profileVAH
        bool vahDefenseOpensAbove = open > profileVAH
        bool vahDefenseTouchesOrApproachesVAH =
             low <= profileVAH + atrValue * vahDefenseApproachATR
        bool immediatePostBreakoutVAHRetest =
             not na(breakoutBarIndex) and
             bar_index == breakoutBarIndex + 1 and
             (breakoutPending or breakoutConfirmed)
        bool vahDefenseMakesLowerLow =
             low < low[1] or immediatePostBreakoutVAHRetest
        bool vahDefenseOpensBelowPreviousHigh = open < high[1]
        bool vahDefenseClosesNearOrAbove =
             close >= profileVAH - atrValue * vahDefenseCloseToleranceATR
        bool vahDefensePositiveBar = close >= open
        float vahDefenseLowerWick =
             (vahDefensePositiveBar ? open : close) - low
        bool vahDefenseHasLowerWick = vahDefenseLowerWick > 0.0
        bool vahDefenseDirectLowerWickShareOk =
             candleRange > 0.0 and
             vahDefenseLowerWick >=
             candleRange * vahDefenseMinimumLowerWickFraction
        bool vahDefenseCandidateLowerWickShareOk =
             candleRange > 0.0 and
             vahDefenseLowerWick >=
             candleRange * vahCandidateMinimumLowerWickFraction
        bool vahDefenseVolumeReady =
             not na(volume) and
             not na(volumeAverage) and
             volumeAverage > 0.0
        bool vahDefenseVolumeAboveAverage =
             vahDefenseVolumeReady and
             volume > volumeAverage
        bool enoughBarsSinceLastVAHDefense =
             na(lastVAHDefenseBarIndex) or
             bar_index - lastVAHDefenseBarIndex >= vahDefenseSpacingBars
        bool vahDefenseCorePriceQualified =
             not valInvalidated and
             vahWasPreviouslyAcceptedAbove and
             vahDefenseOpensAbove and
             vahDefenseTouchesOrApproachesVAH and
             vahDefenseMakesLowerLow and
             vahDefenseOpensBelowPreviousHigh and
             vahDefenseClosesNearOrAbove and
             vahDefenseHasLowerWick and
             enoughBarsSinceLastVAHDefense
        bool directVAHDefense =
             vahDefenseCorePriceQualified and
             vahDefenseDirectLowerWickShareOk and
             vahDefenseVolumeAboveAverage

        if directVAHDefense
            vahDefenseArmed := false
            lastVAHDefenseBarIndex := bar_index
            vahDefendedThisBar := true
            line.set_color(activeVAHLine, vahColor)
            line.set_width(activeVAHLine, 3)

            if showVAHDefenseMarkers
                string vahDefenseTooltip =
                     "VAH DEFENDED\n" +
                     "Time: " + str.format_time(time, "HH:mm", syminfo.timezone) +
                     "\nVAH: " + str.tostring(profileVAH, format.mintick) +
                     "\nOpen: " + str.tostring(open, format.mintick) +
                     "\nPrevious high: " + str.tostring(high[1], format.mintick) +
                     "\nPrevious low: " + str.tostring(low[1], format.mintick) +
                     "\nLow: " + str.tostring(low, format.mintick) +
                     "\nClose: " + str.tostring(close, format.mintick) +
                     "\nLower wick: " + str.tostring(vahDefenseLowerWick, format.mintick) +
                     "\nWick / range: " +
                     str.tostring(vahDefenseLowerWick / candleRange * 100.0, "#.##") + "%" +
                     "\nVolume / average: " +
                     str.tostring(volume / volumeAverage, "#.##") + "×" +
                     "\nImmediate post-breakout: " +
                     str.tostring(immediatePostBreakoutVAHRetest)
                label vahDefenseLabel = label.new(
                     x = time,
                     y = low,
                     text = "VAH\nDEFENDED",
                     xloc = xloc.bar_time,
                     yloc = yloc.price,
                     style = label.style_label_up,
                     color = vahColor,
                     textcolor = color.white,
                     size = size.tiny,
                     tooltip = vahDefenseTooltip)
                array.push(retainedMarkers, vahDefenseLabel)

        else
            bool delayedVAHDefenseCandidate =
                 enableTwoBarVAHDefense and
                 vahDefenseCorePriceQualified and
                 vahDefenseCandidateLowerWickShareOk and
                 vahDefenseVolumeReady and
                 not directVAHDefense

            if delayedVAHDefenseCandidate
                vahDefenseCandidateActive := true
                vahDefenseCandidateBarIndex := bar_index
                vahDefenseCandidateTime := time
                vahDefenseCandidateOpen := open
                vahDefenseCandidateHigh := high
                vahDefenseCandidateLow := low
                vahDefenseCandidateClose := close
                vahDefenseCandidateVolume := volume
                vahDefenseCandidateLowerWickShare :=
                     vahDefenseLowerWick / candleRange

    // A pending breakout is confirmed only after the required later bars hold.
    // Normal paths must avoid losing POC. A deep value-area sweep has already
    // traversed the profile, so its stronger confirmation requires every later
    // hold bar to close at or above VAH.
    if breakoutPending
        bool valueAreaSweepPending =
             breakoutPath == BREAKOUT_PATH_VALUE_AREA_SWEEP
        bool holdFailed = valueAreaSweepPending ?
             close < profileVAH :
             close < profilePOC - atrValue * breakoutFailureBelowPOCATR
        int elapsedHoldBars = bar_index - breakoutBarIndex

        if holdFailed
            breakoutPending := false
            activeEntryLabel := na
        else if elapsedHoldBars >= breakoutHoldBars
            confirmBreakoutNow := true

    // Count only upward breakout attempts that begin below POC. The candle must
    // open below POC, trade up into/through it, and then reject downward from
    // the reached price. This excludes candles that were already accepted above
    // POC before their rejection began.
    bool opensBelowPOC =
         open < profilePOC
    bool reachesPOCFromBelow =
         high >= profilePOC + atrValue * pocMinimumPenetrationATR
    bool closesNearOrBelowPOC =
         close <= profilePOC + atrValue * pocFailedCloseBandATR
    bool rejectsDownFromReachedPrice =
         high - close >= atrValue * pocMinimumDownwardRejectionATR
    bool enoughBarsSinceLastPOCAttempt =
         na(lastPOCAttemptBarIndex) or
         bar_index - lastPOCAttemptBarIndex >= pocAttemptSpacingBars
    bool failedPOCAttemptNow =
         not breakoutPending and
         not breakoutConfirmed and
         opensBelowPOC and
         reachesPOCFromBelow and
         closesNearOrBelowPOC and
         rejectsDownFromReachedPrice and
         enoughBarsSinceLastPOCAttempt

    if failedPOCAttemptNow
        failedPOCAttempts += 1
        lastPOCAttemptBarIndex := bar_index

        if showPOCAttemptMarkers
            string attemptTooltip =
                 "FAILED POC ATTEMPT #" + str.tostring(failedPOCAttempts) +
                 "\nTime: " + str.format_time(time, "HH:mm", syminfo.timezone) +
                 "\nPOC: " + str.tostring(profilePOC, format.mintick) +
                 "\nOpen: " + str.tostring(open, format.mintick) +
                 "\nHigh: " + str.tostring(high, format.mintick) +
                 "\nClose: " + str.tostring(close, format.mintick) +
                 "\nDownward rejection: " + str.tostring(high - close, format.mintick)
            float attemptLabelY = high + atrValue * pocAttemptLabelDistanceATR
            label attemptLabel = label.new(
                 x = time,
                 y = attemptLabelY,
                 text = "POC\nFAIL " + str.tostring(failedPOCAttempts),
                 xloc = xloc.bar_time,
                 yloc = yloc.price,
                 style = label.style_label_down,
                 color = color.new(pocColor, 5),
                 textcolor = color.rgb(30, 30, 30),
                 size = size.tiny,
                 tooltip = attemptTooltip)
            array.push(retainedMarkers, attemptLabel)

    // The continuation candle must travel from the POC region to beyond VAH
    // with strong price structure and participation.
    bool breakoutStartsNearOrBelowPOC =
         open <= profilePOC + atrValue * breakoutStartToleranceATR or
         close[1] <= profilePOC + atrValue * breakoutStartToleranceATR
    bool breakoutClosesAboveVAH =
         close > profileVAH + atrValue * breakoutVAHBufferATR
    bool breakoutPriceQuality =
         close > open and
         candleBody >= atrValue * breakoutBodyATR and
         candleCloseLocation >= breakoutCloseLocation
    bool breakoutVolumeQuality =
         not na(relativeVolume) and
         relativeVolume >= breakoutRelativeVolume
    bool classicPOCContinuationBreakout =
         not breakoutPending and
         not breakoutConfirmed and
         valDefended and
         not valInvalidated and
         failedPOCAttempts >= minimumFailedPOCAttempts and
         breakoutStartsNearOrBelowPOC and
         breakoutClosesAboveVAH and
         breakoutPriceQuality and
         breakoutVolumeQuality

    // POC-fight VAH reclaim:
    // Repeated internal failures prove that POC was a genuine resistance
    // battle. A later candle can confirm continuation without a separate VAL
    // defense when it holds entirely above POC, begins inside value, and
    // decisively reclaims VAH with renewed participation.
    float pocFightBodyToRange =
         candleRange > 0.0 ? candleBody / candleRange : 0.0
    bool pocFightStartsInsideValue =
         open > profilePOC and
         open <= profileVAH and
         close[1] <= profileVAH
    bool pocFightHoldsAbovePOC =
         low >= profilePOC
    bool pocFightClosesDecisivelyAboveVAH =
         close >
         profileVAH +
         atrValue * pocFightVAHClearanceATR
    bool pocFightPriceQuality =
         close > open and
         candleBody >= atrValue * breakoutBodyATR and
         pocFightBodyToRange >= pocFightMinimumBodyRange and
         candleCloseLocation >= pocFightMinimumCloseLocation
    bool pocFightVolumeQuality =
         not na(relativeVolume) and
         relativeVolume >= pocFightMinimumRelativeVolume and
         not na(volume[1]) and
         volume[1] > 0.0 and
         volume >= volume[1] * pocFightPreviousVolumeMultiple
    bool pocFightVAHReclaimBreakout =
         not breakoutPending and
         not breakoutConfirmed and
         enablePOCFightVAHReclaim and
         not valInvalidated and
         profileInternalFailedPOCAttempts >=
              minimumFailedPOCAttempts and
         pocFightStartsInsideValue and
         pocFightHoldsAbovePOC and
         pocFightClosesDecisivelyAboveVAH and
         pocFightPriceQuality and
         pocFightVolumeQuality

    // Exceptional initiative expansion:
    // A decisive, full-bodied candle may prove continuation directly through
    // VAH even when price was already accepted above POC or the chart contains
    // fewer than the normal number of failed POC attempts. The previous close
    // must still be at/below VAH so this is a genuine value-area breakout.
    float exceptionalBodyToRange =
         candleRange > 0.0 ? candleBody / candleRange : 0.0
    bool exceptionalCrossesVAHFromBelow =
         close[1] <= profileVAH and
         close > profileVAH + atrValue * exceptionalVAHClearanceATR
    bool exceptionalPriceQuality =
         close > open and
         candleBody >= atrValue * exceptionalBodyATR and
         exceptionalBodyToRange >= exceptionalBodyRangeFraction and
         candleCloseLocation >= exceptionalCloseLocation
    bool exceptionalRecentVolumeQuality =
         not na(exceptionalPreviousVolumeAverage) and
         exceptionalPreviousVolumeAverage > 0.0 and
         volume >= exceptionalPreviousVolumeAverage *
              exceptionalRecentVolumeMultiplier
    bool exceptionalVAHExpansionBreakout =
         not breakoutPending and
         not breakoutConfirmed and
         enableExceptionalVAHExpansion and
         valDefended and
         not valInvalidated and
         exceptionalCrossesVAHFromBelow and
         exceptionalPriceQuality and
         breakoutVolumeQuality and
         exceptionalRecentVolumeQuality

    // Deep value-area sweep and VAH reclaim:
    // The candle starts from accepted value, sweeps through POC toward VAL,
    // and then closes decisively beyond VAH. A large lower wick is intentional
    // here: it shows the failed lower auction, while body, close, and volume
    // rules require buyers to finish in control.
    float valueAreaSweepLowerWick =
         math.min(open, close) - low
    float valueAreaSweepLowerWickToRange =
         candleRange > 0.0 ?
         valueAreaSweepLowerWick / candleRange :
         0.0
    bool valueAreaSweepStartsInsideValue =
         open >= profilePOC and
         open <= profileVAH and
         close[1] >= profilePOC and
         close[1] <= profileVAH
    bool valueAreaSweepTestsPOCAndPreservesVAL =
         low <= profilePOC and
         low >=
              profileVAL -
              atrValue * valueAreaSweepMaximumVALUndercutATR
    bool valueAreaSweepClosesDecisivelyAboveVAH =
         close >
              profileVAH +
              atrValue * valueAreaSweepVAHClearanceATR
    bool valueAreaSweepPriceQuality =
         close > open and
         candleBody >= atrValue * valueAreaSweepMinimumBodyATR and
         exceptionalBodyToRange >= valueAreaSweepMinimumBodyRange and
         candleCloseLocation >= valueAreaSweepMinimumCloseLocation and
         valueAreaSweepLowerWickToRange >=
              valueAreaSweepMinimumLowerWickRange
    bool valueAreaSweepVolumeQuality =
         not na(relativeVolume) and
         relativeVolume >= valueAreaSweepMinimumRelativeVolume and
         not na(exceptionalPreviousVolumeAverage) and
         exceptionalPreviousVolumeAverage > 0.0 and
         volume >=
              exceptionalPreviousVolumeAverage *
              valueAreaSweepRecentVolumeMultiplier
    bool valueAreaSweepHasPriorEvidence =
         valDefended or
         failedPOCAttempts >= valueAreaSweepMinimumFailedPOCAttempts
    bool valueAreaSweepVAHReclaimBreakout =
         not breakoutPending and
         not breakoutConfirmed and
         enableValueAreaSweepReclaim and
         not valInvalidated and
         valueAreaSweepHasPriorEvidence and
         valueAreaSweepStartsInsideValue and
         valueAreaSweepTestsPOCAndPreservesVAL and
         valueAreaSweepClosesDecisivelyAboveVAH and
         valueAreaSweepPriceQuality and
         valueAreaSweepVolumeQuality
    bool profileRecoveryVAHReclaimBreakout =
         not breakoutPending and
         not breakoutConfirmed and
         profileReactivatedThisBar
    bool strongContinuationBreakout =
         profileRecoveryVAHReclaimBreakout or
         valueAreaSweepVAHReclaimBreakout or
         classicPOCContinuationBreakout or
         pocFightVAHReclaimBreakout or
         exceptionalVAHExpansionBreakout

    if strongContinuationBreakout
        breakoutBarIndex := bar_index
        breakoutTime := time
        breakoutLow := low
        breakoutHigh := high
        breakoutATRAtSignal := atrValue
        breakoutPath := profileRecoveryVAHReclaimBreakout ?
             "PROFILE RECOVERY / VAH RECLAIM" :
             valueAreaSweepVAHReclaimBreakout ?
             BREAKOUT_PATH_VALUE_AREA_SWEEP :
             exceptionalVAHExpansionBreakout ?
             "EXCEPTIONAL VAH EXPANSION" :
             pocFightVAHReclaimBreakout ?
             "POC FIGHT / VAH RECLAIM" :
             "POC-TO-VAH CONTINUATION"
        entryTriggeredThisBar := true

        if breakoutHoldBars == 0
            confirmBreakoutNow := true
        else
            breakoutPending := true

    if confirmBreakoutNow
        breakoutPending := false
        breakoutConfirmed := true

        string continuationTooltip =
             "FRVP ENTRY CONFIRMED\n" +
             "Entry: " + str.format_time(breakoutTime, "HH:mm", syminfo.timezone) +
             "\nType: " + breakoutPath +
             "\nConfirmed: " + str.format_time(time, "HH:mm", syminfo.timezone) +
             "\nVAL: " + str.tostring(profileVAL, format.mintick) +
             "\nPOC: " + str.tostring(profilePOC, format.mintick) +
             "\nVAH: " + str.tostring(profileVAH, format.mintick) +
             "\nFailed POC attempts: " + str.tostring(failedPOCAttempts) +
             "\nInternal POC failures: " +
             str.tostring(profileInternalFailedPOCAttempts)

        if showEntryMarkers
            activeEntryLabel := label.new(
                 x = breakoutTime,
                 y = breakoutLow,
                 text = "FRVP ENTRY\nCONFIRMED",
                 xloc = xloc.bar_time,
                 yloc = yloc.belowbar,
                 style = label.style_label_up,
                 color = continuationColor,
                 textcolor = color.white,
                 size = size.tiny,
                 tooltip = continuationTooltip)
            array.push(retainedEntryMarkers, activeEntryLabel)

        line.set_color(activeVALLine, color.new(valColor, 20))
        line.set_color(activePOCLine, pocColor)
        line.set_color(activeVAHLine, vahColor)
        line.set_width(activePOCLine, 3)
        line.set_width(activeVAHLine, 3)

//------------------------------------------------------------------------------
// Additional same-session trend scanner
//------------------------------------------------------------------------------

// Once the primary profile freezes, this independent scanner rearms. Each
// accepted later movement is stored as an AdditionalProfile and remains
// actionable without replacing the earlier profile.
bool primaryProfileFrozenThisBar =
     lifecycleState == STATE_PROFILE and
     profileReadyBarIndex == bar_index

if newTradingDate
    array.clear(additionalProfiles)
    additionalScannerState := STATE_SEARCHING
    additionalScannerSessionId := 0
    profilesCreatedInCurrentSession := 0
    nextProfileNumber := 2
    lastProfileStartBarIndex := na
    lastProfileFreezeBarIndex := na
    highestAcceptedTrendHigh := na
    additionalScannerResetArmed := false
    array.clear(additionalMovementLows)
    array.clear(additionalMovementHighs)
    array.clear(additionalMovementVolumes)
    array.clear(additionalMovementOpens)
    array.clear(additionalMovementCloses)
    array.clear(additionalMovementATRs)
    array.clear(additionalMovementTimes)
    array.clear(additionalMovementBarIndices)
    additionalMovementLow := na
    additionalMovementHigh := na
    additionalMovementPeakVolume := na
    additionalMovementStartTime := na
    additionalMovementEndTime := na
    additionalMovementHighBarIndex := na
    additionalMovementHighEndTime := na
    additionalAcceptedEndBarIndex := na
    additionalAcceptedEndTime := na
    additionalAcceptedHigh := na
    additionalAcceptedClose := na
    additionalMovementTriggerRelativeVolume := na
    additionalMovementTriggerBodyATR := na
    additionalMovementTriggerCloseLocation := na
    additionalMovementTriggerBarIndex := na
    additionalMovementTriggerTime := na
    additionalMovementUsedAdaptiveOrigin := false
    additionalMovementWasStitched := false
    additionalExceptionalProvisionalStitchUsed := false
    additionalStitchDeadlineBarIndex := na
    additionalStitchReferenceHigh := na
    additionalStitchReferenceLow := na
    additionalStitchPullbackLow := na
    additionalStitchMaySplitRestart := false
    additionalCompactGraceActive := false
    additionalMovementQualifiedAsCompact := false
    additionalRecoveredThroughCompactGrace := false
    additionalFreshParticipationResetUsed := false

bool preserveAdditionalMovementAtSessionBoundary =
     carryActiveProfileAcrossSessions and
     newEnabledMarketSession and
     (
          additionalScannerState == STATE_BUILDING or
          additionalScannerState == STATE_STITCHING
     )

if preserveAdditionalMovementAtSessionBoundary
    additionalScannerSessionId := activeMarketSession

if newEnabledMarketSession and
     not preserveAdditionalMovementAtSessionBoundary
    additionalScannerState := STATE_SEARCHING
    additionalScannerSessionId := activeMarketSession
    profilesCreatedInCurrentSession := 0
    lastProfileStartBarIndex := na
    lastProfileFreezeBarIndex := na
    additionalScannerResetArmed := false
    array.clear(additionalMovementLows)
    array.clear(additionalMovementHighs)
    array.clear(additionalMovementVolumes)
    array.clear(additionalMovementOpens)
    array.clear(additionalMovementCloses)
    array.clear(additionalMovementATRs)
    array.clear(additionalMovementTimes)
    array.clear(additionalMovementBarIndices)
    additionalMovementLow := na
    additionalMovementHigh := na
    additionalMovementPeakVolume := na
    additionalMovementStartTime := na
    additionalMovementEndTime := na
    additionalMovementHighBarIndex := na
    additionalMovementHighEndTime := na
    additionalAcceptedEndBarIndex := na
    additionalAcceptedEndTime := na
    additionalAcceptedHigh := na
    additionalAcceptedClose := na
    additionalMovementTriggerRelativeVolume := na
    additionalMovementTriggerBodyATR := na
    additionalMovementTriggerCloseLocation := na
    additionalMovementTriggerBarIndex := na
    additionalMovementTriggerTime := na
    additionalMovementUsedAdaptiveOrigin := false
    additionalMovementWasStitched := false
    additionalExceptionalProvisionalStitchUsed := false
    additionalStitchDeadlineBarIndex := na
    additionalStitchReferenceHigh := na
    additionalStitchReferenceLow := na
    additionalStitchPullbackLow := na
    additionalStitchMaySplitRestart := false
    additionalCompactGraceActive := false
    additionalMovementQualifiedAsCompact := false
    additionalRecoveredThroughCompactGrace := false
    additionalFreshParticipationResetUsed := false

if primaryProfileFrozenThisBar
    profilesCreatedInCurrentSession :=
         math.max(profilesCreatedInCurrentSession, 1)
    lastProfileStartBarIndex :=
         array.size(movementBarIndices) > 0 ?
         array.first(movementBarIndices) : bar_index
    lastProfileFreezeBarIndex := bar_index
    highestAcceptedTrendHigh :=
         na(highestAcceptedTrendHigh) ?
         movementHigh :
         math.max(highestAcceptedTrendHigh, movementHigh)
    additionalScannerResetArmed := false
    additionalScannerState := STATE_SEARCHING

bool additionalScannerHasProfileContext =
     not na(highestAcceptedTrendHigh) and
     (
          lifecycleState == STATE_PROFILE or
          array.size(additionalProfiles) > 0
     )
bool additionalScannerHasCapacity =
     profilesCreatedInCurrentSession < maximumProfilesPerSession
bool additionalScannerSpacingReady =
     (
          na(lastProfileStartBarIndex) or
          bar_index - lastProfileStartBarIndex >=
               additionalTrendMinimumSpacingBars
     ) and
     (
          na(lastProfileFreezeBarIndex) or
          bar_index > lastProfileFreezeBarIndex
     )
bool additionalScannerPullbackSeen =
     not na(additionalTrendPriorLow) and
     not na(atrValue[1]) and
     additionalTrendPriorLow <=
          highestAcceptedTrendHigh -
          atrValue[1] * additionalTrendMinimumPullbackATR
bool additionalScannerContractionSeen =
     not na(additionalTrendPriorVolumeAverage) and
     not na(volumeAverage[1]) and
     volumeAverage[1] > 0.0 and
     additionalTrendPriorVolumeAverage <=
          volumeAverage[1] * additionalTrendContractionRatio
bool additionalScannerResetSeen =
     additionalScannerPullbackSeen or
     additionalScannerContractionSeen

// A legitimate reset can occur well before the next expansion candle. Preserve
// that evidence until a candidate actually starts instead of requiring it to
// remain inside the rolling four-bar lookback at the trigger itself.
if barstate.isconfirmed and
     additionalScannerState == STATE_SEARCHING and
     additionalScannerHasProfileContext and
     additionalScannerResetSeen
    additionalScannerResetArmed := true

bool freezeAdditionalMovementNow = false
bool discardAdditionalMovementNow = false
bool splitAdditionalRestartNow = false
int splitAdditionalMinimumOriginBarIndex = na

if barstate.isconfirmed and
     timeframeSupported and
     detectionMode == "Auto" and
     enableAdditionalSessionTrends
    bool additionalBullishMovementStart =
         additionalScannerState == STATE_SEARCHING and
         inAnalysisSession and
         inAutoStartWindow and
         additionalScannerHasProfileContext and
         additionalScannerHasCapacity and
         additionalScannerSpacingReady and
         additionalScannerResetArmed and
         not na(atrValue) and
         not na(relativeVolume) and
         close > open and
         candleBody >= atrValue * startBodyATR and
         candleCloseLocation >= startCloseLocation and
         relativeVolume >= startRelativeVolume

    bool additionalFreshParticipationResetNow =
         enableFreshParticipationReset and
         (
              additionalScannerState == STATE_BUILDING or
              additionalScannerState == STATE_STITCHING
         ) and
         inAnalysisSession and
         activeMarketSession == additionalScannerSessionId and
         not additionalFreshParticipationResetUsed and
         bar_index > 0 and
         not na(atrValue) and
         not na(additionalMovementPeakVolume) and
         time - time[1] >=
              freshParticipationResetMinimumGapMinutes * 60000 and
         nz(volume) >=
              freshParticipationResetMinimumAbsoluteVolume and
         additionalMovementPeakVolume <
              freshParticipationResetMinimumAbsoluteVolume and
         nz(volume) >=
              additionalMovementPeakVolume *
              freshParticipationResetPeakVolumeRatio and
         close > open and
         candleBody >= atrValue * freshParticipationResetBodyATR and
         candleCloseLocation >= freshParticipationResetCloseLocation and
         close > additionalMovementHigh

    if additionalBullishMovementStart
        additionalScannerResetArmed := false
        array.clear(additionalMovementLows)
        array.clear(additionalMovementHighs)
        array.clear(additionalMovementVolumes)
        array.clear(additionalMovementOpens)
        array.clear(additionalMovementCloses)
        array.clear(additionalMovementATRs)
        array.clear(additionalMovementTimes)
        array.clear(additionalMovementBarIndices)

        additionalMovementLow := low
        additionalMovementHigh := high
        additionalMovementPeakVolume := nz(volume)
        additionalMovementStartTime := time
        additionalMovementEndTime := time_close
        additionalMovementHighBarIndex := bar_index
        additionalMovementHighEndTime := time_close
        additionalAcceptedEndBarIndex := bar_index
        additionalAcceptedEndTime := time_close
        additionalAcceptedHigh := high
        additionalAcceptedClose := close
        additionalMovementTriggerRelativeVolume := relativeVolume
        additionalMovementTriggerBodyATR := candleBody / atrValue
        additionalMovementTriggerCloseLocation :=
             candleCloseLocation
        additionalMovementTriggerBarIndex := bar_index
        additionalMovementTriggerTime := time
        additionalMovementUsedAdaptiveOrigin := false
        additionalMovementWasStitched := false
        additionalExceptionalProvisionalStitchUsed := false
        additionalStitchDeadlineBarIndex := na
        additionalStitchReferenceHigh := na
        additionalStitchReferenceLow := na
        additionalStitchPullbackLow := na
        additionalStitchMaySplitRestart := false
        additionalCompactGraceActive := false
        additionalMovementQualifiedAsCompact := false
        additionalRecoveredThroughCompactGrace := false
        additionalFreshParticipationResetUsed := false

        int additionalContextBarsToInclude = autoPreTriggerBars
        bool additionalAdaptiveOriginFound = false
        int additionalOriginSearchOffset =
             adaptiveMovementOriginLookbackBars
        while enableAdaptiveMovementOrigin and
             additionalOriginSearchOffset > autoPreTriggerBars
            float additionalOriginRange =
                 high[additionalOriginSearchOffset] -
                 low[additionalOriginSearchOffset]
            float additionalOriginBody =
                 close[additionalOriginSearchOffset] -
                 open[additionalOriginSearchOffset]
            float additionalOriginCloseLocation =
                 additionalOriginRange > 0.0 ?
                 (close[additionalOriginSearchOffset] -
                      low[additionalOriginSearchOffset]) /
                      additionalOriginRange :
                 0.5
            float additionalOriginRelativeVolume =
                 not na(volumeAverage[additionalOriginSearchOffset]) and
                 volumeAverage[additionalOriginSearchOffset] > 0.0 ?
                 volume[additionalOriginSearchOffset] /
                      volumeAverage[additionalOriginSearchOffset] :
                 na
            bool additionalOriginSequenceContiguous =
                 inAnalysisSession[additionalOriginSearchOffset] and
                 activeMarketSession[additionalOriginSearchOffset] ==
                      activeMarketSession and
                 currentDateKey[additionalOriginSearchOffset] ==
                      currentDateKey and
                 time - time[additionalOriginSearchOffset] <=
                      timeframe.in_seconds(timeframe.period) *
                      1000 * additionalOriginSearchOffset +
                      adaptiveOriginMaximumGapMinutes * 60000
            bool additionalOriginFloorHeld = true
            int additionalFloorCheckOffset =
                 additionalOriginSearchOffset - 1
            while additionalFloorCheckOffset >= 0 and
                 additionalOriginFloorHeld
                if low[additionalFloorCheckOffset] <
                     low[additionalOriginSearchOffset] -
                     atrValue[additionalOriginSearchOffset] *
                     adaptiveOriginFloorToleranceATR
                    additionalOriginFloorHeld := false
                additionalFloorCheckOffset -= 1
            bool additionalOriginBreaksPriorHigh =
                 not adaptiveOriginMustBreakPriorHigh or
                 (
                      not na(high[additionalOriginSearchOffset + 1]) and
                      close[additionalOriginSearchOffset] >
                           high[additionalOriginSearchOffset + 1]
                 )
            bool additionalOriginAuctionStructureHeld = true
            float additionalOriginSequencePeakHigh =
                 high[additionalOriginSearchOffset]
            int additionalOriginStructureOffset =
                 additionalOriginSearchOffset - 1
            while additionalOriginStructureOffset >= 0 and
                 additionalOriginAuctionStructureHeld
                float additionalOriginStructureRange =
                     additionalOriginSequencePeakHigh -
                     low[additionalOriginSearchOffset]
                if high[additionalOriginStructureOffset] >
                     additionalOriginSequencePeakHigh
                    additionalOriginSequencePeakHigh :=
                         high[additionalOriginStructureOffset]
                else if additionalOriginStructureRange >
                     syminfo.mintick and
                     low[additionalOriginStructureOffset] <
                          additionalOriginSequencePeakHigh -
                          additionalOriginStructureRange *
                          adaptiveOriginMaximumRetracementShare
                    additionalOriginAuctionStructureHeld := false
                additionalOriginStructureOffset -= 1
            bool additionalAdaptiveOriginCandidate =
                 not additionalAdaptiveOriginFound and
                 additionalOriginSequenceContiguous and
                 additionalOriginFloorHeld and
                 additionalOriginBreaksPriorHigh and
                 additionalOriginAuctionStructureHeld and
                 not na(atrValue[additionalOriginSearchOffset]) and
                 not na(additionalOriginRelativeVolume) and
                 volume[additionalOriginSearchOffset] >=
                      adaptiveOriginMinimumAbsoluteVolume and
                 additionalOriginBody >=
                      atrValue[additionalOriginSearchOffset] *
                      adaptiveOriginMinimumBodyATR and
                 additionalOriginCloseLocation >= startCloseLocation and
                 additionalOriginRelativeVolume >=
                      adaptiveOriginMinimumRelativeVolume and
                 close > high[additionalOriginSearchOffset]
            if additionalAdaptiveOriginCandidate
                additionalContextBarsToInclude :=
                     additionalOriginSearchOffset
                additionalAdaptiveOriginFound := true
                additionalMovementUsedAdaptiveOrigin := true
            additionalOriginSearchOffset -= 1

        int additionalContextOffset =
             additionalContextBarsToInclude
        while additionalContextOffset >= 1
            bool additionalContextEligible =
                 inAnalysisSession[additionalContextOffset] and
                 activeMarketSession[additionalContextOffset] ==
                      activeMarketSession and
                 currentDateKey[additionalContextOffset] == currentDateKey and
                 time - time[additionalContextOffset] <=
                      timeframe.in_seconds(timeframe.period) *
                      1000 * additionalContextOffset +
                      adaptiveOriginMaximumGapMinutes * 60000
            if additionalContextEligible
                array.push(
                     additionalMovementLows,
                     low[additionalContextOffset])
                array.push(
                     additionalMovementHighs,
                     high[additionalContextOffset])
                array.push(
                     additionalMovementVolumes,
                     nz(volume[additionalContextOffset]))
                array.push(
                     additionalMovementOpens,
                     open[additionalContextOffset])
                array.push(
                     additionalMovementCloses,
                     close[additionalContextOffset])
                array.push(
                     additionalMovementATRs,
                     atrValue[additionalContextOffset])
                array.push(
                     additionalMovementTimes,
                     time[additionalContextOffset])
                array.push(
                     additionalMovementBarIndices,
                     bar_index - additionalContextOffset)
                additionalMovementLow :=
                     math.min(
                          additionalMovementLow,
                          low[additionalContextOffset])
                if high[additionalContextOffset] >
                     additionalMovementHigh
                    additionalMovementHigh :=
                         high[additionalContextOffset]
                    additionalMovementHighBarIndex :=
                         bar_index - additionalContextOffset
                    additionalMovementHighEndTime :=
                         time_close[additionalContextOffset]
                additionalMovementPeakVolume :=
                     math.max(
                          additionalMovementPeakVolume,
                          nz(volume[additionalContextOffset]))
                additionalMovementStartTime :=
                     math.min(
                          additionalMovementStartTime,
                          time[additionalContextOffset])
            additionalContextOffset -= 1

        array.push(additionalMovementLows, low)
        array.push(additionalMovementHighs, high)
        array.push(additionalMovementVolumes, nz(volume))
        array.push(additionalMovementOpens, open)
        array.push(additionalMovementCloses, close)
        array.push(additionalMovementATRs, atrValue)
        array.push(additionalMovementTimes, time)
        array.push(additionalMovementBarIndices, bar_index)
        if high >= additionalMovementHigh
            additionalMovementHigh := high
            additionalMovementHighBarIndex := bar_index
            additionalMovementHighEndTime := time_close
        additionalAcceptedEndBarIndex := bar_index
        additionalAcceptedEndTime := time_close
        additionalAcceptedHigh := additionalMovementHigh
        additionalAcceptedClose := close
        lastProfileStartBarIndex :=
             bar_index - array.size(additionalMovementLows) + 1
        additionalScannerState := STATE_BUILDING

    else if additionalFreshParticipationResetNow
        array.clear(additionalMovementLows)
        array.clear(additionalMovementHighs)
        array.clear(additionalMovementVolumes)
        array.clear(additionalMovementOpens)
        array.clear(additionalMovementCloses)
        array.clear(additionalMovementATRs)
        array.clear(additionalMovementTimes)
        array.clear(additionalMovementBarIndices)

        array.push(additionalMovementLows, low)
        array.push(additionalMovementHighs, high)
        array.push(additionalMovementVolumes, nz(volume))
        array.push(additionalMovementOpens, open)
        array.push(additionalMovementCloses, close)
        array.push(additionalMovementATRs, atrValue)
        array.push(additionalMovementTimes, time)
        array.push(additionalMovementBarIndices, bar_index)

        additionalMovementLow := low
        additionalMovementHigh := high
        additionalMovementPeakVolume := nz(volume)
        additionalMovementStartTime := time
        additionalMovementEndTime := time_close
        additionalMovementHighBarIndex := bar_index
        additionalMovementHighEndTime := time_close
        additionalAcceptedEndBarIndex := bar_index
        additionalAcceptedEndTime := time_close
        additionalAcceptedHigh := high
        additionalAcceptedClose := close
        additionalMovementTriggerRelativeVolume := relativeVolume
        additionalMovementTriggerBodyATR := candleBody / atrValue
        additionalMovementTriggerCloseLocation := candleCloseLocation
        additionalMovementTriggerBarIndex := bar_index
        additionalMovementTriggerTime := time
        additionalMovementUsedAdaptiveOrigin := false
        additionalMovementWasStitched := false
        additionalExceptionalProvisionalStitchUsed := false
        additionalStitchDeadlineBarIndex := na
        additionalStitchReferenceHigh := na
        additionalStitchReferenceLow := na
        additionalStitchPullbackLow := na
        additionalStitchMaySplitRestart := false
        additionalCompactGraceActive := false
        additionalMovementQualifiedAsCompact := false
        additionalRecoveredThroughCompactGrace := false
        additionalFreshParticipationResetUsed := true
        lastProfileStartBarIndex := bar_index
        additionalScannerResetArmed := false
        additionalScannerState := STATE_BUILDING

    else if additionalScannerState == STATE_BUILDING
        if inAnalysisSession and
             activeMarketSession == additionalScannerSessionId
            float additionalMovementHighBeforeCurrentBar =
                 additionalMovementHigh
            array.push(additionalMovementLows, low)
            array.push(additionalMovementHighs, high)
            array.push(additionalMovementVolumes, nz(volume))
            array.push(additionalMovementOpens, open)
            array.push(additionalMovementCloses, close)
            array.push(additionalMovementATRs, atrValue)
            array.push(additionalMovementTimes, time)
            array.push(additionalMovementBarIndices, bar_index)

            additionalMovementLow :=
                 math.min(additionalMovementLow, low)
            if high >= additionalMovementHigh
                additionalMovementHigh := high
                additionalMovementHighBarIndex := bar_index
                additionalMovementHighEndTime := time_close
            additionalMovementPeakVolume :=
                 math.max(additionalMovementPeakVolume, nz(volume))
            additionalMovementEndTime := time_close

            bool additionalAcceptedHighExtension =
                 not na(additionalAcceptedHigh) and
                 not na(additionalAcceptedClose) and
                 high >
                      additionalAcceptedHigh +
                      atrValue *
                      acceptedDevelopmentHighExtensionATR and
                 close >=
                      additionalAcceptedClose -
                      atrValue * acceptedDevelopmentCloseBackoffATR and
                 candleCloseLocation >=
                      acceptedDevelopmentMinimumCloseLocation
            bool additionalAcceptedNearHighRecovery =
                 not na(additionalAcceptedHigh) and
                 not na(relativeVolume) and
                 close > open and
                 candleBody >=
                      atrValue *
                      acceptedDevelopmentRecoveryBodyATR and
                 candleCloseLocation >=
                      acceptedDevelopmentRecoveryCloseLocation and
                 relativeVolume >=
                      acceptedDevelopmentRecoveryRelativeVolume and
                 close >=
                      additionalAcceptedHigh -
                      atrValue * extendedStitchNearHighATR
            bool additionalAcceptedDevelopment =
                 (
                      additionalFreshParticipationResetUsed and
                      high > additionalMovementHighBeforeCurrentBar +
                           atrValue *
                           acceptedDevelopmentAbsoluteHighATR
                 ) or
                 additionalAcceptedHighExtension or
                 additionalAcceptedNearHighRecovery
            if additionalAcceptedDevelopment
                additionalAcceptedEndBarIndex := bar_index
                additionalAcceptedEndTime := time_close
                additionalAcceptedHigh :=
                     math.max(additionalAcceptedHigh, high)
                additionalAcceptedClose := close

            int additionalMovementBarCount =
                 array.size(additionalMovementLows)
            int barsSinceAdditionalDevelopment =
                 bar_index - additionalAcceptedEndBarIndex
            float additionalMovementCumulativeVolumeNow =
                 array.sum(additionalMovementVolumes)
            bool additionalMovementIsStandardLargeEnough =
                 additionalMovementBarCount >= minimumMoveBars and
                 not na(atrValue) and
                 additionalMovementHigh - additionalMovementLow >=
                      atrValue * minimumMoveRangeATR
            bool additionalMovementIsCompactLargeEnough =
                 enableCompactHighParticipationProfiles and
                 additionalMovementBarCount >= minimumMoveBars and
                 not na(atrValue) and
                 additionalMovementHigh - additionalMovementLow >=
                      atrValue * compactProfileMinimumRangeATR and
                 additionalMovementCumulativeVolumeNow >=
                      compactProfileMinimumCumulativeVolume
            bool additionalMovementIsLargeEnough =
                 additionalMovementIsStandardLargeEnough or
                 additionalMovementIsCompactLargeEnough
            if additionalMovementIsStandardLargeEnough
                additionalMovementQualifiedAsCompact := false
            bool additionalMovementOrdinarySupportedPause =
                 additionalMovementBarCount >= minimumMoveBars and
                 not na(atrValue) and
                 additionalMovementHigh - additionalMovementLow >=
                      atrValue * developingMovePauseMinimumRangeATR
            int additionalTriggerOffset =
                 not na(additionalMovementTriggerBarIndex) ?
                 bar_index - additionalMovementTriggerBarIndex : na
            int additionalLeadInOffset =
                 not na(additionalTriggerOffset) ?
                 additionalTriggerOffset + 1 : na
            float additionalLeadInRange =
                 not na(additionalLeadInOffset) ?
                 high[additionalLeadInOffset] -
                      low[additionalLeadInOffset] : na
            float additionalLeadInBody =
                 not na(additionalLeadInOffset) ?
                 close[additionalLeadInOffset] -
                      open[additionalLeadInOffset] : na
            float additionalLeadInCloseLocation =
                 not na(additionalLeadInRange) and
                 additionalLeadInRange > 0.0 ?
                 (close[additionalLeadInOffset] -
                      low[additionalLeadInOffset]) /
                      additionalLeadInRange : 0.5
            float additionalLeadInRelativeVolume =
                 not na(additionalLeadInOffset) and
                 not na(volumeAverage[additionalLeadInOffset]) and
                 volumeAverage[additionalLeadInOffset] > 0.0 ?
                 volume[additionalLeadInOffset] /
                      volumeAverage[additionalLeadInOffset] : na
            bool additionalTriggerWasExceptional =
                 enableExceptionalLaunchStart and
                 not na(additionalMovementTriggerRelativeVolume) and
                 not na(additionalMovementTriggerBodyATR) and
                 not na(additionalMovementTriggerCloseLocation) and
                 additionalMovementTriggerRelativeVolume >=
                      exceptionalLaunchRelativeVolume and
                 additionalMovementTriggerBodyATR >=
                      exceptionalLaunchBodyATR and
                 additionalMovementTriggerCloseLocation >=
                      exceptionalLaunchCloseLocation
            bool additionalExceptionalLeadInQualified =
                 enableExceptionalProvisionalStitch and
                 additionalTriggerWasExceptional and
                 not additionalMovementUsedAdaptiveOrigin and
                 not na(additionalTriggerOffset) and
                 not na(additionalLeadInOffset) and
                 additionalLeadInOffset + 1 <= bar_index and
                 array.size(additionalMovementBarIndices) > 0 and
                 array.first(additionalMovementBarIndices) ==
                      additionalMovementTriggerBarIndex and
                 inAnalysisSession[additionalLeadInOffset] and
                 activeMarketSession[additionalLeadInOffset] ==
                      activeMarketSession[additionalTriggerOffset] and
                 currentDateKey[additionalLeadInOffset] ==
                      currentDateKey[additionalTriggerOffset] and
                 time[additionalTriggerOffset] -
                      time[additionalLeadInOffset] <=
                      timeframe.in_seconds(timeframe.period) * 1000 +
                      adaptiveOriginMaximumGapMinutes * 60000 and
                 additionalMovementLow >=
                      low[additionalLeadInOffset] -
                      atrValue[additionalLeadInOffset] *
                      adaptiveOriginFloorToleranceATR and
                 not na(atrValue[additionalLeadInOffset]) and
                 not na(additionalLeadInRelativeVolume) and
                 additionalLeadInBody >=
                      atrValue[additionalLeadInOffset] *
                      exceptionalLaunchBodyATR and
                 additionalLeadInCloseLocation >= startCloseLocation and
                 additionalLeadInRelativeVolume >=
                      exceptionalProvisionalLeadInRelativeVolume and
                 close[additionalLeadInOffset] >
                      high[additionalLeadInOffset + 1] and
                 close[additionalTriggerOffset] >
                      high[additionalLeadInOffset]
            bool additionalExceptionalProvisionalPause =
                 additionalExceptionalLeadInQualified and
                 additionalMovementBarCount >=
                      math.max(2, minimumMoveBars - 1) and
                 not na(atrValue) and
                 additionalMovementHigh - additionalMovementLow >=
                      atrValue * developingMovePauseMinimumRangeATR and
                 additionalMovementCumulativeVolumeNow >=
                      minimumMoveCumulativeVolume
            int additionalAcceptedDevelopmentBarCount =
                 not na(additionalAcceptedEndBarIndex) and
                 not na(additionalMovementTriggerBarIndex) ?
                 additionalAcceptedEndBarIndex -
                      additionalMovementTriggerBarIndex + 1 : 0
            bool additionalExceptionalAcceptedWindowStillProvisional =
                 additionalExceptionalLeadInQualified and
                 additionalAcceptedDevelopmentBarCount < minimumMoveBars
            bool additionalMovementCanWaitThroughSupportedPause =
                 additionalMovementOrdinarySupportedPause or
                 additionalExceptionalProvisionalPause
            bool additionalCompactGraceEligible =
                 enableCompactHighParticipationProfiles and
                 not additionalMovementIsLargeEnough and
                 additionalMovementCanWaitThroughSupportedPause and
                 additionalMovementCumulativeVolumeNow >=
                      compactProfileMinimumCumulativeVolume
            float additionalPauseReferenceRange =
                 additionalAcceptedHigh - additionalMovementLow
            float additionalPauseRecentLow =
                 ta.lowest(low, contractionBars)
            bool additionalPauseStructureHeld =
                 additionalPauseReferenceRange > syminfo.mintick and
                 additionalPauseRecentLow >=
                      additionalAcceptedHigh -
                      additionalPauseReferenceRange *
                      extendedStitchMaximumRetracementShare
            bool additionalMovementStalled =
                 barsSinceAdditionalDevelopment >= contractionBars
            bool additionalMovementReachedMaximum =
                 additionalMovementBarCount >= maximumMoveBars
            bool additionalPauseHeldEMA9 =
                 enableEMA9MovementStitching and
                 additionalMovementCanWaitThroughSupportedPause and
                 (
                      additionalMovementIsStandardLargeEnough and
                      not additionalExceptionalAcceptedWindowStillProvisional ?
                      (
                           not na(recentEMA9MinimumCloseDifference) and
                           not na(recentEMA9MinimumLowDistance) and
                           recentEMA9MinimumCloseDifference >=
                                -atrValue * ema9StitchCloseToleranceATR and
                           recentEMA9MinimumLowDistance <=
                                atrValue * ema9StitchTouchDistanceATR
                      ) :
                      additionalPauseStructureHeld
                 ) and
                 additionalMovementStalled and
                 not additionalMovementReachedMaximum and
                 not na(atrValue)

            if additionalRecoveredThroughCompactGrace and
                 additionalMovementIsCompactLargeEnough and
                 not additionalMovementIsStandardLargeEnough and
                 additionalMovementStalled and
                 not additionalMovementReachedMaximum
                additionalMovementQualifiedAsCompact := true
                freezeAdditionalMovementNow := true
            else if additionalPauseHeldEMA9
                additionalExceptionalProvisionalStitchUsed :=
                     additionalExceptionalProvisionalStitchUsed or
                     additionalExceptionalProvisionalPause or
                     additionalExceptionalAcceptedWindowStillProvisional
                additionalMovementQualifiedAsCompact :=
                     additionalMovementQualifiedAsCompact or
                     (
                          additionalMovementIsCompactLargeEnough and
                          not additionalMovementIsStandardLargeEnough
                     )
                additionalScannerState := STATE_STITCHING
                additionalStitchDeadlineBarIndex :=
                     bar_index +
                     (
                          enableExtendedSupportedPause ?
                          extendedStitchRestartWindowBars :
                          ema9StitchRestartWindowBars
                     )
                additionalStitchReferenceHigh :=
                     additionalAcceptedHigh
                additionalStitchReferenceLow :=
                     additionalMovementLow
                additionalStitchPullbackLow := low
                additionalStitchMaySplitRestart :=
                     additionalMovementIsStandardLargeEnough
                additionalCompactGraceActive := false
            else if additionalCompactGraceEligible and
                 additionalMovementStalled and
                 not additionalMovementReachedMaximum
                additionalScannerState := STATE_STITCHING
                additionalStitchDeadlineBarIndex :=
                     bar_index + compactProfileRecoveryGraceBars
                additionalStitchReferenceHigh :=
                     additionalAcceptedHigh
                additionalStitchReferenceLow :=
                     additionalMovementLow
                additionalStitchPullbackLow := low
                additionalStitchMaySplitRestart := false
                additionalCompactGraceActive := true
            else
                additionalMovementQualifiedAsCompact :=
                     additionalMovementQualifiedAsCompact or
                     (
                          additionalMovementIsCompactLargeEnough and
                          not additionalMovementIsStandardLargeEnough
                     )
                freezeAdditionalMovementNow :=
                     additionalMovementIsLargeEnough and
                     (
                          additionalMovementStalled or
                          additionalMovementReachedMaximum
                     )
                discardAdditionalMovementNow :=
                     not additionalMovementIsLargeEnough and
                     (
                          additionalMovementStalled or
                          additionalMovementReachedMaximum
                     )
        else
            discardAdditionalMovementNow := true

    else if additionalScannerState == STATE_STITCHING
        if inAnalysisSession and
             activeMarketSession == additionalScannerSessionId
            array.push(additionalMovementLows, low)
            array.push(additionalMovementHighs, high)
            array.push(additionalMovementVolumes, nz(volume))
            array.push(additionalMovementOpens, open)
            array.push(additionalMovementCloses, close)
            array.push(additionalMovementATRs, atrValue)
            array.push(additionalMovementTimes, time)
            array.push(additionalMovementBarIndices, bar_index)

            additionalMovementLow :=
                 math.min(additionalMovementLow, low)
            if high >= additionalMovementHigh
                additionalMovementHigh := high
                additionalMovementHighBarIndex := bar_index
                additionalMovementHighEndTime := time_close
            additionalMovementPeakVolume :=
                 math.max(additionalMovementPeakVolume, nz(volume))
            additionalMovementEndTime := time_close
            additionalStitchPullbackLow :=
                 na(additionalStitchPullbackLow) ?
                 low :
                 math.min(additionalStitchPullbackLow, low)

            bool additionalStrongStitchRestart =
                 not na(additionalStitchReferenceHigh) and
                 not na(atrValue) and
                 not na(relativeVolume) and
                 close > open and
                 candleBody >= atrValue * startBodyATR and
                 candleCloseLocation >= startCloseLocation and
                 relativeVolume >= startRelativeVolume and
                 high > additionalStitchReferenceHigh and
                 close > additionalStitchReferenceHigh
            bool additionalCompactStitchRestart =
                 additionalCompactGraceActive and
                 not na(additionalStitchReferenceHigh) and
                 not na(atrValue) and
                 not na(relativeVolume) and
                 close > open and
                 high > additionalStitchReferenceHigh and
                 close > additionalStitchReferenceHigh and
                 candleBody >=
                      atrValue * compactProfileRecoveryBodyATR and
                 candleCloseLocation >=
                      compactProfileRecoveryCloseLocation and
                 relativeVolume >=
                      compactProfileRecoveryRelativeVolume
            float additionalStitchReferenceRange =
                 additionalStitchReferenceHigh -
                 additionalStitchReferenceLow
            bool additionalStitchStructureHeld =
                 not na(additionalStitchReferenceRange) and
                 additionalStitchReferenceRange > syminfo.mintick and
                 not na(additionalStitchPullbackLow) and
                 additionalStitchPullbackLow >=
                      additionalStitchReferenceHigh -
                      additionalStitchReferenceRange *
                      extendedStitchMaximumRetracementShare
            bool additionalNearHighRecovery =
                 enableExtendedSupportedPause and
                 additionalStitchStructureHeld and
                 not na(atrValue) and
                 not na(relativeVolume) and
                 close > open and
                 candleBody >= atrValue * startBodyATR and
                 candleCloseLocation >=
                      extendedStitchMinimumCloseLocation and
                 relativeVolume >=
                      extendedStitchMinimumRelativeVolume and
                 close >=
                      additionalStitchReferenceHigh -
                      atrValue * extendedStitchNearHighATR
            bool additionalStitchSupportFailed =
                 na(intradayEMA9) or
                 close <
                      intradayEMA9 -
                      atrValue * ema9StitchCloseToleranceATR
            bool additionalStitchWindowExpired =
                 not na(additionalStitchDeadlineBarIndex) and
                 bar_index >= additionalStitchDeadlineBarIndex
            bool additionalStitchReachedMaximum =
                 array.size(additionalMovementLows) >= maximumMoveBars
            bool additionalStitchMustEnd =
                 (
                      not enableExtendedSupportedPause and
                      additionalStitchSupportFailed
                 ) or
                 (
                      enableExtendedSupportedPause and
                      not additionalStitchStructureHeld
                 ) or
                 additionalStitchWindowExpired or
                 additionalStitchReachedMaximum

            if additionalStrongStitchRestart and
                 additionalStitchMaySplitRestart
                splitAdditionalRestartNow := true
                splitAdditionalMinimumOriginBarIndex :=
                     additionalAcceptedEndBarIndex + 1
                freezeAdditionalMovementNow := true
            else if additionalStrongStitchRestart or
                 additionalCompactStitchRestart or
                 additionalNearHighRecovery
                additionalRecoveredThroughCompactGrace :=
                     additionalRecoveredThroughCompactGrace or
                     additionalCompactGraceActive
                additionalMovementWasStitched := true
                additionalAcceptedEndBarIndex := bar_index
                additionalAcceptedEndTime := time_close
                additionalAcceptedHigh :=
                     math.max(additionalAcceptedHigh, high)
                additionalAcceptedClose := close
                additionalScannerState := STATE_BUILDING
                additionalStitchDeadlineBarIndex := na
                additionalStitchReferenceHigh := na
                additionalStitchReferenceLow := na
                additionalStitchPullbackLow := na
                additionalStitchMaySplitRestart := false
                additionalCompactGraceActive := false
            else if additionalStitchMustEnd
                if additionalCompactGraceActive and
                     not additionalStitchMaySplitRestart
                    discardAdditionalMovementNow := true
                else
                    freezeAdditionalMovementNow := true
        else
            freezeAdditionalMovementNow :=
                 array.size(additionalMovementLows) >= minimumMoveBars

if freezeAdditionalMovementNow
    int compactAdditionalConfirmationStartBarIndex =
         not na(additionalAcceptedEndBarIndex) ?
         additionalAcceptedEndBarIndex + 1 : na
    int compactAdditionalConfirmationEndBarIndex = bar_index
    bool additionalProvisionalLeadInCompleted =
         not additionalExceptionalProvisionalStitchUsed

    // The pause is evidence that the auction ended, not part of the auction.
    // Always remove bars after the last accepted-development endpoint before
    // calculating the profile, whether or not an earlier pause was stitched.
    if not na(additionalAcceptedEndBarIndex)
        while array.size(additionalMovementBarIndices) > 0 and
             array.last(additionalMovementBarIndices) >
                  additionalAcceptedEndBarIndex
            array.pop(additionalMovementLows)
            array.pop(additionalMovementHighs)
            array.pop(additionalMovementVolumes)
            array.pop(additionalMovementOpens)
            array.pop(additionalMovementCloses)
            array.pop(additionalMovementATRs)
            array.pop(additionalMovementTimes)
            array.pop(additionalMovementBarIndices)

    if additionalExceptionalProvisionalStitchUsed and
         array.size(additionalMovementBarIndices) > 0
        int additionalFreezeTriggerOffset =
             bar_index - additionalMovementTriggerBarIndex
        int additionalFreezeLeadInOffset =
             additionalFreezeTriggerOffset + 1
        float additionalFreezeLeadInRange =
             high[additionalFreezeLeadInOffset] -
             low[additionalFreezeLeadInOffset]
        float additionalFreezeLeadInBody =
             close[additionalFreezeLeadInOffset] -
             open[additionalFreezeLeadInOffset]
        float additionalFreezeLeadInCloseLocation =
             additionalFreezeLeadInRange > 0.0 ?
             (close[additionalFreezeLeadInOffset] -
                  low[additionalFreezeLeadInOffset]) /
                  additionalFreezeLeadInRange : 0.5
        float additionalFreezeLeadInRelativeVolume =
             not na(volumeAverage[additionalFreezeLeadInOffset]) and
             volumeAverage[additionalFreezeLeadInOffset] > 0.0 ?
             volume[additionalFreezeLeadInOffset] /
                  volumeAverage[additionalFreezeLeadInOffset] : na
        bool additionalFreezeTriggerWasExceptional =
             enableExceptionalLaunchStart and
             not na(additionalMovementTriggerRelativeVolume) and
             not na(additionalMovementTriggerBodyATR) and
             not na(additionalMovementTriggerCloseLocation) and
             additionalMovementTriggerRelativeVolume >=
                  exceptionalLaunchRelativeVolume and
             additionalMovementTriggerBodyATR >=
                  exceptionalLaunchBodyATR and
             additionalMovementTriggerCloseLocation >=
                  exceptionalLaunchCloseLocation
        bool additionalFreezeLeadInQualified =
             additionalFreezeTriggerWasExceptional and
             not additionalMovementUsedAdaptiveOrigin and
             additionalFreezeLeadInOffset + 1 <= bar_index and
             array.first(additionalMovementBarIndices) ==
                  additionalMovementTriggerBarIndex and
             inAnalysisSession[additionalFreezeLeadInOffset] and
             activeMarketSession[additionalFreezeLeadInOffset] ==
                  activeMarketSession[additionalFreezeTriggerOffset] and
             currentDateKey[additionalFreezeLeadInOffset] ==
                  currentDateKey[additionalFreezeTriggerOffset] and
             time[additionalFreezeTriggerOffset] -
                  time[additionalFreezeLeadInOffset] <=
                  timeframe.in_seconds(timeframe.period) * 1000 +
                  adaptiveOriginMaximumGapMinutes * 60000 and
             array.min(additionalMovementLows) >=
                  low[additionalFreezeLeadInOffset] -
                  atrValue[additionalFreezeLeadInOffset] *
                  adaptiveOriginFloorToleranceATR and
             not na(atrValue[additionalFreezeLeadInOffset]) and
             not na(additionalFreezeLeadInRelativeVolume) and
             additionalFreezeLeadInBody >=
                  atrValue[additionalFreezeLeadInOffset] *
                  exceptionalLaunchBodyATR and
             additionalFreezeLeadInCloseLocation >= startCloseLocation and
             additionalFreezeLeadInRelativeVolume >=
                  exceptionalProvisionalLeadInRelativeVolume and
             close[additionalFreezeLeadInOffset] >
                  high[additionalFreezeLeadInOffset + 1] and
             close[additionalFreezeTriggerOffset] >
                  high[additionalFreezeLeadInOffset]
        if additionalFreezeLeadInQualified
            array.unshift(
                 additionalMovementLows,
                 low[additionalFreezeLeadInOffset])
            array.unshift(
                 additionalMovementHighs,
                 high[additionalFreezeLeadInOffset])
            array.unshift(
                 additionalMovementVolumes,
                 nz(volume[additionalFreezeLeadInOffset]))
            array.unshift(
                 additionalMovementOpens,
                 open[additionalFreezeLeadInOffset])
            array.unshift(
                 additionalMovementCloses,
                 close[additionalFreezeLeadInOffset])
            array.unshift(
                 additionalMovementATRs,
                 atrValue[additionalFreezeLeadInOffset])
            array.unshift(
                 additionalMovementTimes,
                 time[additionalFreezeLeadInOffset])
            array.unshift(
                 additionalMovementBarIndices,
                 bar_index - additionalFreezeLeadInOffset)
            additionalProvisionalLeadInCompleted := true

    if array.size(additionalMovementLows) > 0
        additionalMovementLow :=
             array.min(additionalMovementLows)
        additionalMovementHigh :=
             array.max(additionalMovementHighs)
        additionalMovementPeakVolume :=
             array.max(additionalMovementVolumes)
        additionalMovementStartTime :=
             array.first(additionalMovementTimes)
        additionalMovementEndTime := additionalAcceptedEndTime
        lastProfileStartBarIndex :=
             array.first(additionalMovementBarIndices)

    float additionalMovementCumulativeVolume =
         array.sum(additionalMovementVolumes)
    array<float> additionalCalculatedProfile =
         f_calculateProfile(
              additionalMovementLows,
              additionalMovementHighs,
              additionalMovementVolumes,
              additionalMovementLow,
              additionalMovementHigh,
              profileRows,
              valueAreaPercent / 100.0)
    float additionalCalculatedVAL =
         array.get(additionalCalculatedProfile, 0)
    float additionalCalculatedPOC =
         array.get(additionalCalculatedProfile, 1)
    float additionalCalculatedVAH =
         array.get(additionalCalculatedProfile, 2)

    bool additionalMatureTopHeavyProfile =
         array.size(additionalMovementLows) >=
              matureTopHeavyProfileMinimumBars and
         additionalMovementCumulativeVolume >=
              matureTopHeavyProfileMinimumVolume

    bool additionalProvisionalStructureCompleted =
         additionalProvisionalLeadInCompleted and
         (
              not additionalExceptionalProvisionalStitchUsed or
              (
                   array.size(additionalMovementLows) >= minimumMoveBars and
                   array.size(additionalMovementATRs) > 0 and
                   additionalMovementHigh - additionalMovementLow >=
                        array.last(additionalMovementATRs) *
                        minimumMoveRangeATR
              )
         )

    bool additionalMovementMakesHigherHigh =
         not additionalTrendRequireHigherHigh or
         additionalMovementHigh >
              highestAcceptedTrendHigh +
              atrValue * additionalTrendHigherHighBufferATR
    bool additionalMovementOverlapsTooMuch = false
    if not na(movementLow) and not na(movementHigh)
        float primaryMovementOverlap =
             f_rangeOverlapFraction(
                  additionalMovementLow,
                  additionalMovementHigh,
                  movementLow,
                  movementHigh)
        bool primaryInitiativeOverlapException =
             f_initiativeOverlapException(
                  additionalMovementLow,
                  additionalMovementHigh,
                  movementHigh,
                  additionalMovementTriggerRelativeVolume,
                  additionalMovementTriggerBodyATR,
                  additionalMovementTriggerCloseLocation,
                  atrValue)
        additionalMovementOverlapsTooMuch :=
             primaryMovementOverlap >
                  additionalTrendMaximumRangeOverlap and
             not primaryInitiativeOverlapException

    if array.size(additionalProfiles) > 0
        for existingProfileIndex = 0 to
             array.size(additionalProfiles) - 1
            AdditionalProfile existingProfile =
                 array.get(
                      additionalProfiles,
                      existingProfileIndex)
            bool sameDateExistingProfile =
                 existingProfile.dateKey == currentDateKey
            float existingOverlap =
                 f_rangeOverlapFraction(
                      additionalMovementLow,
                      additionalMovementHigh,
                      existingProfile.movementLow,
                      existingProfile.movementHigh)
            bool existingInitiativeOverlapException =
                 f_initiativeOverlapException(
                      additionalMovementLow,
                      additionalMovementHigh,
                      existingProfile.movementHigh,
                      additionalMovementTriggerRelativeVolume,
                      additionalMovementTriggerBodyATR,
                      additionalMovementTriggerCloseLocation,
                      atrValue)
            if sameDateExistingProfile and
                 existingOverlap >
                      additionalTrendMaximumRangeOverlap and
                 not existingInitiativeOverlapException
                additionalMovementOverlapsTooMuch := true

    bool additionalProfileValuesReady =
         additionalMovementCumulativeVolume >=
              minimumMoveCumulativeVolume and
         additionalProvisionalStructureCompleted and
         additionalMovementMakesHigherHigh and
         not additionalMovementOverlapsTooMuch and
         not na(additionalCalculatedVAL) and
         not na(additionalCalculatedPOC) and
         not na(additionalCalculatedVAH) and
         additionalMovementHigh > additionalMovementLow and
         (
              (additionalMovementHigh - additionalCalculatedVAH) /
                   (additionalMovementHigh - additionalMovementLow) >=
                   minimumProfileUpperExcessShare or
              additionalMatureTopHeavyProfile
         )

    if additionalProfileValuesReady
        int additionalInitialPOCExtensionEndTime = time_close
        bool additionalPOCStoppedBeforeFreeze = false
        int additionalPOCStopScanOffset =
             bar_index - additionalAcceptedEndBarIndex - 1
        while additionalPOCStopScanOffset >= 0 and
             not additionalPOCStoppedBeforeFreeze
            if close[additionalPOCStopScanOffset] <
                 additionalCalculatedPOC *
                 (1.0 - pocExtensionStopBelowPercent / 100.0)
                additionalInitialPOCExtensionEndTime :=
                     time[additionalPOCStopScanOffset]
                additionalPOCStoppedBeforeFreeze := true
            additionalPOCStopScanOffset -= 1

        line additionalVALLine = line.new(
             x1 = additionalMovementStartTime,
             y1 = additionalCalculatedVAL,
             x2 = additionalMovementEndTime,
             y2 = additionalCalculatedVAL,
             xloc = xloc.bar_time,
             extend = extend.none,
             color = valColor,
             width = 2)
        line additionalPOCLine = line.new(
             x1 = additionalMovementStartTime,
             y1 = additionalCalculatedPOC,
             x2 = additionalInitialPOCExtensionEndTime,
             y2 = additionalCalculatedPOC,
             xloc = xloc.bar_time,
             extend = extend.none,
             color = pocColor,
             width = 2,
             style = line.style_dashed)
        line additionalVAHLine = line.new(
             x1 = additionalMovementStartTime,
             y1 = additionalCalculatedVAH,
             x2 = additionalMovementEndTime,
             y2 = additionalCalculatedVAH,
             xloc = xloc.bar_time,
             extend = extend.none,
             color = vahColor,
             width = 2)
        box additionalMovementBox = na
        if showMovementBox
            additionalMovementBox := box.new(
                 left = additionalMovementStartTime,
                 top = additionalMovementHigh,
                 right = additionalMovementEndTime,
                 bottom = additionalMovementLow,
                 xloc = xloc.bar_time,
                 border_color = color.new(vahColor, 45),
                 border_width = 1,
                 bgcolor = color.new(vahColor, 91))
            array.push(
                 retainedMovementBoxes,
                 additionalMovementBox)
            if array.size(retainedMovementBoxes) >
                 maximumHistoricalProfiles
                box.delete(array.shift(retainedMovementBoxes))

        AdditionalProfile additionalProfile = AdditionalProfile.new(
             number = nextProfileNumber,
             dateKey = currentDateKey,
             sessionId = activeMarketSession,
             movementStartTime = additionalMovementStartTime,
             movementEndTime = additionalMovementEndTime,
             readyBarIndex = bar_index,
             lastVisibleTime = additionalInitialPOCExtensionEndTime,
             movementLow = additionalMovementLow,
             movementHigh = additionalMovementHigh,
             val = additionalCalculatedVAL,
             poc = additionalCalculatedPOC,
             vah = additionalCalculatedVAH,
             freezeVWAP = sessionVWAP,
             pocExtensionStopped = additionalPOCStoppedBeforeFreeze,
             valLine = additionalVALLine,
             pocLine = additionalPOCLine,
             vahLine = additionalVAHLine,
             movementBox = additionalMovementBox)

        if additionalMovementQualifiedAsCompact and
             not na(compactAdditionalConfirmationStartBarIndex) and
             compactAdditionalConfirmationStartBarIndex <=
                  compactAdditionalConfirmationEndBarIndex
            bool compactAdditionalPOCDefenseArmed = true
            int compactAdditionalLastPOCDefenseBarIndex = na
            for compactAdditionalDefenseBarIndex =
                 compactAdditionalConfirmationStartBarIndex to
                 compactAdditionalConfirmationEndBarIndex
                int compactAdditionalDefenseOffset =
                     bar_index - compactAdditionalDefenseBarIndex
                float compactAdditionalOpen =
                     open[compactAdditionalDefenseOffset]
                float compactAdditionalHigh =
                     high[compactAdditionalDefenseOffset]
                float compactAdditionalLow =
                     low[compactAdditionalDefenseOffset]
                float compactAdditionalClose =
                     close[compactAdditionalDefenseOffset]
                float compactAdditionalATR =
                     atrValue[compactAdditionalDefenseOffset]
                float compactAdditionalVolumeAverage =
                     volumeAverage[compactAdditionalDefenseOffset]
                float compactAdditionalRelativeVolume =
                     not na(compactAdditionalVolumeAverage) and
                     compactAdditionalVolumeAverage > 0.0 ?
                     volume[compactAdditionalDefenseOffset] /
                          compactAdditionalVolumeAverage : na
                float compactAdditionalRange =
                     compactAdditionalHigh - compactAdditionalLow
                bool compactAdditionalPositiveBar =
                     compactAdditionalClose >= compactAdditionalOpen
                float compactAdditionalLowerWick =
                     (
                          compactAdditionalPositiveBar ?
                          compactAdditionalOpen : compactAdditionalClose
                     ) - compactAdditionalLow
                bool compactAdditionalBandCleared =
                     compactAdditionalLow >
                          additionalProfile.poc +
                          compactAdditionalATR * pocDefenseApproachATR
                if not compactAdditionalPOCDefenseArmed and
                     compactAdditionalBandCleared
                    compactAdditionalPOCDefenseArmed := true
                bool compactAdditionalSpacingOk =
                     na(compactAdditionalLastPOCDefenseBarIndex) or
                     compactAdditionalDefenseBarIndex -
                          compactAdditionalLastPOCDefenseBarIndex >=
                          pocDefenseSpacingBars
                bool compactAdditionalHistoricalPOCDefense =
                     compactAdditionalPOCDefenseArmed and
                     close[compactAdditionalDefenseOffset + 1] >
                          additionalProfile.poc and
                     compactAdditionalOpen > additionalProfile.poc and
                     compactAdditionalLow <=
                          additionalProfile.poc +
                          compactAdditionalATR * pocDefenseApproachATR and
                     compactAdditionalLow <
                          low[compactAdditionalDefenseOffset + 1] and
                     compactAdditionalOpen <
                          high[compactAdditionalDefenseOffset + 1] and
                     compactAdditionalClose >
                          additionalProfile.poc +
                          compactAdditionalATR *
                          pocDefenseCloseBufferATR and
                     compactAdditionalLowerWick > 0.0 and
                     compactAdditionalRange > 0.0 and
                     compactAdditionalLowerWick >=
                          compactAdditionalRange *
                          pocDefenseMinimumLowerWickFraction and
                     not na(compactAdditionalRelativeVolume) and
                     compactAdditionalRelativeVolume >=
                          pocDefenseMinimumRelativeVolume and
                     compactAdditionalSpacingOk
                if compactAdditionalHistoricalPOCDefense
                    compactAdditionalPOCDefenseArmed := false
                    compactAdditionalLastPOCDefenseBarIndex :=
                         compactAdditionalDefenseBarIndex
                    additionalProfile.pocDefenseArmed := false
                    additionalProfile.lastPOCDefenseBarIndex :=
                         compactAdditionalDefenseBarIndex
                    pocDefendedThisBar := true
                    line.set_color(additionalProfile.pocLine, pocColor)
                    line.set_width(additionalProfile.pocLine, 3)
                    if showPOCDefenseMarkers
                        label compactAdditionalPOCDefenseLabel = label.new(
                             x = time[compactAdditionalDefenseOffset],
                             y = compactAdditionalLow,
                             text = "P" +
                                  str.tostring(additionalProfile.number) +
                                  " POC\nDEFENDED",
                             xloc = xloc.bar_time,
                             yloc = yloc.price,
                             style = label.style_label_up,
                             color = pocColor,
                             textcolor = color.rgb(30, 30, 30),
                             size = size.tiny,
                             tooltip =
                                  "COMPACT PROFILE " +
                                  str.tostring(additionalProfile.number) +
                                  " POC DEFENDED\nDefense: " +
                                  str.format_time(
                                       time[compactAdditionalDefenseOffset],
                                       "HH:mm",
                                       syminfo.timezone) +
                                  "\nKnown when profile froze: " +
                                  str.format_time(
                                       time,
                                       "HH:mm",
                                       syminfo.timezone) +
                                  "\nPOC: " +
                                  str.tostring(
                                       additionalProfile.poc,
                                       format.mintick) +
                                  "\nVolume / average: " +
                                  str.tostring(
                                       compactAdditionalRelativeVolume,
                                       "#.##") + "×")
                        array.push(
                             retainedMarkers,
                             compactAdditionalPOCDefenseLabel)
            additionalProfile.pocDefenseArmed :=
                 compactAdditionalPOCDefenseArmed
            additionalProfile.lastPOCDefenseBarIndex :=
                 compactAdditionalLastPOCDefenseBarIndex

        int additionalStoredBarCount =
             array.size(additionalMovementLows)
        if additionalStoredBarCount > 0
            for storedAdditionalIndex = 0 to
                 additionalStoredBarCount - 1
                float storedAdditionalOpen =
                     array.get(
                          additionalMovementOpens,
                          storedAdditionalIndex)
                float storedAdditionalHigh =
                     array.get(
                          additionalMovementHighs,
                          storedAdditionalIndex)
                float storedAdditionalClose =
                     array.get(
                          additionalMovementCloses,
                          storedAdditionalIndex)
                float storedAdditionalATR =
                     array.get(
                          additionalMovementATRs,
                          storedAdditionalIndex)
                int storedAdditionalTime =
                     array.get(
                          additionalMovementTimes,
                          storedAdditionalIndex)
                int storedAdditionalBarIndex =
                     array.get(
                          additionalMovementBarIndices,
                          storedAdditionalIndex)
                bool storedAdditionalPOCFail =
                     not na(storedAdditionalATR) and
                     storedAdditionalATR > 0.0 and
                     storedAdditionalOpen < additionalProfile.poc and
                     storedAdditionalHigh >=
                          additionalProfile.poc +
                          storedAdditionalATR *
                          pocMinimumPenetrationATR and
                     storedAdditionalClose <=
                          additionalProfile.poc +
                          storedAdditionalATR *
                          pocFailedCloseBandATR and
                     storedAdditionalHigh - storedAdditionalClose >=
                          storedAdditionalATR *
                          pocMinimumDownwardRejectionATR and
                     (
                          na(additionalProfile.lastPOCAttemptBarIndex) or
                          storedAdditionalBarIndex -
                          additionalProfile.lastPOCAttemptBarIndex >=
                          pocAttemptSpacingBars
                     )
                if storedAdditionalPOCFail
                    additionalProfile.failedPOCAttempts += 1
                    additionalProfile.lastPOCAttemptBarIndex :=
                         storedAdditionalBarIndex
                    if showPOCAttemptMarkers
                        label storedAdditionalFailLabel = label.new(
                             x = storedAdditionalTime,
                             y = storedAdditionalHigh +
                                  storedAdditionalATR *
                                  pocAttemptLabelDistanceATR,
                             text = "P" +
                                  str.tostring(additionalProfile.number) +
                                  " POC\nFAIL " +
                                  str.tostring(
                                       additionalProfile.failedPOCAttempts),
                             xloc = xloc.bar_time,
                             yloc = yloc.price,
                             style = label.style_label_down,
                             color = color.new(pocColor, 5),
                             textcolor = color.rgb(30, 30, 30),
                             size = size.tiny,
                             tooltip =
                                  "PROFILE " +
                                  str.tostring(additionalProfile.number) +
                                  " FAILED POC ATTEMPT\nPOC: " +
                                  str.tostring(
                                       additionalProfile.poc,
                                       format.mintick))
                        array.push(
                             retainedMarkers,
                             storedAdditionalFailLabel)
        additionalProfile.internalFailedPOCAttempts :=
             additionalProfile.failedPOCAttempts
        array.push(additionalProfiles, additionalProfile)

        if enableVALSweepPOCReclaim
            f_registerVALSweepPOCProfile(
                 valSweepPOCProfiles,
                 additionalProfile.number,
                 currentDateKey,
                 activeMarketSession,
                 additionalMovementStartTime,
                 additionalMovementEndTime,
                 bar_index,
                 additionalMovementLow,
                 additionalMovementHigh,
                 additionalCalculatedVAL,
                 additionalCalculatedPOC,
                 additionalCalculatedVAH)

        array.push(retainedProfileLines, additionalVALLine)
        array.push(retainedProfileLines, additionalPOCLine)
        array.push(retainedProfileLines, additionalVAHLine)
        while array.size(retainedProfileLines) >
             maximumHistoricalProfiles * 3
            line.delete(array.shift(retainedProfileLines))

        float additionalVALElevation =
             additionalMovementHigh > additionalMovementLow ?
             (additionalCalculatedVAL - additionalMovementLow) /
                  (additionalMovementHigh - additionalMovementLow) :
             0.0
        float additionalDominanceScore =
             additionalMovementCumulativeVolume *
             math.max(
                  additionalMovementHigh - additionalMovementLow,
                  syminfo.mintick)
        if enableStackedMeaningfulVALProfiles
            f_registerMeaningfulVALProfile(
                 meaningfulVALProfiles,
                 currentDateKey,
                 activeMarketSession,
                 additionalMovementStartTime,
                 additionalMovementEndTime,
                 bar_index,
                 additionalMovementLow,
                 additionalMovementHigh,
                 additionalCalculatedVAL,
                 additionalCalculatedPOC,
                 additionalCalculatedVAH,
                 additionalMovementCumulativeVolume,
                 atrValue,
                 additionalVALLine,
                 additionalPOCLine,
                 additionalVAHLine,
                 additionalPOCStoppedBeforeFreeze)
        bool additionalDominantElevationQualified =
             additionalVALElevation >=
                  dominantMinimumVALElevationPercent / 100.0
        bool additionalDominantIsLater =
             na(dominantReferenceEndTime) or
             additionalMovementEndTime > dominantReferenceEndTime
        bool additionalDominantScoreQualified =
             not dominantReferenceReady or
             dominantReferenceInvalidated or
             additionalDominanceScore >=
                  dominantReferenceScore *
                  dominantReplacementScoreRatio
        bool selectAdditionalAsDominant =
             enableDominantProfileVALReference and
             not enableStackedMeaningfulVALProfiles and
             additionalDominantElevationQualified and
             additionalDominantIsLater and
             additionalDominantScoreQualified

        if selectAdditionalAsDominant
            if not na(dominantReferenceVALLine)
                line.delete(dominantReferenceVALLine)
            if not na(dominantReferencePOCLine)
                line.delete(dominantReferencePOCLine)
            if not na(dominantReferenceVAHLine)
                line.delete(dominantReferenceVAHLine)

            dominantReferenceReady := true
            dominantReferenceInvalidated := false
            dominantReferenceDateKey := currentDateKey
            dominantReferenceSessionId := activeMarketSession
            dominantReferenceStartTime :=
                 additionalMovementStartTime
            dominantReferenceEndTime := additionalMovementEndTime
            dominantReferenceReadyBarIndex := bar_index
            dominantReferenceAgeTradingDates := 0
            dominantReferenceMovementLow := additionalMovementLow
            dominantReferenceMovementHigh := additionalMovementHigh
            dominantReferenceVAL := additionalCalculatedVAL
            dominantReferencePOC := additionalCalculatedPOC
            dominantReferenceVAH := additionalCalculatedVAH
            dominantReferenceCumulativeVolume :=
                 additionalMovementCumulativeVolume
            dominantReferenceScore := additionalDominanceScore
            dominantReferenceClosesBelowLow := 0
            dominantReferencePOCExtensionStopped :=
                 additionalPOCStoppedBeforeFreeze
            dominantReferenceDefenseArmed := true
            dominantReferenceTestActive := false
            dominantReferenceTestBarIndex := na
            dominantReferenceTestTime := na
            dominantReferenceTestLow := na

            dominantReferenceVALLine := line.new(
                 x1 = additionalMovementStartTime,
                 y1 = additionalCalculatedVAL,
                 x2 = additionalMovementEndTime,
                 y2 = additionalCalculatedVAL,
                 xloc = xloc.bar_time,
                 extend = extend.none,
                 color = color.new(valColor, 0),
                 width = 4)
            dominantReferencePOCLine := line.new(
                 x1 = additionalMovementStartTime,
                 y1 = additionalCalculatedPOC,
                 x2 = additionalInitialPOCExtensionEndTime,
                 y2 = additionalCalculatedPOC,
                 xloc = xloc.bar_time,
                 extend = extend.none,
                 color = pocColor,
                 width = 3,
                 style = line.style_dashed)
            dominantReferenceVAHLine := line.new(
                 x1 = additionalMovementStartTime,
                 y1 = additionalCalculatedVAH,
                 x2 = additionalMovementEndTime,
                 y2 = additionalCalculatedVAH,
                 xloc = xloc.bar_time,
                 extend = extend.none,
                 color = vahColor,
                 width = 3)

        if showFrozenProfileLabel
            string additionalProfileTooltip =
                 "FRVP " +
                 str.tostring(additionalProfile.number) +
                 " FROZEN\n" +
                 str.format_time(
                      additionalMovementStartTime,
                      "HH:mm",
                      syminfo.timezone) +
                 "–" +
                 str.format_time(
                      additionalMovementEndTime,
                      "HH:mm",
                      syminfo.timezone) +
                 "\nVAL " +
                 str.tostring(additionalProfile.val, format.mintick) +
                 "  •  POC " +
                 str.tostring(additionalProfile.poc, format.mintick) +
                 "  •  VAH " +
                 str.tostring(additionalProfile.vah, format.mintick) +
                 "\nCumulative volume " +
                 str.tostring(
                      math.round(additionalMovementCumulativeVolume))
            label additionalProfileLabel = label.new(
                 x = additionalMovementEndTime,
                 y = additionalMovementHigh,
                 text = "FRVP " +
                      str.tostring(additionalProfile.number) +
                      "\nFROZEN",
                 xloc = xloc.bar_time,
                 yloc = yloc.price,
                 style = label.style_label_down,
                 color = color.new(vahColor, 5),
                 textcolor = color.white,
                 size = size.tiny,
                 tooltip = additionalProfileTooltip)
            array.push(retainedMarkers, additionalProfileLabel)

        profilesCreatedInCurrentSession += 1
        nextProfileNumber += 1
        lastProfileFreezeBarIndex := bar_index
        highestAcceptedTrendHigh :=
             math.max(
                  highestAcceptedTrendHigh,
                  additionalMovementHigh)

    additionalScannerState := STATE_SEARCHING
    array.clear(additionalMovementLows)
    array.clear(additionalMovementHighs)
    array.clear(additionalMovementVolumes)
    array.clear(additionalMovementOpens)
    array.clear(additionalMovementCloses)
    array.clear(additionalMovementATRs)
    array.clear(additionalMovementTimes)
    array.clear(additionalMovementBarIndices)
    additionalMovementLow := na
    additionalMovementHigh := na
    additionalMovementPeakVolume := na
    additionalMovementStartTime := na
    additionalMovementEndTime := na
    additionalMovementHighBarIndex := na
    additionalMovementHighEndTime := na
    additionalAcceptedEndBarIndex := na
    additionalAcceptedEndTime := na
    additionalAcceptedHigh := na
    additionalAcceptedClose := na
    additionalMovementTriggerRelativeVolume := na
    additionalMovementTriggerBodyATR := na
    additionalMovementTriggerCloseLocation := na
    additionalMovementTriggerBarIndex := na
    additionalMovementTriggerTime := na
    additionalMovementUsedAdaptiveOrigin := false
    additionalMovementWasStitched := false
    additionalExceptionalProvisionalStitchUsed := false
    additionalStitchDeadlineBarIndex := na
    additionalStitchReferenceHigh := na
    additionalStitchReferenceLow := na
    additionalStitchPullbackLow := na
    additionalStitchMaySplitRestart := false
    additionalCompactGraceActive := false
    additionalMovementQualifiedAsCompact := false
    additionalRecoveredThroughCompactGrace := false
    additionalFreshParticipationResetUsed := false

// A fully qualified initiative bar after a completed pause begins a new
// auction. Seed it immediately on the same bar so a one-bar launch is not lost
// merely because the preceding profile also became knowable now.
bool seedSplitRestartNow =
     (splitPrimaryRestartNow or splitAdditionalRestartNow) and
     inAnalysisSession and
     activeMarketSession != 0 and
     profilesCreatedInCurrentSession < maximumProfilesPerSession

if seedSplitRestartNow
    array.clear(additionalMovementLows)
    array.clear(additionalMovementHighs)
    array.clear(additionalMovementVolumes)
    array.clear(additionalMovementOpens)
    array.clear(additionalMovementCloses)
    array.clear(additionalMovementATRs)
    array.clear(additionalMovementTimes)
    array.clear(additionalMovementBarIndices)

    additionalMovementLow := low
    additionalMovementHigh := high
    additionalMovementPeakVolume := nz(volume)
    additionalMovementStartTime := time
    additionalMovementEndTime := time_close
    additionalMovementHighBarIndex := bar_index
    additionalMovementHighEndTime := time_close
    additionalMovementTriggerRelativeVolume := relativeVolume
    additionalMovementTriggerBodyATR := candleBody / atrValue
    additionalMovementTriggerCloseLocation := candleCloseLocation
    additionalMovementTriggerBarIndex := bar_index
    additionalMovementTriggerTime := time
    additionalMovementUsedAdaptiveOrigin := false
    additionalMovementWasStitched := false
    additionalExceptionalProvisionalStitchUsed := false
    additionalStitchDeadlineBarIndex := na
    additionalStitchReferenceHigh := na
    additionalStitchReferenceLow := na
    additionalStitchPullbackLow := na
    additionalStitchMaySplitRestart := false
    additionalCompactGraceActive := false
    additionalMovementQualifiedAsCompact := false
    additionalRecoveredThroughCompactGrace := false
    additionalFreshParticipationResetUsed := false

    int splitMinimumOriginBarIndex =
         splitPrimaryRestartNow ?
         splitPrimaryMinimumOriginBarIndex :
         splitAdditionalMinimumOriginBarIndex

    int splitContextBarsToInclude = autoPreTriggerBars
    bool splitAdaptiveOriginFound = false
    int splitOriginOffset = adaptiveMovementOriginLookbackBars
    while enableAdaptiveMovementOrigin and
         splitOriginOffset > autoPreTriggerBars
        float splitOriginRange =
             high[splitOriginOffset] - low[splitOriginOffset]
        float splitOriginBody =
             close[splitOriginOffset] - open[splitOriginOffset]
        float splitOriginCloseLocation =
             splitOriginRange > 0.0 ?
             (close[splitOriginOffset] - low[splitOriginOffset]) /
                  splitOriginRange : 0.5
        float splitOriginRelativeVolume =
             not na(volumeAverage[splitOriginOffset]) and
             volumeAverage[splitOriginOffset] > 0.0 ?
             volume[splitOriginOffset] /
                  volumeAverage[splitOriginOffset] : na
        bool splitOriginContiguous =
             inAnalysisSession[splitOriginOffset] and
             activeMarketSession[splitOriginOffset] ==
                  activeMarketSession and
             currentDateKey[splitOriginOffset] == currentDateKey and
             time - time[splitOriginOffset] <=
                  timeframe.in_seconds(timeframe.period) *
                  1000 * splitOriginOffset +
                  adaptiveOriginMaximumGapMinutes * 60000
        bool splitOriginFloorHeld = true
        int splitFloorOffset = splitOriginOffset - 1
        while splitFloorOffset >= 0 and splitOriginFloorHeld
            if low[splitFloorOffset] <
                 low[splitOriginOffset] -
                 atrValue[splitOriginOffset] *
                 adaptiveOriginFloorToleranceATR
                splitOriginFloorHeld := false
            splitFloorOffset -= 1
        bool splitOriginBreaksPriorHigh =
             not adaptiveOriginMustBreakPriorHigh or
             (
                  not na(high[splitOriginOffset + 1]) and
                  close[splitOriginOffset] >
                       high[splitOriginOffset + 1]
             )
        bool splitOriginAuctionStructureHeld = true
        float splitOriginSequencePeakHigh = high[splitOriginOffset]
        int splitOriginStructureOffset = splitOriginOffset - 1
        while splitOriginStructureOffset >= 0 and
             splitOriginAuctionStructureHeld
            float splitOriginStructureRange =
                 splitOriginSequencePeakHigh - low[splitOriginOffset]
            if high[splitOriginStructureOffset] >
                 splitOriginSequencePeakHigh
                splitOriginSequencePeakHigh :=
                     high[splitOriginStructureOffset]
            else if splitOriginStructureRange > syminfo.mintick and
                 low[splitOriginStructureOffset] <
                      splitOriginSequencePeakHigh -
                      splitOriginStructureRange *
                      adaptiveOriginMaximumRetracementShare
                splitOriginAuctionStructureHeld := false
            splitOriginStructureOffset -= 1
        bool splitAdaptiveOriginCandidate =
             not splitAdaptiveOriginFound and
             splitOriginContiguous and
             splitOriginFloorHeld and
             splitOriginBreaksPriorHigh and
             splitOriginAuctionStructureHeld and
             (
                  na(splitMinimumOriginBarIndex) or
                  bar_index - splitOriginOffset >=
                       splitMinimumOriginBarIndex
             ) and
             not na(atrValue[splitOriginOffset]) and
             not na(splitOriginRelativeVolume) and
             volume[splitOriginOffset] >=
                  adaptiveOriginMinimumAbsoluteVolume and
             splitOriginBody >=
                  atrValue[splitOriginOffset] *
                  adaptiveOriginMinimumBodyATR and
             splitOriginCloseLocation >= startCloseLocation and
             splitOriginRelativeVolume >=
                  adaptiveOriginMinimumRelativeVolume and
             close > high[splitOriginOffset]
        if splitAdaptiveOriginCandidate
            splitContextBarsToInclude := splitOriginOffset
            splitAdaptiveOriginFound := true
            additionalMovementUsedAdaptiveOrigin := true
        splitOriginOffset -= 1

    int splitContextOffset = splitContextBarsToInclude
    while splitContextOffset >= 1
        bool splitContextEligible =
             inAnalysisSession[splitContextOffset] and
             activeMarketSession[splitContextOffset] ==
                  activeMarketSession and
             currentDateKey[splitContextOffset] == currentDateKey and
             (
                  na(splitMinimumOriginBarIndex) or
                  bar_index - splitContextOffset >=
                       splitMinimumOriginBarIndex
             ) and
             time - time[splitContextOffset] <=
                  timeframe.in_seconds(timeframe.period) *
                  1000 * splitContextOffset +
                  adaptiveOriginMaximumGapMinutes * 60000
        if splitContextEligible
            array.push(additionalMovementLows, low[splitContextOffset])
            array.push(additionalMovementHighs, high[splitContextOffset])
            array.push(
                 additionalMovementVolumes,
                 nz(volume[splitContextOffset]))
            array.push(additionalMovementOpens, open[splitContextOffset])
            array.push(additionalMovementCloses, close[splitContextOffset])
            array.push(additionalMovementATRs, atrValue[splitContextOffset])
            array.push(additionalMovementTimes, time[splitContextOffset])
            array.push(
                 additionalMovementBarIndices,
                 bar_index - splitContextOffset)
            additionalMovementLow :=
                 math.min(additionalMovementLow, low[splitContextOffset])
            additionalMovementHigh :=
                 math.max(additionalMovementHigh, high[splitContextOffset])
            additionalMovementPeakVolume :=
                 math.max(
                      additionalMovementPeakVolume,
                      nz(volume[splitContextOffset]))
            additionalMovementStartTime :=
                 math.min(additionalMovementStartTime, time[splitContextOffset])
        splitContextOffset -= 1

    array.push(additionalMovementLows, low)
    array.push(additionalMovementHighs, high)
    array.push(additionalMovementVolumes, nz(volume))
    array.push(additionalMovementOpens, open)
    array.push(additionalMovementCloses, close)
    array.push(additionalMovementATRs, atrValue)
    array.push(additionalMovementTimes, time)
    array.push(additionalMovementBarIndices, bar_index)
    additionalAcceptedEndBarIndex := bar_index
    additionalAcceptedEndTime := time_close
    additionalAcceptedHigh := additionalMovementHigh
    additionalAcceptedClose := close
    lastProfileStartBarIndex :=
         array.first(additionalMovementBarIndices)
    additionalScannerSessionId := activeMarketSession
    additionalScannerResetArmed := false
    additionalScannerState := STATE_BUILDING

if discardAdditionalMovementNow
    additionalScannerState := STATE_SEARCHING
    array.clear(additionalMovementLows)
    array.clear(additionalMovementHighs)
    array.clear(additionalMovementVolumes)
    array.clear(additionalMovementOpens)
    array.clear(additionalMovementCloses)
    array.clear(additionalMovementATRs)
    array.clear(additionalMovementTimes)
    array.clear(additionalMovementBarIndices)
    additionalMovementLow := na
    additionalMovementHigh := na
    additionalMovementPeakVolume := na
    additionalMovementStartTime := na
    additionalMovementEndTime := na
    additionalMovementHighBarIndex := na
    additionalMovementHighEndTime := na
    additionalAcceptedEndBarIndex := na
    additionalAcceptedEndTime := na
    additionalAcceptedHigh := na
    additionalAcceptedClose := na
    additionalMovementTriggerRelativeVolume := na
    additionalMovementTriggerBodyATR := na
    additionalMovementTriggerCloseLocation := na
    additionalMovementTriggerBarIndex := na
    additionalMovementTriggerTime := na
    additionalMovementUsedAdaptiveOrigin := false
    additionalMovementWasStitched := false
    additionalExceptionalProvisionalStitchUsed := false
    additionalStitchDeadlineBarIndex := na
    additionalStitchReferenceHigh := na
    additionalStitchReferenceLow := na
    additionalStitchPullbackLow := na
    additionalStitchMaySplitRestart := false
    additionalCompactGraceActive := false
    additionalMovementQualifiedAsCompact := false
    additionalRecoveredThroughCompactGrace := false
    additionalFreshParticipationResetUsed := false

//------------------------------------------------------------------------------
// Support-confirmed retrospective profiles
//------------------------------------------------------------------------------
// A short auction is stored invisibly at its high-participation culmination.
// It is drawn only after later price action proves its calculated VAL or POC
// as support. Nothing in this branch is visible or alertable before that live
// confirmation exists.

if barstate.isconfirmed and
     timeframeSupported and
     inAnalysisSession and
     enableRetrospectiveSupportProfiles
    int retrospectiveCandidateIndex =
         array.size(retrospectiveCandidates) - 1
    while retrospectiveCandidateIndex >= 0
        RetrospectiveProfileCandidate retrospectiveCandidate =
             array.get(
                  retrospectiveCandidates,
                  retrospectiveCandidateIndex)

        bool retrospectiveCandidateExpired =
             retrospectiveCandidate.dateKey != currentDateKey or
             bar_index > retrospectiveCandidate.expiryBarIndex
        bool retrospectiveCandidateLost =
             bar_index > retrospectiveCandidate.endBarIndex and
             close < retrospectiveCandidate.val
        bool removeRetrospectiveCandidate =
             retrospectiveCandidateExpired or
             retrospectiveCandidateLost
        bool retrospectiveProfileConfirmedNow = false
        string retrospectiveConfirmationPath = ""

        if not removeRetrospectiveCandidate and
             bar_index > retrospectiveCandidate.endBarIndex
            float retrospectiveLowerWick =
                 (close >= open ? open : close) - low
            float retrospectiveLowerWickShare =
                 candleRange > syminfo.mintick ?
                 retrospectiveLowerWick / candleRange : 0.0
            bool retrospectiveDirectVALDefense =
                 open > retrospectiveCandidate.val and
                 low <= retrospectiveCandidate.val and
                 close > retrospectiveCandidate.val and
                 low < low[1] and
                 not na(relativeVolume) and
                 relativeVolume >=
                      retrospectiveVALDefenseRelativeVolume and
                 retrospectiveLowerWickShare >=
                      retrospectiveVALDefenseLowerWickShare

            if retrospectiveDirectVALDefense
                retrospectiveProfileConfirmedNow := true
                retrospectiveConfirmationPath := "VAL DEFENSE"
            else
                bool retrospectiveStartsPOCTest =
                     not retrospectiveCandidate.pocTestActive and
                     not na(atrValue) and
                     open > retrospectiveCandidate.poc and
                     low <= retrospectiveCandidate.poc +
                          atrValue * retrospectivePOCApproachATR and
                     close > retrospectiveCandidate.poc
                if retrospectiveStartsPOCTest
                    retrospectiveCandidate.pocTestActive := true
                    retrospectiveCandidate.pocTestBarIndex := bar_index
                    retrospectiveCandidate.pocTestTime := time
                    retrospectiveCandidate.pocTestLow := low

                if retrospectiveCandidate.pocTestActive
                    int retrospectiveBarsSincePOCTest =
                         bar_index -
                         retrospectiveCandidate.pocTestBarIndex
                    bool retrospectivePOCFloorPreserved =
                         not na(atrValue) and
                         low >= retrospectiveCandidate.pocTestLow -
                              atrValue * 0.05
                    float retrospectivePriorPeakVolume =
                         ta.highest(volume[1], 2)
                    bool retrospectiveBuyerControl =
                         retrospectiveBarsSincePOCTest > 0 and
                         retrospectiveBarsSincePOCTest <=
                              retrospectiveBuyerControlWindowBars and
                         retrospectivePOCFloorPreserved and
                         close > open and
                         candleBody >=
                              atrValue *
                              retrospectiveBuyerControlBodyATR and
                         candleCloseLocation >=
                              retrospectiveBuyerControlCloseLocation and
                         nz(volume) >=
                              retrospectivePriorPeakVolume *
                              retrospectiveBuyerControlVolumeRatio and
                         high - retrospectiveCandidate.pocTestLow >=
                              atrValue *
                              retrospectiveBuyerControlReactionATR

                    if retrospectiveBuyerControl
                        retrospectiveProfileConfirmedNow := true
                        retrospectiveConfirmationPath :=
                             "POC FLOOR / BUYER CONTROL"
                    else if not retrospectivePOCFloorPreserved or
                         retrospectiveBarsSincePOCTest >=
                              retrospectiveBuyerControlWindowBars
                        retrospectiveCandidate.pocTestActive := false
                        retrospectiveCandidate.pocTestBarIndex := na
                        retrospectiveCandidate.pocTestTime := na
                        retrospectiveCandidate.pocTestLow := na

        if retrospectiveProfileConfirmedNow
            bool duplicateRetrospectiveProfile =
                 lifecycleState == STATE_PROFILE and
                 movementStartTime <= retrospectiveCandidate.endTime and
                 movementEndTime >= retrospectiveCandidate.startTime
            if array.size(additionalProfiles) > 0
                for retrospectiveDuplicateIndex = 0 to
                     array.size(additionalProfiles) - 1
                    AdditionalProfile retrospectiveExistingProfile =
                         array.get(
                              additionalProfiles,
                              retrospectiveDuplicateIndex)
                    if retrospectiveExistingProfile.movementStartTime <=
                         retrospectiveCandidate.endTime and
                         retrospectiveExistingProfile.movementEndTime >=
                         retrospectiveCandidate.startTime
                        duplicateRetrospectiveProfile := true

            if not duplicateRetrospectiveProfile and
                 retrospectiveProfilesConfirmedInSession <
                      maximumRetrospectiveProfilesPerSession
                line retrospectiveVALLine = line.new(
                     x1 = retrospectiveCandidate.startTime,
                     y1 = retrospectiveCandidate.val,
                     x2 = retrospectiveCandidate.endTime,
                     y2 = retrospectiveCandidate.val,
                     xloc = xloc.bar_time,
                     extend = extend.none,
                     color = valColor,
                     width = 2)
                line retrospectivePOCLine = line.new(
                     x1 = retrospectiveCandidate.startTime,
                     y1 = retrospectiveCandidate.poc,
                     x2 = time_close,
                     y2 = retrospectiveCandidate.poc,
                     xloc = xloc.bar_time,
                     extend = extend.none,
                     color = pocColor,
                     width = 2,
                     style = line.style_dashed)
                line retrospectiveVAHLine = line.new(
                     x1 = retrospectiveCandidate.startTime,
                     y1 = retrospectiveCandidate.vah,
                     x2 = retrospectiveCandidate.endTime,
                     y2 = retrospectiveCandidate.vah,
                     xloc = xloc.bar_time,
                     extend = extend.none,
                     color = vahColor,
                     width = 2)
                box retrospectiveMovementBox = na
                if showMovementBox
                    retrospectiveMovementBox := box.new(
                         left = retrospectiveCandidate.startTime,
                         top = retrospectiveCandidate.movementHigh,
                         right = retrospectiveCandidate.endTime,
                         bottom = retrospectiveCandidate.movementLow,
                         xloc = xloc.bar_time,
                         border_color = color.new(vahColor, 45),
                         border_width = 1,
                         bgcolor = color.new(vahColor, 91))
                    array.push(
                         retainedMovementBoxes,
                         retrospectiveMovementBox)
                    if array.size(retainedMovementBoxes) >
                         maximumHistoricalProfiles
                        box.delete(array.shift(retainedMovementBoxes))

                AdditionalProfile retrospectiveProfile =
                     AdditionalProfile.new(
                          number = nextProfileNumber,
                          dateKey = currentDateKey,
                          sessionId = activeMarketSession,
                          movementStartTime =
                               retrospectiveCandidate.startTime,
                          movementEndTime =
                               retrospectiveCandidate.endTime,
                          readyBarIndex = bar_index,
                          lastVisibleTime = time_close,
                          movementLow =
                               retrospectiveCandidate.movementLow,
                          movementHigh =
                               retrospectiveCandidate.movementHigh,
                          val = retrospectiveCandidate.val,
                          poc = retrospectiveCandidate.poc,
                          vah = retrospectiveCandidate.vah,
                          freezeVWAP = sessionVWAP,
                          valDefended = true,
                          valLine = retrospectiveVALLine,
                          pocLine = retrospectivePOCLine,
                          vahLine = retrospectiveVAHLine,
                          movementBox = retrospectiveMovementBox)
                array.push(additionalProfiles, retrospectiveProfile)
                array.push(retainedProfileLines, retrospectiveVALLine)
                array.push(retainedProfileLines, retrospectivePOCLine)
                array.push(retainedProfileLines, retrospectiveVAHLine)
                while array.size(retainedProfileLines) >
                     maximumHistoricalProfiles * 3
                    line.delete(array.shift(retainedProfileLines))

                retrospectiveProfilesConfirmedInSession += 1
                nextProfileNumber += 1

            removeRetrospectiveCandidate := true

        if removeRetrospectiveCandidate
            array.remove(
                 retrospectiveCandidates,
                 retrospectiveCandidateIndex)
        else
            array.set(
                 retrospectiveCandidates,
                 retrospectiveCandidateIndex,
                 retrospectiveCandidate)
        retrospectiveCandidateIndex -= 1

    bool retrospectiveRangeCulmination =
         retrospectiveProfilesConfirmedInSession <
              maximumRetrospectiveProfilesPerSession and
         not na(atrValue) and
         not na(relativeVolume) and
         close > open and
         nz(volume) >= retrospectiveCulminationMinimumVolume and
         relativeVolume >= retrospectiveCulminationRelativeVolume and
         candleBody >= atrValue * retrospectiveCulminationBodyATR and
         candleCloseLocation >=
              retrospectiveCulminationCloseLocation and
         bar_index > 0 and
         high > high[1]

    if retrospectiveRangeCulmination
        bool retrospectiveRangeStored = false
        int retrospectiveBarsLow =
             math.min(
                  retrospectiveMinimumBars,
                  retrospectiveMaximumBars)
        int retrospectiveBarsHigh =
             math.max(
                  retrospectiveMinimumBars,
                  retrospectiveMaximumBars)
        for retrospectiveLength = retrospectiveBarsLow to
             retrospectiveBarsHigh
            if not retrospectiveRangeStored and
                 bar_index >= retrospectiveLength - 1
                int retrospectiveStartOffset =
                     retrospectiveLength - 1
                bool retrospectiveWindowEligible =
                     currentDateKey[retrospectiveStartOffset] ==
                          currentDateKey and
                     activeMarketSession[retrospectiveStartOffset] ==
                          activeMarketSession and
                     time - time[retrospectiveStartOffset] <=
                          retrospectiveMaximumSpanMinutes * 60000
                array<float> retrospectiveLows = array.new_float()
                array<float> retrospectiveHighs = array.new_float()
                array<float> retrospectiveVolumes = array.new_float()
                if retrospectiveWindowEligible
                    int retrospectiveOffset =
                         retrospectiveStartOffset
                    while retrospectiveOffset >= 0
                        bool retrospectiveBarEligible =
                             currentDateKey[retrospectiveOffset] ==
                                  currentDateKey and
                             activeMarketSession[retrospectiveOffset] ==
                                  activeMarketSession
                        if retrospectiveBarEligible
                            array.push(
                                 retrospectiveLows,
                                 low[retrospectiveOffset])
                            array.push(
                                 retrospectiveHighs,
                                 high[retrospectiveOffset])
                            array.push(
                                 retrospectiveVolumes,
                                 nz(volume[retrospectiveOffset]))
                        else
                            retrospectiveWindowEligible := false
                        retrospectiveOffset -= 1

                if retrospectiveWindowEligible and
                     array.size(retrospectiveLows) ==
                          retrospectiveLength
                    float retrospectiveMovementLow =
                         array.min(retrospectiveLows)
                    float retrospectiveMovementHigh =
                         array.max(retrospectiveHighs)
                    float retrospectiveCumulativeVolume =
                         array.sum(retrospectiveVolumes)
                    float retrospectiveMovementRange =
                         retrospectiveMovementHigh -
                         retrospectiveMovementLow
                    bool retrospectiveStartOwnsFloor =
                         low[retrospectiveStartOffset] <=
                              retrospectiveMovementLow +
                              atrValue * 0.10
                    bool retrospectiveEndOwnsHigh =
                         high >= retrospectiveMovementHigh -
                              syminfo.mintick
                    bool retrospectivePriceDeveloped =
                         close > close[retrospectiveStartOffset]
                    bool retrospectiveSizeQualified =
                         retrospectiveCumulativeVolume >=
                              retrospectiveMinimumCumulativeVolume and
                         retrospectiveMovementRange >=
                              atrValue *
                              retrospectiveMinimumRangeATR

                    if retrospectiveStartOwnsFloor and
                         retrospectiveEndOwnsHigh and
                         retrospectivePriceDeveloped and
                         retrospectiveSizeQualified
                        array<float> retrospectiveCalculatedProfile =
                             f_calculateProfile(
                                  retrospectiveLows,
                                  retrospectiveHighs,
                                  retrospectiveVolumes,
                                  retrospectiveMovementLow,
                                  retrospectiveMovementHigh,
                                  profileRows,
                                  valueAreaPercent / 100.0)
                        float retrospectiveCalculatedVAL =
                             array.get(
                                  retrospectiveCalculatedProfile,
                                  0)
                        float retrospectiveCalculatedPOC =
                             array.get(
                                  retrospectiveCalculatedProfile,
                                  1)
                        float retrospectiveCalculatedVAH =
                             array.get(
                                  retrospectiveCalculatedProfile,
                                  2)
                        float retrospectiveVALElevation =
                             retrospectiveMovementRange >
                                  syminfo.mintick ?
                             (
                                  retrospectiveCalculatedVAL -
                                  retrospectiveMovementLow
                             ) / retrospectiveMovementRange : 0.0
                        bool retrospectiveProfileReady =
                             not na(retrospectiveCalculatedVAL) and
                             not na(retrospectiveCalculatedPOC) and
                             not na(retrospectiveCalculatedVAH) and
                             retrospectiveVALElevation >=
                                  retrospectiveMinimumVALElevation

                        bool duplicatePendingRetrospective = false
                        if array.size(retrospectiveCandidates) > 0
                            for pendingDuplicateIndex = 0 to
                                 array.size(retrospectiveCandidates) - 1
                                RetrospectiveProfileCandidate pendingDuplicate =
                                     array.get(
                                          retrospectiveCandidates,
                                          pendingDuplicateIndex)
                                if pendingDuplicate.startTime ==
                                     time[retrospectiveStartOffset] and
                                     pendingDuplicate.endTime == time_close
                                    duplicatePendingRetrospective := true

                        if retrospectiveProfileReady and
                             not duplicatePendingRetrospective
                            RetrospectiveProfileCandidate newRetrospectiveCandidate =
                                 RetrospectiveProfileCandidate.new(
                                      dateKey = currentDateKey,
                                      sessionId = activeMarketSession,
                                      startTime =
                                           time[retrospectiveStartOffset],
                                      endTime = time_close,
                                      startBarIndex =
                                           bar_index -
                                           retrospectiveStartOffset,
                                      endBarIndex = bar_index,
                                      expiryBarIndex =
                                           bar_index +
                                           retrospectiveCandidateExpiryBars,
                                      movementLow =
                                           retrospectiveMovementLow,
                                      movementHigh =
                                           retrospectiveMovementHigh,
                                      val = retrospectiveCalculatedVAL,
                                      poc = retrospectiveCalculatedPOC,
                                      vah = retrospectiveCalculatedVAH,
                                      cumulativeVolume =
                                           retrospectiveCumulativeVolume)
                            array.push(
                                 retrospectiveCandidates,
                                 newRetrospectiveCandidate)
                            while array.size(retrospectiveCandidates) >
                                 maximumPendingRetrospectiveCandidates
                                array.shift(retrospectiveCandidates)
                            retrospectiveRangeStored := true

//------------------------------------------------------------------------------
// Independent lifecycle for every additional frozen profile
//------------------------------------------------------------------------------

if barstate.isconfirmed and
     timeframeSupported and
     inAnalysisSession and
     array.size(additionalProfiles) > 0
    for additionalProfileIndex = 0 to
         array.size(additionalProfiles) - 1
        AdditionalProfile additionalProfile =
             array.get(additionalProfiles, additionalProfileIndex)
        bool additionalProfileCanBeEvaluated =
             additionalProfile.dateKey == currentDateKey and
             bar_index > additionalProfile.readyBarIndex

        if additionalProfileCanBeEvaluated
            bool additionalConfirmBreakoutNow = false
            bool additionalProfileReactivatedNow = false
            if not additionalProfile.pocExtensionStopped
                if close <
                     additionalProfile.poc *
                     (1.0 - pocExtensionStopBelowPercent / 100.0)
                    additionalProfile.pocExtensionStopped := true
                else
                    additionalProfile.lastVisibleTime := time_close
                    line.set_x2(
                         additionalProfile.pocLine,
                         additionalProfile.lastVisibleTime)

            bool additionalCloseBelowMovementLow =
                 close < additionalProfile.movementLow
            additionalProfile.closesBelowMovementLow :=
                 additionalCloseBelowMovementLow ?
                 additionalProfile.closesBelowMovementLow + 1 :
                 0
            bool additionalProfileInvalidatedNow =
                 additionalProfile.closesBelowMovementLow >=
                      valInvalidationCloses and
                 not additionalProfile.invalidated

            if additionalProfileInvalidatedNow
                additionalProfile.invalidated := true
                additionalProfile.valEntryCandidateActive := false
                additionalProfile.valEntryCandidateBarIndex := na
                additionalProfile.valEntryCandidateTime := na
                additionalProfile.valEntryCandidateHigh := na
                additionalProfile.valEntryCandidateLow := na
                additionalProfile.breakoutPending := false
                additionalProfile.breakoutConfirmed := false
                additionalProfile.entryLabel := na
                additionalProfile.recoveryStage := 0
                if showVALInvalidation and
                     not additionalProfile.invalidationMarked
                    label additionalLostLabel = label.new(
                         x = time,
                         y = low,
                         text = "FRVP " +
                              str.tostring(additionalProfile.number) +
                              "\nLOST",
                         xloc = xloc.bar_time,
                         yloc = yloc.price,
                         style = label.style_label_up,
                         color = color.new(color.red, 5),
                         textcolor = color.white,
                         size = size.tiny,
                         tooltip =
                              "Profile " +
                              str.tostring(additionalProfile.number) +
                              " was accepted below its movement low " +
                              str.tostring(
                                   additionalProfile.movementLow,
                                   format.mintick))
                    array.push(retainedMarkers, additionalLostLabel)
                    additionalProfile.invalidationMarked := true

            if additionalProfile.invalidated and
                 enableProfileReactivation
                int additionalRecoveryStageBefore =
                     additionalProfile.recoveryStage
                float additionalRecoveryBodyToRange =
                     candleRange > 0.0 ?
                     candleBody / candleRange :
                     0.0
                bool additionalOrderedRecovery =
                     additionalRecoveryStageBefore >= 2 and
                     additionalProfile.failedPOCAttempts >=
                          minimumFailedPOCAttempts and
                     close[1] > additionalProfile.poc and
                     close[1] <= additionalProfile.vah and
                     open > additionalProfile.poc and
                     open <= additionalProfile.vah and
                     low >= additionalProfile.poc and
                     close >
                          additionalProfile.vah +
                          atrValue * pocFightVAHClearanceATR and
                     close > open and
                     candleBody >= atrValue * breakoutBodyATR and
                     additionalRecoveryBodyToRange >=
                          pocFightMinimumBodyRange and
                     candleCloseLocation >=
                          pocFightMinimumCloseLocation and
                     not na(relativeVolume) and
                     relativeVolume >= breakoutRelativeVolume and
                     not na(volume[1]) and
                     volume[1] > 0.0 and
                     volume >=
                          volume[1] * pocFightPreviousVolumeMultiple
                if additionalOrderedRecovery
                    additionalProfile.invalidated := false
                    additionalProfile.invalidationMarked := false
                    additionalProfile.valDefended := true
                    additionalProfile.closesBelowMovementLow := 0
                    additionalProfile.recoveryStage := 0
                    additionalProfile.pocDefenseArmed := true
                    additionalProfile.vahDefenseArmed := true
                    additionalProfileReactivatedNow := true
                    profileReactivatedThisBar := true
                else
                    additionalProfile.recoveryStage :=
                         close < additionalProfile.val ? 0 :
                         close < additionalProfile.poc ? 1 : 2

            if not additionalProfile.invalidated
                float additionalVALLowerWick =
                     math.min(open, close) - low

                bool additionalVALEntryConfirmedNow = false
                if enableVALEntryConfirmation and
                     not enableDominantProfileVALReference and
                     additionalProfile.valEntryCandidateActive
                    int additionalBarsSinceVALCandidate =
                         bar_index -
                         additionalProfile.valEntryCandidateBarIndex
                    bool additionalVALEntryFloorBroken =
                         low < additionalProfile.valEntryCandidateLow
                    bool additionalVALEntryReachedPOC =
                         high >= additionalProfile.poc
                    bool additionalVALEntryHighConfirmed =
                         additionalBarsSinceVALCandidate >= 1 and
                         additionalBarsSinceVALCandidate <=
                              valEntryConfirmationBars and
                         close >
                              additionalProfile.valEntryCandidateHigh

                    if additionalVALEntryFloorBroken or
                         additionalVALEntryReachedPOC
                        additionalProfile.valEntryCandidateActive :=
                             false
                    else if additionalVALEntryHighConfirmed
                        additionalVALEntryConfirmedNow := true
                        valEntryConfirmedThisBar := true
                        additionalProfile.valEntryCandidateActive :=
                             false

                        float additionalVALEntryLabelY =
                             low -
                             math.max(
                                  atrValue * valEntryLabelDistanceATR,
                                  high * 0.003)
                        string additionalVALEntryTooltip =
                             "VAL ENTRY CONFIRMED\n" +
                             "Profile: " +
                             str.tostring(additionalProfile.number) +
                             "\nDefense: " +
                             str.format_time(
                                  additionalProfile.valEntryCandidateTime,
                                  "HH:mm",
                                  syminfo.timezone) +
                             "\nConfirmed: " +
                             str.format_time(
                                  time,
                                  "HH:mm",
                                  syminfo.timezone) +
                             "\nVAL: " +
                             str.tostring(
                                  additionalProfile.val,
                                  format.mintick) +
                             "\nDefended low: " +
                             str.tostring(
                                  additionalProfile.valEntryCandidateLow,
                                  format.mintick) +
                             "\nDefense high: " +
                             str.tostring(
                                  additionalProfile.valEntryCandidateHigh,
                                  format.mintick)

                        if showEntryMarkers
                            label additionalVALEntryLabel = label.new(
                                 x = time,
                                 y = additionalVALEntryLabelY,
                                 text = "VAL ENTRY\nCONFIRMED",
                                 xloc = xloc.bar_time,
                                 yloc = yloc.price,
                                 style = label.style_label_up,
                                 color = continuationColor,
                                 textcolor = color.white,
                                 size = size.tiny,
                                 tooltip =
                                      additionalVALEntryTooltip)
                            array.push(
                                 retainedEntryMarkers,
                                 additionalVALEntryLabel)
                    else if additionalBarsSinceVALCandidate >=
                         valEntryConfirmationBars
                        additionalProfile.valEntryCandidateActive :=
                             false

                bool additionalVALEntryNearVAL =
                     not na(atrValue) and
                     atrValue > 0.0 and
                     low >=
                          additionalProfile.val -
                          atrValue * valEntryMaximumUndercutATR and
                     low <=
                          additionalProfile.val +
                          atrValue * valEntryMaximumFrontRunATR
                bool additionalVALEntryWickQuality =
                     candleRange > 0.0 and
                     additionalVALLowerWick >=
                          candleRange *
                          valEntryMinimumLowerWickRange and
                     additionalVALLowerWick >=
                          candleBody * valEntryMinimumLowerWickBody
                bool additionalVALEntryVolumeQuality =
                     not na(relativeVolume) and
                     relativeVolume > valEntryMinimumRelativeVolume
                bool additionalVALEntryCandidate =
                     enableVALEntryConfirmation and
                     not enableDominantProfileVALReference and
                     not additionalProfile.valEntryCandidateActive and
                     not additionalVALEntryConfirmedNow and
                     open > additionalProfile.val and
                     additionalVALEntryNearVAL and
                     close > additionalProfile.val and
                     additionalVALEntryWickQuality and
                     additionalVALEntryVolumeQuality and
                     low < low[1]

                if additionalVALEntryCandidate
                    additionalProfile.valEntryCandidateActive := true
                    additionalProfile.valEntryCandidateBarIndex :=
                         bar_index
                    additionalProfile.valEntryCandidateTime := time
                    additionalProfile.valEntryCandidateHigh := high
                    additionalProfile.valEntryCandidateLow := low
                    additionalProfile.valDefended := true
                    valDefendedThisBar := true
                    line.set_color(
                         additionalProfile.valLine,
                         color.new(valColor, 0))
                    line.set_width(additionalProfile.valLine, 3)

                bool additionalVALDefense =
                     open > additionalProfile.val and
                     close > additionalProfile.val and
                     low < additionalProfile.val and
                     candleBody > 0.0 and
                     additionalVALLowerWick >=
                          candleBody * valMinimumLowerWickToBody
                if additionalVALDefense
                    additionalProfile.valDefended := true
                    line.set_color(
                         additionalProfile.valLine,
                         color.new(valColor, 0))
                    line.set_width(additionalProfile.valLine, 3)
                    if not enableDominantProfileVALReference
                        valDefendedThisBar := true
                    if showVALDefenseMarkers and
                         not enableDominantProfileVALReference
                        label additionalVALDefenseLabel = label.new(
                             x = time,
                             y = low,
                             text = "P" +
                                  str.tostring(additionalProfile.number) +
                                  " VAL\nDEFENDED",
                             xloc = xloc.bar_time,
                             yloc = yloc.price,
                             style = label.style_label_up,
                             color = color.new(valColor, 0),
                             textcolor = color.white,
                             size = size.tiny,
                             tooltip =
                                  "PROFILE " +
                                  str.tostring(additionalProfile.number) +
                                  " VAL DEFENDED\nVAL: " +
                                  str.tostring(
                                       additionalProfile.val,
                                       format.mintick))
                        array.push(
                             retainedMarkers,
                             additionalVALDefenseLabel)

                bool additionalPOCBandCleared =
                     low >
                     additionalProfile.poc +
                     atrValue * pocDefenseApproachATR
                if not additionalProfile.pocDefenseArmed and
                     additionalPOCBandCleared
                    additionalProfile.pocDefenseArmed := true

                if additionalProfile.pocDefenseArmed
                    bool additionalPOCPositiveBar = close >= open
                    float additionalPOCLowerWick =
                         (
                              additionalPOCPositiveBar ?
                              open :
                              close
                         ) - low
                    bool additionalDirectPOCDefense =
                         close[1] > additionalProfile.poc and
                         open > additionalProfile.poc and
                         low <=
                              additionalProfile.poc +
                              atrValue * pocDefenseApproachATR and
                         low < low[1] and
                         open < high[1] and
                         close >
                              additionalProfile.poc +
                              atrValue * pocDefenseCloseBufferATR and
                         additionalPOCLowerWick > 0.0 and
                         candleRange > 0.0 and
                         additionalPOCLowerWick >=
                              candleRange *
                              pocDefenseMinimumLowerWickFraction and
                         not na(volumeAverage) and
                         volumeAverage > 0.0 and
                         volume / volumeAverage >=
                              pocDefenseMinimumRelativeVolume and
                         (
                              na(
                                   additionalProfile.lastPOCDefenseBarIndex) or
                              bar_index -
                              additionalProfile.lastPOCDefenseBarIndex >=
                                   pocDefenseSpacingBars
                         )
                    if additionalDirectPOCDefense
                        additionalProfile.pocDefenseArmed := false
                        additionalProfile.lastPOCDefenseBarIndex :=
                             bar_index
                        pocDefendedThisBar := true
                        line.set_color(
                             additionalProfile.pocLine,
                             pocColor)
                        line.set_width(additionalProfile.pocLine, 3)
                        if showPOCDefenseMarkers
                            label additionalPOCDefenseLabel = label.new(
                                 x = time,
                                 y = low,
                                 text = "P" +
                                      str.tostring(
                                           additionalProfile.number) +
                                      " POC\nDEFENDED",
                                 xloc = xloc.bar_time,
                                 yloc = yloc.price,
                                 style = label.style_label_up,
                                 color = pocColor,
                                 textcolor = color.rgb(30, 30, 30),
                                 size = size.tiny,
                                 tooltip =
                                      "PROFILE " +
                                      str.tostring(
                                           additionalProfile.number) +
                                      " POC DEFENDED\nPOC: " +
                                      str.tostring(
                                           additionalProfile.poc,
                                           format.mintick) +
                                      "\nVolume / average: " +
                                      str.tostring(
                                           volume / volumeAverage,
                                           "#.##") +
                                      "×")
                            array.push(
                                 retainedMarkers,
                                 additionalPOCDefenseLabel)

                bool additionalVAHBandCleared =
                     low >
                     additionalProfile.vah +
                     atrValue * vahDefenseApproachATR
                if not additionalProfile.vahDefenseArmed and
                     additionalVAHBandCleared
                    additionalProfile.vahDefenseArmed := true

                if additionalProfile.vahCandidateActive
                    int additionalVAHCandidateAge =
                         bar_index -
                         additionalProfile.vahCandidateBarIndex
                    bool additionalVAHCandidateFloorHeld =
                         low >= additionalProfile.vahCandidateLow
                    bool additionalVAHCandidateValueHeld =
                         close >=
                         additionalProfile.vah -
                         atrValue * vahDefenseCloseToleranceATR
                    bool additionalTwoBarVAHDefense =
                         additionalVAHCandidateAge >= 1 and
                         additionalVAHCandidateAge <=
                              vahDefenseConfirmationWindowBars and
                         additionalVAHCandidateFloorHeld and
                         additionalVAHCandidateValueHeld and
                         open > additionalProfile.vah and
                         close > additionalProfile.vahCandidateHigh and
                         close > open and
                         candleBody >=
                              atrValue *
                              twoBarVAHConfirmationBodyATR and
                         candleCloseLocation >=
                              twoBarVAHConfirmationCloseLocation and
                         not na(volumeAverage) and
                         volumeAverage > 0.0 and
                         volume > volumeAverage and
                         volume >=
                              additionalProfile.vahCandidateVolume *
                              twoBarVAHConfirmationVolumeMultiple
                    if additionalTwoBarVAHDefense
                        additionalProfile.vahDefenseArmed := false
                        additionalProfile.lastVAHDefenseBarIndex :=
                             bar_index
                        vahDefendedThisBar := true
                        line.set_color(
                             additionalProfile.vahLine,
                             vahColor)
                        line.set_width(additionalProfile.vahLine, 3)
                        if showVAHDefenseMarkers
                            label additionalTwoBarVAHLabel = label.new(
                                 x = additionalProfile.vahCandidateTime,
                                 y = additionalProfile.vahCandidateLow,
                                 text = "P" +
                                      str.tostring(
                                           additionalProfile.number) +
                                      " VAH\nDEFENDED",
                                 xloc = xloc.bar_time,
                                 yloc = yloc.price,
                                 style = label.style_label_up,
                                 color = vahColor,
                                 textcolor = color.white,
                                 size = size.tiny,
                                 tooltip =
                                      "PROFILE " +
                                      str.tostring(
                                           additionalProfile.number) +
                                      " VAH DEFENDED\nTest: " +
                                      str.format_time(
                                           additionalProfile.vahCandidateTime,
                                           "HH:mm",
                                           syminfo.timezone) +
                                      "\nConfirmed: " +
                                      str.format_time(
                                           time,
                                           "HH:mm",
                                           syminfo.timezone) +
                                      "\nVAH: " +
                                      str.tostring(
                                           additionalProfile.vah,
                                           format.mintick))
                            array.push(
                                 retainedMarkers,
                                 additionalTwoBarVAHLabel)

                    bool additionalVAHCandidateExpired =
                         additionalVAHCandidateAge >=
                         vahDefenseConfirmationWindowBars
                    bool additionalVAHCandidateFailed =
                         not additionalVAHCandidateFloorHeld or
                         not additionalVAHCandidateValueHeld
                    if additionalTwoBarVAHDefense or
                         additionalVAHCandidateExpired or
                         additionalVAHCandidateFailed
                        additionalProfile.vahCandidateActive := false
                        additionalProfile.vahCandidateBarIndex := na
                        additionalProfile.vahCandidateTime := na
                        additionalProfile.vahCandidateOpen := na
                        additionalProfile.vahCandidateHigh := na
                        additionalProfile.vahCandidateLow := na
                        additionalProfile.vahCandidateClose := na
                        additionalProfile.vahCandidateVolume := na
                        additionalProfile.vahCandidateLowerWickShare :=
                             na

                if additionalProfile.vahDefenseArmed and
                     not additionalProfile.vahCandidateActive
                    bool additionalImmediateVAHRetest =
                         not na(additionalProfile.breakoutBarIndex) and
                         bar_index ==
                              additionalProfile.breakoutBarIndex + 1 and
                         (
                              additionalProfile.breakoutPending or
                              additionalProfile.breakoutConfirmed
                         )
                    bool additionalVAHPositiveBar = close >= open
                    float additionalVAHLowerWick =
                         (
                              additionalVAHPositiveBar ?
                              open :
                              close
                         ) - low
                    bool additionalVAHVolumeReady =
                         not na(volumeAverage) and
                         volumeAverage > 0.0
                    bool additionalVAHCoreQualified =
                         close[1] > additionalProfile.vah and
                         open > additionalProfile.vah and
                         low <=
                              additionalProfile.vah +
                              atrValue * vahDefenseApproachATR and
                         (
                              low < low[1] or
                              additionalImmediateVAHRetest
                         ) and
                         open < high[1] and
                         close >=
                              additionalProfile.vah -
                              atrValue * vahDefenseCloseToleranceATR and
                         additionalVAHLowerWick > 0.0 and
                         candleRange > 0.0 and
                         (
                              na(
                                   additionalProfile.lastVAHDefenseBarIndex) or
                              bar_index -
                              additionalProfile.lastVAHDefenseBarIndex >=
                                   vahDefenseSpacingBars
                         )
                    bool additionalDirectVAHDefense =
                         additionalVAHCoreQualified and
                         additionalVAHLowerWick >=
                              candleRange *
                              vahDefenseMinimumLowerWickFraction and
                         additionalVAHVolumeReady and
                         volume > volumeAverage
                    if additionalDirectVAHDefense
                        additionalProfile.vahDefenseArmed := false
                        additionalProfile.lastVAHDefenseBarIndex :=
                             bar_index
                        vahDefendedThisBar := true
                        line.set_color(
                             additionalProfile.vahLine,
                             vahColor)
                        line.set_width(additionalProfile.vahLine, 3)
                        if showVAHDefenseMarkers
                            label additionalVAHDefenseLabel = label.new(
                                 x = time,
                                 y = low,
                                 text = "P" +
                                      str.tostring(
                                           additionalProfile.number) +
                                      " VAH\nDEFENDED",
                                 xloc = xloc.bar_time,
                                 yloc = yloc.price,
                                 style = label.style_label_up,
                                 color = vahColor,
                                 textcolor = color.white,
                                 size = size.tiny,
                                 tooltip =
                                      "PROFILE " +
                                      str.tostring(
                                           additionalProfile.number) +
                                      " VAH DEFENDED\nVAH: " +
                                      str.tostring(
                                           additionalProfile.vah,
                                           format.mintick))
                            array.push(
                                 retainedMarkers,
                                 additionalVAHDefenseLabel)
                    else
                        bool additionalDelayedVAHCandidate =
                             enableTwoBarVAHDefense and
                             additionalVAHCoreQualified and
                             additionalVAHLowerWick >=
                                  candleRange *
                                  vahCandidateMinimumLowerWickFraction and
                             additionalVAHVolumeReady
                        if additionalDelayedVAHCandidate
                            additionalProfile.vahCandidateActive := true
                            additionalProfile.vahCandidateBarIndex :=
                                 bar_index
                            additionalProfile.vahCandidateTime := time
                            additionalProfile.vahCandidateOpen := open
                            additionalProfile.vahCandidateHigh := high
                            additionalProfile.vahCandidateLow := low
                            additionalProfile.vahCandidateClose := close
                            additionalProfile.vahCandidateVolume :=
                                 volume
                            additionalProfile.vahCandidateLowerWickShare :=
                                 additionalVAHLowerWick / candleRange

            if additionalProfile.breakoutPending
                bool additionalValueAreaSweepPending =
                     additionalProfile.breakoutPath ==
                     BREAKOUT_PATH_VALUE_AREA_SWEEP
                bool additionalHoldFailed =
                     additionalValueAreaSweepPending ?
                     close < additionalProfile.vah :
                     close <
                          additionalProfile.poc -
                          atrValue * breakoutFailureBelowPOCATR
                int additionalElapsedHoldBars =
                     bar_index - additionalProfile.breakoutBarIndex
                if additionalHoldFailed
                    additionalProfile.breakoutPending := false
                    additionalProfile.entryLabel := na
                else if additionalElapsedHoldBars >=
                     breakoutHoldBars
                    additionalConfirmBreakoutNow := true

            bool additionalOpensBelowPOC =
                 open < additionalProfile.poc
            bool additionalReachesPOC =
                 high >=
                 additionalProfile.poc +
                 atrValue * pocMinimumPenetrationATR
            bool additionalClosesNearPOC =
                 close <=
                 additionalProfile.poc +
                 atrValue * pocFailedCloseBandATR
            bool additionalRejectsFromPOC =
                 high - close >=
                 atrValue * pocMinimumDownwardRejectionATR
            bool additionalPOCFailSpacing =
                 na(additionalProfile.lastPOCAttemptBarIndex) or
                 bar_index -
                 additionalProfile.lastPOCAttemptBarIndex >=
                 pocAttemptSpacingBars
            bool additionalPOCFailNow =
                 not additionalProfile.invalidated and
                 not additionalProfile.breakoutPending and
                 not additionalProfile.breakoutConfirmed and
                 additionalOpensBelowPOC and
                 additionalReachesPOC and
                 additionalClosesNearPOC and
                 additionalRejectsFromPOC and
                 additionalPOCFailSpacing
            if additionalPOCFailNow
                additionalProfile.failedPOCAttempts += 1
                additionalProfile.lastPOCAttemptBarIndex := bar_index
                if showPOCAttemptMarkers
                    label additionalPOCFailLabel = label.new(
                         x = time,
                         y = high +
                              atrValue * pocAttemptLabelDistanceATR,
                         text = "P" +
                              str.tostring(additionalProfile.number) +
                              " POC\nFAIL " +
                              str.tostring(
                                   additionalProfile.failedPOCAttempts),
                         xloc = xloc.bar_time,
                         yloc = yloc.price,
                         style = label.style_label_down,
                         color = color.new(pocColor, 5),
                         textcolor = color.rgb(30, 30, 30),
                         size = size.tiny,
                         tooltip =
                              "PROFILE " +
                              str.tostring(additionalProfile.number) +
                              " FAILED POC ATTEMPT\nPOC: " +
                              str.tostring(
                                   additionalProfile.poc,
                                   format.mintick))
                    array.push(
                         retainedMarkers,
                         additionalPOCFailLabel)

            bool additionalBreakoutStartsNearPOC =
                 open <=
                      additionalProfile.poc +
                      atrValue * breakoutStartToleranceATR or
                 close[1] <=
                      additionalProfile.poc +
                      atrValue * breakoutStartToleranceATR
            bool additionalBreakoutAboveVAH =
                 close >
                 additionalProfile.vah +
                 atrValue * breakoutVAHBufferATR
            bool additionalBreakoutPriceQuality =
                 close > open and
                 candleBody >= atrValue * breakoutBodyATR and
                 candleCloseLocation >= breakoutCloseLocation
            bool additionalBreakoutVolumeQuality =
                 not na(relativeVolume) and
                 relativeVolume >= breakoutRelativeVolume
            bool additionalClassicBreakout =
                 not additionalProfile.breakoutPending and
                 not additionalProfile.breakoutConfirmed and
                 additionalProfile.valDefended and
                 not additionalProfile.invalidated and
                 additionalProfile.failedPOCAttempts >=
                      minimumFailedPOCAttempts and
                 additionalBreakoutStartsNearPOC and
                 additionalBreakoutAboveVAH and
                 additionalBreakoutPriceQuality and
                 additionalBreakoutVolumeQuality

            float additionalBodyToRange =
                 candleRange > 0.0 ?
                 candleBody / candleRange :
                 0.0
            bool additionalPOCFightBreakout =
                 not additionalProfile.breakoutPending and
                 not additionalProfile.breakoutConfirmed and
                 enablePOCFightVAHReclaim and
                 not additionalProfile.invalidated and
                 additionalProfile.internalFailedPOCAttempts >=
                      minimumFailedPOCAttempts and
                 open > additionalProfile.poc and
                 open <= additionalProfile.vah and
                 close[1] <= additionalProfile.vah and
                 low >= additionalProfile.poc and
                 close >
                      additionalProfile.vah +
                      atrValue * pocFightVAHClearanceATR and
                 close > open and
                 candleBody >= atrValue * breakoutBodyATR and
                 additionalBodyToRange >=
                      pocFightMinimumBodyRange and
                 candleCloseLocation >=
                      pocFightMinimumCloseLocation and
                 not na(relativeVolume) and
                 relativeVolume >=
                      pocFightMinimumRelativeVolume and
                 not na(volume[1]) and
                 volume[1] > 0.0 and
                 volume >=
                      volume[1] * pocFightPreviousVolumeMultiple

            bool additionalExceptionalBreakout =
                 not additionalProfile.breakoutPending and
                 not additionalProfile.breakoutConfirmed and
                 enableExceptionalVAHExpansion and
                 additionalProfile.valDefended and
                 not additionalProfile.invalidated and
                 close[1] <= additionalProfile.vah and
                 close >
                      additionalProfile.vah +
                      atrValue * exceptionalVAHClearanceATR and
                 close > open and
                 candleBody >= atrValue * exceptionalBodyATR and
                 additionalBodyToRange >=
                      exceptionalBodyRangeFraction and
                 candleCloseLocation >= exceptionalCloseLocation and
                 additionalBreakoutVolumeQuality and
                 not na(exceptionalPreviousVolumeAverage) and
                 exceptionalPreviousVolumeAverage > 0.0 and
                 volume >=
                      exceptionalPreviousVolumeAverage *
                      exceptionalRecentVolumeMultiplier
            float additionalValueAreaSweepLowerWick =
                 math.min(open, close) - low
            float additionalValueAreaSweepLowerWickToRange =
                 candleRange > 0.0 ?
                 additionalValueAreaSweepLowerWick / candleRange :
                 0.0
            bool additionalValueAreaSweepBreakout =
                 not additionalProfile.breakoutPending and
                 not additionalProfile.breakoutConfirmed and
                 enableValueAreaSweepReclaim and
                 not additionalProfile.invalidated and
                 (
                      additionalProfile.valDefended or
                      additionalProfile.failedPOCAttempts >=
                           valueAreaSweepMinimumFailedPOCAttempts
                 ) and
                 open >= additionalProfile.poc and
                 open <= additionalProfile.vah and
                 close[1] >= additionalProfile.poc and
                 close[1] <= additionalProfile.vah and
                 low <= additionalProfile.poc and
                 low >=
                      additionalProfile.val -
                      atrValue * valueAreaSweepMaximumVALUndercutATR and
                 close >
                      additionalProfile.vah +
                      atrValue * valueAreaSweepVAHClearanceATR and
                 close > open and
                 candleBody >=
                      atrValue * valueAreaSweepMinimumBodyATR and
                 additionalBodyToRange >=
                      valueAreaSweepMinimumBodyRange and
                 candleCloseLocation >=
                      valueAreaSweepMinimumCloseLocation and
                 additionalValueAreaSweepLowerWickToRange >=
                      valueAreaSweepMinimumLowerWickRange and
                 not na(relativeVolume) and
                 relativeVolume >=
                      valueAreaSweepMinimumRelativeVolume and
                 not na(exceptionalPreviousVolumeAverage) and
                 exceptionalPreviousVolumeAverage > 0.0 and
                 volume >=
                      exceptionalPreviousVolumeAverage *
                      valueAreaSweepRecentVolumeMultiplier
            bool additionalStrongBreakout =
                 additionalProfileReactivatedNow or
                 additionalValueAreaSweepBreakout or
                 additionalClassicBreakout or
                 additionalPOCFightBreakout or
                 additionalExceptionalBreakout

            if additionalStrongBreakout
                additionalProfile.breakoutBarIndex := bar_index
                additionalProfile.breakoutTime := time
                additionalProfile.breakoutLow := low
                additionalProfile.breakoutHigh := high
                additionalProfile.breakoutATR := atrValue
                additionalProfile.breakoutPath :=
                     additionalProfileReactivatedNow ?
                     "PROFILE RECOVERY / VAH RECLAIM" :
                     additionalValueAreaSweepBreakout ?
                     BREAKOUT_PATH_VALUE_AREA_SWEEP :
                     additionalExceptionalBreakout ?
                     "EXCEPTIONAL VAH EXPANSION" :
                     additionalPOCFightBreakout ?
                     "POC FIGHT / VAH RECLAIM" :
                     "POC-TO-VAH CONTINUATION"
                entryTriggeredThisBar := true
                if breakoutHoldBars == 0
                    additionalConfirmBreakoutNow := true
                else
                    additionalProfile.breakoutPending := true

            if additionalConfirmBreakoutNow
                additionalProfile.breakoutPending := false
                additionalProfile.breakoutConfirmed := true
                if showEntryMarkers
                    string additionalConfirmedEntryTooltip =
                         "FRVP ENTRY CONFIRMED\n" +
                         "Profile: " +
                         str.tostring(additionalProfile.number) +
                         "\nEntry: " +
                         str.format_time(
                              additionalProfile.breakoutTime,
                              "HH:mm",
                              syminfo.timezone) +
                         "\nConfirmed: " +
                         str.format_time(
                              time,
                              "HH:mm",
                              syminfo.timezone) +
                         "\nType: " +
                         additionalProfile.breakoutPath +
                         "\nVAL: " +
                         str.tostring(
                              additionalProfile.val,
                              format.mintick) +
                         "\nPOC: " +
                         str.tostring(
                              additionalProfile.poc,
                              format.mintick) +
                         "\nVAH: " +
                         str.tostring(
                              additionalProfile.vah,
                              format.mintick)
                    additionalProfile.entryLabel := label.new(
                         x = additionalProfile.breakoutTime,
                         y = additionalProfile.breakoutLow,
                         text = "FRVP ENTRY\nCONFIRMED",
                         xloc = xloc.bar_time,
                         yloc = yloc.belowbar,
                         style = label.style_label_up,
                         color = continuationColor,
                         textcolor = color.white,
                         size = size.tiny,
                         tooltip = additionalConfirmedEntryTooltip)
                    array.push(
                         retainedEntryMarkers,
                         additionalProfile.entryLabel)
                line.set_color(
                     additionalProfile.valLine,
                     color.new(valColor, 20))
                line.set_color(additionalProfile.pocLine, pocColor)
                line.set_color(additionalProfile.vahLine, vahColor)
                line.set_width(additionalProfile.pocLine, 3)
                line.set_width(additionalProfile.vahLine, 3)

            array.set(
                 additionalProfiles,
                 additionalProfileIndex,
                 additionalProfile)

//------------------------------------------------------------------------------
// Stacked meaningful-profile VAL defense
//------------------------------------------------------------------------------
// Lower meaningful value areas remain active. A higher profile is initially
// unproven because buyers can still wait at the lower value structure. It earns
// its own VAL-defense eligibility only after a post-freeze trip to, or a narrow
// ATR-based front-run of, its VAH.

bool stackedMeaningfulVALCanBeEvaluated =
     barstate.isconfirmed and
     timeframeSupported and
     inAnalysisSession and
     enableVALEntryConfirmation and
     enableStackedMeaningfulVALProfiles and
     array.size(meaningfulVALProfiles) > 0

int bestStackedDefenseIndex = -1
float bestStackedDefenseDistance = na
int bestStackedDefenseTestTime = na
float bestStackedDefenseTestLow = na

if stackedMeaningfulVALCanBeEvaluated
    for meaningfulProfileIndex = 0 to
         array.size(meaningfulVALProfiles) - 1
        MeaningfulVALProfile meaningfulProfile =
             array.get(
                  meaningfulVALProfiles,
                  meaningfulProfileIndex)

        if not meaningfulProfile.pocExtensionStopped
            if close <
                 meaningfulProfile.poc *
                 (1.0 - pocExtensionStopBelowPercent / 100.0)
                meaningfulProfile.pocExtensionStopped := true
            else if not na(meaningfulProfile.pocLine)
                line.set_x2(meaningfulProfile.pocLine, time_close)

        bool meaningfulProfileMayAdvance =
             bar_index > meaningfulProfile.readyBarIndex and
             not meaningfulProfile.invalidated
        if meaningfulProfileMayAdvance
            meaningfulProfile.closesBelowMovementLow :=
                 close < meaningfulProfile.movementLow ?
                 meaningfulProfile.closesBelowMovementLow + 1 : 0
            meaningfulProfile.closesBelowVAL :=
                 meaningfulProfile.stackedAboveLower and
                 close < meaningfulProfile.val ?
                 meaningfulProfile.closesBelowVAL + 1 : 0

            bool meaningfulMovementLowLost =
                 meaningfulProfile.closesBelowMovementLow >=
                      valInvalidationCloses
            bool meaningfulStackedVALLost =
                 meaningfulProfile.stackedAboveLower and
                 meaningfulProfile.closesBelowVAL >=
                      stackedVALInvalidationCloses
            bool meaningfulProfileInvalidatedNow =
                 meaningfulMovementLowLost or
                 meaningfulStackedVALLost
            if meaningfulProfileInvalidatedNow
                meaningfulProfile.invalidated := true
                meaningfulProfile.defenseArmed := false
                meaningfulProfile.testActive := false
                meaningfulProfile.testBarIndex := na
                meaningfulProfile.testTime := na
                meaningfulProfile.testLow := na
                if not na(meaningfulProfile.valLine)
                    line.set_color(
                         meaningfulProfile.valLine,
                         color.new(valColor, 75))
                if not na(meaningfulProfile.pocLine)
                    line.set_color(
                         meaningfulProfile.pocLine,
                         color.new(pocColor, 75))
                if not na(meaningfulProfile.vahLine)
                    line.set_color(
                         meaningfulProfile.vahLine,
                         color.new(vahColor, 75))

            if not meaningfulProfile.invalidated
                // This is the decisive stacked-profile gate. The profile's own
                // construction bars cannot prove that its higher value holds.
                float meaningfulDepartureAllowance =
                     not na(atrValue) and atrValue > 0.0 ?
                     atrValue * stackedVAHDepartureFrontRunATR : 0.0
                if not meaningfulProfile.departureProven and
                     high >= meaningfulProfile.vah -
                          meaningfulDepartureAllowance
                    meaningfulProfile.departureProven := true
                    meaningfulProfile.defenseArmed := true

                if meaningfulProfile.departureProven
                    if not meaningfulProfile.defenseArmed and
                         high >= meaningfulProfile.poc
                        meaningfulProfile.defenseArmed := true

                    float meaningfulProfileRowHeight =
                         (meaningfulProfile.movementHigh -
                              meaningfulProfile.movementLow) /
                         profileRows
                    float meaningfulProfileApproachAllowance =
                         meaningfulProfile.ageTradingDates > 0 ?
                         math.max(
                              atrValue * dominantVALFrontRunATR,
                              meaningfulProfileRowHeight *
                                   stackedVALProfileRowTolerance) :
                         atrValue * dominantVALFrontRunATR
                    bool startsMeaningfulVALTest =
                         meaningfulProfile.defenseArmed and
                         not meaningfulProfile.testActive and
                         not na(atrValue) and
                         atrValue > 0.0 and
                         open > meaningfulProfile.val and
                         low <= meaningfulProfile.val +
                              meaningfulProfileApproachAllowance
                    if startsMeaningfulVALTest
                        meaningfulProfile.testActive := true
                        meaningfulProfile.testBarIndex := bar_index
                        meaningfulProfile.testTime := time
                        meaningfulProfile.testLow := low

                    if meaningfulProfile.defenseArmed and
                         meaningfulProfile.testActive
                        meaningfulProfile.testLow :=
                             math.min(
                                  meaningfulProfile.testLow,
                                  low)
                        int meaningfulBarsSinceTest =
                             bar_index -
                             meaningfulProfile.testBarIndex
                        bool meaningfulVALRecovered =
                             meaningfulBarsSinceTest <=
                                  valEntryConfirmationBars and
                             close > meaningfulProfile.val

                        if meaningfulVALRecovered
                            float meaningfulDefenseDistance =
                                 math.abs(
                                      meaningfulProfile.testLow -
                                      meaningfulProfile.val) /
                                 atrValue
                            bool betterMeaningfulDefense =
                                 bestStackedDefenseIndex < 0 or
                                 meaningfulDefenseDistance <
                                      bestStackedDefenseDistance
                            if betterMeaningfulDefense
                                bestStackedDefenseIndex :=
                                     meaningfulProfileIndex
                                bestStackedDefenseDistance :=
                                     meaningfulDefenseDistance
                                bestStackedDefenseTestTime :=
                                     meaningfulProfile.testTime
                                bestStackedDefenseTestLow :=
                                     meaningfulProfile.testLow
                        else if meaningfulBarsSinceTest >=
                                  valEntryConfirmationBars
                            meaningfulProfile.testActive := false
                            meaningfulProfile.testBarIndex := na
                            meaningfulProfile.testTime := na
                            meaningfulProfile.testLow := na

        array.set(
             meaningfulVALProfiles,
             meaningfulProfileIndex,
             meaningfulProfile)

if bestStackedDefenseIndex >= 0
    MeaningfulVALProfile defendedMeaningfulProfile =
         array.get(
              meaningfulVALProfiles,
              bestStackedDefenseIndex)
    DefenseScoreResult stackedDefenseScore =
         f_calculateDefenseScore(
              defendedMeaningfulProfile.val,
              bestStackedDefenseTestLow,
              defendedMeaningfulProfile.testBarIndex,
              defendedMeaningfulProfile.movementLow,
              defendedMeaningfulProfile.movementHigh,
              true,
              false,
              false,
              atrValue,
              volumeAverage,
              dailyEMA20,
              dailyEMA200)
    valEntryConfirmedThisBar := true
    valDefendedThisBar := true
    defenseScoreThisBar := stackedDefenseScore.score

    // Only the closest qualifying value level owns this bar. Clear any other
    // profile that recovered on the same candle so overlapping stacks cannot
    // print delayed duplicate entries on the following bar.
    if array.size(meaningfulVALProfiles) > 0
        for recoveredProfileIndex = 0 to
             array.size(meaningfulVALProfiles) - 1
            MeaningfulVALProfile recoveredProfile =
                 array.get(
                      meaningfulVALProfiles,
                      recoveredProfileIndex)
            bool competingRecovery =
                 recoveredProfile.testActive and
                 close > recoveredProfile.val
            if competingRecovery
                recoveredProfile.testActive := false
                recoveredProfile.testBarIndex := na
                recoveredProfile.testTime := na
                recoveredProfile.testLow := na
                if recoveredProfileIndex == bestStackedDefenseIndex
                    recoveredProfile.defenseArmed := false
                array.set(
                     meaningfulVALProfiles,
                     recoveredProfileIndex,
                     recoveredProfile)

    // Preserve compatibility with the existing profile-specific continuation
    // state without letting that state choose or replace the stacked reference.
    if lifecycleState == STATE_PROFILE and
         movementStartTime ==
              defendedMeaningfulProfile.movementStartTime
        valDefended := true
    if array.size(additionalProfiles) > 0
        for meaningfulMatchIndex = 0 to
             array.size(additionalProfiles) - 1
            AdditionalProfile meaningfulMatchProfile =
                 array.get(
                      additionalProfiles,
                      meaningfulMatchIndex)
            if meaningfulMatchProfile.movementStartTime ==
                 defendedMeaningfulProfile.movementStartTime
                meaningfulMatchProfile.valDefended := true
                array.set(
                     additionalProfiles,
                     meaningfulMatchIndex,
                     meaningfulMatchProfile)

    float stackedEntryLabelY =
         low -
         math.max(
              atrValue * valEntryLabelDistanceATR,
              high * 0.003)
    string stackedEntryTooltip =
         "FRVP ENTRY CONFIRMED\n" +
         "Type: STACKED MEANINGFUL VAL DEFENSE\n" +
         "Profile: " +
         str.format_time(
              defendedMeaningfulProfile.movementStartTime,
              "MM-dd HH:mm",
              syminfo.timezone) +
         "–" +
         str.format_time(
              defendedMeaningfulProfile.movementEndTime,
              "HH:mm",
              syminfo.timezone) +
         "\nTest: " +
         str.format_time(
              bestStackedDefenseTestTime,
              "HH:mm",
              syminfo.timezone) +
         "\nConfirmed: " +
         str.format_time(time, "HH:mm", syminfo.timezone) +
         "\nVAL: " +
         str.tostring(
              defendedMeaningfulProfile.val,
              format.mintick) +
         "\nPOC: " +
         str.tostring(
              defendedMeaningfulProfile.poc,
              format.mintick) +
         "\nVAH: " +
         str.tostring(
              defendedMeaningfulProfile.vah,
              format.mintick) +
         "\nDefended low: " +
         str.tostring(
              bestStackedDefenseTestLow,
              format.mintick) +
         "\nDefense score: " +
         str.tostring(stackedDefenseScore.score) +
         "/100 (" +
         f_defenseGrade(stackedDefenseScore.score) + ")" +
         "\nPrior references: " +
         str.tostring(stackedDefenseScore.referenceCount) +
         "\nClean break / ownership: " +
         (
              stackedDefenseScore.cleanBreak and
              stackedDefenseScore.cleanOwnership ?
              "YES" : "NO"
         ) +
         (
              defendedMeaningfulProfile.stackedAboveLower ?
              "\nHigher profile proved by post-freeze VAH departure." :
              "\nFoundation meaningful profile."
         )

    if showEntryMarkers
        label stackedEntryLabel = label.new(
             x = time,
             y = stackedEntryLabelY,
             text =
                  "VAL DEFENDED\nSCORE " +
                  str.tostring(stackedDefenseScore.score) +
                  "\nENTRY CONFIRMED",
             xloc = xloc.bar_time,
             yloc = yloc.price,
             style = label.style_label_up,
             color = continuationColor,
             textcolor = color.white,
             size = size.tiny,
             tooltip = stackedEntryTooltip)
        array.push(
             retainedEntryMarkers,
             stackedEntryLabel)

    if not na(defendedMeaningfulProfile.valLine)
        line.set_color(
             defendedMeaningfulProfile.valLine,
             color.new(valColor, 0))
        line.set_width(defendedMeaningfulProfile.valLine, 4)

//------------------------------------------------------------------------------
// Dominant-profile VAL defense (legacy single-reference fallback)
//------------------------------------------------------------------------------
// Profile selection occurs in both freeze blocks above. This lifecycle watches
// only the selected reference. A defense is an auction outcome: price reaches
// or narrowly front-runs VAL and regains a close above VAL. The candle may
// begin at or above POC before rotating down into the VAL test.
// It deliberately does not inspect candle color, wick proportions, lower lows,
// or relative volume.

bool dominantReferenceCanBeEvaluated =
     barstate.isconfirmed and
     timeframeSupported and
     inAnalysisSession and
     enableVALEntryConfirmation and
     enableDominantProfileVALReference and
     not enableStackedMeaningfulVALProfiles and
     dominantReferenceReady and
     bar_index > dominantReferenceReadyBarIndex

if dominantReferenceCanBeEvaluated
    if not dominantReferencePOCExtensionStopped
        if close <
             dominantReferencePOC *
             (1.0 - pocExtensionStopBelowPercent / 100.0)
            dominantReferencePOCExtensionStopped := true
        else if not na(dominantReferencePOCLine)
            line.set_x2(dominantReferencePOCLine, time_close)

    dominantReferenceClosesBelowLow :=
         close < dominantReferenceMovementLow ?
         dominantReferenceClosesBelowLow + 1 :
         0

    bool dominantReferenceInvalidatedNow =
         not dominantReferenceInvalidated and
         dominantReferenceClosesBelowLow >= valInvalidationCloses

    if dominantReferenceInvalidatedNow
        dominantReferenceInvalidated := true
        dominantReferenceDefenseArmed := false
        dominantReferenceTestActive := false
        dominantReferenceTestBarIndex := na
        dominantReferenceTestTime := na
        dominantReferenceTestLow := na
        if not na(dominantReferenceVALLine)
            line.set_color(
                 dominantReferenceVALLine,
                 color.new(valColor, 75))
        if not na(dominantReferencePOCLine)
            line.set_color(
                 dominantReferencePOCLine,
                 color.new(pocColor, 75))
        if not na(dominantReferenceVAHLine)
            line.set_color(
                 dominantReferenceVAHLine,
                 color.new(vahColor, 75))

    if not dominantReferenceInvalidated
        // Reaching POC proves the prior defense produced enough separation to
        // make a later return to VAL a fresh entry rather than duplicate noise.
        if not dominantReferenceDefenseArmed and
             high >= dominantReferencePOC
            dominantReferenceDefenseArmed := true

        if dominantReferenceDefenseArmed and
             not dominantReferenceTestActive and
             not na(atrValue) and
             atrValue > 0.0 and
             open > dominantReferenceVAL and
             low <=
                  dominantReferenceVAL +
                  atrValue * dominantVALFrontRunATR
            dominantReferenceTestActive := true
            dominantReferenceTestBarIndex := bar_index
            dominantReferenceTestTime := time
            dominantReferenceTestLow := low

        if dominantReferenceDefenseArmed and
             dominantReferenceTestActive
            dominantReferenceTestLow :=
                 math.min(dominantReferenceTestLow, low)
            int dominantBarsSinceTest =
                 bar_index - dominantReferenceTestBarIndex
            bool dominantVALRecovered =
                 dominantBarsSinceTest <= valEntryConfirmationBars and
                 close > dominantReferenceVAL

            if dominantVALRecovered
                DefenseScoreResult dominantDefenseScore =
                     f_calculateDefenseScore(
                          dominantReferenceVAL,
                          dominantReferenceTestLow,
                          dominantReferenceTestBarIndex,
                          dominantReferenceMovementLow,
                          dominantReferenceMovementHigh,
                          true,
                          false,
                          false,
                          atrValue,
                          volumeAverage,
                          dailyEMA20,
                          dailyEMA200)
                valEntryConfirmedThisBar := true
                valDefendedThisBar := true
                defenseScoreThisBar := dominantDefenseScore.score
                dominantReferenceDefenseArmed := false
                dominantReferenceTestActive := false

                // Preserve compatibility with the established continuation
                // paths when their underlying profile is the selected one.
                if lifecycleState == STATE_PROFILE and
                     movementStartTime == dominantReferenceStartTime
                    valDefended := true
                if array.size(additionalProfiles) > 0
                    for dominantMatchIndex = 0 to
                         array.size(additionalProfiles) - 1
                        AdditionalProfile dominantMatchProfile =
                             array.get(
                                  additionalProfiles,
                                  dominantMatchIndex)
                        if dominantMatchProfile.movementStartTime ==
                             dominantReferenceStartTime
                            dominantMatchProfile.valDefended := true
                            array.set(
                                 additionalProfiles,
                                 dominantMatchIndex,
                                 dominantMatchProfile)

                float dominantEntryLabelY =
                     low -
                     math.max(
                          atrValue * valEntryLabelDistanceATR,
                          high * 0.003)
                string dominantEntryTooltip =
                     "FRVP ENTRY CONFIRMED\n" +
                     "Type: DOMINANT VAL DEFENSE\n" +
                     "Profile: " +
                     str.format_time(
                          dominantReferenceStartTime,
                          "MM-dd HH:mm",
                          syminfo.timezone) +
                     "–" +
                     str.format_time(
                          dominantReferenceEndTime,
                          "HH:mm",
                          syminfo.timezone) +
                     "\nTest: " +
                     str.format_time(
                          dominantReferenceTestTime,
                          "HH:mm",
                          syminfo.timezone) +
                     "\nConfirmed: " +
                     str.format_time(
                          time,
                          "HH:mm",
                          syminfo.timezone) +
                     "\nVAL: " +
                     str.tostring(
                          dominantReferenceVAL,
                          format.mintick) +
                     "\nPOC: " +
                     str.tostring(
                          dominantReferencePOC,
                          format.mintick) +
                     "\nVAH: " +
                     str.tostring(
                          dominantReferenceVAH,
                          format.mintick) +
                     "\nDefended low: " +
                     str.tostring(
                          dominantReferenceTestLow,
                          format.mintick) +
                     "\nDefense score: " +
                     str.tostring(dominantDefenseScore.score) +
                     "/100 (" +
                     f_defenseGrade(dominantDefenseScore.score) + ")" +
                     "\nPrior references: " +
                     str.tostring(dominantDefenseScore.referenceCount) +
                     "\nClean break / ownership: " +
                     (
                          dominantDefenseScore.cleanBreak and
                          dominantDefenseScore.cleanOwnership ?
                          "YES" : "NO"
                     )

                if showEntryMarkers
                    label dominantEntryLabel = label.new(
                         x = time,
                         y = dominantEntryLabelY,
                         text =
                              "VAL DEFENDED\nSCORE " +
                              str.tostring(dominantDefenseScore.score) +
                              "\nENTRY CONFIRMED",
                         xloc = xloc.bar_time,
                         yloc = yloc.price,
                         style = label.style_label_up,
                         color = continuationColor,
                         textcolor = color.white,
                         size = size.tiny,
                         tooltip = dominantEntryTooltip)
                    array.push(
                         retainedEntryMarkers,
                         dominantEntryLabel)

                if not na(dominantReferenceVALLine)
                    line.set_color(
                         dominantReferenceVALLine,
                         color.new(valColor, 0))
                    line.set_width(dominantReferenceVALLine, 4)

                dominantReferenceTestBarIndex := na
                dominantReferenceTestTime := na
                dominantReferenceTestLow := na
            else if dominantBarsSinceTest >= valEntryConfirmationBars
                dominantReferenceTestActive := false
                dominantReferenceTestBarIndex := na
                dominantReferenceTestTime := na
                dominantReferenceTestLow := na

//------------------------------------------------------------------------------
// VAL sweep followed by an immediate POC reclaim
//------------------------------------------------------------------------------
// This remains separate from ordinary VAL defense because it requires one
// bullish initiative candle to travel from VAL through POC while still
// remaining inside the frozen value area.

bool valSweepPOCCanBeEvaluated =
     barstate.isconfirmed and
     timeframeSupported and
     inAnalysisSession and
     enableVALSweepPOCReclaim and
     array.size(valSweepPOCProfiles) > 0 and
     not na(atrValue) and
     atrValue > 0.0 and
     not na(relativeVolume)

int bestVALSweepPOCProfileIndex = -1
float bestVALSweepPOCDistance = na

if valSweepPOCCanBeEvaluated
    for sweepProfileIndex = 0 to array.size(valSweepPOCProfiles) - 1
        VALSweepPOCProfile sweepProfile =
             array.get(valSweepPOCProfiles, sweepProfileIndex)

        bool sweepProfileMayAdvance =
             bar_index > sweepProfile.readyBarIndex and
             not sweepProfile.invalidated
        if sweepProfileMayAdvance
            sweepProfile.closesBelowMovementLow :=
                 close < sweepProfile.movementLow ?
                 sweepProfile.closesBelowMovementLow + 1 : 0

            if sweepProfile.closesBelowMovementLow >= valInvalidationCloses
                sweepProfile.invalidated := true
                sweepProfile.armed := false

            bool rearmSweepProfile =
                 not sweepProfile.invalidated and
                 not sweepProfile.armed and
                 not na(sweepProfile.lastSignalBarIndex) and
                 bar_index > sweepProfile.lastSignalBarIndex + 1 and
                 low > sweepProfile.poc
            if rearmSweepProfile
                sweepProfile.armed := true

            float sweepLowerWick = math.min(open, close) - low
            float sweepLowerWickShare =
                 candleRange > syminfo.mintick ?
                 sweepLowerWick / candleRange : 0.0
            float sweepBodyATR = candleBody / atrValue
            bool sweepsVALAndPreservesRange =
                 low <= sweepProfile.val and
                 low >= sweepProfile.movementLow and
                 low >= sweepProfile.val -
                      atrValue * valEntryMaximumUndercutATR
            bool reclaimsPOCInsideValue =
                 open < sweepProfile.poc and
                 close[1] <= sweepProfile.poc and
                 close > sweepProfile.poc and
                 high < sweepProfile.vah
            bool sweepReclaimPriceQuality =
                 close > open and
                 sweepBodyATR >= valSweepPOCMinimumBodyATR and
                 candleCloseLocation >=
                      valSweepPOCMinimumCloseLocation and
                 sweepLowerWickShare >=
                      valEntryMinimumLowerWickRange
            bool sweepReclaimVolumeQuality =
                 relativeVolume >= valEntryMinimumRelativeVolume
            bool qualifyingVALSweepPOCReclaim =
                 sweepProfile.armed and
                 not sweepProfile.invalidated and
                 sweepsVALAndPreservesRange and
                 reclaimsPOCInsideValue and
                 sweepReclaimPriceQuality and
                 sweepReclaimVolumeQuality

            if qualifyingVALSweepPOCReclaim
                float sweepDistance =
                     math.abs(low - sweepProfile.val) / atrValue
                bool betterSweepProfile =
                     bestVALSweepPOCProfileIndex < 0 or
                     sweepDistance < bestVALSweepPOCDistance
                if betterSweepProfile
                    bestVALSweepPOCProfileIndex := sweepProfileIndex
                    bestVALSweepPOCDistance := sweepDistance

        array.set(
             valSweepPOCProfiles,
             sweepProfileIndex,
             sweepProfile)

if bestVALSweepPOCProfileIndex >= 0
    VALSweepPOCProfile reclaimedSweepProfile =
         array.get(
              valSweepPOCProfiles,
              bestVALSweepPOCProfileIndex)
    DefenseScoreResult sweepDefenseScore =
         f_calculateDefenseScore(
              reclaimedSweepProfile.val,
              low,
              bar_index,
              reclaimedSweepProfile.movementLow,
              reclaimedSweepProfile.movementHigh,
              false,
              false,
              false,
              atrValue,
              volumeAverage,
              dailyEMA20,
              dailyEMA200)
    reclaimedSweepProfile.armed := false
    reclaimedSweepProfile.lastSignalBarIndex := bar_index
    array.set(
         valSweepPOCProfiles,
         bestVALSweepPOCProfileIndex,
         reclaimedSweepProfile)

    entryTriggeredThisBar := true
    defenseScoreThisBar := sweepDefenseScore.score

    float sweepEntryLabelY =
         low -
         math.max(
              atrValue * valEntryLabelDistanceATR,
              high * 0.003)
    string sweepEntryTooltip =
         "FRVP ENTRY CONFIRMED\n" +
         "Type: VAL SWEEP / POC RECLAIM\n" +
         "Profile " +
         str.tostring(reclaimedSweepProfile.number) +
         ": " +
         str.format_time(
              reclaimedSweepProfile.movementStartTime,
              "MM-dd HH:mm",
              syminfo.timezone) +
         "–" +
         str.format_time(
              reclaimedSweepProfile.movementEndTime,
              "HH:mm",
              syminfo.timezone) +
         "\nEntry: " +
         str.format_time(time, "HH:mm", syminfo.timezone) +
         "\nVAL: " +
         str.tostring(reclaimedSweepProfile.val, format.mintick) +
         "\nPOC: " +
         str.tostring(reclaimedSweepProfile.poc, format.mintick) +
         "\nVAH: " +
         str.tostring(reclaimedSweepProfile.vah, format.mintick) +
         "\nLow: " + str.tostring(low, format.mintick) +
         "\nRelative volume: " +
         str.tostring(relativeVolume, "#.##") + "x" +
         "\nDefense score: " +
         str.tostring(sweepDefenseScore.score) +
         "/100 (" +
         f_defenseGrade(sweepDefenseScore.score) + ")" +
         "\nPrior references: " +
         str.tostring(sweepDefenseScore.referenceCount)

    if showEntryMarkers
        label sweepEntryLabel = label.new(
             x = time,
             y = sweepEntryLabelY,
             text =
                  "VAL TO POC\nSCORE " +
                  str.tostring(sweepDefenseScore.score) +
                  "\nENTRY CONFIRMED",
             xloc = xloc.bar_time,
             yloc = yloc.price,
             style = label.style_label_up,
             color = continuationColor,
             textcolor = color.white,
             size = size.tiny,
             tooltip = sweepEntryTooltip)
        array.push(retainedEntryMarkers, sweepEntryLabel)

//------------------------------------------------------------------------------
// Reference-backed daily EMA defense entry
//------------------------------------------------------------------------------
// A daily EMA is not promoted merely because price touches it. Price must have
// shown earlier market memory around the same level, broken above it, preserved
// ownership, and then recovered the EMA with a qualifying confidence score.
// This path runs only when v1.49 did not already confirm another entry bar.

var bool scoredEMA20DefenseArmed = true
var bool scoredEMA20TestActive = false
var int scoredEMA20TestBarIndex = na
var int scoredEMA20TestTime = na
var float scoredEMA20TestLow = na

var bool scoredEMA200DefenseArmed = true
var bool scoredEMA200TestActive = false
var int scoredEMA200TestBarIndex = na
var int scoredEMA200TestTime = na
var float scoredEMA200TestLow = na

if newTradingDate
    scoredEMA20DefenseArmed := true
    scoredEMA20TestActive := false
    scoredEMA20TestBarIndex := na
    scoredEMA20TestTime := na
    scoredEMA20TestLow := na
    scoredEMA200DefenseArmed := true
    scoredEMA200TestActive := false
    scoredEMA200TestBarIndex := na
    scoredEMA200TestTime := na
    scoredEMA200TestLow := na

if not scoredEMA20DefenseArmed and
     not scoredEMA20TestActive and
     not na(dailyEMA20) and
     dailyEMA20 > 0.0 and
     low > dailyEMA20 * (1.0 + scoredEMARearmPercent / 100.0)
    scoredEMA20DefenseArmed := true

if not scoredEMA200DefenseArmed and
     not scoredEMA200TestActive and
     not na(dailyEMA200) and
     dailyEMA200 > 0.0 and
     low > dailyEMA200 * (1.0 + scoredEMARearmPercent / 100.0)
    scoredEMA200DefenseArmed := true

bool scoredEMA20ConfirmedNow = false
bool scoredEMA200ConfirmedNow = false
DefenseScoreResult scoredEMA20Result = DefenseScoreResult.new()
DefenseScoreResult scoredEMA200Result = DefenseScoreResult.new()

bool scoredEMAEvaluationReady =
     barstate.isconfirmed and
     timeframeSupported and
     inAnalysisSession and
     enableDefenseConfidenceScore and
     enableReferenceBackedEMAEntry and
     not entryTriggeredThisBar and
     not valEntryConfirmedThisBar and
     not na(atrValue) and
     atrValue > 0.0

if scoredEMAEvaluationReady and
     not na(dailyEMA20) and
     dailyEMA20 > 0.0
    float scoredEMA20ApproachAllowance =
         math.max(
              atrValue * scoredEMAFrontRunATR,
              dailyEMA20 * scoredEMAFrontRunPercent / 100.0)
    float scoredEMA20Floor =
         dailyEMA20 *
         (1.0 - scoredEMAMaximumUndercutPercent / 100.0)
    bool startsScoredEMA20Test =
         scoredEMA20DefenseArmed and
         not scoredEMA20TestActive and
         not na(dailyEMA20[1]) and
         dailyEMA20[1] > 0.0 and
         close[1] > dailyEMA20[1] and
         open > dailyEMA20 and
         low <= dailyEMA20 + scoredEMA20ApproachAllowance and
         low >= scoredEMA20Floor
    if startsScoredEMA20Test
        scoredEMA20TestActive := true
        scoredEMA20TestBarIndex := bar_index
        scoredEMA20TestTime := time
        scoredEMA20TestLow := low

    if scoredEMA20TestActive
        scoredEMA20TestLow :=
             math.min(scoredEMA20TestLow, low)
        int scoredEMA20BarsSinceTest =
             bar_index - scoredEMA20TestBarIndex
        bool scoredEMA20FloorLost =
             scoredEMA20TestLow < scoredEMA20Floor
        bool scoredEMA20Recovered =
             scoredEMA20BarsSinceTest >= 1 and
             scoredEMA20BarsSinceTest <= valEntryConfirmationBars and
             close > dailyEMA20 and
             close > open and
             candleRange > syminfo.mintick and
             candleCloseLocation >= 0.60 and
             not scoredEMA20FloorLost
        if scoredEMA20Recovered
            scoredEMA20Result :=
                 f_calculateDefenseScore(
                      dailyEMA20,
                      scoredEMA20TestLow,
                      scoredEMA20TestBarIndex,
                      na,
                      na,
                      false,
                      true,
                      false,
                      atrValue,
                      volumeAverage,
                      dailyEMA20,
                      dailyEMA200)
            scoredEMA20ConfirmedNow :=
                 scoredEMA20Result.score >=
                      minimumReferenceBackedEMAScore and
                 scoredEMA20Result.referenceCount > 0 and
                 scoredEMA20Result.highParticipationReference and
                 scoredEMA20Result.cleanBreak and
                 scoredEMA20Result.cleanOwnership and
                 scoredEMA20Result.strongImpulse
        if scoredEMA20ConfirmedNow or
             scoredEMA20FloorLost or
             scoredEMA20BarsSinceTest >= valEntryConfirmationBars
            scoredEMA20TestActive := false
            scoredEMA20TestBarIndex := na
            scoredEMA20TestTime := na
            scoredEMA20TestLow := na
        if scoredEMA20ConfirmedNow
            scoredEMA20DefenseArmed := false

if scoredEMAEvaluationReady and
     not na(dailyEMA200) and
     dailyEMA200 > 0.0
    float scoredEMA200ApproachAllowance =
         math.max(
              atrValue * scoredEMAFrontRunATR,
              dailyEMA200 * scoredEMAFrontRunPercent / 100.0)
    float scoredEMA200Floor =
         dailyEMA200 *
         (1.0 - scoredEMAMaximumUndercutPercent / 100.0)
    bool startsScoredEMA200Test =
         scoredEMA200DefenseArmed and
         not scoredEMA200TestActive and
         not na(dailyEMA200[1]) and
         dailyEMA200[1] > 0.0 and
         close[1] > dailyEMA200[1] and
         open > dailyEMA200 and
         low <= dailyEMA200 + scoredEMA200ApproachAllowance and
         low >= scoredEMA200Floor
    if startsScoredEMA200Test
        scoredEMA200TestActive := true
        scoredEMA200TestBarIndex := bar_index
        scoredEMA200TestTime := time
        scoredEMA200TestLow := low

    if scoredEMA200TestActive
        scoredEMA200TestLow :=
             math.min(scoredEMA200TestLow, low)
        int scoredEMA200BarsSinceTest =
             bar_index - scoredEMA200TestBarIndex
        bool scoredEMA200FloorLost =
             scoredEMA200TestLow < scoredEMA200Floor
        bool scoredEMA200Recovered =
             scoredEMA200BarsSinceTest >= 1 and
             scoredEMA200BarsSinceTest <= valEntryConfirmationBars and
             close > dailyEMA200 and
             close > open and
             candleRange > syminfo.mintick and
             candleCloseLocation >= 0.60 and
             not scoredEMA200FloorLost
        if scoredEMA200Recovered
            scoredEMA200Result :=
                 f_calculateDefenseScore(
                      dailyEMA200,
                      scoredEMA200TestLow,
                      scoredEMA200TestBarIndex,
                      na,
                      na,
                      false,
                      true,
                      true,
                      atrValue,
                      volumeAverage,
                      dailyEMA20,
                      dailyEMA200)
            scoredEMA200ConfirmedNow :=
                 scoredEMA200Result.score >=
                      minimumReferenceBackedEMAScore and
                 scoredEMA200Result.referenceCount > 0 and
                 scoredEMA200Result.highParticipationReference and
                 scoredEMA200Result.cleanBreak and
                 scoredEMA200Result.cleanOwnership and
                 scoredEMA200Result.strongImpulse
        if scoredEMA200ConfirmedNow or
             scoredEMA200FloorLost or
             scoredEMA200BarsSinceTest >= valEntryConfirmationBars
            scoredEMA200TestActive := false
            scoredEMA200TestBarIndex := na
            scoredEMA200TestTime := na
            scoredEMA200TestLow := na
        if scoredEMA200ConfirmedNow
            scoredEMA200DefenseArmed := false

if scoredEMA20ConfirmedNow or scoredEMA200ConfirmedNow
    bool useScoredEMA20 =
         scoredEMA20ConfirmedNow and
         (
              not scoredEMA200ConfirmedNow or
              scoredEMA20Result.score >= scoredEMA200Result.score
         )
    int selectedEMAScoreValue =
         useScoredEMA20 ?
         scoredEMA20Result.score : scoredEMA200Result.score
    int selectedEMAReferenceCount =
         useScoredEMA20 ?
         scoredEMA20Result.referenceCount :
         scoredEMA200Result.referenceCount
    int selectedEMAReferenceTime =
         useScoredEMA20 ?
         scoredEMA20Result.referenceTime :
         scoredEMA200Result.referenceTime
    int selectedEMABreakTime =
         useScoredEMA20 ?
         scoredEMA20Result.breakTime : scoredEMA200Result.breakTime
    float selectedEMALevel =
         useScoredEMA20 ? dailyEMA20 : dailyEMA200
    string selectedEMAName =
         useScoredEMA20 ? "D EMA 20" : "D EMA 200"
    float selectedEMALabelY =
         low -
         math.max(
              atrValue * valEntryLabelDistanceATR,
              high * 0.003)
    string selectedEMATooltip =
         "FRVP ENTRY CONFIRMED\n" +
         "Type: REFERENCE-BACKED " + selectedEMAName +
         " DEFENSE\n" +
         "Confirmed: " +
         str.format_time(time, "HH:mm", syminfo.timezone) +
         "\nLevel: " +
         str.tostring(selectedEMALevel, format.mintick) +
         "\nDefense score: " +
         str.tostring(selectedEMAScoreValue) +
         "/100 (" +
         f_defenseGrade(selectedEMAScoreValue) + ")" +
         "\nPrior references: " +
         str.tostring(selectedEMAReferenceCount) +
         "\nClean break / ownership: YES" +
         "\nReference: " +
         (
              not na(selectedEMAReferenceTime) ?
              str.format_time(
                   selectedEMAReferenceTime,
                   "HH:mm",
                   syminfo.timezone) : "N/A"
         ) +
         "\nBreak: " +
         (
              not na(selectedEMABreakTime) ?
              str.format_time(
                   selectedEMABreakTime,
                   "HH:mm",
                   syminfo.timezone) : "N/A"
         )

    entryTriggeredThisBar := true
    emaDefendedThisBar := true
    defenseScoreThisBar := selectedEMAScoreValue

    if showEntryMarkers
        label scoredEMAEntryLabel = label.new(
             x = time,
             y = selectedEMALabelY,
             text =
                  selectedEMAName +
                  " DEFENDED\nSCORE " +
                  str.tostring(selectedEMAScoreValue) +
                  "\nENTRY CONFIRMED",
             xloc = xloc.bar_time,
             yloc = yloc.price,
             style = label.style_label_up,
             color = continuationColor,
             textcolor = color.white,
             size = size.tiny,
             tooltip = selectedEMATooltip)
        array.push(retainedEntryMarkers, scoredEMAEntryLabel)

// Daily EMA resistance warning. This is intentionally independent of the FRVP
// lifecycle: the daily levels remain useful even before a profile freezes or
// after its entry completes. Only an approach from below that still closes
// below the EMA is labeled; a close above it is treated as a breakout.
var bool dailyEMA20WarningArmed = true
var bool dailyEMA200WarningArmed = true
var bool dailyEMA20DefenseArmed = true
var bool dailyEMA200DefenseArmed = true

if newTradingDate
    dailyEMA20WarningArmed := true
    dailyEMA200WarningArmed := true
    dailyEMA20DefenseArmed := true
    dailyEMA200DefenseArmed := true

float dailyEMAWarningFraction =
     dailyEMAWarningDistancePercent / 100.0
float dailyEMARearmFraction =
     dailyEMAWarningRearmPercent / 100.0

if not dailyEMA20WarningArmed and not na(dailyEMA20)
    bool dailyEMA20MovedAway =
         high < dailyEMA20 * (1.0 - dailyEMARearmFraction)
    bool dailyEMA20BrokenAbove =
         close > dailyEMA20
    if dailyEMA20MovedAway or dailyEMA20BrokenAbove
        dailyEMA20WarningArmed := true

if not dailyEMA200WarningArmed and not na(dailyEMA200)
    bool dailyEMA200MovedAway =
         high < dailyEMA200 * (1.0 - dailyEMARearmFraction)
    bool dailyEMA200BrokenAbove =
         close > dailyEMA200
    if dailyEMA200MovedAway or dailyEMA200BrokenAbove
        dailyEMA200WarningArmed := true

if not dailyEMA20DefenseArmed and not na(dailyEMA20)
    bool dailyEMA20LeftSupportBand =
         low > dailyEMA20 * (1.0 + dailyEMARearmFraction)
    bool dailyEMA20LostSupport = close < dailyEMA20
    if dailyEMA20LeftSupportBand or dailyEMA20LostSupport
        dailyEMA20DefenseArmed := true

if not dailyEMA200DefenseArmed and not na(dailyEMA200)
    bool dailyEMA200LeftSupportBand =
         low > dailyEMA200 * (1.0 + dailyEMARearmFraction)
    bool dailyEMA200LostSupport = close < dailyEMA200
    if dailyEMA200LeftSupportBand or dailyEMA200LostSupport
        dailyEMA200DefenseArmed := true

bool dailyEMA20SellWarning =
     barstate.isconfirmed and
     showDailyEMASellWarnings and
     dailyEMA20WarningArmed and
     not na(dailyEMA20) and
     close[1] < dailyEMA20[1] and
     open < dailyEMA20 and
     high >= dailyEMA20 * (1.0 - dailyEMAWarningFraction) and
     close < dailyEMA20
bool dailyEMA200SellWarning =
     barstate.isconfirmed and
     showDailyEMASellWarnings and
     dailyEMA200WarningArmed and
     not na(dailyEMA200) and
     close[1] < dailyEMA200[1] and
     open < dailyEMA200 and
     high >= dailyEMA200 * (1.0 - dailyEMAWarningFraction) and
     close < dailyEMA200

if dailyEMA20SellWarning or dailyEMA200SellWarning
    bool bothDailyEMAsNear =
         dailyEMA20SellWarning and
         dailyEMA200SellWarning
    string dailyEMAWarningText =
         bothDailyEMAsNear ? "D EMA 20/200\nSELL WATCH" :
         dailyEMA200SellWarning ? "D EMA 200\nSELL WATCH" :
         "D EMA 20\nSELL WATCH"
    color dailyEMAWarningColor =
         dailyEMA200SellWarning ?
         dailyEMA200Color : dailyEMA20Color
    float dailyEMAWarningY =
         high +
         (not na(atrValue) ?
              atrValue * dailyEMALabelDistanceATR :
              high * 0.005)
    string dailyEMAWarningTooltip =
         "OVERHEAD DAILY EMA WARNING\n" +
         "Time: " +
         str.format_time(time, "HH:mm", syminfo.timezone) +
         "\nDaily EMA 20: " +
         str.tostring(dailyEMA20, format.mintick) +
         "\nDaily EMA 200: " +
         str.tostring(dailyEMA200, format.mintick) +
         "\nBar high: " +
         str.tostring(high, format.mintick) +
         "\nClose: " +
         str.tostring(close, format.mintick) +
         "\nWarning distance: " +
         str.tostring(dailyEMAWarningDistancePercent, "#.##") +
         "%\nVisual warning only; existing FRVP alerts are unchanged."
    label dailyEMAWarningLabel = label.new(
         x = time,
         y = dailyEMAWarningY,
         text = dailyEMAWarningText,
         xloc = xloc.bar_time,
         yloc = yloc.price,
         style = label.style_label_down,
         color = dailyEMAWarningColor,
         textcolor = color.white,
         size = size.tiny,
         tooltip = dailyEMAWarningTooltip)
    array.push(
         retainedDailyEMAWarningMarkers,
         dailyEMAWarningLabel)

    if dailyEMA20SellWarning
        dailyEMA20WarningArmed := false
    if dailyEMA200SellWarning
        dailyEMA200WarningArmed := false

float dailyEMASupportLowerWick =
     math.min(open, close) - low
bool dailyEMASupportWickQualified =
     candleRange > 0.0 and
     dailyEMASupportLowerWick >=
          candleRange *
          dailyEMADefenseMinimumLowerWickFraction
bool dailyEMA20Defended =
     barstate.isconfirmed and
     showDailyEMADefenseAndFailure and
     dailyEMA20DefenseArmed and
     dailyEMA20NearCurrentPrice and
     not na(dailyEMA20[1]) and
     close[1] > dailyEMA20[1] and
     open > dailyEMA20 and
     low <= dailyEMA20 * (1.0 + dailyEMAWarningFraction) and
     close > dailyEMA20 and
     dailyEMASupportWickQualified
bool dailyEMA200Defended =
     barstate.isconfirmed and
     showDailyEMADefenseAndFailure and
     dailyEMA200DefenseArmed and
     dailyEMA200NearCurrentPrice and
     not na(dailyEMA200[1]) and
     close[1] > dailyEMA200[1] and
     open > dailyEMA200 and
     low <= dailyEMA200 * (1.0 + dailyEMAWarningFraction) and
     close > dailyEMA200 and
     dailyEMASupportWickQualified
bool dailyEMA20Failed =
     barstate.isconfirmed and
     showDailyEMADefenseAndFailure and
     dailyEMA20NearCurrentPrice and
     not na(dailyEMA20[1]) and
     close[1] >= dailyEMA20[1] and
     close < dailyEMA20
bool dailyEMA200Failed =
     barstate.isconfirmed and
     showDailyEMADefenseAndFailure and
     dailyEMA200NearCurrentPrice and
     not na(dailyEMA200[1]) and
     close[1] >= dailyEMA200[1] and
     close < dailyEMA200

if dailyEMA20Defended or dailyEMA200Defended
    bool bothDailyEMAsDefended =
         dailyEMA20Defended and
         dailyEMA200Defended
    string dailyEMADefendedText =
         bothDailyEMAsDefended ? "D EMA 20/200\nDEFENDED" :
         dailyEMA200Defended ? "D EMA 200\nDEFENDED" :
         "D EMA 20\nDEFENDED"
    float dailyEMADefendedY =
         low -
         (not na(atrValue) ?
              atrValue * dailyEMALabelDistanceATR :
              high * 0.005)
    label dailyEMADefendedLabel = label.new(
         x = time,
         y = dailyEMADefendedY,
         text = dailyEMADefendedText,
         xloc = xloc.bar_time,
         yloc = yloc.price,
         style = label.style_label_up,
         color = color.rgb(0, 181, 120),
         textcolor = color.white,
         size = size.tiny,
         tooltip =
              dailyEMADefendedText +
              "\nTime: " +
              str.format_time(time, "HH:mm", syminfo.timezone) +
              "\nDaily EMA 20: " +
              str.tostring(dailyEMA20, format.mintick) +
              "\nDaily EMA 200: " +
              str.tostring(dailyEMA200, format.mintick) +
              "\nLower wick / range: " +
              str.tostring(
                   dailyEMASupportLowerWick /
                   candleRange * 100.0,
                   "#.##") +
              "%")
    array.push(
         retainedDailyEMAWarningMarkers,
         dailyEMADefendedLabel)

    if dailyEMA20Defended
        dailyEMA20DefenseArmed := false
    if dailyEMA200Defended
        dailyEMA200DefenseArmed := false

if dailyEMA20Failed or dailyEMA200Failed
    bool bothDailyEMAsFailed =
         dailyEMA20Failed and
         dailyEMA200Failed
    string dailyEMAFailedText =
         bothDailyEMAsFailed ? "D EMA 20/200\nFAILED" :
         dailyEMA200Failed ? "D EMA 200\nFAILED" :
         "D EMA 20\nFAILED"
    float dailyEMAFailedY =
         high +
         (not na(atrValue) ?
              atrValue * dailyEMALabelDistanceATR :
              high * 0.005)
    label dailyEMAFailedLabel = label.new(
         x = time,
         y = dailyEMAFailedY,
         text = dailyEMAFailedText,
         xloc = xloc.bar_time,
         yloc = yloc.price,
         style = label.style_label_down,
         color = color.rgb(211, 47, 47),
         textcolor = color.white,
         size = size.tiny,
         tooltip =
              dailyEMAFailedText +
              "\nTime: " +
              str.format_time(time, "HH:mm", syminfo.timezone) +
              "\nClose: " +
              str.tostring(close, format.mintick) +
              "\nDaily EMA 20: " +
              str.tostring(dailyEMA20, format.mintick) +
              "\nDaily EMA 200: " +
              str.tostring(dailyEMA200, format.mintick))
    array.push(
         retainedDailyEMAWarningMarkers,
         dailyEMAFailedLabel)

// Keep drawings within the declared object limits.
while array.size(retainedMarkers) > maximumHistoricalMarkers
    label.delete(array.shift(retainedMarkers))

// Entry labels use their own protected pool, so a historical entry cannot be
// displaced by later POC-failure and VAL diagnostic labels.
while array.size(retainedEntryMarkers) > maximumHistoricalEntryMarkers
    label.delete(array.shift(retainedEntryMarkers))

while array.size(retainedDailyEMAWarningMarkers) >
     maximumDailyEMAWarningMarkers
    label.delete(
         array.shift(retainedDailyEMAWarningMarkers))

// Dedicated alert choices. All events use confirmed bars because the frozen
// profile lifecycle is intentionally evaluated only after candle close.
plot(
     defenseScoreThisBar,
     title = "Defense confidence score",
     display = display.none)

bool anyFRVPEntryTriggeredThisBar =
     entryTriggeredThisBar or
     valEntryConfirmedThisBar

alertcondition(
     anyFRVPEntryTriggeredThisBar,
     title = "FRVP Entry Bar",
     message = "FRVP Entry Bar: {{ticker}} {{interval}} produced a confirmed meaningful-profile VAL defense, reference-backed daily EMA defense, VAL-sweep/POC-reclaim, or a qualifying recovery, POC-to-VAH continuation, POC-fight VAH reclaim, exceptional-volume VAH expansion, or deep value-area sweep and VAH reclaim. Defense score when applicable: {{plot(\"Defense confidence score\")}}. Close: {{close}}.")

bool defendedLevelTriggeredThisBar =
     valDefendedThisBar or
     pocDefendedThisBar or
     vahDefendedThisBar or
     emaDefendedThisBar

alertcondition(
     defendedLevelTriggeredThisBar,
     title = "FRVP VAL / POC / VAH / EMA Defended",
     message = "FRVP Defended: {{ticker}} {{interval}} defended a VAL, POC, VAH, or reference-backed daily EMA. Defense score when applicable: {{plot(\"Defense confidence score\")}}. Close: {{close}}.")
