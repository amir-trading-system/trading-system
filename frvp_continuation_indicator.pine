float pocMinimumPenetrationATR = input.float(
     0.00,
     "POC attempt minimum penetration (ATR)",
     minval = 0.00,
     step = 0.05,
     group = GROUP_POC,
     display = display.none)

float pocFailedCloseBandATR = input.float(
     0.15,
     "POC rejection maximum close above POC (ATR)",
     minval = 0.00,
     step = 0.05,
     group = GROUP_POC,
     display = display.none,
     tooltip = "Allows a rejection candle to finish slightly above POC when it clearly moved downward from its high.")

float pocMinimumDownwardRejectionATR = input.float(
     0.10,
     "Minimum downward rejection from high (ATR)",
     minval = 0.00,
     step = 0.05,
     group = GROUP_POC,
     display = display.none,
     tooltip = "Measures the drop from the candle high to its close after reaching POC. This distinguishes a real downward rejection from a candle that simply closes near POC.")

float pocDefenseApproachATR = input.float(
     0.15,
     "POC defense maximum distance above POC (ATR)",
     minval = 0.00,
     step = 0.05,
     group = GROUP_POC,
     display = display.none,
     tooltip = "A support test may stop slightly above POC and still qualify as buyers front-running the level.")

float pocDefenseMinimumRelativeVolume = input.float(
     0.80,
     "POC defense minimum relative volume",
     minval = 0.00,
     step = 0.05,
     group = GROUP_POC,
     display = display.none,
     tooltip = "0.80 permits a reduced-volume selling-exhaustion defense when all POC price, lower-low, wick, and recovery requirements pass.")

float pocDefenseMinimumLowerWickFraction = input.float(
     0.25,
     "POC defense minimum lower wick / range",
     minval = 0.00,
     maxval = 1.00,
     step = 0.05,
     group = GROUP_POC,
     display = display.none,
     tooltip = "0.25 requires the lower wick to occupy at least 25% of the candle's high-low range. Wick is open-low on positive candles and close-low on negative candles.")

float pocDefenseCloseBufferATR = input.float(
     0.00,
     "POC defense close-above buffer (ATR)",
     minval = 0.00,
     step = 0.05,
     group = GROUP_POC,
     display = display.none)

int pocDefenseSpacingBars = input.int(
     2,
     "Minimum bars between POC defenses",
     minval = 1,
     maxval = 30,
     group = GROUP_POC,
     display = display.none,
     tooltip = "A new label requires price to leave the POC approach band, return, and respect this minimum bar spacing.")

int pocAttemptSpacingBars = input.int(
     2,
     "Minimum bars between POC attempts",
     minval = 1,
     maxval = 30,
     group = GROUP_POC,
     display = display.none)

float pocAttemptLabelDistanceATR = input.float(
     0.50,
     "POC fail label distance above bar (ATR)",
     minval = 0.00,
     maxval = 5.00,
     step = 0.05,
     group = GROUP_POC,
     display = display.none,
     tooltip = "Moves each POC FAIL label above its signal candle. Increase this value if labels still cover nearby price bars.")

int minimumFailedPOCAttempts = input.int(
     2,
     "Minimum spaced failed POC attempts",
     minval = 1,
     maxval = 10,
     group = GROUP_POC,
     display = display.none)

float vahDefenseApproachATR = input.float(
     0.15,
     "VAH defense maximum distance above VAH (ATR)",
     minval = 0.00,
     step = 0.05,
     group = GROUP_VAH,
     display = display.none,
     tooltip = "A defense may stop this far above VAH. After a defense, price must leave the same approach band before another fresh defense can be marked.")

float vahDefenseMinimumLowerWickFraction = input.float(
     0.25,
     "VAH defense minimum lower wick / range",
     minval = 0.00,
     maxval = 1.00,
     step = 0.05,
     group = GROUP_VAH,
     display = display.none,
     tooltip = "Uses open-low on positive candles and close-low on negative candles, matching POC defense.")

float vahDefenseCloseToleranceATR = input.float(
     0.25,
     "VAH defense close tolerance below VAH (ATR)",
     minval = 0.00,
     step = 0.05,
     group = GROUP_VAH,
     display = display.none,
     tooltip = "Allows a small close beneath VAH when a strong lower wick and above-average volume demonstrate recovery.")

int vahDefenseSpacingBars = input.int(
     2,
     "Minimum bars between VAH defenses",
     minval = 1,
     maxval = 30,
     group = GROUP_VAH,
     display = display.none)

bool enableTwoBarVAHDefense = input.bool(
     true,
     "Allow VAH test + delayed buyer confirmation",
     group = GROUP_VAH,
     display = display.none,
     tooltip = "A VAH test with a visible lower wick may be confirmed by a later bullish, above-average-volume response while the test low remains preserved.")

float vahCandidateMinimumLowerWickFraction = input.float(
     0.10,
     "Delayed VAH test minimum lower wick / range",
     minval = 0.00,
     maxval = 1.00,
     step = 0.05,
     group = GROUP_VAH,
     display = display.none,
     tooltip = "The direct VAH defense still requires the stricter wick setting. This relaxed value applies only to a test that must receive later buyer confirmation.")

int vahDefenseConfirmationWindowBars = input.int(
