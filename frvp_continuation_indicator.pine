     "Delayed VAH confirmation volume / test volume",
     minval = 1.00,
     step = 0.25,
     group = GROUP_VAH,
     display = display.none)

float breakoutStartToleranceATR = input.float(
     0.15,
     "Breakout may start above POC by (ATR)",
     minval = 0.00,
     step = 0.05,
     group = GROUP_BREAKOUT,
     display = display.none)

bool enablePOCFightVAHReclaim = input.bool(
     true,
     "Allow internal POC-fight VAH reclaim",
