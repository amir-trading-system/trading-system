//@version=6
indicator("Bullish Supply→Demand Flip Zones [v6.16 • Session Labels + All S→D Retests]", overlay = true, max_bars_back = 5000, max_boxes_count = 200, max_labels_count = 250)

// Invisible output anchor for TradingView editor compatibility.
plot(na, title = "Output anchor", display = display.none)

// This indicator detects bullish demand-retest zones from supply flips and continuation bases:
//   1. A rejection pivot defines the actionable price band and may expand backward into a multi-bar supply structure.
//   2. The seller-control structure must terminate at confirmed demand.
//   3. The upper supply remains hidden until a high-quality bullish break confirms.
//   4. After confirmation, all drawings stay hidden while retest logic remains active.
//   5. The full structure and external label appear on the first valid retest.
//   6. Every later fresh re-entry into an active S→D zone receives another S→D arrow.
//   7. A separate continuation-base path recognizes compact high-volume bullish shelves that launch higher.
//   8. A later failure ends the active zone without rewriting the successful retest or structure.

// ─────────────────────── Inputs ─────────────────────────
groupSupply = "1. Hidden supply qualification"
pivotLeft = input.int(3, "Pivot bars left", minval = 1, maxval = 20, group = groupSupply)
pivotRight = input.int(3, "Pivot bars right", minval = 1, maxval = 20, group = groupSupply)
allowBearishSupplyCandle = input.bool(true, "Allow bearish rejection supply candle", group = groupSupply,
     tooltip = "Allows high-volume bearish rejection origins such as SDOT 2026-06-29 10:24. All wick, departure, trend, and volume filters still apply.")
minBearishOriginBodyAtr = input.float(0.45, "Bearish origin minimum body (ATR)", minval = 0.0, step = 0.05, group = groupSupply,
     tooltip = "Prevents small ordinary red candles from qualifying as bearish supply origins.")
minUpperWickAtr = input.float(0.10, "Minimum upper wick (ATR)", minval = 0.0, step = 0.05, group = groupSupply)
minBearishDepartureAtr = input.float(0.50, "Minimum bearish departure (ATR)", minval = 0.1, step = 0.05, group = groupSupply)
maxHiddenAge = input.int(750, "Maximum hidden-zone age (bars)", minval = 20, maxval = 5000, group = groupSupply)
maxHiddenCandidates = input.int(75, "Maximum hidden candidates", minval = 5, maxval = 250, group = groupSupply)

groupSupplyStructure = "1a. Multi-bar supply structure"
expandSupplyStructure = input.bool(true, "Expand pivot into multi-bar supply structure", group = groupSupplyStructure,
     tooltip = "Walks backward through contiguous high-volume rejection bars that touched the pivot's supply band. The price band remains defined by the pivot.")
minSupplyStructureBars = input.int(3, "Minimum supply-structure bars", minval = 2, maxval = 10, group = groupSupplyStructure,
     tooltip = "The effective minimum is capped at Pivot bars left + 1 because the structure scan stays inside the confirmed pivot window.")
structureTouchBufferAtr = input.float(0.05, "Structure touch buffer (ATR)", minval = 0.0, step = 0.05, group = groupSupplyStructure)
structureCloseBufferAtr = input.float(0.10, "Structure close buffer (ATR)", minval = 0.0, step = 0.05, group = groupSupplyStructure,
     tooltip = "A participating bar must touch the supply band and then close back at or below its proximal boundary, allowing this buffer.")

groupSellerLeg = "1b. Seller-control leg and demand termination"
requireSellerControlLeg = input.bool(true, "Require completed seller-control leg", group = groupSellerLeg,
     tooltip = "Requires supply to produce a multi-bar decline that ends at confirmed demand before it can flip to demand.")
demandPivotLeft = input.int(3, "Demand pivot bars left", minval = 1, maxval = 10, group = groupSellerLeg)
demandPivotRight = input.int(3, "Demand pivot bars right", minval = 1, maxval = 10, group = groupSellerLeg)
minSellerLegBars = input.int(3, "Minimum seller-leg bars", minval = 1, maxval = 50, group = groupSellerLeg)
maxSellerLegBars = input.int(30, "Maximum seller-leg bars", minval = 3, maxval = 100, group = groupSellerLeg)
minSellerLegAtr = input.float(1.50, "Minimum supply-to-demand decline (ATR)", minval = 0.1, step = 0.25, group = groupSellerLeg)
minDemandLowerWickAtr = input.float(0.10, "Demand minimum lower wick (ATR)", minval = 0.0, step = 0.05, group = groupSellerLeg)
minDemandReactionAtr = input.float(0.75, "Minimum reaction from demand (ATR)", minval = 0.1, step = 0.25, group = groupSellerLeg)
minDemandRelativeVolume = input.float(0.80, "Demand/reaction minimum relative volume", minval = 0.1, step = 0.1, group = groupSellerLeg,
     tooltip = "May qualify on the exact demand pivot or on a reaction candle before that pivot is confirmed.")
allowCompactSellerLeg = input.bool(true, "Allow compact high-volume seller leg", group = groupSellerLeg,
     tooltip = "Allows a 1-2 bar seller leg when the supply origin has exceptional volume and demand remains stable for the required right bars.")
compactMaxSellerLegBars = input.int(2, "Compact seller-leg maximum bars", minval = 1, maxval = 5, group = groupSellerLeg)
compactDemandRightBars = input.int(2, "Compact demand confirmation bars", minval = 1, maxval = 5, group = groupSellerLeg)
minCompactSupplyRelativeVolume = input.float(2.00, "Compact-leg supply minimum relative volume", minval = 1.0, step = 0.25, group = groupSellerLeg,
     tooltip = "Keeps compact pullbacks selective. SDOT 2026-07-17 07:09 measures approximately 3.87x average volume.")

groupContinuation = "1c. Bullish continuation-base zones"
enableContinuationBases = input.bool(true, "Detect bullish continuation bases", group = groupContinuation,
     tooltip = "Adds a separate live-safe path for compact, high-volume bullish shelves that immediately launch higher. It does not weaken the supply-flip rules.")
continuationMinBaseBars = input.int(3, "Minimum base bars", minval = 2, maxval = 8, group = groupContinuation)
continuationMaxBaseBars = input.int(5, "Maximum base bars", minval = 2, maxval = 10, group = groupContinuation,
     tooltip = "The detector tests the longest qualifying base first. Keep this at or above Minimum base bars.")
continuationZoneFloor = input.string("Lowest close", "Continuation-zone lower boundary",
     options = ["Lowest close", "Highest body low"], group = groupContinuation,
     tooltip = "Lowest close captures the full accepted shelf. Highest body low creates a narrower, more conservative zone.")
continuationMinAverageRelativeVolume = input.float(1.50, "Base minimum average relative volume", minval = 0.1, step = 0.25, group = groupContinuation)
continuationMinBarRelativeVolume = input.float(0.80, "Each base bar minimum relative volume", minval = 0.1, step = 0.10, group = groupContinuation)
continuationHighVolumeThreshold = input.float(1.50, "High-volume base-bar threshold", minval = 0.1, step = 0.25, group = groupContinuation)
continuationMinHighVolumeBars = input.int(2, "Minimum high-volume bars in base", minval = 1, maxval = 8, group = groupContinuation)
continuationMaxZoneWidthAtr = input.float(2.25, "Maximum continuation-zone width (ATR)", minval = 0.25, step = 0.25, group = groupContinuation)
continuationMaxCloseSpreadAtr = input.float(1.50, "Maximum base close spread (ATR)", minval = 0.10, step = 0.10, group = groupContinuation)
continuationMaxNetPullbackAtr = input.float(0.25, "Maximum first-to-last close pullback (ATR)", minval = 0.0, step = 0.05, group = groupContinuation,
     tooltip = "The last base close may sit slightly below the first close, but the shelf cannot materially roll over.")
continuationPriorImpulseLookback = input.int(5, "Prior impulse lookback bars", minval = 1, maxval = 30, group = groupContinuation)
continuationMinPriorImpulseAtr = input.float(1.50, "Minimum prior impulse into base (ATR)", minval = 0.0, step = 0.25, group = groupContinuation)
continuationBreakBufferAtr = input.float(0.05, "Continuation close-above-base buffer (ATR)", minval = 0.0, step = 0.05, group = groupContinuation)
continuationMinBreakBodyAtr = input.float(0.50, "Continuation breakout minimum body (ATR)", minval = 0.0, step = 0.05, group = groupContinuation)
continuationMinBreakRelativeVolume = input.float(1.20, "Continuation breakout minimum relative volume", minval = 0.1, step = 0.10, group = groupContinuation)
continuationMaxBreakUpperWickAtr = input.float(0.50, "Continuation breakout maximum upper wick (ATR)", minval = 0.0, step = 0.10, group = groupContinuation)
continuationDuplicateWindowBars = input.int(10, "Duplicate suppression window (bars)", minval = 1, maxval = 100, group = groupContinuation)

groupTrend = "2. Bullish-trend filters"
requireBullishTrend = input.bool(true, "Require bullish trend context", group = groupTrend)
fastEmaLength = input.int(9, "Fast EMA length", minval = 2, maxval = 100, group = groupTrend)
slowEmaLength = input.int(20, "Slow EMA length", minval = 3, maxval = 250, group = groupTrend)
trendSlopeBars = input.int(3, "Rising-average lookback", minval = 1, maxval = 20, group = groupTrend)
requireRisingEmas = input.bool(true, "Require EMA 9 and EMA 20 to be rising", group = groupTrend)
requireRisingVwap = input.bool(false, "Require VWAP to be rising", group = groupTrend)
requireSupplyVolume = input.bool(true, "Require supply volume above average", group = groupTrend)
minSupplyRelativeVolume = input.float(1.00, "Supply minimum relative volume", minval = 0.1, step = 0.1, group = groupTrend)
requireReactionAboveSlowEma = input.bool(true, "Require supply reaction to hold EMA 20", group = groupTrend,
     tooltip = "Keeps supply reactions that behave like pullbacks within a bullish trend.")
maxSupplyExtensionAtr = input.float(2.50, "Maximum supply extension above trend (ATR)", minval = 0.0, step = 0.25, group = groupTrend,
     tooltip = "Rejects exhaustion highs. Set to 0 to disable. The SDOT 07:09 setup needs approximately 2.35 ATR or more.")
maxBearishSupplyExtensionAtr = input.float(3.00, "Maximum bearish-origin extension (ATR)", minval = 0.0, step = 0.25, group = groupTrend,
     tooltip = "Bearish rejection origins may spike farther from trend before closing back down. SDOT 2026-06-29 10:24 measures approximately 2.76 ATR.")
useExtremeVolumeExtensionOverride = input.bool(true, "Allow extreme-volume extension override", group = groupTrend,
     tooltip = "Allows unusually active supply origins to exceed the normal extension limit. The seller-leg, breakout, and retest rules still apply.")
minExtremeSupplyRelativeVolume = input.float(3.00, "Extreme-volume minimum relative volume", minval = 1.0, step = 0.25, group = groupTrend)
maxExtremeSupplyExtensionAtr = input.float(4.50, "Extreme-volume maximum extension (ATR)", minval = 0.0, step = 0.25, group = groupTrend,
     tooltip = "SDOT 2026-07-01 09:30 measures approximately 3.79 ATR with approximately 9.7x average volume.")

groupFlip = "3. Flip confirmation"
requiredBreakCloses = input.int(2, "Consecutive closes required above supply", minval = 1, maxval = 5, group = groupFlip,
     tooltip = "Two closes reject one-bar probes such as SDOT 10:46 and confirm the cleaner 10:49-10:50 break.")
breakBufferAtr = input.float(0.05, "Close above supply buffer (ATR)", minval = 0.0, step = 0.05, group = groupFlip)
minBreakBodyAtr = input.float(0.50, "Minimum bullish breakout body (ATR)", minval = 0.0, step = 0.05, group = groupFlip)
volumeAverageLength = input.int(20, "Volume average length", minval = 2, maxval = 200, group = groupFlip)
requireBreakVolume = input.bool(true, "Require breakout volume above average", group = groupFlip)
minBreakRelativeVolume = input.float(1.20, "Breakout minimum relative volume", minval = 0.1, step = 0.1, group = groupFlip)
confirmedBarsOnly = input.bool(true, "Confirm signals only at bar close", group = groupFlip,
     tooltip = "Recommended. Prevents realtime signals from appearing and disappearing intrabar.")

groupManagement = "4. Flipped-demand management"
invalidationMode = input.string("Close", "Invalidation method", options = ["Close", "Wick"], group = groupManagement)
invalidationBufferAtr = input.float(0.10, "Invalidation buffer (ATR)", minval = 0.0, step = 0.05, group = groupManagement,
     tooltip = "Allows a small close/wick penetration beyond the zone before declaring failure.")
sendDynamicAlerts = input.bool(true, "Send dynamic flip/retest alerts", group = groupManagement,
     tooltip = "Create a TradingView alert using 'Any alert() function call'. Messages include the zone prices.")
maxDisplayedZones = input.int(50, "Maximum tracked flip structures", minval = 1, maxval = 75, group = groupManagement)

groupDisplay = "5. Display"
activeFill = input.color(color.new(color.lime, 84), "Active demand fill", group = groupDisplay)
activeBorder = input.color(color.new(color.lime, 15), "Active demand border", group = groupDisplay)
validTextColor = input.color(color.new(color.lime, 0), "Valid-zone text", group = groupDisplay)
invalidTextColor = input.color(color.new(color.red, 0), "Invalid-zone text/marker", group = groupDisplay)
showSellerControlLeg = input.bool(true, "Show full supply/control structure after retest", group = groupDisplay)
sellerLegFill = input.color(color.new(color.red, 91), "Supply/control structure fill", group = groupDisplay)
sellerLegBorder = input.color(color.new(color.red, 55), "Supply/control structure border", group = groupDisplay)
showContinuationBaseStructure = input.bool(true, "Show continuation-base structure after retest", group = groupDisplay)
continuationBaseFill = input.color(color.new(color.aqua, 90), "Continuation-base structure fill", group = groupDisplay)
continuationBaseBorder = input.color(color.new(color.aqua, 45), "Continuation-base structure border", group = groupDisplay)
showFlipMarkers = input.bool(true, "Show zone-type arrows on retests", group = groupDisplay)
showAdditionalSupplyRetests = input.bool(true, "Mark every fresh S→D retest", group = groupDisplay,
     tooltip = "After the first valid S→D retest, marks each later re-entry that occurs after price has first left the zone. Continuous bars inside one retest receive only one arrow.")
showRetestMarkers = input.bool(true, "Show first-retest markers", group = groupDisplay)
showLaterBreakMarkers = input.bool(true, "Show red marker when a retested zone later breaks", group = groupDisplay)
zoneLeftPaddingBars = input.int(3, "Start visible area before origin (bars)", minval = 0, maxval = 20, group = groupDisplay,
     tooltip = "Visual padding only. Moves the box left border before the true origin so it does not cover the origin candle wick. Detection and bar counts remain unchanged.")
zoneTextLeftOffsetBars = input.int(1, "Text distance left of visible area (bars)", minval = 0, maxval = 20, group = groupDisplay,
     tooltip = "Places the complete zone callout outside the box on its left side. The arrow tip points toward the visible zone.")
drawFromSupplyOrigin = input.bool(true, "Draw from original supply candle", group = groupDisplay)
showTrendAverages = input.bool(false, "Show EMA 9, EMA 20, and VWAP", group = groupDisplay)

// ────────────────────── Helpers ──────────────────────
f_origin_session_suffix(int originTimestamp) =>
    int originHour = hour(originTimestamp, syminfo.timezone)
    int originMinute = minute(originTimestamp, syminfo.timezone)
    int originMinuteOfDay = originHour * 60 + originMinute
    originMinuteOfDay < 570 ? " • PREMARKET" : originMinuteOfDay >= 960 ? " • AFTER HOURS" : ""

// ────────────────────── Core calculations ──────────────────────
float atr = ta.atr(14)
float volumeAverage = ta.sma(volume, volumeAverageLength)
float fastEma = ta.ema(close, fastEmaLength)
float slowEma = ta.ema(close, slowEmaLength)
float sessionVwap = ta.vwap(hlc3)
float confirmedPivotHigh = ta.pivothigh(high, pivotLeft, pivotRight)
float confirmedPivotLow = ta.pivotlow(low, demandPivotLeft, demandPivotRight)
float postDemandHigh = ta.highest(high, demandPivotRight)
float compactPostDemandLow = ta.lowest(low, compactDemandRightBars)
float compactPostDemandHigh = ta.highest(high, compactDemandRightBars)
float postPivotLow = ta.lowest(low, pivotRight)
float postPivotClose = ta.lowest(close, pivotRight)
bool signalBarReady = not confirmedBarsOnly or barstate.isconfirmed

plot(showTrendAverages ? fastEma : na, title = "EMA 9", color = color.new(color.teal, 0), linewidth = 1)
plot(showTrendAverages ? slowEma : na, title = "EMA 20", color = color.new(color.orange, 0), linewidth = 1)
plot(showTrendAverages ? sessionVwap : na, title = "Session VWAP", color = color.new(color.purple, 0), linewidth = 1)

int ZONE_KIND_SUPPLY_FLIP = 0
int ZONE_KIND_CONTINUATION_BASE = 1

// Hidden supply candidates.
var array<float> candidateTops = array.new<float>()
var array<float> candidateBottoms = array.new<float>()
var array<float> candidateLegReferences = array.new<float>()
var array<float> candidateOriginRelativeVolumes = array.new<float>()
var array<int> candidateOriginBars = array.new<int>()
var array<int> candidateStructureStartBars = array.new<int>()
var array<float> candidateOriginAtrs = array.new<float>()
var array<float> candidateTrackedLows = array.new<float>()
var array<bool> candidateLegConfirmed = array.new<bool>()
var array<float> candidateDemandLows = array.new<float>()
var array<int> candidateDemandBars = array.new<int>()
var array<int> candidateBreakCounts = array.new<int>()

// Confirmed supply→demand zones.
var array<box> flipBoxes = array.new<box>()
var array<box> flipLegBoxes = array.new<box>()
var array<label> flipTextLabels = array.new<label>()
var array<float> flipTops = array.new<float>()
var array<float> flipBottoms = array.new<float>()
var array<float> flipDemandLows = array.new<float>()
var array<int> flipDemandBars = array.new<int>()
var array<int> flipConfirmationBars = array.new<int>()
var array<int> flipOriginTimes = array.new<int>()
var array<bool> flipRetested = array.new<bool>()
var array<bool> flipWasIntersecting = array.new<bool>()
var array<bool> flipActive = array.new<bool>()
var array<int> flipZoneKinds = array.new<int>()

bool flipDetected = false
bool firstRetestDetected = false
bool supplyFlipRetestDetected = false
bool additionalSupplyFlipRetestDetected = false
bool continuationBaseRetestDetected = false
bool invalidationDetected = false
bool laterBreakDetected = false
color hiddenDrawingColor = color.new(color.black, 100)

// ───────────────── Create hidden supply candidates ────────────────
if signalBarReady and not na(confirmedPivotHigh) and bar_index > pivotRight + trendSlopeBars and not na(atr[pivotRight])
    float pivotOpen = open[pivotRight]
    float pivotClose = close[pivotRight]
    float pivotHigh = high[pivotRight]
    float bodyHigh = math.max(pivotOpen, pivotClose)
    float bodyLow = math.min(pivotOpen, pivotClose)
    float pivotAtr = atr[pivotRight]
    float pivotFastEma = fastEma[pivotRight]
    float pivotSlowEma = slowEma[pivotRight]
    float pivotVwap = sessionVwap[pivotRight]
    float pivotVolumeAverage = volumeAverage[pivotRight]
    float nearestTrendReference = math.max(pivotFastEma, math.max(pivotSlowEma, pivotVwap))

    float bearishOriginBody = pivotOpen - pivotClose
    bool bullishSupplyOrigin = pivotClose >= pivotOpen
    bool bearishRejectionOrigin = allowBearishSupplyCandle and pivotClose < pivotOpen and
         bearishOriginBody >= pivotAtr * minBearishOriginBodyAtr
    bool directionOk = bullishSupplyOrigin or bearishRejectionOrigin
    // A bearish rejection candle performs part of the departure inside its own body,
    // so its close/body-low is the more faithful proximal boundary. Bullish origins
    // retain the original upper-wick/body-high boundary.
    float actionableZoneBottom = bearishRejectionOrigin ? bodyLow : bodyHigh
    bool wickOk = pivotHigh - bodyHigh >= pivotAtr * minUpperWickAtr
    bool departureOk = bodyHigh - postPivotLow >= pivotAtr * minBearishDepartureAtr and postPivotClose < bodyHigh
    bool validZoneWidth = pivotHigh > bodyHigh

    bool trendDataReady = not na(pivotFastEma) and not na(pivotSlowEma) and not na(pivotVwap)
    bool supplyAboveTrend = pivotClose > pivotFastEma and pivotClose > pivotSlowEma and pivotClose > pivotVwap and
         pivotHigh > pivotFastEma and pivotHigh > pivotSlowEma and pivotHigh > pivotVwap
    bool bullishStack = pivotFastEma > pivotSlowEma
    bool slopeDataReady = not na(fastEma[pivotRight + trendSlopeBars]) and not na(slowEma[pivotRight + trendSlopeBars])
    bool risingEmas = not requireRisingEmas or
         (slopeDataReady and pivotFastEma > fastEma[pivotRight + trendSlopeBars] and
         pivotSlowEma > slowEma[pivotRight + trendSlopeBars])
    bool risingVwap = not requireRisingVwap or
         (not na(sessionVwap[pivotRight + trendSlopeBars]) and pivotVwap > sessionVwap[pivotRight + trendSlopeBars])
    float supplyRelativeVolume = not na(volume[pivotRight]) and not na(pivotVolumeAverage) and pivotVolumeAverage > 0.0 ?
         volume[pivotRight] / pivotVolumeAverage : na
    bool supplyVolumeOk = not requireSupplyVolume or
         (not na(supplyRelativeVolume) and supplyRelativeVolume >= minSupplyRelativeVolume)
    float applicableMaxExtensionAtr = bearishRejectionOrigin ? maxBearishSupplyExtensionAtr : maxSupplyExtensionAtr
    float supplyExtensionAtr = pivotAtr > 0.0 ? (bodyHigh - nearestTrendReference) / pivotAtr : na
    bool normalExtensionOk = applicableMaxExtensionAtr <= 0.0 or
         (not na(supplyExtensionAtr) and supplyExtensionAtr <= applicableMaxExtensionAtr)
    bool extremeVolumeExtensionOk = useExtremeVolumeExtensionOverride and
         not na(supplyRelativeVolume) and supplyRelativeVolume >= minExtremeSupplyRelativeVolume and
         not na(supplyExtensionAtr) and supplyExtensionAtr <= maxExtremeSupplyExtensionAtr
    bool extensionOk = normalExtensionOk or extremeVolumeExtensionOk

    bool reactionHoldsSlowEma = true
    for reactionOffset = 0 to pivotRight - 1
        reactionHoldsSlowEma := reactionHoldsSlowEma and not na(slowEma[reactionOffset]) and
             close[reactionOffset] >= slowEma[reactionOffset]
    bool reactionLocationOk = not requireReactionAboveSlowEma or reactionHoldsSlowEma

    bool supplyTrendOk = supplyVolumeOk and (not requireBullishTrend or
         (trendDataReady and supplyAboveTrend and bullishStack and risingEmas and risingVwap and
         reactionLocationOk and extensionOk))

    if directionOk and wickOk and departureOk and validZoneWidth and supplyTrendOk
        int originBar = bar_index - pivotRight
        int supplyStructureStartBar = originBar
        int supplyStructureBars = 1

        // The pivot defines the vertical zone. Expand only the temporal origin,
        // walking backward contiguously through the pivot's left-side confirmation
        // window. A failed bar ends the expansion; the scan never jumps across gaps.
        if expandSupplyStructure
            for backwardStep = 1 to pivotLeft
                int structureOffset = pivotRight + backwardStep
                float structureBodyHigh = math.max(open[structureOffset], close[structureOffset])
                float structureVolumeAverage = volumeAverage[structureOffset]
                float structureRelativeVolume = not na(volume[structureOffset]) and
                     not na(structureVolumeAverage) and structureVolumeAverage > 0.0 ?
                     volume[structureOffset] / structureVolumeAverage : na
                bool structureDataReady = not na(high[structureOffset]) and not na(close[structureOffset]) and
                     not na(atr[structureOffset]) and not na(fastEma[structureOffset]) and
                     not na(slowEma[structureOffset]) and not na(sessionVwap[structureOffset])
                bool structureTouches = structureDataReady and
                     high[structureOffset] >= actionableZoneBottom - pivotAtr * structureTouchBufferAtr and
                     high[structureOffset] <= pivotHigh + syminfo.mintick * 2.0
                bool structureRejects = structureDataReady and
                     close[structureOffset] <= actionableZoneBottom + pivotAtr * structureCloseBufferAtr and
                     high[structureOffset] - structureBodyHigh >= pivotAtr * minUpperWickAtr
                bool structureVolumeOk = not requireSupplyVolume or
                     (not na(structureRelativeVolume) and structureRelativeVolume >= minSupplyRelativeVolume)
                bool structureLocationOk = not requireBullishTrend or
                     (close[structureOffset] > fastEma[structureOffset] and
                     close[structureOffset] > slowEma[structureOffset] and
                     close[structureOffset] > sessionVwap[structureOffset] and
                     high[structureOffset] > fastEma[structureOffset] and
                     high[structureOffset] > slowEma[structureOffset] and
                     high[structureOffset] > sessionVwap[structureOffset])

                if structureTouches and structureRejects and structureVolumeOk and structureLocationOk
                    supplyStructureStartBar := originBar - backwardStep
                    supplyStructureBars += 1
                else
                    break

        int effectiveMinSupplyStructureBars = math.min(minSupplyStructureBars, pivotLeft + 1)
        if supplyStructureBars < effectiveMinSupplyStructureBars
            supplyStructureStartBar := originBar

        bool duplicate = false
        int duplicateIndex = array.size(candidateTops) - 1
        while duplicateIndex >= 0
            float oldTop = array.get(candidateTops, duplicateIndex)
            float oldBottom = array.get(candidateBottoms, duplicateIndex)
            int oldOriginBar = array.get(candidateOriginBars, duplicateIndex)
            bool overlaps = actionableZoneBottom <= oldTop and pivotHigh >= oldBottom
            bool closeInTime = originBar - oldOriginBar <= pivotLeft + pivotRight + 2
            if overlaps and closeInTime
                duplicate := true
            duplicateIndex -= 1

        if not duplicate
            array.push(candidateTops, pivotHigh)
            array.push(candidateBottoms, actionableZoneBottom)
            // Keep the original body-high for measuring seller-leg decline even when
            // a bearish origin uses its deeper close as the actionable zone boundary.
            array.push(candidateLegReferences, bodyHigh)
            array.push(candidateOriginRelativeVolumes, supplyRelativeVolume)
            array.push(candidateOriginBars, originBar)
            array.push(candidateStructureStartBars, supplyStructureStartBar)
            array.push(candidateOriginAtrs, pivotAtr)
            array.push(candidateTrackedLows, postPivotLow)
            array.push(candidateLegConfirmed, false)
            array.push(candidateDemandLows, na)
            array.push(candidateDemandBars, na)
            array.push(candidateBreakCounts, 0)

            if array.size(candidateTops) > maxHiddenCandidates
                array.shift(candidateTops)
                array.shift(candidateBottoms)
                array.shift(candidateLegReferences)
                array.shift(candidateOriginRelativeVolumes)
                array.shift(candidateOriginBars)
                array.shift(candidateStructureStartBars)
                array.shift(candidateOriginAtrs)
                array.shift(candidateTrackedLows)
                array.shift(candidateLegConfirmed)
                array.shift(candidateDemandLows)
                array.shift(candidateDemandBars)
                array.shift(candidateBreakCounts)

// ────────────── Confirm supply→demand flips ──────────────
int candidateIndex = array.size(candidateTops) - 1
while candidateIndex >= 0
    float supplyTop = array.get(candidateTops, candidateIndex)
    float supplyBottom = array.get(candidateBottoms, candidateIndex)
    float sellerLegReference = array.get(candidateLegReferences, candidateIndex)
    float supplyOriginRelativeVolume = array.get(candidateOriginRelativeVolumes, candidateIndex)
    int supplyOriginBar = array.get(candidateOriginBars, candidateIndex)
    int supplyStructureStartBar = array.get(candidateStructureStartBars, candidateIndex)
    float supplyOriginAtr = array.get(candidateOriginAtrs, candidateIndex)
    float trackedLegLow = array.get(candidateTrackedLows, candidateIndex)
    bool sellerLegConfirmed = array.get(candidateLegConfirmed, candidateIndex)
    float demandLow = array.get(candidateDemandLows, candidateIndex)
    int demandBar = array.get(candidateDemandBars, candidateIndex)
    int breakCount = array.get(candidateBreakCounts, candidateIndex)

    // A new low after demand confirmation means the seller leg has not truly ended.
    // Reset it and wait for a later demand pivot, provided the leg is still young enough.
    if sellerLegConfirmed and not na(demandLow) and low < demandLow - syminfo.mintick
        sellerLegConfirmed := false
        demandLow := na
        demandBar := na
        trackedLegLow := low
        array.set(candidateLegConfirmed, candidateIndex, false)
        array.set(candidateDemandLows, candidateIndex, na)
        array.set(candidateDemandBars, candidateIndex, na)
        array.set(candidateTrackedLows, candidateIndex, trackedLegLow)

    if not sellerLegConfirmed
        trackedLegLow := na(trackedLegLow) ? low : math.min(trackedLegLow, low)
        array.set(candidateTrackedLows, candidateIndex, trackedLegLow)

        if signalBarReady and not na(confirmedPivotLow) and not na(atr[demandPivotRight])
            int proposedDemandBar = bar_index - demandPivotRight
            int proposedLegBars = proposedDemandBar - supplyOriginBar
            float demandAtr = atr[demandPivotRight]
            float demandBodyLow = math.min(open[demandPivotRight], close[demandPivotRight])
            float demandLowerWick = demandBodyLow - confirmedPivotLow
            bool pivotIsLegLow = math.abs(confirmedPivotLow - trackedLegLow) <= syminfo.mintick * 2.0
            bool legDurationOk = proposedLegBars >= minSellerLegBars and proposedLegBars <= maxSellerLegBars
            bool legDeclineOk = sellerLegReference - confirmedPivotLow >= supplyOriginAtr * minSellerLegAtr
            bool demandWickOk = demandLowerWick >= demandAtr * minDemandLowerWickAtr
            bool demandReactionOk = postDemandHigh - confirmedPivotLow >= demandAtr * minDemandReactionAtr
            float maxDemandReactionRelativeVolume = na
            for demandVolumeOffset = 0 to demandPivotRight
                float reactionVolumeAverage = volumeAverage[demandVolumeOffset]
                float reactionRelativeVolume = not na(volume[demandVolumeOffset]) and
                     not na(reactionVolumeAverage) and reactionVolumeAverage > 0.0 ?
                     volume[demandVolumeOffset] / reactionVolumeAverage : na
                if not na(reactionRelativeVolume)
                    maxDemandReactionRelativeVolume := na(maxDemandReactionRelativeVolume) ?
                         reactionRelativeVolume : math.max(maxDemandReactionRelativeVolume, reactionRelativeVolume)
            bool demandVolumeOk = not na(maxDemandReactionRelativeVolume) and
                 maxDemandReactionRelativeVolume >= minDemandRelativeVolume

            if pivotIsLegLow and legDurationOk and legDeclineOk and demandWickOk and
                 demandReactionOk and demandVolumeOk
                sellerLegConfirmed := true
                demandLow := confirmedPivotLow
                demandBar := proposedDemandBar
                array.set(candidateLegConfirmed, candidateIndex, true)
                array.set(candidateDemandLows, candidateIndex, demandLow)
                array.set(candidateDemandBars, candidateIndex, demandBar)

        // Compact fallback: some strong supply candles produce a sharp one- or two-bar
        // seller leg whose low cannot satisfy the normal left-pivot requirement because
        // an earlier pre-origin candle was lower. Require exceptional origin volume,
        // a stable post-low reaction, and all normal decline/wick/reaction/volume tests.
        if not sellerLegConfirmed and allowCompactSellerLeg and bar_index >= compactDemandRightBars
            int compactDemandBar = bar_index - compactDemandRightBars
            int compactLegBars = compactDemandBar - supplyOriginBar
            float compactDemandLow = low[compactDemandRightBars]
            float compactDemandAtr = atr[compactDemandRightBars]
            float compactDemandBodyLow = math.min(open[compactDemandRightBars], close[compactDemandRightBars])
            float compactDemandLowerWick = compactDemandBodyLow - compactDemandLow
            float compactMaxDemandRelativeVolume = na
            for compactVolumeOffset = 0 to compactDemandRightBars
                float compactVolumeAverage = volumeAverage[compactVolumeOffset]
                float compactRelativeVolume = not na(volume[compactVolumeOffset]) and
                     not na(compactVolumeAverage) and compactVolumeAverage > 0.0 ?
                     volume[compactVolumeOffset] / compactVolumeAverage : na
                if not na(compactRelativeVolume)
                    compactMaxDemandRelativeVolume := na(compactMaxDemandRelativeVolume) ?
                         compactRelativeVolume : math.max(compactMaxDemandRelativeVolume, compactRelativeVolume)

            bool compactOriginVolumeOk = not na(supplyOriginRelativeVolume) and
                 supplyOriginRelativeVolume >= minCompactSupplyRelativeVolume
            bool compactDurationOk = compactLegBars >= 1 and compactLegBars <= compactMaxSellerLegBars
            bool compactIsStableLegLow = compactDemandLow < compactPostDemandLow and
                 math.abs(compactDemandLow - trackedLegLow) <= syminfo.mintick * 2.0
            bool compactLegDeclineOk = sellerLegReference - compactDemandLow >= supplyOriginAtr * minSellerLegAtr
            bool compactDemandWickOk = not na(compactDemandAtr) and
                 compactDemandLowerWick >= compactDemandAtr * minDemandLowerWickAtr
            bool compactDemandReactionOk = not na(compactDemandAtr) and
                 compactPostDemandHigh - compactDemandLow >= compactDemandAtr * minDemandReactionAtr
            bool compactDemandVolumeOk = not na(compactMaxDemandRelativeVolume) and
                 compactMaxDemandRelativeVolume >= minDemandRelativeVolume

            if compactOriginVolumeOk and compactDurationOk and compactIsStableLegLow and
                 compactLegDeclineOk and compactDemandWickOk and compactDemandReactionOk and compactDemandVolumeOk
                sellerLegConfirmed := true
                demandLow := compactDemandLow
                demandBar := compactDemandBar
                array.set(candidateLegConfirmed, candidateIndex, true)
                array.set(candidateDemandLows, candidateIndex, demandLow)
                array.set(candidateDemandBars, candidateIndex, demandBar)

    bool legReady = not requireSellerControlLeg or sellerLegConfirmed
    bool expired = bar_index - supplyOriginBar > maxHiddenAge
    bool legFormationExpired = requireSellerControlLeg and not sellerLegConfirmed and
         bar_index - supplyOriginBar > maxSellerLegBars + demandPivotRight
    bool closesAboveSupply = close > supplyTop + atr * breakBufferAtr
    if signalBarReady
        breakCount := legReady and closesAboveSupply ? breakCount + 1 : 0
        array.set(candidateBreakCounts, candidateIndex, breakCount)

    float bullishBody = close - open
    bool breakBodyOk = bullishBody >= atr * minBreakBodyAtr
    bool breakVolumeOk = not requireBreakVolume or
         (not na(volume) and not na(volumeAverage) and volume >= volumeAverage * minBreakRelativeVolume)
    bool breakTrendDataReady = not na(fastEma) and not na(slowEma) and not na(sessionVwap)
    bool breakAboveTrend = close > fastEma and close > slowEma and close > sessionVwap
    bool breakBullishStack = fastEma > slowEma
    bool breakRisingEmas = not requireRisingEmas or
         (not na(fastEma[trendSlopeBars]) and not na(slowEma[trendSlopeBars]) and
         fastEma > fastEma[trendSlopeBars] and slowEma > slowEma[trendSlopeBars])
    bool breakRisingVwap = not requireRisingVwap or
         (not na(sessionVwap[trendSlopeBars]) and sessionVwap > sessionVwap[trendSlopeBars])
    bool breakTrendOk = not requireBullishTrend or
         (breakTrendDataReady and breakAboveTrend and breakBullishStack and breakRisingEmas and breakRisingVwap)

    bool qualifiedFlip = signalBarReady and legReady and breakCount >= requiredBreakCloses and
         breakBodyOk and breakVolumeOk and breakTrendOk
    bool failedBreakQuality = signalBarReady and legReady and breakCount >= requiredBreakCloses and
         not (breakBodyOk and breakVolumeOk and breakTrendOk)

    // A weak breakout sequence does not erase proven supply. Reset confirmation and
    // let the hidden candidate wait for a later, higher-quality break.
    if failedBreakQuality
        breakCount := 0
        array.set(candidateBreakCounts, candidateIndex, breakCount)

    if qualifiedFlip
        box newFlipBox = box.new(
             left = drawFromSupplyOrigin ? math.max(0, supplyStructureStartBar - zoneLeftPaddingBars) : bar_index,
             top = supplyTop,
             right = bar_index + 1,
             bottom = supplyBottom,
             xloc = xloc.bar_index,
             border_color = hiddenDrawingColor,
             border_width = 1,
             bgcolor = hiddenDrawingColor,
             text = "",
             text_color = hiddenDrawingColor,
             text_size = size.normal,
             text_halign = text.align_left)

        box newLegBox = na
        if sellerLegConfirmed and not na(demandLow) and not na(demandBar)
            newLegBox := box.new(
                 left = math.max(0, supplyStructureStartBar - zoneLeftPaddingBars),
                 top = supplyTop,
                 right = demandBar + 1,
                 bottom = demandLow,
                 xloc = xloc.bar_index,
                 border_color = hiddenDrawingColor,
                 border_width = 1,
                 bgcolor = hiddenDrawingColor,
                 text = "",
                 text_color = hiddenDrawingColor,
                 text_size = size.normal,
                 text_halign = text.align_left)

        array.push(flipBoxes, newFlipBox)
        array.push(flipLegBoxes, newLegBox)
        array.push(flipTextLabels, na)
        array.push(flipTops, supplyTop)
        array.push(flipBottoms, supplyBottom)
        array.push(flipDemandLows, demandLow)
        array.push(flipDemandBars, demandBar)
        array.push(flipConfirmationBars, bar_index)
        array.push(flipOriginTimes, time[bar_index - supplyStructureStartBar])
        array.push(flipRetested, false)
        array.push(flipWasIntersecting, false)
        array.push(flipActive, true)
        array.push(flipZoneKinds, ZONE_KIND_SUPPLY_FLIP)
        flipDetected := true

        if sendDynamicAlerts
            string legDetails = sellerLegConfirmed ?
                 " | Supply structure: " + str.tostring(demandBar - supplyStructureStartBar + 1) + " bars" +
                 " | Demand low: " + str.tostring(demandLow, format.mintick) : ""
            alert("Supply→Demand flip confirmed | " + syminfo.ticker + " " + timeframe.period +
                 " | Zone: " + str.tostring(supplyBottom, format.mintick) + " - " +
                 str.tostring(supplyTop, format.mintick) + legDetails, alert.freq_once_per_bar_close)

        array.remove(candidateTops, candidateIndex)
        array.remove(candidateBottoms, candidateIndex)
        array.remove(candidateLegReferences, candidateIndex)
        array.remove(candidateOriginRelativeVolumes, candidateIndex)
        array.remove(candidateOriginBars, candidateIndex)
        array.remove(candidateStructureStartBars, candidateIndex)
        array.remove(candidateOriginAtrs, candidateIndex)
        array.remove(candidateTrackedLows, candidateIndex)
        array.remove(candidateLegConfirmed, candidateIndex)
        array.remove(candidateDemandLows, candidateIndex)
        array.remove(candidateDemandBars, candidateIndex)
        array.remove(candidateBreakCounts, candidateIndex)

        if array.size(flipBoxes) > maxDisplayedZones
            box oldestBox = array.shift(flipBoxes)
            box oldestLegBox = array.shift(flipLegBoxes)
            label oldestTextLabel = array.shift(flipTextLabels)
            box.delete(oldestBox)
            if not na(oldestLegBox)
                box.delete(oldestLegBox)
            if not na(oldestTextLabel)
                label.delete(oldestTextLabel)
            array.shift(flipTops)
            array.shift(flipBottoms)
            array.shift(flipDemandLows)
            array.shift(flipDemandBars)
            array.shift(flipConfirmationBars)
            array.shift(flipOriginTimes)
            array.shift(flipRetested)
            array.shift(flipWasIntersecting)
            array.shift(flipActive)
            array.shift(flipZoneKinds)
    else if expired or legFormationExpired
        array.remove(candidateTops, candidateIndex)
        array.remove(candidateBottoms, candidateIndex)
        array.remove(candidateLegReferences, candidateIndex)
        array.remove(candidateOriginRelativeVolumes, candidateIndex)
        array.remove(candidateOriginBars, candidateIndex)
        array.remove(candidateStructureStartBars, candidateIndex)
        array.remove(candidateOriginAtrs, candidateIndex)
        array.remove(candidateTrackedLows, candidateIndex)
        array.remove(candidateLegConfirmed, candidateIndex)
        array.remove(candidateDemandLows, candidateIndex)
        array.remove(candidateDemandBars, candidateIndex)
        array.remove(candidateBreakCounts, candidateIndex)

    candidateIndex -= 1

// ───────────── Confirm bullish continuation-base zones ─────────────
// This path is intentionally separate from supply qualification. It looks for:
//   prior bullish impulse → compact high-volume acceptance shelf → decisive close above the shelf.
// The resulting demand zone remains hidden until its first later retest, matching the supply-flip lifecycle.
if enableContinuationBases and signalBarReady and continuationMaxBaseBars >= continuationMinBaseBars and
     bar_index > continuationMaxBaseBars + continuationPriorImpulseLookback + trendSlopeBars and not na(atr)
    bool continuationBreakTrendDataReady = not na(fastEma) and not na(slowEma) and not na(sessionVwap)
    bool continuationBreakAboveTrend = close > fastEma and close > slowEma and close > sessionVwap
    bool continuationBreakBullishStack = fastEma > slowEma
    bool continuationBreakRisingEmas = not requireRisingEmas or
         (not na(fastEma[trendSlopeBars]) and not na(slowEma[trendSlopeBars]) and
         fastEma > fastEma[trendSlopeBars] and slowEma > slowEma[trendSlopeBars])
    bool continuationBreakRisingVwap = not requireRisingVwap or
         (not na(sessionVwap[trendSlopeBars]) and sessionVwap > sessionVwap[trendSlopeBars])
    bool continuationBreakTrendOk = not requireBullishTrend or
         (continuationBreakTrendDataReady and continuationBreakAboveTrend and continuationBreakBullishStack and
         continuationBreakRisingEmas and continuationBreakRisingVwap)

    int selectedBaseBars = 0
    float selectedBaseTop = na
    float selectedBaseBottom = na
    int selectedBaseStartBar = na
    int selectedBaseEndBar = na

    int continuationLengthsToTest = continuationMaxBaseBars - continuationMinBaseBars
    for continuationLengthIndex = 0 to continuationLengthsToTest
        int testedBaseBars = continuationMaxBaseBars - continuationLengthIndex
        if selectedBaseBars == 0 and bar_index > testedBaseBars + continuationPriorImpulseLookback
            float baseAtr = atr[1]
            float baseTop = na
            float baseLowestClose = na
            float baseHighestClose = na
            float baseHighestBodyLow = na
            float relativeVolumeSum = 0.0
            int relativeVolumeSamples = 0
            int highVolumeBaseBars = 0
            bool eachBaseBarVolumeOk = true
            bool eachBaseBarTrendOk = true
            bool baseDataReady = not na(baseAtr) and baseAtr > 0.0

            for baseOffset = 1 to testedBaseBars
                float baseBodyLow = math.min(open[baseOffset], close[baseOffset])
                float baseVolumeAverage = volumeAverage[baseOffset]
                float baseRelativeVolume = not na(volume[baseOffset]) and not na(baseVolumeAverage) and
                     baseVolumeAverage > 0.0 ? volume[baseOffset] / baseVolumeAverage : na

                baseTop := na(baseTop) ? high[baseOffset] : math.max(baseTop, high[baseOffset])
                baseLowestClose := na(baseLowestClose) ? close[baseOffset] : math.min(baseLowestClose, close[baseOffset])
                baseHighestClose := na(baseHighestClose) ? close[baseOffset] : math.max(baseHighestClose, close[baseOffset])
                baseHighestBodyLow := na(baseHighestBodyLow) ? baseBodyLow : math.max(baseHighestBodyLow, baseBodyLow)

                bool baseBarDataReady = not na(high[baseOffset]) and not na(close[baseOffset]) and
                     not na(fastEma[baseOffset]) and not na(slowEma[baseOffset]) and not na(sessionVwap[baseOffset]) and
                     not na(baseRelativeVolume)
                baseDataReady := baseDataReady and baseBarDataReady
                if not na(baseRelativeVolume)
                    relativeVolumeSum += baseRelativeVolume
                    relativeVolumeSamples += 1
                    highVolumeBaseBars += baseRelativeVolume >= continuationHighVolumeThreshold ? 1 : 0
                eachBaseBarVolumeOk := eachBaseBarVolumeOk and not na(baseRelativeVolume) and
                     baseRelativeVolume >= continuationMinBarRelativeVolume
                eachBaseBarTrendOk := eachBaseBarTrendOk and (not requireBullishTrend or
                     (close[baseOffset] > slowEma[baseOffset] and close[baseOffset] > sessionVwap[baseOffset] and
                     fastEma[baseOffset] > slowEma[baseOffset]))

            float baseBottom = continuationZoneFloor == "Lowest close" ? baseLowestClose : baseHighestBodyLow
            float averageBaseRelativeVolume = relativeVolumeSamples == testedBaseBars ?
                 relativeVolumeSum / testedBaseBars : na
            float baseZoneWidth = baseTop - baseBottom
            float baseCloseSpread = baseHighestClose - baseLowestClose
            bool validBaseZone = baseDataReady and not na(baseBottom) and baseTop > baseBottom and
                 baseZoneWidth <= baseAtr * continuationMaxZoneWidthAtr and
                 baseCloseSpread <= baseAtr * continuationMaxCloseSpreadAtr
            bool baseVolumeOk = eachBaseBarVolumeOk and not na(averageBaseRelativeVolume) and
                 averageBaseRelativeVolume >= continuationMinAverageRelativeVolume and
                 highVolumeBaseBars >= math.min(continuationMinHighVolumeBars, testedBaseBars)
            bool baseNetProgressOk = close[1] >= close[testedBaseBars] - baseAtr * continuationMaxNetPullbackAtr

            float priorImpulseLow = na
            for priorOffset = testedBaseBars + 1 to testedBaseBars + continuationPriorImpulseLookback
                priorImpulseLow := na(priorImpulseLow) ? low[priorOffset] : math.min(priorImpulseLow, low[priorOffset])
            bool priorImpulseOk = continuationMinPriorImpulseAtr <= 0.0 or
                 (not na(priorImpulseLow) and baseBottom - priorImpulseLow >= baseAtr * continuationMinPriorImpulseAtr)

            bool baseQualified = validBaseZone and baseVolumeOk and eachBaseBarTrendOk and
                 baseNetProgressOk and priorImpulseOk
            if baseQualified
                selectedBaseBars := testedBaseBars
                selectedBaseTop := baseTop
                selectedBaseBottom := baseBottom
                selectedBaseStartBar := bar_index - testedBaseBars
                selectedBaseEndBar := bar_index - 1

    if selectedBaseBars > 0
        float continuationBreakBody = close - open
        float continuationBreakUpperWick = high - math.max(open, close)
        bool continuationClosesAboveBase = close > selectedBaseTop + atr * continuationBreakBufferAtr
        bool continuationBreakBodyOk = continuationBreakBody >= atr * continuationMinBreakBodyAtr
        bool continuationBreakVolumeOk = not na(volume) and not na(volumeAverage) and volumeAverage > 0.0 and
             volume / volumeAverage >= continuationMinBreakRelativeVolume
        bool continuationBreakWickOk = continuationBreakUpperWick <= atr * continuationMaxBreakUpperWickAtr
        bool continuationBreakQualified = continuationClosesAboveBase and continuationBreakBodyOk and
             continuationBreakVolumeOk and continuationBreakWickOk and continuationBreakTrendOk

        bool continuationDuplicate = false
        int continuationDuplicateIndex = array.size(flipTops) - 1
        while continuationDuplicateIndex >= 0
            float oldZoneTop = array.get(flipTops, continuationDuplicateIndex)
            float oldZoneBottom = array.get(flipBottoms, continuationDuplicateIndex)
            int oldConfirmationBar = array.get(flipConfirmationBars, continuationDuplicateIndex)
            bool continuationOverlap = selectedBaseBottom <= oldZoneTop and selectedBaseTop >= oldZoneBottom
            bool continuationCloseInTime = bar_index - oldConfirmationBar <= continuationDuplicateWindowBars
            if continuationOverlap and continuationCloseInTime
                continuationDuplicate := true
            continuationDuplicateIndex -= 1

        if continuationBreakQualified and not continuationDuplicate
            box newContinuationZoneBox = box.new(
                 left = drawFromSupplyOrigin ? math.max(0, selectedBaseStartBar - zoneLeftPaddingBars) : bar_index,
                 top = selectedBaseTop,
                 right = bar_index + 1,
                 bottom = selectedBaseBottom,
                 xloc = xloc.bar_index,
                 border_color = hiddenDrawingColor,
                 border_width = 1,
                 bgcolor = hiddenDrawingColor,
                 text = "",
                 text_color = hiddenDrawingColor,
                 text_size = size.normal,
                 text_halign = text.align_left)

            box newContinuationBaseBox = box.new(
                 left = math.max(0, selectedBaseStartBar - zoneLeftPaddingBars),
                 top = selectedBaseTop,
                 right = selectedBaseEndBar + 1,
                 bottom = selectedBaseBottom,
                 xloc = xloc.bar_index,
                 border_color = hiddenDrawingColor,
                 border_width = 1,
                 bgcolor = hiddenDrawingColor,
                 text = "",
                 text_color = hiddenDrawingColor,
                 text_size = size.normal,
                 text_halign = text.align_left)

            array.push(flipBoxes, newContinuationZoneBox)
            array.push(flipLegBoxes, newContinuationBaseBox)
            array.push(flipTextLabels, na)
            array.push(flipTops, selectedBaseTop)
            array.push(flipBottoms, selectedBaseBottom)
            array.push(flipDemandLows, selectedBaseBottom)
            array.push(flipDemandBars, selectedBaseEndBar)
            array.push(flipConfirmationBars, bar_index)
            array.push(flipOriginTimes, time[bar_index - selectedBaseStartBar])
            array.push(flipRetested, false)
            array.push(flipWasIntersecting, false)
            array.push(flipActive, true)
            array.push(flipZoneKinds, ZONE_KIND_CONTINUATION_BASE)
            flipDetected := true

            if sendDynamicAlerts
                alert("Bullish continuation base confirmed | " + syminfo.ticker + " " + timeframe.period +
                     " | Base bars: " + str.tostring(selectedBaseBars) +
                     " | Zone: " + str.tostring(selectedBaseBottom, format.mintick) + " - " +
                     str.tostring(selectedBaseTop, format.mintick), alert.freq_once_per_bar_close)

            if array.size(flipBoxes) > maxDisplayedZones
                box oldestBox = array.shift(flipBoxes)
                box oldestLegBox = array.shift(flipLegBoxes)
                label oldestTextLabel = array.shift(flipTextLabels)
                box.delete(oldestBox)
                if not na(oldestLegBox)
                    box.delete(oldestLegBox)
                if not na(oldestTextLabel)
                    label.delete(oldestTextLabel)
                array.shift(flipTops)
                array.shift(flipBottoms)
                array.shift(flipDemandLows)
                array.shift(flipDemandBars)
                array.shift(flipConfirmationBars)
                array.shift(flipOriginTimes)
                array.shift(flipRetested)
                array.shift(flipWasIntersecting)
                array.shift(flipActive)
                array.shift(flipZoneKinds)

// ───────── Extend, retest, and close zone lifecycles ─────────
int zoneIndex = 0
while zoneIndex < array.size(flipBoxes)
    box zoneBox = array.get(flipBoxes, zoneIndex)
    box sellerLegBox = array.get(flipLegBoxes, zoneIndex)
    label zoneTextLabel = array.get(flipTextLabels, zoneIndex)
    float zoneTop = array.get(flipTops, zoneIndex)
    float zoneBottom = array.get(flipBottoms, zoneIndex)
    float sellerLegDemandLow = array.get(flipDemandLows, zoneIndex)
    int sellerLegDemandBar = array.get(flipDemandBars, zoneIndex)
    int confirmationBar = array.get(flipConfirmationBars, zoneIndex)
    int originTime = array.get(flipOriginTimes, zoneIndex)
    string originStartText = "START " + str.format_time(originTime, "HH:mm", syminfo.timezone) +
         f_origin_session_suffix(originTime)
    bool alreadyRetested = array.get(flipRetested, zoneIndex)
    bool wasIntersecting = array.get(flipWasIntersecting, zoneIndex)
    bool isActive = array.get(flipActive, zoneIndex)
    int zoneKind = array.get(flipZoneKinds, zoneIndex)
    bool isContinuationBase = zoneKind == ZONE_KIND_CONTINUATION_BASE
    bool removed = false

    if isActive
        box.set_right(zoneBox, bar_index + 1)
        float invalidationThreshold = zoneBottom - atr * invalidationBufferAtr
        bool invalidated = invalidationMode == "Close" ? close < invalidationThreshold : low < invalidationThreshold

        if signalBarReady and invalidated and bar_index > confirmationBar
            invalidationDetected := true

            // A zone that fails before its first retest must never become visible.
            if not alreadyRetested
                if sendDynamicAlerts
                    string failedZoneName = isContinuationBase ? "Continuation-base zone failed before first retest" :
                         "Supply→Demand zone failed before first retest"
                    alert(failedZoneName + " | " + syminfo.ticker + " " + timeframe.period +
                         " | Zone: " + str.tostring(zoneBottom, format.mintick) + " - " +
                         str.tostring(zoneTop, format.mintick), alert.freq_once_per_bar_close)
                box.delete(zoneBox)
                if not na(sellerLegBox)
                    box.delete(sellerLegBox)
                if not na(zoneTextLabel)
                    label.delete(zoneTextLabel)
                array.remove(flipBoxes, zoneIndex)
                array.remove(flipLegBoxes, zoneIndex)
                array.remove(flipTextLabels, zoneIndex)
                array.remove(flipTops, zoneIndex)
                array.remove(flipBottoms, zoneIndex)
                array.remove(flipDemandLows, zoneIndex)
                array.remove(flipDemandBars, zoneIndex)
                array.remove(flipConfirmationBars, zoneIndex)
                array.remove(flipOriginTimes, zoneIndex)
                array.remove(flipRetested, zoneIndex)
                array.remove(flipWasIntersecting, zoneIndex)
                array.remove(flipActive, zoneIndex)
                array.remove(flipZoneKinds, zoneIndex)
                removed := true
            else
                // The retest was valid when it occurred. Freeze that green history at the
                // later break and mark the failure separately instead of repainting it gray.
                array.set(flipActive, zoneIndex, false)
                laterBreakDetected := true
                box.set_right(zoneBox, bar_index)
                box.set_bgcolor(zoneBox, activeFill)
                box.set_border_color(zoneBox, activeBorder)
                box.set_text(zoneBox, "")

                bool showOriginStructure = isContinuationBase ? showContinuationBaseStructure : showSellerControlLeg
                string brokenLifecycleText = isContinuationBase ?
                     "BASE\nVALID RETEST → LATER BROKEN\n" + originStartText :
                     "S→D\nVALID RETEST → LATER BROKEN\n" + originStartText
                string brokenOriginText = ""
                if showOriginStructure and not na(sellerLegBox)
                    string brokenOriginStructureName = isContinuationBase ? "BASE ORIGIN" : "SUPPLY ORIGIN"
                    string brokenOriginLevelName = isContinuationBase ? "floor " : "demand "
                    int brokenStructureBars = math.max(1,
                         sellerLegDemandBar - box.get_left(sellerLegBox) + 1 - zoneLeftPaddingBars)
                    brokenOriginText := "\n\n" + brokenOriginStructureName + "\n" +
                         str.tostring(brokenStructureBars) + " bars • " + brokenOriginLevelName +
                         str.tostring(sellerLegDemandLow, format.mintick)

                if not na(zoneTextLabel)
                    label.set_text(zoneTextLabel, brokenLifecycleText + brokenOriginText)
                    label.set_textcolor(zoneTextLabel, invalidTextColor)
                    label.set_color(zoneTextLabel, color.new(color.red, 75))
                if sendDynamicAlerts
                    string laterBreakName = isContinuationBase ? "Retested continuation-base zone later broken" :
                         "Retested supply→demand zone later broken"
                    alert(laterBreakName + " | " + syminfo.ticker + " " + timeframe.period +
                         " | Zone: " + str.tostring(zoneBottom, format.mintick) + " - " +
                         str.tostring(zoneTop, format.mintick), alert.freq_once_per_bar_close)
        else
            bool intersectsZone = low <= zoneTop and high >= zoneBottom
            bool firstRetest = signalBarReady and bar_index > confirmationBar and intersectsZone and not alreadyRetested
            if firstRetest
                array.set(flipRetested, zoneIndex, true)
                array.set(flipWasIntersecting, zoneIndex, true)
                firstRetestDetected := true
                supplyFlipRetestDetected := supplyFlipRetestDetected or not isContinuationBase
                continuationBaseRetestDetected := continuationBaseRetestDetected or isContinuationBase
                box.set_bgcolor(zoneBox, activeFill)
                box.set_border_color(zoneBox, activeBorder)
                box.set_text(zoneBox, "")

                bool showOriginStructure = isContinuationBase ? showContinuationBaseStructure : showSellerControlLeg
                string lifecycleText = isContinuationBase ?
                     "BASE\nVALID RETEST\n" + originStartText :
                     "S→D\nVALID RETEST\n" + originStartText
                string originText = ""
                color externalLabelColor = color.new(isContinuationBase ? continuationBaseBorder : activeBorder, 72)
                if showOriginStructure and not na(sellerLegBox)
                    color originFill = isContinuationBase ? continuationBaseFill : sellerLegFill
                    color originBorder = isContinuationBase ? continuationBaseBorder : sellerLegBorder
                    box.set_bgcolor(sellerLegBox, originFill)
                    box.set_border_color(sellerLegBox, originBorder)
                    box.set_text(sellerLegBox, "")
                    string originStructureName = isContinuationBase ? "BASE ORIGIN" : "SUPPLY ORIGIN"
                    string originLevelName = isContinuationBase ? "floor " : "demand "
                    int structureBars = math.max(1,
                         sellerLegDemandBar - box.get_left(sellerLegBox) + 1 - zoneLeftPaddingBars)
                    originText := "\n\n" + originStructureName + "\n" +
                         str.tostring(structureBars) + " bars • " + originLevelName +
                         str.tostring(sellerLegDemandLow, format.mintick)

                int externalTextBar = math.max(0, box.get_left(zoneBox) - zoneTextLeftOffsetBars)
                zoneTextLabel := label.new(
                     x = externalTextBar,
                     y = zoneTop,
                     text = lifecycleText + originText,
                     xloc = xloc.bar_index,
                     yloc = yloc.price,
                     style = label.style_label_right,
                     color = externalLabelColor,
                     textcolor = validTextColor,
                     size = size.small,
                     textalign = text.align_right)
                array.set(flipTextLabels, zoneIndex, zoneTextLabel)
                if sendDynamicAlerts
                    string firstRetestName = isContinuationBase ? "Bullish continuation-base first retest" :
                         "Supply→Demand first retest"
                    string structureDetailName = isContinuationBase ? " | Base floor: " : " | Structure demand: "
                    alert(firstRetestName + " | " + syminfo.ticker + " " + timeframe.period +
                         " | Zone: " + str.tostring(zoneBottom, format.mintick) + " - " +
                         str.tostring(zoneTop, format.mintick) +
                         (not na(sellerLegDemandLow) ? structureDetailName +
                         str.tostring(sellerLegDemandLow, format.mintick) : ""), alert.freq_once_per_bar_close)
            else if signalBarReady and alreadyRetested
                // Mark a later S→D retest only when price freshly re-enters after first leaving the zone.
                // This prevents one multi-bar visit from printing an arrow on every candle.
                bool freshRetestEntry = intersectsZone and not wasIntersecting
                if freshRetestEntry and not isContinuationBase and showAdditionalSupplyRetests
                    additionalSupplyFlipRetestDetected := true
                    if sendDynamicAlerts
                        alert("Additional Supply→Demand retest | " + syminfo.ticker + " " + timeframe.period +
                             " | Zone: " + str.tostring(zoneBottom, format.mintick) + " - " +
                             str.tostring(zoneTop, format.mintick), alert.freq_once_per_bar_close)
                array.set(flipWasIntersecting, zoneIndex, intersectsZone)

    if not removed
        zoneIndex += 1

// ───────────────────── Markers and alerts ─────────────────────
plotshape(showFlipMarkers and (supplyFlipRetestDetected or additionalSupplyFlipRetestDetected), title = "Supply→Demand retest", style = shape.arrowup,
     location = location.belowbar, color = color.new(color.lime, 0), text = "S→D", textcolor = color.black, size = size.normal)
plotshape(showFlipMarkers and continuationBaseRetestDetected, title = "Retested bullish continuation base", style = shape.arrowup,
     location = location.belowbar, color = color.new(color.aqua, 0), text = "BASE", textcolor = color.black, size = size.normal)
// BASE and S→D zones use their own labeled arrows, so do not draw the generic retest circle on those bars.
plotshape(showRetestMarkers and firstRetestDetected and not continuationBaseRetestDetected and not supplyFlipRetestDetected, title = "First demand-zone retest", style = shape.circle,
     location = location.belowbar, color = color.new(color.aqua, 0), size = size.normal)
plotshape(showLaterBreakMarkers and laterBreakDetected, title = "Retested demand zone later broken", style = shape.xcross,
     location = location.belowbar, color = invalidTextColor, text = "INVALID", textcolor = invalidTextColor, size = size.normal)

alertcondition(firstRetestDetected or supplyFlipRetestDetected or continuationBaseRetestDetected or additionalSupplyFlipRetestDetected, title = "First retest of bullish demand zone",
     message = "Price is making its first retest of a confirmed bullish demand zone on {{ticker}} {{interval}}.")
