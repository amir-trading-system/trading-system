     4,
     title = "Support Shelf Bars",
     minval = 3,
     maxval = 12,
     group = "Pattern Detection",
     display = display.data_window,
     tooltip = "The indicator uses the lows immediately before the close-below break. One high-low outlier is allowed.")
float maximumShelfWidthPct = input.float(
     2.0,
     title = "Maximum Shelf Width (%)",
     minval = 0.1,
