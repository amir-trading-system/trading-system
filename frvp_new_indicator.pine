//@version=6
indicator(
     "Interactive Fixed Range Volume Profile & Histogram (v7.5)",
     shorttitle = "Interactive FRVP v7.5",
     overlay = true,
     max_boxes_count = 500,
     max_lines_count = 10,
     max_labels_count = 20)

// =============================================================================
// 1. INTERACTIVE INPUTS (drag-and-drop)
// =============================================================================
int startA = input.time(
     timestamp("2026-01-01 00:00"),
     title = "Range - Start Point",
     confirm = true,
     group = "Range Boundaries")
int endA = input.time(
     timestamp("2026-06-30 23:59"),
     title = "Range - End Point",
     confirm = true,
     group = "Range Boundaries")

string rowsLayout = input.string(
     "Number of Rows",
     title = "Rows Layout",
     options = ["Number of Rows", "Ticks Per Row"],
     group = "Profile Precision Settings",
     tooltip = "Use the same layout and row size in TradingView's FRVP when comparing levels.")
int rowSize = input.int(
     100,
     title = "Row Size",
     minval = 1,
     maxval = 500,
     group = "Profile Precision Settings",
     tooltip = "Number of rows when Rows Layout is Number of Rows; otherwise ticks in each row.")
float valueAreaPct = input.float(
     70.0,
     title = "Value Area Volume (%)",
     minval = 1.0,
     maxval = 100.0,
     step = 1.0,
     group = "Profile Precision Settings")
float supportNodeMinPct = input.float(
     50.0,
     title = "Below-VAL Support Minimum (% of POC Row)",
     minval = 1.0,
     maxval = 100.0,
     step = 5.0,
     group = "Profile Precision Settings",
     tooltip = "Draws support only when the strongest local volume peak below VAL reaches this percentage of the POC row's volume.")
int profileWidthPct = input.int(
     30,
     title = "Profile Width (% of Range)",
     minval = 5,
     maxval = 100,
     group = "Profile Style")
string profilePlacement = input.string(
     "Left",
     title = "Profile Placement",
     options = ["Right", "Left"],
     group = "Profile Style")
string volumeDisplay = input.string(
     "Up/Down",
     title = "Volume Display",
     options = ["Up/Down", "Total"],
     group = "Profile Style")
bool showProfileBackground = input.bool(
     true,
     title = "Show Profile Background",
     group = "Profile Style")
bool showRangeBoundaries = input.bool(
     false,
     title = "Show Range Boundaries",
     group = "Profile Style")
bool extendLevelsRight = input.bool(
     false,
     title = "Extend VAH / POC / VAL Right",
     group = "Profile Style")
bool showBuyerZone = input.bool(
     true,
     title = "Show Top Two Buyer Zones",
     group = "Buyer Zone",
     tooltip = "Draws the two strongest distinct estimated bullish-volume price areas across the entire selected range, provided buyers / sellers is at least 1.0.")
float buyerZoneNeighborPct = input.float(
     90.0,
     title = "Adjacent Row Minimum (% of Buyer Peak)",
     minval = 1.0,
     maxval = 100.0,
     step = 5.0,
     group = "Buyer Zone",
     tooltip = "Includes adjacent price rows in each zone while their bullish volume remains at least this percentage of that zone's peak row.")
bool showBuyerZoneVolumes = input.bool(
     true,
     title = "Show Buyer x Seller Volume",
     group = "Buyer Zone",
     tooltip = "Shows a black label at the histogram's left edge with estimated up-volume x down-volume and their relative ratio. The higher-ratio zone is highlighted.")
bool showSellerZone = input.bool(
     true,
     title = "Show Top Two Seller Zones",
     group = "Seller Zone",
     tooltip = "Draws the two strongest distinct estimated bearish-volume price areas across the entire selected range, provided sellers / buyers is at least 1.0.")
float sellerZoneNeighborPct = input.float(
     90.0,
     title = "Adjacent Row Minimum (% of Seller Peak)",
     minval = 1.0,
     maxval = 100.0,
     step = 5.0,
     group = "Seller Zone",
     tooltip = "Includes adjacent price rows in each zone while their bearish volume remains at least this percentage of that zone's peak row.")
bool showSellerZoneVolumes = input.bool(
     true,
     title = "Show Seller x Buyer Volume",
     group = "Seller Zone",
     tooltip = "Shows a black histogram label with estimated down-volume x up-volume and their relative ratio. The higher-ratio seller zone is highlighted.")
bool showLocalBuyerDominance = input.bool(
     true,
     title = "Mark Local Buyer-Dominance Rows",
     group = "Local Buyer Dominance",
     tooltip = "Marks a row when its buyer volume is strictly greater than both adjacent rows, its seller volume is strictly lower than both adjacent rows, and buyers / sellers is at least 1.0.")

color upVolumeColor = input.color(
     color.rgb(38, 166, 154),
     title = "Up Volume",
     group = "Profile Colors")
color downVolumeColor = input.color(
     color.rgb(239, 83, 80),
     title = "Down Volume",
     group = "Profile Colors")
