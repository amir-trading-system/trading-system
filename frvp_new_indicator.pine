//@version=6
indicator(
     "Support to Resistance - Strong Reclaim",
     shorttitle = "S/R Strong Reclaim",
     overlay = true,
     max_bars_back = 500,
     max_lines_count = 300,
     max_labels_count = 100)

// =============================================================================
// PATTERN DEFINITION AND DEFAULTS
// =============================================================================
// 1. An uptrend forms a compact support shelf that is not sliding lower.
// 2. Price closes below the shelf.
// 3. The former support rejects price from below in separate clusters.
// 4. A high-volume bullish bar closes above the highest rejection.
// 5. When several levels break together, the highest resistance is selected.
// 6. Unresolved nearby or cumulatively strong resistance cannot remain above.
// 7. The reclaim must occur inside a controlled, non-exhausted price expansion.
// 8. A mature resistance with many separated rejections can use a slower
//    breakout path without weakening the primary explosive-reclaim rules.

string scanSession = input.session(
     "0400-2000",
     title = "Detection Session",
     group = "Pattern Detection",
     display = display.data_window,
     tooltip = "The pattern can form during premarket, regular hours, or postmarket. Candidates reset when a new exchange date begins.")
