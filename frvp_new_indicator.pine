bool showDevelopingResistance = input.bool(
     true,
     title = "Show Developing Resistance",
     group = "Style",
     display = display.data_window)
int maximumSavedSignals = input.int(
     100,
     title = "Maximum Saved Resistance Lines",
     minval = 1,
     maxval = 200,
     group = "Style",
     display = display.data_window)
color resistanceColor = input.color(
     color.rgb(244, 67, 54),
     title = "Resistance Line",
     group = "Style",
     display = display.data_window)
color entryColor = input.color(
     color.rgb(76, 175, 80),
     title = "Entry Marker",
     group = "Style",
     display = display.data_window)

type PatternCandidate
    int breakBar
    float shelfLow
    float shelfHigh
    float shelfVolume
    float shelfSlopePctPerBar
    bool primaryShelfEligible
    int rejectionBars
    int rejectionClusters
    bool previousWasRejection
    float resistance
    int firstResistanceBar
    float setupVolume
    int setupBars
    float rejectionVolume
    int rejectionVolumeBars
    float maximumCloseAfterBreak
    line resistanceLine

type PivotFlipCandidate
    int breakBar
    float support
    float priorAdvancePct
    int rejectionBars
    int consecutiveRejections
    int maximumConsecutiveRejections
    float resistance
    int firstResistanceBar
    float setupVolume
    int setupBars
    float rejectionVolume
    int rejectionVolumeBars
    line resistanceLine

var array<PatternCandidate> candidates = array.new<PatternCandidate>()
var array<PivotFlipCandidate> pivotCandidates = array.new<PivotFlipCandidate>()
var array<line> savedResistanceLines = array.new<line>()
var array<float> shelfLowBuffer = array.new<float>()
var float previousHighOfDay = na
var int lastSignalBar = na
var float lastSignalResistance = na

int dateKey = year * 10000 + month * 100 + dayofmonth
bool newDate = na(dateKey[1]) or dateKey != dateKey[1]
bool inDetectionSession = not na(time(timeframe.period, scanSession))

if newDate
    while array.size(candidates) > 0
        PatternCandidate expiredCandidate = array.pop(candidates)
        if not na(expiredCandidate.resistanceLine)
            line.delete(expiredCandidate.resistanceLine)
    while array.size(pivotCandidates) > 0
        PivotFlipCandidate expiredPivot = array.pop(pivotCandidates)
        if not na(expiredPivot.resistanceLine)
            line.delete(expiredPivot.resistanceLine)
    previousHighOfDay := na

float highOfDayBeforeCurrentBar = previousHighOfDay
float recentStructureHigh = na
for structureOffset = 1 to maximumSetupBars
    if not na(high[structureOffset]) and
         inDetectionSession[structureOffset] and
         dateKey[structureOffset] == dateKey
        recentStructureHigh :=
             na(recentStructureHigh) ?
             high[structureOffset] :
             math.max(
                  recentStructureHigh,
                  high[structureOffset])
float recentAverageVolume =
     ta.sma(volume, recentVolumeLookbackBars)[1]
float entryMomentumPct =
     not na(close[entryMomentumLookbackBars]) ?
     (close /
          math.max(
               close[entryMomentumLookbackBars],
               syminfo.mintick) - 1.0) * 100.0 : na
float entryCandleRangePct =
     (high - low) /
          math.max(close, syminfo.mintick) * 100.0
float entryCandleBodyPct =
     (close - open) /
          math.max(close, syminfo.mintick) * 100.0
float previousHighGapPct =
     not na(recentStructureHigh) ?
     (recentStructureHigh /
          math.max(close, syminfo.mintick) - 1.0) * 100.0 : 0.0

bool entrySignal = false
float signaledResistance = na
float signaledTarget = na
int bestBreakBar = na
float bestScore = na
float bestResistance = na
bool bestMatureReclaim = false
int bestPivotBreakBar = na
float bestPivotScore = na
float bestPivotResistance = na

// =============================================================================
// UPDATE EVERY ACTIVE SUPPORT-BREAK CANDIDATE
// =============================================================================
if inDetectionSession
    int candidateIndex = array.size(candidates) - 1
    while candidateIndex >= 0
        PatternCandidate candidate = array.get(candidates, candidateIndex)
        int elapsedBars = bar_index - candidate.breakBar

        if elapsedBars > maximumSetupBars
            if not na(candidate.resistanceLine)
                line.delete(candidate.resistanceLine)
            array.remove(candidates, candidateIndex)
        else
            candidate.maximumCloseAfterBreak :=
                 na(candidate.maximumCloseAfterBreak) ?
                 close : math.max(candidate.maximumCloseAfterBreak, close)

            bool rejectionNow =
                 high >= candidate.shelfLow and
                 close <= candidate.shelfHigh

            if rejectionNow
                candidate.rejectionBars += 1
                candidate.rejectionVolume += nz(volume, 0.0)
                candidate.rejectionVolumeBars += 1
                if not candidate.previousWasRejection
                    candidate.rejectionClusters += 1
                candidate.resistance :=
                     na(candidate.resistance) ?
                     high : math.max(candidate.resistance, high)
                if na(candidate.firstResistanceBar)
                    candidate.firstResistanceBar := bar_index

                if showDevelopingResistance
                    if na(candidate.resistanceLine)
                        candidate.resistanceLine := line.new(
                             candidate.firstResistanceBar,
                             candidate.resistance,
                             bar_index,
                             candidate.resistance,
                             xloc = xloc.bar_index,
                             extend = extend.none,
                             color = resistanceColor,
                             width = 2)
                    else
                        line.set_xy1(
                             candidate.resistanceLine,
                             candidate.firstResistanceBar,
                             candidate.resistance)
                        line.set_xy2(
                             candidate.resistanceLine,
                             bar_index,
                             candidate.resistance)
            else if not na(candidate.resistanceLine)
                line.set_x2(candidate.resistanceLine, bar_index)

            candidate.previousWasRejection := rejectionNow

            float setupAverageVolume =
                 candidate.setupBars > 0 ?
                 candidate.setupVolume / candidate.setupBars : na
            float rejectionAverageVolume =
                 candidate.rejectionVolumeBars > 0 ?
                 candidate.rejectionVolume /
                      candidate.rejectionVolumeBars : na
            float candleRange = math.max(high - low, syminfo.mintick)
            float closeLocation =
                 (close - low) / candleRange * 100.0
            float closeAboveResistancePct =
                 not na(candidate.resistance) ?
                 (close / candidate.resistance - 1.0) * 100.0 : na

            bool enoughHistory = candidate.setupBars >= 3
            bool clusterConfirmed =
                 candidate.rejectionClusters >=
                      minimumResistanceClusters
            bool decisiveBreak =
                 not na(candidate.resistance) and
                 close > candidate.resistance and
                 not na(closeAboveResistancePct) and
                 closeAboveResistancePct >=
                      minimumCloseAboveResistancePct
            bool setupVolumeConfirmed =
                 enoughHistory and
                 not na(setupAverageVolume) and
                 nz(volume, 0.0) >=
                      setupAverageVolume *
                      minimumVolumeVsSetupAverage
            bool rejectionVolumeConfirmed =
                 not na(rejectionAverageVolume) and
                 nz(volume, 0.0) >=
                      rejectionAverageVolume *
                      minimumVolumeVsRejectionAverage
            bool recentVolumeConfirmed =
                 not na(recentAverageVolume) and
                 nz(volume, 0.0) >=
                      recentAverageVolume *
                      minimumVolumeVsRecentAverage
            bool previousBarVolumeConfirmed =
                 not na(volume[1]) and
                 volume[1] > 0.0 and
                 nz(volume, 0.0) >=
                      volume[1] *
                      minimumVolumeVsPreviousBar
            bool candleConfirmed =
                 close > open and
                 closeLocation >= minimumCloseLocationPct
            bool standardMatureVolumeAcceleration =
                 not na(recentAverageVolume) and
                 nz(volume, 0.0) >=
                      recentAverageVolume *
                      minimumMatureVolumeVsRecentAverage and
                 nz(volume, 0.0) <=
                      recentAverageVolume *
                      maximumMatureVolumeVsRecentAverage and
                 not na(volume[1]) and
                 volume[1] > 0.0 and
                 nz(volume, 0.0) >=
                      volume[1] *
                      minimumMatureVolumeVsPreviousBar
            bool burstMatureVolumeAcceleration =
                 not na(recentAverageVolume) and
                 nz(volume, 0.0) >
                      recentAverageVolume *
                      maximumMatureVolumeVsRecentAverage and
                 nz(volume, 0.0) <=
                      recentAverageVolume *
                      maximumMatureBurstVolumeVsRecentAverage and
                 not na(volume[1]) and
                 volume[1] > 0.0 and
                 nz(volume, 0.0) >=
                      volume[1] *
                      minimumMatureBurstVolumeVsPreviousBar

            bool primaryCandidateQualified =
                 barstate.isconfirmed and
                 candidate.primaryShelfEligible and
                 clusterConfirmed and
                 decisiveBreak and
                 setupVolumeConfirmed and
                 rejectionVolumeConfirmed and
                 recentVolumeConfirmed and
                 previousBarVolumeConfirmed and
                 candleConfirmed
            bool matureCandidateQualified =
                 barstate.isconfirmed and
                 not candidate.primaryShelfEligible and
                 candidate.setupBars >= minimumMatureSetupBars and
                 candidate.rejectionClusters >=
                      minimumMatureResistanceClusters and
                 decisiveBreak and
                 not na(setupAverageVolume) and
                 nz(volume, 0.0) >=
                      setupAverageVolume *
                      minimumMatureVolumeVsSetupAverage and
                 nz(volume, 0.0) <=
                      setupAverageVolume *
                      maximumMatureVolumeVsSetupAverage and
                 rejectionVolumeConfirmed and
                 (standardMatureVolumeAcceleration or
                      burstMatureVolumeAcceleration) and
                 candleConfirmed and
                 entryCandleRangePct >=
                      minimumMatureEntryRangePct and
                 entryCandleRangePct <= maximumEntryRangePct and
                 entryCandleBodyPct >=
                      minimumMatureEntryBodyPct and
                 previousHighGapPct <=
                      maximumMatureRecentHighGapPct
            bool candidateQualified =
                 primaryCandidateQualified or
                 matureCandidateQualified

            if candidateQualified
                float score =
                     candidate.resistance /
                          math.max(close, syminfo.mintick) * 1000000.0 +
                     candidate.rejectionClusters * 1000.0 +
                     candidate.rejectionBars * 10.0 +
                     nz(volume, 0.0) /
                          math.max(setupAverageVolume, 1.0)
                if na(bestScore) or score > bestScore
                    bestScore := score
                    bestBreakBar := candidate.breakBar
                    bestResistance := candidate.resistance
                    bestMatureReclaim := matureCandidateQualified

            candidate.setupVolume += nz(volume, 0.0)
            candidate.setupBars += 1
            array.set(candidates, candidateIndex, candidate)

        candidateIndex -= 1

// =============================================================================
// UPDATE SINGLE-PIVOT SUPPORT FLIPS
// =============================================================================
if inDetectionSession and enablePivotSupportReclaims
    int pivotIndex = array.size(pivotCandidates) - 1
    while pivotIndex >= 0
        PivotFlipCandidate pivotCandidate =
             array.get(pivotCandidates, pivotIndex)
        int pivotElapsedBars =
             bar_index - pivotCandidate.breakBar

        if pivotElapsedBars > maximumPivotSetupBars
            if not na(pivotCandidate.resistanceLine)
                line.delete(pivotCandidate.resistanceLine)
            array.remove(pivotCandidates, pivotIndex)
        else
            bool pivotRejectionNow =
                 high >= pivotCandidate.support and
                 close <= pivotCandidate.support

            if pivotRejectionNow
                pivotCandidate.rejectionBars += 1
                pivotCandidate.consecutiveRejections += 1
                pivotCandidate.maximumConsecutiveRejections :=
                     math.max(
                          pivotCandidate.maximumConsecutiveRejections,
                          pivotCandidate.consecutiveRejections)
                pivotCandidate.rejectionVolume +=
                     nz(volume, 0.0)
                pivotCandidate.rejectionVolumeBars += 1
                pivotCandidate.resistance :=
                     na(pivotCandidate.resistance) ?
                     high : math.max(
                          pivotCandidate.resistance,
                          high)
                if na(pivotCandidate.firstResistanceBar)
                    pivotCandidate.firstResistanceBar :=
                         bar_index

                if showDevelopingResistance
                    if na(pivotCandidate.resistanceLine)
                        pivotCandidate.resistanceLine := line.new(
                             pivotCandidate.firstResistanceBar,
                             pivotCandidate.resistance,
                             bar_index,
                             pivotCandidate.resistance,
                             xloc = xloc.bar_index,
                             extend = extend.none,
                             color = resistanceColor,
                             width = 2)
                    else
                        line.set_xy1(
                             pivotCandidate.resistanceLine,
                             pivotCandidate.firstResistanceBar,
                             pivotCandidate.resistance)
                        line.set_xy2(
                             pivotCandidate.resistanceLine,
                             bar_index,
                             pivotCandidate.resistance)
            else
                pivotCandidate.consecutiveRejections := 0
                if not na(pivotCandidate.resistanceLine)
                    line.set_x2(
                         pivotCandidate.resistanceLine,
                         bar_index)

            float pivotSetupAverageVolume =
                 pivotCandidate.setupBars > 0 ?
                 pivotCandidate.setupVolume /
                      pivotCandidate.setupBars : na
            float pivotRejectionAverageVolume =
                 pivotCandidate.rejectionVolumeBars > 0 ?
                 pivotCandidate.rejectionVolume /
                      pivotCandidate.rejectionVolumeBars : na
            float pivotCandleRange =
                 math.max(high - low, syminfo.mintick)
            float pivotCloseLocation =
                 (close - low) / pivotCandleRange * 100.0
            float pivotBreakoutExtensionPct =
                 not na(pivotCandidate.resistance) ?
                 (close / pivotCandidate.resistance - 1.0) *
                      100.0 : na

            bool pivotCandidateQualified =
                 barstate.isconfirmed and
                 pivotCandidate.setupBars >=
                      minimumPivotConsecutiveResistanceBars and
                 pivotCandidate.maximumConsecutiveRejections >=
                      minimumPivotConsecutiveResistanceBars and
                 not na(pivotCandidate.resistance) and
                 close > pivotCandidate.resistance and
                 not na(pivotBreakoutExtensionPct) and
                 pivotBreakoutExtensionPct > 0.0 and
                 pivotBreakoutExtensionPct <=
                      maximumPivotBreakoutExtensionPct and
                 not na(pivotSetupAverageVolume) and
                 nz(volume, 0.0) >=
                      pivotSetupAverageVolume *
                      minimumPivotVolumeVsSetupAverage and
                 not na(pivotRejectionAverageVolume) and
                 nz(volume, 0.0) >=
                      pivotRejectionAverageVolume *
                      minimumPivotVolumeVsRejectionAverage and
                 not na(recentAverageVolume) and
                 nz(volume, 0.0) >=
                      recentAverageVolume *
                      minimumPivotVolumeVsRecentAverage and
                 not na(volume[1]) and
                 volume[1] > 0.0 and
                 nz(volume, 0.0) >=
                      volume[1] *
                      minimumPivotVolumeVsPreviousBar and
                 close > open and
                 pivotCloseLocation >=
                      minimumPivotCloseLocationPct and
                 not na(entryMomentumPct) and
                 entryMomentumPct >=
                      minimumPivotEntryMomentumPct and
                 entryCandleRangePct >=
                      minimumPivotEntryRangePct and
                 entryCandleRangePct <=
                      maximumPivotEntryRangePct and
                 entryCandleBodyPct >=
                      minimumPivotEntryBodyPct and
                 entryCandleBodyPct <=
                      maximumPivotEntryBodyPct

            if pivotCandidateQualified
                float pivotScore =
                     pivotCandidate.resistance /
                          math.max(close, syminfo.mintick) *
                          1000000.0 +
                     pivotCandidate.maximumConsecutiveRejections *
                          1000.0 +
                     pivotCandidate.rejectionBars * 10.0 +
                     nz(volume, 0.0) /
                          math.max(
                               pivotSetupAverageVolume,
                               1.0)
                if na(bestPivotScore) or
                     pivotScore > bestPivotScore
                    bestPivotScore := pivotScore
                    bestPivotBreakBar :=
                         pivotCandidate.breakBar
                    bestPivotResistance :=
                         pivotCandidate.resistance

            pivotCandidate.setupVolume += nz(volume, 0.0)
            pivotCandidate.setupBars += 1
            array.set(
                 pivotCandidates,
                 pivotIndex,
                 pivotCandidate)

        pivotIndex -= 1

// =============================================================================
// EMIT ONE SIGNAL FOR THE BEST QUALIFYING CANDIDATE ON THIS BAR
// =============================================================================
if not na(bestBreakBar)
    bool duplicateSignal =
         not na(lastSignalBar) and
         not na(lastSignalResistance) and
         bar_index - lastSignalBar <= duplicateCooldownBars and
         math.abs(
              bestResistance / lastSignalResistance - 1.0) * 100.0 <=
              duplicateLevelTolerancePct

    int chosenIndex = na
    int searchIndex = array.size(candidates) - 1
    while searchIndex >= 0
        PatternCandidate candidate = array.get(candidates, searchIndex)
        if candidate.breakBar == bestBreakBar
            chosenIndex := searchIndex
        searchIndex -= 1

    bool overheadResistanceBlocked = false
    int unresolvedOverheadLevels = 0
    int nearbyOverheadLevels = 0
    float cumulativeOverheadEvidence = 0.0
    float strongestOverheadEvidence = 0.0
    float chosenEvidenceVolume = na
    if not na(chosenIndex)
        PatternCandidate chosenForEvidence =
             array.get(candidates, chosenIndex)
        chosenEvidenceVolume :=
             chosenForEvidence.shelfVolume +
             chosenForEvidence.rejectionVolume
        int overheadIndex = array.size(candidates) - 1
        while overheadIndex >= 0
            PatternCandidate overheadCandidate =
                 array.get(candidates, overheadIndex)
            bool differentCandidate =
                 overheadCandidate.breakBar != bestBreakBar
            bool confirmedOverheadResistance =
                 overheadCandidate.rejectionClusters >=
                      minimumOverheadResistanceClusters and
                 not na(overheadCandidate.resistance)
            float overheadDistancePct =
                 confirmedOverheadResistance ?
                 (overheadCandidate.resistance /
                      math.max(close, syminfo.mintick) - 1.0) *
                      100.0 : na
            bool unresolvedOverheadResistance =
                 confirmedOverheadResistance and
                 not na(overheadCandidate.maximumCloseAfterBreak) and
                 overheadCandidate.maximumCloseAfterBreak <=
                      overheadCandidate.resistance
            float overheadEvidenceVolume =
                 overheadCandidate.shelfVolume +
                 overheadCandidate.rejectionVolume
            if differentCandidate and
                 confirmedOverheadResistance and
                 unresolvedOverheadResistance and
                 not na(overheadDistancePct) and
                 overheadDistancePct > 0.0 and
                 overheadDistancePct <=
                      maximumOverheadResistanceDistancePct
                unresolvedOverheadLevels += 1
                cumulativeOverheadEvidence +=
                     overheadEvidenceVolume
                strongestOverheadEvidence :=
                     math.max(
                          strongestOverheadEvidence,
                          overheadEvidenceVolume)
                if overheadDistancePct <=
                     maximumNearbyOverheadDistancePct
                    nearbyOverheadLevels += 1
            overheadIndex -= 1

        bool nearbyOverheadBlocked =
             nearbyOverheadLevels > 0
        bool strongestOverheadBlocked =
             strongestOverheadEvidence >=
                  chosenEvidenceVolume *
                  minimumOverheadEvidenceRatio
        bool cumulativeOverheadBlocked =
             unresolvedOverheadLevels >=
                  minimumStackedOverheadLevels and
             cumulativeOverheadEvidence >=
                  chosenEvidenceVolume *
                  minimumOverheadEvidenceRatio
        overheadResistanceBlocked :=
             nearbyOverheadBlocked or
             strongestOverheadBlocked or
             cumulativeOverheadBlocked

    bool previousHighGapConfirmed =
         previousHighGapPct <= maximumPreviousHighGapPct
    bool controlledMomentumPath =
         not na(entryMomentumPct) and
         entryMomentumPct >= minimumEntryMomentumPct and
         entryMomentumPct <= maximumEntryMomentumPct and
         entryCandleRangePct >= minimumEntryRangePct and
         entryCandleRangePct <= maximumEntryRangePct
    bool clearSpaceImpulsePath =
         unresolvedOverheadLevels == 0 and
         previousHighGapPct <= maximumClearSpaceHighGapPct and
         entryCandleRangePct >= minimumEntryRangePct and
         entryCandleRangePct <= maximumEntryRangePct and
         entryCandleBodyPct >= minimumClearSpaceBodyPct and
         entryCandleBodyPct <= maximumClearSpaceBodyPct
    bool immediateFollowThroughQuality =
         previousHighGapConfirmed and
         (controlledMomentumPath or
              clearSpaceImpulsePath or
              bestMatureReclaim)

    if not duplicateSignal and
         not overheadResistanceBlocked and
         immediateFollowThroughQuality and
         not na(chosenIndex)
        PatternCandidate chosen = array.get(candidates, chosenIndex)
        entrySignal := true
        signaledResistance := chosen.resistance
        signaledTarget :=
             close < highOfDayBeforeCurrentBar ?
             highOfDayBeforeCurrentBar : close * 1.05
        lastSignalBar := bar_index
        lastSignalResistance := chosen.resistance

        if showDevelopingResistance
            if na(chosen.resistanceLine)
                int chosenLineStartBar =
                     na(chosen.firstResistanceBar) ?
                     chosen.breakBar : chosen.firstResistanceBar
                chosen.resistanceLine := line.new(
                     chosenLineStartBar,
                     chosen.resistance,
                     bar_index,
                     chosen.resistance,
                     xloc = xloc.bar_index,
                     extend = extend.none,
                     color = resistanceColor,
                     width = 2)
            else
                line.set_xy2(
                     chosen.resistanceLine,
                     bar_index,
                     chosen.resistance)
            array.push(savedResistanceLines, chosen.resistanceLine)

            while array.size(savedResistanceLines) > maximumSavedSignals
                line oldestLine = array.shift(savedResistanceLines)
                line.delete(oldestLine)

    // Remove the resolved candidate and nearby duplicates, whether this bar
    // emitted a signal or was suppressed by cooldown/overhead resistance.
    int cleanupIndex = array.size(candidates) - 1
    while cleanupIndex >= 0
        PatternCandidate candidate = array.get(candidates, cleanupIndex)
        bool sameCandidate = candidate.breakBar == bestBreakBar
        bool sameLevel =
             not na(candidate.resistance) and
             math.abs(
                  candidate.resistance / bestResistance - 1.0) * 100.0 <=
                  duplicateLevelTolerancePct
        if sameCandidate or sameLevel
            bool keepChosenLine =
                 entrySignal and
                 sameCandidate and
                 not na(candidate.resistanceLine)
            if not keepChosenLine and not na(candidate.resistanceLine)
                line.delete(candidate.resistanceLine)
            array.remove(candidates, cleanupIndex)
        cleanupIndex -= 1

// A pivot reclaim is intentionally emitted through a separate path. It does
// not weaken the compact-shelf rules used by the primary and mature setups.
if not na(bestPivotBreakBar)
    bool pivotDuplicateSignal =
         not na(lastSignalBar) and
         not na(lastSignalResistance) and
         bar_index - lastSignalBar <= duplicateCooldownBars and
         math.abs(
              bestPivotResistance /
                   lastSignalResistance - 1.0) * 100.0 <=
              duplicateLevelTolerancePct

    int chosenPivotIndex = na
    int pivotSearchIndex = array.size(pivotCandidates) - 1
    while pivotSearchIndex >= 0
        PivotFlipCandidate pivotCandidate =
             array.get(
                  pivotCandidates,
                  pivotSearchIndex)
        if pivotCandidate.breakBar == bestPivotBreakBar
            chosenPivotIndex := pivotSearchIndex
        pivotSearchIndex -= 1

    if not entrySignal and
         not pivotDuplicateSignal and
         not na(chosenPivotIndex)
        PivotFlipCandidate chosenPivot =
             array.get(
                  pivotCandidates,
                  chosenPivotIndex)
        entrySignal := true
        signaledResistance := chosenPivot.resistance
        signaledTarget :=
             close < highOfDayBeforeCurrentBar ?
             highOfDayBeforeCurrentBar : close * 1.05
        lastSignalBar := bar_index
        lastSignalResistance := chosenPivot.resistance

        if showDevelopingResistance
            if na(chosenPivot.resistanceLine)
                int pivotLineStartBar =
                     na(chosenPivot.firstResistanceBar) ?
                     chosenPivot.breakBar :
                     chosenPivot.firstResistanceBar
                chosenPivot.resistanceLine := line.new(
                     pivotLineStartBar,
                     chosenPivot.resistance,
                     bar_index,
                     chosenPivot.resistance,
                     xloc = xloc.bar_index,
                     extend = extend.none,
                     color = resistanceColor,
                     width = 2)
            else
                line.set_xy2(
                     chosenPivot.resistanceLine,
                     bar_index,
                     chosenPivot.resistance)
            array.push(
                 savedResistanceLines,
                 chosenPivot.resistanceLine)

            while array.size(savedResistanceLines) >
                 maximumSavedSignals
                line oldestPivotLine =
                     array.shift(savedResistanceLines)
                line.delete(oldestPivotLine)

    int pivotCleanupIndex = array.size(pivotCandidates) - 1
    while pivotCleanupIndex >= 0
        PivotFlipCandidate pivotCandidate =
             array.get(
                  pivotCandidates,
                  pivotCleanupIndex)
        bool samePivotCandidate =
             pivotCandidate.breakBar == bestPivotBreakBar
        bool samePivotLevel =
             not na(pivotCandidate.resistance) and
             math.abs(
                  pivotCandidate.resistance /
                       bestPivotResistance - 1.0) * 100.0 <=
                  duplicateLevelTolerancePct
        if samePivotCandidate or samePivotLevel
            bool keepPivotLine =
                 entrySignal and
                 samePivotCandidate and
                 not na(pivotCandidate.resistanceLine)
            if not keepPivotLine and
                 not na(pivotCandidate.resistanceLine)
                line.delete(pivotCandidate.resistanceLine)
            array.remove(
                 pivotCandidates,
                 pivotCleanupIndex)
        pivotCleanupIndex -= 1

// =============================================================================
// CREATE A NEW CANDIDATE WHEN A COMPACT SUPPORT SHELF BREAKS
// =============================================================================
bool enoughShelfHistory =
     bar_index >= supportShelfBars and
     dateKey[supportShelfBars] == dateKey and
     inDetectionSession[supportShelfBars]

if inDetectionSession and enoughShelfHistory
    array.clear(shelfLowBuffer)
    int validSessionBars = 0
    float shelfVolume = 0.0
    float shelfMeanLow = 0.0
    for offset = 1 to supportShelfBars
        array.push(shelfLowBuffer, low[offset])
        shelfVolume += nz(volume[offset], 0.0)
        shelfMeanLow += low[offset] / supportShelfBars
        if inDetectionSession[offset] and dateKey[offset] == dateKey
            validSessionBars += 1

    if validSessionBars == supportShelfBars
        array.sort(shelfLowBuffer, order.ascending)
        float shelfLow = array.get(shelfLowBuffer, 0)
        float shelfHigh =
             array.get(shelfLowBuffer, supportShelfBars - 2)
        int lowsInsideShelf = 0
        int closesHoldingShelf = 0
        for offset = 1 to supportShelfBars
            if low[offset] >= shelfLow and low[offset] <= shelfHigh
                lowsInsideShelf += 1
            if close[offset] >= shelfLow
                closesHoldingShelf += 1

        float shelfXMean =
             (supportShelfBars - 1.0) / 2.0
        float shelfSlopeNumerator = 0.0
        float shelfSlopeDenominator = 0.0
        for shelfPosition = 0 to supportShelfBars - 1
            int chronologicalOffset =
                 supportShelfBars - shelfPosition
            float shelfXDistance =
                 shelfPosition - shelfXMean
            shelfSlopeNumerator +=
                 shelfXDistance *
                 (low[chronologicalOffset] - shelfMeanLow)
            shelfSlopeDenominator +=
                 shelfXDistance * shelfXDistance
        float rawShelfSlope =
             shelfSlopeDenominator > 0.0 ?
             shelfSlopeNumerator / shelfSlopeDenominator : 0.0
        float shelfSlopePctPerBar =
             rawShelfSlope /
             math.max(shelfMeanLow, syminfo.mintick) * 100.0

        float priorTrendLow = na
        int validPriorTrendBars = 0
        for trendOffset = supportShelfBars + 1 to supportShelfBars + priorAdvanceLookbackBars
            if not na(low[trendOffset]) and
                 inDetectionSession[trendOffset] and
                 dateKey[trendOffset] == dateKey
                priorTrendLow :=
                     na(priorTrendLow) ?
                     low[trendOffset] :
                     math.min(priorTrendLow, low[trendOffset])
                validPriorTrendBars += 1
        float priorAdvancePct =
             not na(priorTrendLow) ?
             (shelfLow /
                  math.max(priorTrendLow, syminfo.mintick) - 1.0) *
                  100.0 : na
        bool formedAfterUptrend =
             validPriorTrendBars >= minimumPriorTrendBars and
             not na(priorAdvancePct) and
             priorAdvancePct >= minimumPriorAdvancePct

        float shelfWidthPct =
             (shelfHigh - shelfLow) /
                  math.max(close, syminfo.mintick) * 100.0
        bool shelfStructureConfirmed =
             lowsInsideShelf >= supportShelfBars - 1 and
             closesHoldingShelf >= supportShelfBars - 1 and
             shelfWidthPct <= maximumShelfWidthPct
        bool primaryCompactShelf =
             shelfStructureConfirmed and
             shelfSlopePctPerBar >=
                  -maximumShelfDownSlopePctPerBar
        bool matureCompactShelf =
             shelfStructureConfirmed and
             shelfSlopePctPerBar >=
                  -maximumMatureShelfDownSlopePctPerBar
        bool closedBelowSupport = close < shelfLow

        if matureCompactShelf and
             formedAfterUptrend and
             closedBelowSupport and
             barstate.isconfirmed
            while array.size(candidates) >= maximumActiveCandidates
                PatternCandidate oldestCandidate = array.shift(candidates)
                if not na(oldestCandidate.resistanceLine)
                    line.delete(oldestCandidate.resistanceLine)

            PatternCandidate newCandidate = PatternCandidate.new(
                 bar_index,
                 shelfLow,
                 shelfHigh,
                 shelfVolume,
                 shelfSlopePctPerBar,
                 primaryCompactShelf,
                 0,
                 0,
                 false,
                 na,
                 na,
                 0.0,
                 0,
                 0.0,
                 0,
                 na,
                 na)
            array.push(candidates, newCandidate)

// A strong one-bar pivot can also establish genuine support. This path is
// deliberately strict: the pivot must follow a large advance, fail on the
// next bar, produce a consecutive resistance sequence, and later be reclaimed
// by exceptional participation. The ELPW 12:13-12:19 sequence is the model.
bool enoughPivotHistory =
     bar_index >= pivotPriorAdvanceLookbackBars + 1 and
     dateKey[pivotPriorAdvanceLookbackBars + 1] == dateKey and
     inDetectionSession[pivotPriorAdvanceLookbackBars + 1]

if enablePivotSupportReclaims and
     inDetectionSession and
     enoughPivotHistory
    float priorPivotTrendLow = na
    int validPriorPivotBars = 0
    for pivotOffset = 2 to pivotPriorAdvanceLookbackBars + 1
        if not na(low[pivotOffset]) and
             inDetectionSession[pivotOffset] and
             dateKey[pivotOffset] == dateKey
            priorPivotTrendLow :=
                 na(priorPivotTrendLow) ?
                 low[pivotOffset] :
                 math.min(
                      priorPivotTrendLow,
                      low[pivotOffset])
            validPriorPivotBars += 1

    float pivotPriorAdvancePct =
         not na(priorPivotTrendLow) ?
         (low[1] /
              math.max(
                   priorPivotTrendLow,
                   syminfo.mintick) - 1.0) * 100.0 : na
    bool strongPivotSupportBar =
         close[1] > open[1] and
         high[1] > high[2] and
         low[1] > low[2]
    bool closedBelowPivotSupport =
         close < low[1]
    bool pivotFormedAfterAdvance =
         validPriorPivotBars ==
              pivotPriorAdvanceLookbackBars and
         not na(pivotPriorAdvancePct) and
         pivotPriorAdvancePct >=
              minimumPivotPriorAdvancePct

    if strongPivotSupportBar and
         closedBelowPivotSupport and
         pivotFormedAfterAdvance and
         barstate.isconfirmed
        while array.size(pivotCandidates) >=
             maximumActiveCandidates
            PivotFlipCandidate oldestPivot =
                 array.shift(pivotCandidates)
            if not na(oldestPivot.resistanceLine)
                line.delete(oldestPivot.resistanceLine)

        PivotFlipCandidate newPivotCandidate =
             PivotFlipCandidate.new(
                  bar_index,
                  low[1],
                  pivotPriorAdvancePct,
                  0,
                  0,
                  0,
                  na,
                  na,
                  0.0,
                  0,
                  0.0,
                  0,
                  na)
        array.push(
             pivotCandidates,
             newPivotCandidate)

if inDetectionSession
    previousHighOfDay :=
         na(previousHighOfDay) ?
         high : math.max(previousHighOfDay, high)

plotshape(
     entrySignal,
     title = "Strong Reclaim Entry",
     style = shape.labelup,
     location = location.belowbar,
     color = entryColor,
     text = "ENTRY",
     textcolor = color.black,
     size = size.small)

plot(
     entrySignal ? signaledResistance : na,
     title = "Reclaimed Resistance",
     display = display.none)
plot(
     entrySignal ? signaledTarget : na,
     title = "Previous HOD / Continuation Target",
     display = display.none)

alertcondition(
     entrySignal,
     title = "Strong Support-to-Resistance Reclaim",
     message = "{{ticker}} strong reclaim entry at {{close}}. Reclaimed resistance: {{plot(\"Reclaimed Resistance\")}}. Target: {{plot(\"Previous HOD / Continuation Target\")}}.")
