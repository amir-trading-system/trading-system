     color.rgb(0, 188, 212),
     title = "Value Area Up",
     group = "Profile Colors")
color valueAreaDownColor = input.color(
     color.rgb(236, 64, 122),
     title = "Value Area Down",
     group = "Profile Colors")
color totalVolumeColor = input.color(
     color.rgb(96, 125, 139),
     title = "Total Volume",
     group = "Profile Colors")
color valueAreaTotalColor = input.color(
     color.rgb(41, 182, 246),
     title = "Value Area Total",
     group = "Profile Colors")
color profileBackgroundColor = input.color(
     color.new(color.rgb(33, 45, 62), 88),
     title = "Profile Background",
     group = "Profile Colors")
color supportLineColor = input.color(
     color.orange,
     title = "Potential Support Below VAL",
     group = "Profile Colors")
color buyerZoneColor = input.color(
     color.rgb(0, 188, 212),
     title = "Top Buyer Zones",
     group = "Profile Colors")
color sellerZoneColor = input.color(
     color.rgb(239, 83, 80),
     title = "Top Seller Zones",
     group = "Profile Colors")
color localBuyerDominanceColor = input.color(
     color.lime,
     title = "Local Buyer-Dominance Rows",
     group = "Profile Colors")

// A profile above the split threshold retains its calculated rows but renders
// in Total mode to stay within TradingView's drawing-object limit.
const int MAX_ROWS_PER_PROFILE = 240
const int MAX_SPLIT_ROWS = 120
const int PROFILE_META_SIZE = 11
const int META_VAH = 0
const int META_POC = 1
const int META_VAL = 2
const int META_BOTTOM = 3
const int META_TOP = 4
const int META_ROW_HEIGHT = 5
const int META_ROW_COUNT = 6
const int META_TOTAL_VOLUME = 7
const int META_POC_ROW = 8
const int META_VAL_ROW = 9
const int META_VAH_ROW = 10
const int REGION_VAL_TO_POC = 0
const int REGION_POC_TO_VAH = 1
const int REGION_BELOW_VAL = 2
const int REGION_ABOVE_VAH = 3

// =============================================================================
// 2. CAPTURE THE RANGE'S OHLCV BARS
// =============================================================================
// The previous version stored a candle's entire volume at its closing price.
// That creates a close-by-volume histogram, not a fixed-range volume profile.
// We retain each bar's high, low and volume so the calculation can allocate the
// bar's volume proportionally to every price row that the bar traversed.

var float[] rangeOpensA = array.new_float(0)
var float[] rangeHighsA = array.new_float(0)
var float[] rangeLowsA = array.new_float(0)
var float[] rangeClosesA = array.new_float(0)
var float[] rangeVolumesA = array.new_float(0)

var float totalVolA = 0.0

if barstate.isfirst
    array.clear(rangeOpensA)
    array.clear(rangeHighsA)
    array.clear(rangeLowsA)
    array.clear(rangeClosesA)
    array.clear(rangeVolumesA)
    totalVolA := 0.0

bool inRangeA = time >= startA and time <= endA
float currentVolume = nz(volume)

if inRangeA
    array.push(rangeOpensA, open)
    array.push(rangeHighsA, high)
    array.push(rangeLowsA, low)
    array.push(rangeClosesA, close)
    array.push(rangeVolumesA, currentVolume)
    totalVolA += currentVolume

// =============================================================================
// 3. PROFILE CALCULATION
// =============================================================================
f_ticksPerRow(int totalTicks, string layout, int requestedSize) =>
    int selectedTicks = math.max(1, requestedSize)

    if layout == "Number of Rows"
        int requestedRows = math.max(1, requestedSize)
        float rawTicks = float(totalTicks) / requestedRows
        int ticksDown = math.max(1, int(math.floor(rawTicks)))
        int ticksUp = math.max(1, int(math.ceil(rawTicks)))
        int rowsWithDown = int(math.ceil(float(totalTicks) / ticksDown))
        int rowsWithUp = int(math.ceil(float(totalTicks) / ticksUp))

        // TradingView chooses the whole-tick row height whose resulting row
        // count is closest to the requested number of rows.
        selectedTicks :=
             math.abs(rowsWithDown - requestedRows) <=
                  math.abs(rowsWithUp - requestedRows) ?
             ticksDown : ticksUp

    // Keep the histogram within the platform's drawing-object limit. This
    // only affects extremely fine Ticks Per Row selections.
    int calculatedRows = int(math.ceil(float(totalTicks) / selectedTicks))
    if calculatedRows > MAX_ROWS_PER_PROFILE
        selectedTicks :=
             int(math.ceil(float(totalTicks) / MAX_ROWS_PER_PROFILE))

    selectedTicks

f_calculateProfile(
     float[] opens,
     float[] highs,
     float[] lows,
     float[] closes,
     float[] volumes,
     string layout,
     int requestedSize,
     float targetPct) =>
    float[] result = array.new_float(0)
    int sourceBars = array.size(volumes)

    if sourceBars > 0
        float rawRangeLow = array.min(lows)
        float rawRangeHigh = array.max(highs)
        float profileBottom =
             math.floor(rawRangeLow / syminfo.mintick) * syminfo.mintick
        float profileTop =
             math.ceil(rawRangeHigh / syminfo.mintick) * syminfo.mintick
        int totalTicks = math.max(
             1,
             int(math.round(
                  (profileTop - profileBottom) / syminfo.mintick)))
        int ticksPerRow =
             f_ticksPerRow(totalTicks, layout, requestedSize)
        float rowHeight = ticksPerRow * syminfo.mintick
        int rowCount = math.max(
             1,
             int(math.ceil(float(totalTicks) / ticksPerRow)))
        float[] rowVolumes = array.new_float(rowCount, 0.0)
        float[] rowUpVolumes = array.new_float(rowCount, 0.0)
        float[] rowDownVolumes = array.new_float(rowCount, 0.0)
        float totalProfileVolume = 0.0

        // Allocate each bar's volume by the percentage of its high-low range
        // overlapping each profile row. This conserves total volume and avoids
        // the false concentration at closing prices present in v6.
        for sourceIndex = 0 to sourceBars - 1
            float barHigh = array.get(highs, sourceIndex)
            float barLow = array.get(lows, sourceIndex)
            bool isUpBar =
                 array.get(closes, sourceIndex) >=
                      array.get(opens, sourceIndex)
            float barVolume = array.get(volumes, sourceIndex)
            totalProfileVolume += barVolume

            if barHigh <= barLow
                int singleRow = math.max(
                     0,
                     math.min(
                          rowCount - 1,
                          int(math.floor(
                               (barLow - profileBottom) / rowHeight))))
                array.set(
                     rowVolumes,
                     singleRow,
                     array.get(rowVolumes, singleRow) + barVolume)
                if isUpBar
                    array.set(
                         rowUpVolumes,
                         singleRow,
                         array.get(rowUpVolumes, singleRow) + barVolume)
                else
                    array.set(
                         rowDownVolumes,
                         singleRow,
                         array.get(rowDownVolumes, singleRow) + barVolume)
            else
                int firstRow = math.max(
                     0,
                     int(math.floor(
                          (barLow - profileBottom) / rowHeight)))
                int lastRow = math.min(
                     rowCount - 1,
                     int(math.floor(
                          (barHigh - profileBottom) / rowHeight)))

                for rowIndex = firstRow to lastRow
                    float rowLow = profileBottom + rowIndex * rowHeight
                    float rowHigh =
                         math.min(profileTop, rowLow + rowHeight)
                    float overlap = math.max(
                         0.0,
                         math.min(barHigh, rowHigh) -
                              math.max(barLow, rowLow))
                    if overlap > 0.0
                        float allocatedVolume =
                             barVolume * overlap / (barHigh - barLow)
                        array.set(
                             rowVolumes,
                             rowIndex,
                             array.get(rowVolumes, rowIndex) +
                                  allocatedVolume)
                        if isUpBar
                            array.set(
                                 rowUpVolumes,
                                 rowIndex,
                                 array.get(rowUpVolumes, rowIndex) +
                                      allocatedVolume)
                        else
                            array.set(
                                 rowDownVolumes,
                                 rowIndex,
                                 array.get(rowDownVolumes, rowIndex) +
                                      allocatedVolume)

        // The POC is the row containing the greatest total volume.
        int pocRow = 0
        float pocRowVolume = array.get(rowVolumes, 0)
        if rowCount > 1
            for rowIndex = 1 to rowCount - 1
                float candidateVolume = array.get(rowVolumes, rowIndex)
                if candidateVolume > pocRowVolume
                    pocRow := rowIndex
                    pocRowVolume := candidateVolume

        // Build a contiguous value area from the POC. At each step include the
        // larger of the immediately adjacent rows. For equal volume, prefer
        // the row closer to the POC; if distance also ties, prefer the upper
        // row, matching TradingView's documented tie-break rules.
        int valueLowRow = pocRow
        int valueHighRow = pocRow
        float includedVolume = pocRowVolume
        float targetVolume = totalProfileVolume * targetPct / 100.0

        while includedVolume < targetVolume and
             (valueLowRow > 0 or valueHighRow < rowCount - 1)
            float belowVolume =
                 valueLowRow > 0 ?
                 array.get(rowVolumes, valueLowRow - 1) : -1.0
            float aboveVolume =
                 valueHighRow < rowCount - 1 ?
                 array.get(rowVolumes, valueHighRow + 1) : -1.0

            int belowDistance =
                 valueLowRow > 0 ?
                 pocRow - (valueLowRow - 1) : 1000000
            int aboveDistance =
                 valueHighRow < rowCount - 1 ?
                 (valueHighRow + 1) - pocRow : 1000000
            bool chooseAbove =
                 aboveVolume > belowVolume or
                 (aboveVolume == belowVolume and
                      aboveDistance <= belowDistance)
            float candidateVolume =
                 chooseAbove ? aboveVolume : belowVolume

            // TradingView stops before an adjacent row that would push the
            // value area beyond its requested percentage. The old logic added
            // that row first, which displaced VAH/VAL on concentrated profiles.
            if includedVolume + candidateVolume > targetVolume
                break
            else if chooseAbove and valueHighRow < rowCount - 1
                valueHighRow += 1
                includedVolume += candidateVolume
            else if valueLowRow > 0
                valueLowRow -= 1
                includedVolume += candidateVolume

        float valPrice = profileBottom + valueLowRow * rowHeight
        float vahPrice = math.min(
             profileTop,
             profileBottom + (valueHighRow + 1) * rowHeight)
        float pocRowLow = profileBottom + pocRow * rowHeight
        float pocRowHigh = math.min(profileTop, pocRowLow + rowHeight)
        float pocPrice = (pocRowLow + pocRowHigh) * 0.5

        array.push(result, vahPrice)
        array.push(result, pocPrice)
        array.push(result, valPrice)
        array.push(result, profileBottom)
        array.push(result, profileTop)
        array.push(result, rowHeight)
        array.push(result, float(rowCount))
        array.push(result, totalProfileVolume)
        array.push(result, float(pocRow))
        array.push(result, float(valueLowRow))
        array.push(result, float(valueHighRow))
        for rowIndex = 0 to rowCount - 1
            array.push(result, array.get(rowVolumes, rowIndex))
        for rowIndex = 0 to rowCount - 1
            array.push(result, array.get(rowUpVolumes, rowIndex))
        for rowIndex = 0 to rowCount - 1
            array.push(result, array.get(rowDownVolumes, rowIndex))

    result

f_profileRegionVolume(float[] profile, int region) =>
    float regionVolume = na

    if array.size(profile) >= PROFILE_META_SIZE
        int rowCount = int(array.get(profile, META_ROW_COUNT))
        int pocRow = int(array.get(profile, META_POC_ROW))
        int valueLowRow = int(array.get(profile, META_VAL_ROW))
        int valueHighRow = int(array.get(profile, META_VAH_ROW))
        regionVolume := 0.0

        for rowIndex = 0 to rowCount - 1
            bool includeRow =
                 region == REGION_VAL_TO_POC ?
                      rowIndex >= valueLowRow and rowIndex <= pocRow :
                 region == REGION_POC_TO_VAH ?
                      rowIndex > pocRow and rowIndex <= valueHighRow :
                 region == REGION_BELOW_VAL ?
                      rowIndex < valueLowRow :
                 region == REGION_ABOVE_VAH ?
                      rowIndex > valueHighRow : false

            if includeRow
                regionVolume += array.get(
                     profile,
                     PROFILE_META_SIZE + rowIndex)

    regionVolume

f_supportNodeBelowVAL(float[] profile, float minimumPctOfPOC) =>
    float supportPrice = na
    float supportVolume = na
    int supportRow = na

    if array.size(profile) >= PROFILE_META_SIZE
        int rowCount = int(array.get(profile, META_ROW_COUNT))
        int pocRow = int(array.get(profile, META_POC_ROW))
        int valueLowRow = int(array.get(profile, META_VAL_ROW))
        float profileBottom = array.get(profile, META_BOTTOM)
        float profileTop = array.get(profile, META_TOP)
        float rowHeight = array.get(profile, META_ROW_HEIGHT)
        float pocVolume = array.get(
             profile,
             PROFILE_META_SIZE + pocRow)
        float requiredVolume =
             pocVolume * minimumPctOfPOC / 100.0

        if valueLowRow > 0 and pocVolume > 0.0
            for rowIndex = 0 to valueLowRow - 1
                float rowVolume = array.get(
                     profile,
                     PROFILE_META_SIZE + rowIndex)
                float lowerNeighborVolume =
                     rowIndex > 0 ?
                     array.get(
                          profile,
                          PROFILE_META_SIZE + rowIndex - 1) : -1.0
                float upperNeighborVolume =
                     rowIndex < rowCount - 1 ?
                     array.get(
                          profile,
                          PROFILE_META_SIZE + rowIndex + 1) : -1.0
                bool isLocalPeak =
                     rowVolume > 0.0 and
                     rowVolume >= lowerNeighborVolume and
                     rowVolume >= upperNeighborVolume
                bool isStrongerCandidate =
                     na(supportVolume) or
                     rowVolume > supportVolume or
                     (rowVolume == supportVolume and
                          rowIndex > supportRow)

                if isLocalPeak and
                     rowVolume >= requiredVolume and
                     isStrongerCandidate
                    supportRow := rowIndex
                    supportVolume := rowVolume

            if not na(supportRow)
                float supportRowLow =
                     profileBottom + supportRow * rowHeight
                float supportRowHigh = math.min(
                     profileTop,
                     supportRowLow + rowHeight)
                supportPrice :=
                     (supportRowLow + supportRowHigh) * 0.5

    supportPrice

f_topDirectionalZones(
     float[] profile,
     float neighborMinimumPct,
     bool useBuyerVolume) =>
    float[] zones = array.new_float(0)

    if array.size(profile) >= PROFILE_META_SIZE
        int rowCount = int(array.get(profile, META_ROW_COUNT))
        float profileBottom = array.get(profile, META_BOTTOM)
        float profileTop = array.get(profile, META_TOP)
        float rowHeight = array.get(profile, META_ROW_HEIGHT)
        int upVolumeOffset = PROFILE_META_SIZE + rowCount
        int downVolumeOffset =
             PROFILE_META_SIZE + rowCount * 2
        int primaryVolumeOffset =
             useBuyerVolume ? upVolumeOffset : downVolumeOffset
        int opposingVolumeOffset =
             useBuyerVolume ? downVolumeOffset : upVolumeOffset
        int firstPeakRow = 0
        float firstPeakVolume = array.get(
             profile,
             primaryVolumeOffset)

        if rowCount > 1
            for rowIndex = 1 to rowCount - 1
                float rowDirectionalVolume = array.get(
                     profile,
                     primaryVolumeOffset + rowIndex)
                if rowDirectionalVolume > firstPeakVolume
                    firstPeakRow := rowIndex
                    firstPeakVolume := rowDirectionalVolume

        if firstPeakVolume > 0.0
            float firstMinimum =
                 firstPeakVolume * neighborMinimumPct / 100.0
            int firstLowRow = firstPeakRow
            int firstHighRow = firstPeakRow

            while firstLowRow > 0 and
                 array.get(
                      profile,
                      primaryVolumeOffset + firstLowRow - 1) >=
                      firstMinimum
                firstLowRow -= 1

            while firstHighRow < rowCount - 1 and
                 array.get(
                      profile,
                      primaryVolumeOffset + firstHighRow + 1) >=
                      firstMinimum
                firstHighRow += 1

            float firstDirectionalVolume = 0.0
            float firstOpposingVolume = 0.0
            for rowIndex = firstLowRow to firstHighRow
                firstDirectionalVolume += array.get(
                     profile,
                     primaryVolumeOffset + rowIndex)
                firstOpposingVolume += array.get(
                     profile,
                     opposingVolumeOffset + rowIndex)

            array.push(
                 zones,
                 profileBottom + firstLowRow * rowHeight)
            array.push(
                 zones,
                 math.min(
                      profileTop,
                      profileBottom +
                           (firstHighRow + 1) * rowHeight))
            array.push(zones, firstDirectionalVolume)
            array.push(zones, firstOpposingVolume)

            int excludedLow = math.max(0, firstLowRow - 1)
            int excludedHigh = math.min(
                 rowCount - 1,
                 firstHighRow + 1)
            int secondPeakRow = -1
            float secondPeakVolume = -1.0

            for rowIndex = 0 to rowCount - 1
                float rowDirectionalVolume = array.get(
                     profile,
                     primaryVolumeOffset + rowIndex)
                float lowerNeighborVolume =
                     rowIndex > 0 ?
                     array.get(
                          profile,
                          primaryVolumeOffset + rowIndex - 1) : -1.0
                float upperNeighborVolume =
                     rowIndex < rowCount - 1 ?
                     array.get(
                          profile,
                          primaryVolumeOffset + rowIndex + 1) : -1.0
                bool outsideFirstZone =
                     rowIndex < excludedLow or
                     rowIndex > excludedHigh
                bool isLocalDirectionalPeak =
                     rowDirectionalVolume > 0.0 and
                     rowDirectionalVolume >= lowerNeighborVolume and
                     rowDirectionalVolume >= upperNeighborVolume

                if outsideFirstZone and
                     isLocalDirectionalPeak and
                     rowDirectionalVolume > secondPeakVolume
                    secondPeakRow := rowIndex
                    secondPeakVolume := rowDirectionalVolume

            if secondPeakRow >= 0
                float secondMinimum =
                     secondPeakVolume * neighborMinimumPct / 100.0
                int secondLowRow = secondPeakRow
                int secondHighRow = secondPeakRow

                while secondLowRow > 0 and
                     (secondLowRow - 1 < excludedLow or
                          secondLowRow - 1 > excludedHigh) and
                     array.get(
                          profile,
                          primaryVolumeOffset + secondLowRow - 1) >=
                          secondMinimum
                    secondLowRow -= 1

                while secondHighRow < rowCount - 1 and
                     (secondHighRow + 1 < excludedLow or
                          secondHighRow + 1 > excludedHigh) and
                     array.get(
                          profile,
                          primaryVolumeOffset + secondHighRow + 1) >=
                          secondMinimum
                    secondHighRow += 1

                float secondDirectionalVolume = 0.0
                float secondOpposingVolume = 0.0
                for rowIndex = secondLowRow to secondHighRow
                    secondDirectionalVolume += array.get(
                         profile,
                         primaryVolumeOffset + rowIndex)
                    secondOpposingVolume += array.get(
                         profile,
                         opposingVolumeOffset + rowIndex)

                array.push(
                     zones,
                     profileBottom + secondLowRow * rowHeight)
                array.push(
                     zones,
                     math.min(
                          profileTop,
                          profileBottom +
                               (secondHighRow + 1) * rowHeight))
                array.push(zones, secondDirectionalVolume)
                array.push(zones, secondOpposingVolume)

    zones

f_formatVolume(float volumeValue) =>
    na(volumeValue) ? "n/a" : str.tostring(volumeValue, "#,###")

f_formatCompactVolume(float volumeValue) =>
    string formattedVolume = "n/a"

    if not na(volumeValue)
        float absoluteVolume = math.abs(volumeValue)
        formattedVolume :=
             absoluteVolume >= 1000000000.0 ?
                  str.tostring(volumeValue / 1000000000.0, "#.##") + "B" :
             absoluteVolume >= 1000000.0 ?
                  str.tostring(volumeValue / 1000000.0, "#.##") + "M" :
             absoluteVolume >= 1000.0 ?
                  str.tostring(volumeValue / 1000.0, "#.##") + "K" :
                  str.tostring(volumeValue, "#")

    formattedVolume

f_directionalRelative(float primaryVolume, float opposingVolume) =>
    float relativeValue =
         opposingVolume > 0.0 ?
         primaryVolume / opposingVolume :
         primaryVolume > 0.0 ? 1000000000.0 : 0.0

    relativeValue

f_directionalText(float primaryVolume, float opposingVolume) =>
    string relativeText =
         opposingVolume > 0.0 ?
         str.tostring(
              f_directionalRelative(
                   primaryVolume,
                   opposingVolume),
              "#.##") : "n/a"

    f_formatCompactVolume(primaryVolume) +
         " x " +
         f_formatCompactVolume(opposingVolume) +
         " | R: " +
         relativeText

var float[] profileA = array.new_float(0)
var float vahA = na
var float pocA = na
var float valA = na

if barstate.islast
    profileA := f_calculateProfile(
         rangeOpensA,
         rangeHighsA,
         rangeLowsA,
         rangeClosesA,
         rangeVolumesA,
         rowsLayout,
         rowSize,
         valueAreaPct)

    vahA := array.size(profileA) >= PROFILE_META_SIZE ?
         array.get(profileA, META_VAH) : na
    pocA := array.size(profileA) >= PROFILE_META_SIZE ?
         array.get(profileA, META_POC) : na
    valA := array.size(profileA) >= PROFILE_META_SIZE ?
         array.get(profileA, META_VAL) : na

float volumeVALToPOCA = f_profileRegionVolume(
     profileA,
     REGION_VAL_TO_POC)
float volumePOCToVAHA = f_profileRegionVolume(
     profileA,
     REGION_POC_TO_VAH)
float volumeBelowVALA = f_profileRegionVolume(
     profileA,
     REGION_BELOW_VAL)
float volumeAboveVAHA = f_profileRegionVolume(
     profileA,
     REGION_ABOVE_VAH)
float supportBelowVALA =
     f_supportNodeBelowVAL(profileA, supportNodeMinPct)

// =============================================================================
// 4. LINES AND HISTOGRAMS
// =============================================================================
var line lineStartA = line.new(
     na, na, na, na,
     xloc = xloc.bar_time,
     color = color.new(color.aqua, 40),
     style = line.style_dashed,
     width = 1)
var line lineEndA = line.new(
     na, na, na, na,
     xloc = xloc.bar_time,
     color = color.new(color.aqua, 40),
     style = line.style_dashed,
     width = 1)

var line lineVahA = line.new(
     na, na, na, na,
     xloc = xloc.bar_time,
     color = color.red,
     width = 1)
var line linePocA = line.new(
     na, na, na, na,
     xloc = xloc.bar_time,
     color = color.white,
     width = 2)
var line lineValA = line.new(
     na, na, na, na,
     xloc = xloc.bar_time,
     color = color.green,
     width = 1)
var line lineSupportBelowVALA = line.new(
     na, na, na, na,
     xloc = xloc.bar_time,
     color = supportLineColor,
     style = line.style_dashed,
     width = 1)

var box[] histBoxesA = array.new_box(0)
var box profileBackgroundA = na
var box buyerVolumeZone1A = na
var box buyerVolumeZone2A = na
var label buyerVolumeLabel1A = na
var label buyerVolumeLabel2A = na
var box sellerVolumeZone1A = na
var box sellerVolumeZone2A = na
var label sellerVolumeLabel1A = na
var label sellerVolumeLabel2A = na
var box[] localBuyerDominanceBoxesA = array.new_box(0)

f_clearBoxes(box[] boxes) =>
    if array.size(boxes) > 0
        for boxIndex = 0 to array.size(boxes) - 1
            box.delete(array.get(boxes, boxIndex))
        array.clear(boxes)

f_drawLocalBuyerDominanceRows(
     float[] profile,
     box[] boxes,
     int rangeStartTime,
     int rangeEndTime,
     color markerColor) =>
    if array.size(profile) >= PROFILE_META_SIZE
        int rowCount = int(array.get(profile, META_ROW_COUNT))
        float profileBottom = array.get(profile, META_BOTTOM)
        float profileTop = array.get(profile, META_TOP)
        float rowHeight = array.get(profile, META_ROW_HEIGHT)
        int upVolumeOffset = PROFILE_META_SIZE + rowCount
        int downVolumeOffset =
             PROFILE_META_SIZE + rowCount * 2

        if rowCount >= 3
            for rowIndex = 1 to rowCount - 2
                float buyerBelow = array.get(
                     profile,
                     upVolumeOffset + rowIndex - 1)
                float buyerCurrent = array.get(
                     profile,
                     upVolumeOffset + rowIndex)
                float buyerAbove = array.get(
                     profile,
                     upVolumeOffset + rowIndex + 1)
                float sellerBelow = array.get(
                     profile,
                     downVolumeOffset + rowIndex - 1)
                float sellerCurrent = array.get(
                     profile,
                     downVolumeOffset + rowIndex)
                float sellerAbove = array.get(
                     profile,
                     downVolumeOffset + rowIndex + 1)
                bool hasLocalBuyerDominance =
                     buyerCurrent > buyerBelow and
                     buyerCurrent > buyerAbove and
                     sellerCurrent < sellerBelow and
                     sellerCurrent < sellerAbove and
                     buyerCurrent >= sellerCurrent

                if hasLocalBuyerDominance
                    float rowLow =
                         profileBottom + rowIndex * rowHeight
                    float rowHigh = math.min(
                         profileTop,
                         rowLow + rowHeight)
                    box dominanceRow = box.new(
                         left = rangeStartTime,
                         top = rowHigh,
                         right = rangeEndTime,
                         bottom = rowLow,
                         xloc = xloc.bar_time,
                         bgcolor = color.new(markerColor, 88),
                         border_color = markerColor,
                         border_width = 1)
                    array.push(boxes, dominanceRow)

f_drawHistogram(
     float[] profile,
     box[] boxes,
     int rangeStartTime,
     int rangeEndTime,
     int barDurationMs,
     int widthPct,
     string placement,
     string displayMode,
     color upColor,
     color downColor,
     color valueUpColor,
     color valueDownColor,
     color totalColor,
     color valueTotalColor) =>
    if array.size(profile) >= PROFILE_META_SIZE and
         not na(rangeStartTime) and
         not na(rangeEndTime)
        float profileTop = array.get(profile, META_TOP)
        float rowHeight = array.get(profile, META_ROW_HEIGHT)
        int rowCount = int(array.get(profile, META_ROW_COUNT))
        int valueLowRow = int(array.get(profile, META_VAL_ROW))
        int valueHighRow = int(array.get(profile, META_VAH_ROW))
        bool useSplitDisplay =
             displayMode == "Up/Down" and rowCount <= MAX_SPLIT_ROWS
        float maximumVolume = 0.0
        int profileEndTime = rangeEndTime + barDurationMs
        int rangeWidthMs = math.max(
             barDurationMs,
             profileEndTime - rangeStartTime)
        int maximumWidthMs = math.max(
             1,
             int(math.round(rangeWidthMs * widthPct / 100.0)))

        for rowIndex = 0 to rowCount - 1
            maximumVolume := math.max(
                 maximumVolume,
                 array.get(profile, PROFILE_META_SIZE + rowIndex))

        if maximumVolume > 0.0
            float profileBottom = array.get(profile, META_BOTTOM)
            for rowIndex = 0 to rowCount - 1
                float rowVolume =
                     array.get(profile, PROFILE_META_SIZE + rowIndex)
                if rowVolume > 0.0
                    float rowUpVolume =
                         array.get(
                              profile,
                              PROFILE_META_SIZE + rowCount + rowIndex)
                    float rowDownVolume =
                         array.get(
                              profile,
                              PROFILE_META_SIZE + rowCount * 2 + rowIndex)
                    float rowLow =
                         profileBottom + rowIndex * rowHeight
                    float rowHigh =
                         math.min(profileTop, rowLow + rowHeight)
                    int rowWidthMs = math.max(
                         1,
                         int(math.round(
                              rowVolume / maximumVolume * maximumWidthMs)))
                    int rowLeft =
                         placement == "Right" ?
                         profileEndTime - rowWidthMs : rangeStartTime
                    int rowRight = rowLeft + rowWidthMs
                    bool insideValueArea =
                         rowIndex >= valueLowRow and
                              rowIndex <= valueHighRow

                    if not useSplitDisplay
                        color rowColor =
                             insideValueArea ?
                             color.new(valueTotalColor, 20) :
                             color.new(totalColor, 35)
                        box histogramRow = box.new(
                             left = rowLeft,
                             top = rowHigh,
                             right = rowRight,
                             bottom = rowLow,
                             xloc = xloc.bar_time,
                             bgcolor = rowColor,
                             border_color = color.new(rowColor, 100))
                        array.push(boxes, histogramRow)
                    else
                        int upWidthMs =
                             int(math.round(
                                  rowWidthMs * rowUpVolume / rowVolume))
                        if rowUpVolume > 0.0 and rowDownVolume > 0.0
                            upWidthMs := math.max(
                                 1,
                                 math.min(rowWidthMs - 1, upWidthMs))
                        else if rowUpVolume > 0.0
                            upWidthMs := rowWidthMs
                        else
                            upWidthMs := 0

                        int splitTime = rowLeft + upWidthMs
                        color displayedUpColor =
                             insideValueArea ?
                             color.new(valueUpColor, 15) :
                             color.new(upColor, 35)
                        color displayedDownColor =
                             insideValueArea ?
                             color.new(valueDownColor, 15) :
                             color.new(downColor, 35)

                        if rowUpVolume > 0.0 and splitTime > rowLeft
                            box upHistogramRow = box.new(
                                 left = rowLeft,
                                 top = rowHigh,
                                 right = splitTime,
                                 bottom = rowLow,
                                 xloc = xloc.bar_time,
                                 bgcolor = displayedUpColor,
                                 border_color =
                                      color.new(displayedUpColor, 100))
                            array.push(boxes, upHistogramRow)

                        if rowDownVolume > 0.0 and rowRight > splitTime
                            box downHistogramRow = box.new(
                                 left = splitTime,
                                 top = rowHigh,
                                 right = rowRight,
                                 bottom = rowLow,
                                 xloc = xloc.bar_time,
                                 bgcolor = displayedDownColor,
                                 border_color =
                                      color.new(displayedDownColor, 100))
                            array.push(boxes, downHistogramRow)

if barstate.islast
    f_clearBoxes(histBoxesA)
    f_clearBoxes(localBuyerDominanceBoxesA)
    if not na(profileBackgroundA)
        box.delete(profileBackgroundA)
        profileBackgroundA := na
    if not na(buyerVolumeZone1A)
        box.delete(buyerVolumeZone1A)
        buyerVolumeZone1A := na
    if not na(buyerVolumeZone2A)
        box.delete(buyerVolumeZone2A)
        buyerVolumeZone2A := na
    if not na(buyerVolumeLabel1A)
        label.delete(buyerVolumeLabel1A)
        buyerVolumeLabel1A := na
    if not na(buyerVolumeLabel2A)
        label.delete(buyerVolumeLabel2A)
        buyerVolumeLabel2A := na
    if not na(sellerVolumeZone1A)
        box.delete(sellerVolumeZone1A)
        sellerVolumeZone1A := na
    if not na(sellerVolumeZone2A)
        box.delete(sellerVolumeZone2A)
        sellerVolumeZone2A := na
    if not na(sellerVolumeLabel1A)
        label.delete(sellerVolumeLabel1A)
        sellerVolumeLabel1A := na
    if not na(sellerVolumeLabel2A)
        label.delete(sellerVolumeLabel2A)
        sellerVolumeLabel2A := na

    int histogramBarMs = math.max(
         1,
         int(timeframe.in_seconds() * 1000.0))
    int endTimeA = endA + histogramBarMs
    int rangeWidthMsA = math.max(
         histogramBarMs,
         endTimeA - startA)
    int histogramMaximumWidthMsA = math.max(
         1,
         int(math.round(
              rangeWidthMsA * profileWidthPct / 100.0)))
    int histogramLabelTimeA =
         profilePlacement == "Left" ?
         startA :
         endTimeA - histogramMaximumWidthMsA
    int sellerHistogramLabelTimeA =
         histogramLabelTimeA +
              int(math.round(histogramMaximumWidthMsA * 0.4))
    color boundaryColorA =
         showRangeBoundaries ?
         color.new(color.aqua, 40) : color.new(color.aqua, 100)
    levelExtension =
         extendLevelsRight ? extend.right : extend.none

    line.set_color(lineStartA, boundaryColorA)
    line.set_color(lineEndA, boundaryColorA)
    line.set_extend(lineVahA, levelExtension)
    line.set_extend(linePocA, levelExtension)
    line.set_extend(lineValA, levelExtension)
    line.set_extend(lineSupportBelowVALA, levelExtension)
    line.set_color(
         lineSupportBelowVALA,
         na(supportBelowVALA) ?
         color.new(supportLineColor, 100) : supportLineColor)
    line.set_xy1(
         lineSupportBelowVALA,
         startA,
         supportBelowVALA)
    line.set_xy2(
         lineSupportBelowVALA,
         endTimeA,
         supportBelowVALA)

    if array.size(profileA) >= PROFILE_META_SIZE
        float bottomA = array.get(profileA, META_BOTTOM)
        float topA = array.get(profileA, META_TOP)
        if showProfileBackground
            profileBackgroundA := box.new(
                 left = startA,
                 top = topA,
                 right = endTimeA,
                 bottom = bottomA,
                 xloc = xloc.bar_time,
                 bgcolor = profileBackgroundColor,
                 border_color = color.new(color.aqua, 75))
        line.set_xy1(lineStartA, startA, bottomA)
        line.set_xy2(lineStartA, startA, topA)
        line.set_xy1(lineEndA, endTimeA, bottomA)
        line.set_xy2(lineEndA, endTimeA, topA)
        line.set_xy1(lineVahA, startA, vahA)
        line.set_xy2(lineVahA, endTimeA, vahA)
        line.set_xy1(linePocA, startA, pocA)
        line.set_xy2(linePocA, endTimeA, pocA)
        line.set_xy1(lineValA, startA, valA)
        line.set_xy2(lineValA, endTimeA, valA)
        f_drawHistogram(
             profileA,
             histBoxesA,
             startA,
             endA,
             histogramBarMs,
             profileWidthPct,
             profilePlacement,
             volumeDisplay,
             upVolumeColor,
             downVolumeColor,
             valueAreaUpColor,
             valueAreaDownColor,
             totalVolumeColor,
             valueAreaTotalColor)
        float[] buyerZonesA = f_topDirectionalZones(
             profileA,
             buyerZoneNeighborPct,
             true)
        float buyerRatio1A = na
        float buyerRatio2A = na
        bool firstZoneHasHigherRelativeA = true
        if array.size(buyerZonesA) >= 4
            buyerRatio1A := f_directionalRelative(
                 array.get(buyerZonesA, 2),
                 array.get(buyerZonesA, 3))
        if array.size(buyerZonesA) >= 8
            buyerRatio2A := f_directionalRelative(
                 array.get(buyerZonesA, 6),
                 array.get(buyerZonesA, 7))
            firstZoneHasHigherRelativeA :=
                 buyerRatio1A >= buyerRatio2A
        if showBuyerZone and
             array.size(buyerZonesA) >= 4 and
             buyerRatio1A >= 1.0
            buyerVolumeZone1A := box.new(
                 left = startA,
                 top = array.get(buyerZonesA, 1),
                 right = endTimeA,
                 bottom = array.get(buyerZonesA, 0),
                 xloc = xloc.bar_time,
                 bgcolor = color.new(
                      buyerZoneColor,
                      firstZoneHasHigherRelativeA ? 60 : 88),
                 border_color = color.new(
                      buyerZoneColor,
                      firstZoneHasHigherRelativeA ? 0 : 50),
                 border_width = 1)
            if showBuyerZoneVolumes
                buyerVolumeLabel1A := label.new(
                     x = histogramLabelTimeA,
                     y =
                          (array.get(buyerZonesA, 0) +
                               array.get(buyerZonesA, 1)) / 2.0,
                     text = f_directionalText(
                          array.get(buyerZonesA, 2),
                          array.get(buyerZonesA, 3)),
                     xloc = xloc.bar_time,
                     yloc = yloc.price,
                     style = label.style_label_left,
                     color = color.black,
                     textcolor = color.white,
                     size = size.tiny)
        if showBuyerZone and
             array.size(buyerZonesA) >= 8 and
             buyerRatio2A >= 1.0
            buyerVolumeZone2A := box.new(
                 left = startA,
                 top = array.get(buyerZonesA, 5),
                 right = endTimeA,
                 bottom = array.get(buyerZonesA, 4),
                 xloc = xloc.bar_time,
                 bgcolor = color.new(
                      buyerZoneColor,
                      firstZoneHasHigherRelativeA ? 88 : 60),
                 border_color = color.new(
                      buyerZoneColor,
                      firstZoneHasHigherRelativeA ? 50 : 0),
                 border_width = 1)
            if showBuyerZoneVolumes
                buyerVolumeLabel2A := label.new(
                     x = histogramLabelTimeA,
                     y =
                          (array.get(buyerZonesA, 4) +
                               array.get(buyerZonesA, 5)) / 2.0,
                     text = f_directionalText(
                          array.get(buyerZonesA, 6),
                          array.get(buyerZonesA, 7)),
                     xloc = xloc.bar_time,
                     yloc = yloc.price,
                     style = label.style_label_left,
                     color = color.black,
                     textcolor = color.white,
                     size = size.tiny)

        float[] sellerZonesA = f_topDirectionalZones(
             profileA,
             sellerZoneNeighborPct,
             false)
        float sellerRatio1A = na
        float sellerRatio2A = na
        bool firstSellerZoneHasHigherRelativeA = true
        if array.size(sellerZonesA) >= 4
            sellerRatio1A := f_directionalRelative(
                 array.get(sellerZonesA, 2),
                 array.get(sellerZonesA, 3))
        if array.size(sellerZonesA) >= 8
            sellerRatio2A := f_directionalRelative(
                 array.get(sellerZonesA, 6),
                 array.get(sellerZonesA, 7))
            firstSellerZoneHasHigherRelativeA :=
                 sellerRatio1A >= sellerRatio2A
        if showSellerZone and
             array.size(sellerZonesA) >= 4 and
             sellerRatio1A >= 1.0
            sellerVolumeZone1A := box.new(
                 left = startA,
                 top = array.get(sellerZonesA, 1),
                 right = endTimeA,
                 bottom = array.get(sellerZonesA, 0),
                 xloc = xloc.bar_time,
                 bgcolor = color.new(
                      sellerZoneColor,
                      firstSellerZoneHasHigherRelativeA ? 60 : 88),
                 border_color = color.new(
                      sellerZoneColor,
                      firstSellerZoneHasHigherRelativeA ? 0 : 50),
                 border_width = 1)
            if showSellerZoneVolumes
                sellerVolumeLabel1A := label.new(
                     x = sellerHistogramLabelTimeA,
                     y =
                          (array.get(sellerZonesA, 0) +
                               array.get(sellerZonesA, 1)) / 2.0,
                     text = f_directionalText(
                          array.get(sellerZonesA, 2),
                          array.get(sellerZonesA, 3)),
                     xloc = xloc.bar_time,
                     yloc = yloc.price,
                     style = label.style_label_left,
                     color = color.black,
                     textcolor = color.white,
                     size = size.tiny)
        if showSellerZone and
             array.size(sellerZonesA) >= 8 and
             sellerRatio2A >= 1.0
            sellerVolumeZone2A := box.new(
                 left = startA,
                 top = array.get(sellerZonesA, 5),
                 right = endTimeA,
                 bottom = array.get(sellerZonesA, 4),
                 xloc = xloc.bar_time,
                 bgcolor = color.new(
                      sellerZoneColor,
                      firstSellerZoneHasHigherRelativeA ? 88 : 60),
                 border_color = color.new(
                      sellerZoneColor,
                      firstSellerZoneHasHigherRelativeA ? 50 : 0),
                 border_width = 1)
            if showSellerZoneVolumes
                sellerVolumeLabel2A := label.new(
                     x = sellerHistogramLabelTimeA,
                     y =
                          (array.get(sellerZonesA, 4) +
                               array.get(sellerZonesA, 5)) / 2.0,
                     text = f_directionalText(
                          array.get(sellerZonesA, 6),
                          array.get(sellerZonesA, 7)),
                     xloc = xloc.bar_time,
                     yloc = yloc.price,
                     style = label.style_label_left,
                     color = color.black,
                     textcolor = color.white,
                     size = size.tiny)

        if showLocalBuyerDominance
            f_drawLocalBuyerDominanceRows(
                 profileA,
                 localBuyerDominanceBoxesA,
                 startA,
                 endTimeA,
                 localBuyerDominanceColor)

// =============================================================================
// 5. PROFILE SUMMARY TABLE
// =============================================================================
var table compTable = table.new(
     position = position.top_right,
     columns = 2,
     rows = 10,
     bgcolor = color.new(color.black, 15),
     border_width = 1,
     border_color = color.gray)

if barstate.islast
    string effectiveRowsA =
         array.size(profileA) >= PROFILE_META_SIZE ?
         str.tostring(int(array.get(profileA, META_ROW_COUNT))) : "n/a"

    table.cell(
         compTable, 0, 0, "FRVP Summary",
         text_color = color.white,
         text_size = size.small)
    table.cell(
         compTable, 1, 0, "Selected Range",
         text_color = color.aqua,
         text_size = size.small)

    table.cell(
         compTable, 0, 1, "Total Volume Sum:",
         text_color = color.white,
         text_size = size.small)
    table.cell(
         compTable, 1, 1, str.tostring(totalVolA, "#,###"),
         text_color = color.yellow,
         text_size = size.small)

    table.cell(
         compTable, 0, 2, "VAH (Red Line):",
         text_color = color.white,
         text_size = size.small)
    table.cell(
         compTable, 1, 2, str.tostring(vahA, format.mintick),
         text_color = color.red,
         text_size = size.small)

    table.cell(
         compTable, 0, 3, "POC (White Line):",
         text_color = color.white,
         text_size = size.small)
    table.cell(
         compTable, 1, 3, str.tostring(pocA, format.mintick),
         text_color = color.white,
         text_size = size.small)

    table.cell(
         compTable, 0, 4, "VAL (Green Line):",
         text_color = color.white,
         text_size = size.small)
    table.cell(
         compTable, 1, 4, str.tostring(valA, format.mintick),
         text_color = color.green,
         text_size = size.small)
    table.cell(
         compTable, 0, 5, "Effective Rows:",
         text_color = color.white,
         text_size = size.small)
    table.cell(
         compTable, 1, 5, effectiveRowsA,
         text_color = color.aqua,
         text_size = size.small)

    table.cell(
         compTable, 0, 6, "Below VAL:",
         text_color = color.white,
         text_size = size.small)
    table.cell(
         compTable, 1, 6, f_formatVolume(volumeBelowVALA),
         text_color = color.silver,
         text_size = size.small)

    table.cell(
         compTable, 0, 7, "VAL to POC:",
         text_color = color.white,
         text_size = size.small)
    table.cell(
         compTable, 1, 7, f_formatVolume(volumeVALToPOCA),
         text_color = color.green,
         text_size = size.small)

    table.cell(
         compTable, 0, 8, "POC to VAH:",
         text_color = color.white,
         text_size = size.small)
    table.cell(
         compTable, 1, 8, f_formatVolume(volumePOCToVAHA),
         text_color = color.red,
         text_size = size.small)


    table.cell(
         compTable, 0, 9, "Above VAH:",
         text_color = color.white,
         text_size = size.small)
    table.cell(
         compTable, 1, 9, f_formatVolume(volumeAboveVAHA),
         text_color = color.silver,
         text_size = size.small)
