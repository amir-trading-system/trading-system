//@version=6
indicator(
     "Interactive Fixed Range Volume Profile & Histogram (v7.5)",
     shorttitle = "Interactive FRVP v7.5",
     overlay = true,
     max_boxes_count = 500,
     max_lines_count = 10,
     max_labels_count = 500)

// =============================================================================
// 1. INTERACTIVE INPUTS (drag-and-drop)
// =============================================================================
int startA = input.time(
     timestamp("2026-01-01 00:00"),
     title = "Range - Start Point",
     confirm = true,
     group = "Range Boundaries")
int endA = input.time(
     timestamp("2026-06-30 23:59"),
     title = "Range - End Point",
     confirm = true,
     group = "Range Boundaries")

string rowsLayout = input.string(
     "Number of Rows",
     title = "Rows Layout",
     options = ["Number of Rows", "Ticks Per Row"],
     group = "Profile Precision Settings",
     tooltip = "Use the same layout and row size in TradingView's FRVP when comparing levels.")
int rowSize = input.int(
     100,
     title = "Row Size",
     minval = 1,
     maxval = 500,
     group = "Profile Precision Settings",
     tooltip = "Number of rows when Rows Layout is Number of Rows; otherwise ticks in each row.")
float valueAreaPct = input.float(
     70.0,
     title = "Value Area Volume (%)",
     minval = 1.0,
     maxval = 100.0,
     step = 1.0,
     group = "Profile Precision Settings")
bool useNativeFootprint = input.bool(
     true,
     title = "Use Native Footprint Data (Premium)",
     group = "Profile Precision Settings",
     tooltip = "Builds VAL, POC, VAH and buyer/seller rows from TradingView's native intrabar footprint data. If footprint history is unavailable, the table reports that the OHLCV approximation is being used instead.")
int profileWidthPct = input.int(
     30,
     title = "Profile Width (% of Range)",
     minval = 5,
     maxval = 100,
     group = "Profile Style")
string profilePlacement = input.string(
     "Left",
     title = "Profile Placement",
     options = ["Right", "Left"],
     group = "Profile Style")
string volumeDisplay = input.string(
     "Up/Down",
     title = "Volume Display",
     options = ["Up/Down", "Total"],
     group = "Profile Style")
bool showProfileBackground = input.bool(
     true,
     title = "Show Profile Background",
     group = "Profile Style")
bool showRangeBoundaries = input.bool(
     false,
     title = "Show Range Boundaries",
     group = "Profile Style")
bool extendLevelsRight = input.bool(
     false,
     title = "Extend VAH / POC / VAL Right",
     group = "Profile Style")
bool showBuyerZone = input.bool(
     true,
     title = "Show Top Four Buyer Rows",
     group = "Buyer Zone",
     tooltip = "Draws the four profile rows with the greatest estimated bullish volume. Each result is exactly one histogram row and requires buyers / sellers of at least 1.0. Equal-volume ties favor higher prices.")
bool showBuyerZoneVolumes = input.bool(
     true,
     title = "Show Buyer x Seller Volume",
     group = "Buyer Zone",
     tooltip = "Shows a green label outside the histogram's left edge with estimated up-volume x down-volume and their relative ratio.")
bool showSellerZone = input.bool(
     true,
     title = "Show Top Two Seller Rows",
     group = "Seller Zone",
     tooltip = "Draws the two profile rows with the greatest estimated bearish volume. Each result is exactly one histogram row and requires sellers / buyers of at least 1.0. Equal-volume ties favor higher prices.")
bool showSellerZoneVolumes = input.bool(
     true,
     title = "Show Seller x Buyer Volume",
     group = "Seller Zone",
     tooltip = "Shows a red label outside the histogram's left edge with estimated down-volume x up-volume and their relative ratio.")
bool showValueAreaDirectionalLabels = input.bool(
     true,
     title = "Show Value Area Buyer / Seller Labels",
     group = "Value Area Direction",
     tooltip = "Shows aggregate estimated buyer volume x seller volume and the buyer / seller ratio for VAL to POC and POC to VAH.")
bool showLocalBuyerDominance = input.bool(
     true,
     title = "Mark Local Buyer-Dominance Reversals",
     group = "Local Buyer Dominance",
     tooltip = "Shows a Reversal arrow outside the histogram's left edge when a row's buyer volume is strictly greater than both adjacent rows, its seller volume is strictly lower than both adjacent rows, and buyers / sellers is at least 1.0.")
bool showVALBuyerTransition = input.bool(
     true,
     title = "Show Buyer Transition Below VAL",
     group = "VAL Buyer Transition",
     tooltip = "Shows the first meaningful, persistent improvement from seller control toward buyer control below VAL.")
bool useStableVALBuyerControlRows = input.bool(
     true,
     title = "Use Stable Rows for VAL Buyer Control",
     group = "VAL Buyer Transition",
     tooltip = "Calculates an additional VAL Buyer Control/Transition signal on a globally anchored fixed-price grid. This prevents inactive prices added to the selected range from changing the signal's local row structure. The original profile signal keeps priority, so existing cases retain their previous label.")
float valBuyerControlRowHeight = input.float(
     0.02,
     title = "Stable Control Row Height ($)",
     minval = 0.0001,
     maxval = 1.0,
     step = 0.01,
     group = "VAL Buyer Transition",
     tooltip = "Maximum price height of each stable signal row. The default is two cents. This setting does not change the displayed histogram, VAL, POC, VAH, Buyer Shift, or reversal arrows.")
float valBuyerMaxDistancePct = input.float(
     5.0,
     title = "Maximum Transition Distance Below VAL (%)",
     minval = 0.1,
     maxval = 20.0,
     step = 0.5,
     group = "VAL Buyer Transition",
     tooltip = "Maximum percentage distance below VAL searched by the adjacent-row transition signal.")
float valBuyerMinRowVolumePct = input.float(
     30.0,
     title = "Minimum Row Volume (% of POC Row)",
     minval = 1.0,
     maxval = 100.0,
     step = 5.0,
     group = "VAL Buyer Transition",
     tooltip = "Used only by the adjacent-row transition. The highest-relative shift has no minimum-volume requirement.")
float valBuyerMinImprovementPct = input.float(
     5.0,
     title = "Minimum Imbalance Improvement (% of POC Row)",
     minval = 1.0,
     maxval = 100.0,
     step = 1.0,
     group = "VAL Buyer Transition",
     tooltip = "Requires the buyer-minus-seller imbalance to improve by at least this percentage of the POC row's total volume.")
bool showVALBuyerRelativeShift = input.bool(
     true,
     title = "Show Highest Buyer Ratio Near VAL",
     group = "VAL Buyer Shift",
     tooltip = "Shows the single highest positive buyer / seller ratio within the selected number of histogram rows on either side of VAL.")
int valBuyerRelativeMaxDistanceRows = input.int(
     6,
     title = "Maximum Distance From VAL (Rows)",
     minval = 1,
     maxval = 50,
     group = "VAL Buyer Shift",
     tooltip = "Counts histogram rows rather than price percentage so the proximity rule adapts to each profile's row size.")

color upVolumeColor = input.color(
     color.rgb(38, 166, 154),
     title = "Up Volume",
     group = "Profile Colors")
color downVolumeColor = input.color(
     color.rgb(239, 83, 80),
     title = "Down Volume",
     group = "Profile Colors")
color valueAreaUpColor = input.color(
     color.rgb(0, 188, 212),
     title = "Value Area Up",
     group = "Profile Colors")
color valueAreaDownColor = input.color(
     color.rgb(236, 64, 122),
     title = "Value Area Down",
     group = "Profile Colors")
color totalVolumeColor = input.color(
     color.rgb(96, 125, 139),
     title = "Total Volume",
     group = "Profile Colors")
color valueAreaTotalColor = input.color(
     color.rgb(41, 182, 246),
     title = "Value Area Total",
     group = "Profile Colors")
color profileBackgroundColor = input.color(
     color.new(color.rgb(33, 45, 62), 88),
     title = "Profile Background",
     group = "Profile Colors")
color buyerZoneColor = input.color(
     color.rgb(0, 188, 212),
     title = "Top Four Buyer Rows",
     group = "Profile Colors")
color sellerZoneColor = input.color(
     color.rgb(239, 83, 80),
     title = "Top Two Seller Rows",
     group = "Profile Colors")
color localBuyerDominanceColor = input.color(
     color.lime,
     title = "Local Buyer-Dominance Reversals",
     group = "Profile Colors")
color valBuyerShiftColor = input.color(
     color.orange,
     title = "VAL Buyer Shift",
     group = "Profile Colors")
color valBuyerControlColor = input.color(
     color.lime,
     title = "VAL Buyer Control",
     group = "Profile Colors")

// A profile above the split threshold retains its calculated rows but renders
// in Total mode to stay within TradingView's drawing-object limit.
const int MAX_ROWS_PER_PROFILE = 240
const int MAX_SPLIT_ROWS = 120
const int MAX_SIGNAL_ROWS = 2000
const int MAX_FOOTPRINT_POINTS = 90000
const int PROFILE_META_SIZE = 11
const int META_VAH = 0
const int META_POC = 1
const int META_VAL = 2
const int META_BOTTOM = 3
const int META_TOP = 4
const int META_ROW_HEIGHT = 5
const int META_ROW_COUNT = 6
const int META_TOTAL_VOLUME = 7
const int META_POC_ROW = 8
const int META_VAL_ROW = 9
const int META_VAH_ROW = 10
const int REGION_VAL_TO_POC = 0
const int REGION_POC_TO_VAH = 1
const int REGION_BELOW_VAL = 2
const int REGION_ABOVE_VAH = 3

// =============================================================================
// 2. CAPTURE THE RANGE'S PROFILE INPUT DATA
// =============================================================================
// Native footprint rows are the primary source. OHLCV is retained both for the
// profile's complete high-low span and as an explicit fallback when footprint
// history is unavailable for any nonzero-volume bar in the selected range.

var float[] rangeOpensA = array.new_float(0)
var float[] rangeHighsA = array.new_float(0)
var float[] rangeLowsA = array.new_float(0)
var float[] rangeClosesA = array.new_float(0)
var float[] rangeVolumesA = array.new_float(0)
var float[] rangeFootprintPricesA = array.new_float(0)
var float[] rangeFootprintBuyVolumesA = array.new_float(0)
var float[] rangeFootprintSellVolumesA = array.new_float(0)

var float totalVolA = 0.0
var int footprintCoveredBarsA = 0
var bool footprintCapacityExceededA = false

// A one-tick native footprint preserves TradingView's finest available
// intrabar price/volume information. The profile calculation below coalesces
// these rows into the user's selected Number of Rows or Ticks Per Row layout.
// Pine permits only one request.footprint() call in a script.
footprint barFootprintA = request.footprint(1)

if barstate.isfirst
    array.clear(rangeOpensA)
    array.clear(rangeHighsA)
    array.clear(rangeLowsA)
    array.clear(rangeClosesA)
    array.clear(rangeVolumesA)
    array.clear(rangeFootprintPricesA)
    array.clear(rangeFootprintBuyVolumesA)
    array.clear(rangeFootprintSellVolumesA)
    totalVolA := 0.0
    footprintCoveredBarsA := 0
    footprintCapacityExceededA := false

bool inRangeA = time >= startA and time <= endA
float currentVolume = nz(volume)

if inRangeA
    array.push(rangeOpensA, open)
    array.push(rangeHighsA, high)
    array.push(rangeLowsA, low)
    array.push(rangeClosesA, close)
    array.push(rangeVolumesA, currentVolume)
    totalVolA += currentVolume

    if useNativeFootprint and not footprintCapacityExceededA
        if not na(barFootprintA)
            array<volume_row> footprintRowsA = barFootprintA.rows()
            int footprintRowCountA = array.size(footprintRowsA)
            bool hasFootprintCapacityA =
                 array.size(rangeFootprintPricesA) + footprintRowCountA <=
                      MAX_FOOTPRINT_POINTS

            if hasFootprintCapacityA
                if footprintRowCountA > 0
                    for footprintRowIndexA = 0 to footprintRowCountA - 1
                        volume_row footprintRowA =
                             array.get(
                                  footprintRowsA,
                                  footprintRowIndexA)
                        float footprintPriceA =
                             (footprintRowA.down_price() +
                                  footprintRowA.up_price()) * 0.5
                        array.push(
                             rangeFootprintPricesA,
                             footprintPriceA)
                        array.push(
                             rangeFootprintBuyVolumesA,
                             footprintRowA.buy_volume())
                        array.push(
                             rangeFootprintSellVolumesA,
                             footprintRowA.sell_volume())
                footprintCoveredBarsA += 1
            else
                footprintCapacityExceededA := true
                footprintCoveredBarsA := 0
                array.clear(rangeFootprintPricesA)
                array.clear(rangeFootprintBuyVolumesA)
                array.clear(rangeFootprintSellVolumesA)
        else if currentVolume <= 0.0
            // A zero-volume bar has no footprint rows but is still complete.
            footprintCoveredBarsA += 1

bool usesNativeFootprintA =
     useNativeFootprint and
     not footprintCapacityExceededA and
     array.size(rangeVolumesA) > 0 and
     footprintCoveredBarsA == array.size(rangeVolumesA) and
     array.size(rangeFootprintPricesA) > 0

// =============================================================================
// 3. PROFILE CALCULATION
// =============================================================================
f_ticksPerRow(
     int totalTicks,
     string layout,
     int requestedSize,
     int maximumRows) =>
    int selectedTicks = math.max(1, requestedSize)

    if layout == "Number of Rows"
        int requestedRows = math.max(1, requestedSize)
        float rawTicks = float(totalTicks) / requestedRows
        int ticksDown = math.max(1, int(math.floor(rawTicks)))
        int ticksUp = math.max(1, int(math.ceil(rawTicks)))
        int rowsWithDown = int(math.ceil(float(totalTicks) / ticksDown))
        int rowsWithUp = int(math.ceil(float(totalTicks) / ticksUp))

        // TradingView chooses the whole-tick row height whose resulting row
        // count is closest to the requested number of rows.
        selectedTicks :=
             math.abs(rowsWithDown - requestedRows) <=
                  math.abs(rowsWithUp - requestedRows) ?
             ticksDown : ticksUp

    // Keep the histogram within the platform's drawing-object limit. This
    // only affects extremely fine Ticks Per Row selections.
    int calculatedRows = int(math.ceil(float(totalTicks) / selectedTicks))
    int safeMaximumRows = math.max(1, maximumRows)
    if calculatedRows > safeMaximumRows
        selectedTicks :=
             int(math.ceil(float(totalTicks) / safeMaximumRows))

    selectedTicks

f_calculateProfile(
     float[] opens,
     float[] highs,
     float[] lows,
     float[] closes,
     float[] volumes,
     float[] footprintPrices,
     float[] footprintBuyVolumes,
     float[] footprintSellVolumes,
     bool useFootprintRows,
     string layout,
     int requestedSize,
     float targetPct,
     int maximumRows,
     bool anchorRowsToGrid) =>
    float[] result = array.new_float(0)
    int sourceBars = array.size(volumes)

    if sourceBars > 0
        float rawRangeLow = array.min(lows)
        float rawRangeHigh = array.max(highs)
        float profileBottom =
             math.floor(rawRangeLow / syminfo.mintick) * syminfo.mintick
        float profileTop =
             math.ceil(rawRangeHigh / syminfo.mintick) * syminfo.mintick
        int totalTicks = math.max(
             1,
             int(math.round(
                  (profileTop - profileBottom) / syminfo.mintick)))
        int ticksPerRow =
             f_ticksPerRow(
                  totalTicks,
                  layout,
                  requestedSize,
                  maximumRows)
        float rowHeight = ticksPerRow * syminfo.mintick

        // The displayed FRVP begins at the selected range's low, matching the
        // built-in tool. The stable control profile instead anchors boundaries
        // to absolute multiples of its row height. Adding unused lower prices
        // therefore cannot shift the buyer-control rows at higher prices.
        if anchorRowsToGrid
            profileBottom :=
                 math.floor(
                      rawRangeLow / rowHeight + 0.0000001) *
                      rowHeight
            profileTop :=
                 math.ceil(
                      rawRangeHigh / rowHeight - 0.0000001) *
                      rowHeight
            totalTicks := math.max(
                 1,
                 int(math.round(
                      (profileTop - profileBottom) /
                           syminfo.mintick)))

        int rowCount = math.max(
             1,
             int(math.ceil(float(totalTicks) / ticksPerRow)))
        float[] rowVolumes = array.new_float(rowCount, 0.0)
        float[] rowUpVolumes = array.new_float(rowCount, 0.0)
        float[] rowDownVolumes = array.new_float(rowCount, 0.0)
        float totalProfileVolume = 0.0

        if useFootprintRows and array.size(footprintPrices) > 0
            int footprintPointCount = array.size(footprintPrices)
            for footprintIndex = 0 to footprintPointCount - 1
                float footprintPrice =
                     array.get(footprintPrices, footprintIndex)
                float footprintBuyVolume =
                     nz(array.get(footprintBuyVolumes, footprintIndex))
                float footprintSellVolume =
                     nz(array.get(footprintSellVolumes, footprintIndex))
                float footprintTotalVolume =
                     footprintBuyVolume + footprintSellVolume
                int footprintProfileRow = math.max(
                     0,
                     math.min(
                          rowCount - 1,
                          int(math.floor(
                               (footprintPrice - profileBottom) /
                                    rowHeight))))

                totalProfileVolume += footprintTotalVolume
                array.set(
                     rowVolumes,
                     footprintProfileRow,
                     array.get(rowVolumes, footprintProfileRow) +
                          footprintTotalVolume)
                array.set(
                     rowUpVolumes,
                     footprintProfileRow,
                     array.get(rowUpVolumes, footprintProfileRow) +
                          footprintBuyVolume)
                array.set(
                     rowDownVolumes,
                     footprintProfileRow,
                     array.get(rowDownVolumes, footprintProfileRow) +
                          footprintSellVolume)
        else
            // Explicit fallback for chart history where native footprints are
            // unavailable: distribute each candle's volume evenly across all
            // profile rows traversed by its high-low range.
            for sourceIndex = 0 to sourceBars - 1
                float barHigh = array.get(highs, sourceIndex)
                float barLow = array.get(lows, sourceIndex)
                bool isUpBar =
                     array.get(closes, sourceIndex) >=
                          array.get(opens, sourceIndex)
                float barVolume = array.get(volumes, sourceIndex)
                totalProfileVolume += barVolume

                if barHigh <= barLow
                    int singleRow = math.max(
                         0,
                         math.min(
                              rowCount - 1,
                              int(math.floor(
                                   (barLow - profileBottom) / rowHeight))))
                    array.set(
                         rowVolumes,
                         singleRow,
                         array.get(rowVolumes, singleRow) + barVolume)
                    if isUpBar
                        array.set(
                             rowUpVolumes,
                             singleRow,
                             array.get(rowUpVolumes, singleRow) + barVolume)
                    else
                        array.set(
                             rowDownVolumes,
                             singleRow,
                             array.get(rowDownVolumes, singleRow) + barVolume)
                else
                    int firstRow = math.max(
                         0,
                         int(math.floor(
                              (barLow - profileBottom) / rowHeight)))
                    int lastRow = math.min(
                         rowCount - 1,
                         int(math.floor(
                              (barHigh - profileBottom) / rowHeight)))
                    int touchedRows = math.max(
                         1,
                         lastRow - firstRow + 1)
                    float allocatedVolume =
                         barVolume / float(touchedRows)

                    for rowIndex = firstRow to lastRow
                        array.set(
                             rowVolumes,
                             rowIndex,
                             array.get(rowVolumes, rowIndex) +
                                  allocatedVolume)
                        if isUpBar
                            array.set(
                                 rowUpVolumes,
                                 rowIndex,
                                 array.get(rowUpVolumes, rowIndex) +
                                      allocatedVolume)
                        else
                            array.set(
                                 rowDownVolumes,
                                 rowIndex,
                                 array.get(rowDownVolumes, rowIndex) +
                                      allocatedVolume)

        // The POC is the row containing the greatest total volume.
        int pocRow = 0
        float pocRowVolume = array.get(rowVolumes, 0)
        if rowCount > 1
            for rowIndex = 1 to rowCount - 1
                float candidateVolume = array.get(rowVolumes, rowIndex)
                if candidateVolume > pocRowVolume
                    pocRow := rowIndex
                    pocRowVolume := candidateVolume

        // Build a contiguous value area from the POC. At each step include the
        // larger of the immediately adjacent rows. For equal volume, prefer
        // the row closer to the POC; if distance also ties, prefer the upper
        // row, matching TradingView's documented tie-break rules.
        int valueLowRow = pocRow
        int valueHighRow = pocRow
        float includedVolume = pocRowVolume
        float targetVolume = totalProfileVolume * targetPct / 100.0

        while includedVolume < targetVolume and
             (valueLowRow > 0 or valueHighRow < rowCount - 1)
            float belowVolume =
                 valueLowRow > 0 ?
                 array.get(rowVolumes, valueLowRow - 1) : -1.0
            float aboveVolume =
                 valueHighRow < rowCount - 1 ?
                 array.get(rowVolumes, valueHighRow + 1) : -1.0

            int belowDistance =
                 valueLowRow > 0 ?
                 pocRow - (valueLowRow - 1) : 1000000
            int aboveDistance =
                 valueHighRow < rowCount - 1 ?
                 (valueHighRow + 1) - pocRow : 1000000
            bool chooseAbove =
                 aboveVolume > belowVolume or
                 (aboveVolume == belowVolume and
                      aboveDistance <= belowDistance)
            float candidateVolume =
                 chooseAbove ? aboveVolume : belowVolume

            // TradingView stops before an adjacent row that would push the
            // value area beyond its requested percentage. The old logic added
            // that row first, which displaced VAH/VAL on concentrated profiles.
            if includedVolume + candidateVolume > targetVolume
                break
            else if chooseAbove and valueHighRow < rowCount - 1
                valueHighRow += 1
                includedVolume += candidateVolume
            else if valueLowRow > 0
                valueLowRow -= 1
                includedVolume += candidateVolume

        float valPrice = profileBottom + valueLowRow * rowHeight
        float vahPrice = math.min(
             profileTop,
             profileBottom + (valueHighRow + 1) * rowHeight)
        float pocRowLow = profileBottom + pocRow * rowHeight
        float pocRowHigh = math.min(profileTop, pocRowLow + rowHeight)
        float pocPrice = (pocRowLow + pocRowHigh) * 0.5

        array.push(result, vahPrice)
        array.push(result, pocPrice)
        array.push(result, valPrice)
        array.push(result, profileBottom)
        array.push(result, profileTop)
        array.push(result, rowHeight)
        array.push(result, float(rowCount))
        array.push(result, totalProfileVolume)
        array.push(result, float(pocRow))
        array.push(result, float(valueLowRow))
        array.push(result, float(valueHighRow))
        for rowIndex = 0 to rowCount - 1
            array.push(result, array.get(rowVolumes, rowIndex))
        for rowIndex = 0 to rowCount - 1
            array.push(result, array.get(rowUpVolumes, rowIndex))
        for rowIndex = 0 to rowCount - 1
            array.push(result, array.get(rowDownVolumes, rowIndex))

    result

f_profileRegionVolume(float[] profile, int region) =>
    float regionVolume = na

    if array.size(profile) >= PROFILE_META_SIZE
        int rowCount = int(array.get(profile, META_ROW_COUNT))
        int pocRow = int(array.get(profile, META_POC_ROW))
        int valueLowRow = int(array.get(profile, META_VAL_ROW))
        int valueHighRow = int(array.get(profile, META_VAH_ROW))
        regionVolume := 0.0

        for rowIndex = 0 to rowCount - 1
            bool includeRow =
                 region == REGION_VAL_TO_POC ?
                      rowIndex >= valueLowRow and rowIndex <= pocRow :
                 region == REGION_POC_TO_VAH ?
                      rowIndex > pocRow and rowIndex <= valueHighRow :
                 region == REGION_BELOW_VAL ?
                      rowIndex < valueLowRow :
                 region == REGION_ABOVE_VAH ?
                      rowIndex > valueHighRow : false

            if includeRow
                regionVolume += array.get(
                     profile,
                     PROFILE_META_SIZE + rowIndex)

    regionVolume

f_profileRegionDirectionalVolumes(float[] profile, int region) =>
    float[] directionalVolumes = array.new_float(0)

    if array.size(profile) >= PROFILE_META_SIZE
        int rowCount = int(array.get(profile, META_ROW_COUNT))
        int pocRow = int(array.get(profile, META_POC_ROW))
        int valueLowRow = int(array.get(profile, META_VAL_ROW))
        int valueHighRow = int(array.get(profile, META_VAH_ROW))
        int upVolumeOffset = PROFILE_META_SIZE + rowCount
        int downVolumeOffset = PROFILE_META_SIZE + rowCount * 2
        float buyerVolume = 0.0
        float sellerVolume = 0.0

        for rowIndex = 0 to rowCount - 1
            bool includeRow =
                 region == REGION_VAL_TO_POC ?
                      rowIndex >= valueLowRow and rowIndex <= pocRow :
                 region == REGION_POC_TO_VAH ?
                      rowIndex > pocRow and rowIndex <= valueHighRow : false

            if includeRow
                buyerVolume += array.get(
                     profile,
                     upVolumeOffset + rowIndex)
                sellerVolume += array.get(
                     profile,
                     downVolumeOffset + rowIndex)

        array.push(directionalVolumes, buyerVolume)
        array.push(directionalVolumes, sellerVolume)

    directionalVolumes

f_topDirectionalRows(
     float[] profile,
     bool useBuyerVolume,
     int requestedRows) =>
    float[] strongestRows = array.new_float(0)

    if array.size(profile) >= PROFILE_META_SIZE
        int rowCount = int(array.get(profile, META_ROW_COUNT))
        float profileBottom = array.get(profile, META_BOTTOM)
        float profileTop = array.get(profile, META_TOP)
        float rowHeight = array.get(profile, META_ROW_HEIGHT)
        int upVolumeOffset = PROFILE_META_SIZE + rowCount
        int downVolumeOffset =
             PROFILE_META_SIZE + rowCount * 2
        int primaryVolumeOffset =
             useBuyerVolume ? upVolumeOffset : downVolumeOffset
        int opposingVolumeOffset =
             useBuyerVolume ? downVolumeOffset : upVolumeOffset
        int[] selectedRows = array.new_int(0)
        int resultCount = math.min(requestedRows, rowCount)

        // Rank individual rows, not merged neighborhoods. Each pass selects
        // one unused row. Using >= while iterating upward makes the higher
        // price win an equal-volume tie.
        if resultCount > 0
            for resultIndex = 0 to resultCount - 1
                int selectedRow = -1
                float selectedVolume = -1.0

                for rowIndex = 0 to rowCount - 1
                    bool wasAlreadySelected =
                         array.includes(selectedRows, rowIndex)
                    float rowDirectionalVolume = array.get(
                         profile,
                         primaryVolumeOffset + rowIndex)
                    if not wasAlreadySelected and
                         rowDirectionalVolume >= selectedVolume
                        selectedRow := rowIndex
                        selectedVolume := rowDirectionalVolume

                if selectedRow >= 0 and selectedVolume > 0.0
                    array.push(selectedRows, selectedRow)
                    float selectedLow =
                         profileBottom + selectedRow * rowHeight
                    float selectedHigh = math.min(
                         profileTop,
                         selectedLow + rowHeight)
                    array.push(strongestRows, selectedLow)
                    array.push(strongestRows, selectedHigh)
                    array.push(strongestRows, selectedVolume)
                    array.push(
                         strongestRows,
                         array.get(
                              profile,
                              opposingVolumeOffset + selectedRow))

    strongestRows

f_valBuyerTransition(
     float[] profile,
     float maximumDistancePct,
     float minimumRowVolumePct,
     float minimumImprovementPct) =>
    float[] transition = array.new_float(0)

    if array.size(profile) >= PROFILE_META_SIZE
        int rowCount = int(array.get(profile, META_ROW_COUNT))
        int pocRow = int(array.get(profile, META_POC_ROW))
        int valueLowRow = int(array.get(profile, META_VAL_ROW))
        float profileBottom = array.get(profile, META_BOTTOM)
        float rowHeight = array.get(profile, META_ROW_HEIGHT)
        float valPrice = array.get(profile, META_VAL)
        int totalVolumeOffset = PROFILE_META_SIZE
        int upVolumeOffset = PROFILE_META_SIZE + rowCount
        int downVolumeOffset =
             PROFILE_META_SIZE + rowCount * 2
        float pocRowVolume = array.get(
             profile,
             totalVolumeOffset + pocRow)
        float minimumRowVolume =
             pocRowVolume * minimumRowVolumePct / 100.0
        float minimumImprovement =
             pocRowVolume * minimumImprovementPct / 100.0
        float minimumBoundaryPrice =
             valPrice * (1.0 - maximumDistancePct / 100.0)
        bool foundTransition = false

        // Scan upward through price so the label marks the first persistent
        // improvement from seller control toward VAL, rather than a later
        // buyer-dominant row after the transition is already established.
        if valueLowRow > 0 and pocRowVolume > 0.0
            for lowerRow = 0 to valueLowRow - 1
                int upperRow = lowerRow + 1
                float boundaryPrice =
                     profileBottom + upperRow * rowHeight
                float lowerBuyer = array.get(
                     profile,
                     upVolumeOffset + lowerRow)
                float lowerSeller = array.get(
                     profile,
                     downVolumeOffset + lowerRow)
                float upperBuyer = array.get(
                     profile,
                     upVolumeOffset + upperRow)
                float upperSeller = array.get(
                     profile,
                     downVolumeOffset + upperRow)
                float lowerImbalance = lowerBuyer - lowerSeller
                float upperImbalance = upperBuyer - upperSeller
                float imbalanceImprovement =
                     upperImbalance - lowerImbalance
                float lowerTotalVolume = array.get(
                     profile,
                     totalVolumeOffset + lowerRow)
                float upperTotalVolume = array.get(
                     profile,
                     totalVolumeOffset + upperRow)
                bool isNearVAL =
                     boundaryPrice >= minimumBoundaryPrice and
                     boundaryPrice <= valPrice
                bool hasEnoughVolume =
                     lowerTotalVolume >= minimumRowVolume and
                     upperTotalVolume >= minimumRowVolume
                bool startsWithSellerControl =
                     lowerImbalance < 0.0
                bool improvesEnough =
                     imbalanceImprovement >= minimumImprovement
                bool improvementPersists = false
                if upperRow < valueLowRow
                    float nextImbalance =
                         array.get(
                              profile,
                              upVolumeOffset + upperRow + 1) -
                         array.get(
                              profile,
                              downVolumeOffset + upperRow + 1)
                    improvementPersists :=
                         nextImbalance >= upperImbalance
                else
                    improvementPersists := upperImbalance > 0.0

                if not foundTransition and
                     isNearVAL and
                     hasEnoughVolume and
                     startsWithSellerControl and
                     improvesEnough and
                     improvementPersists
                    bool establishesBuyerControl =
                         upperImbalance > 0.0
                    array.push(transition, boundaryPrice)
                    array.push(
                         transition,
                         establishesBuyerControl ? 1.0 : 0.0)
                    array.push(transition, imbalanceImprovement)
                    array.push(transition, lowerImbalance)
                    array.push(transition, upperImbalance)
                    foundTransition := true

    transition

f_highestBuyerRelativeNearVAL(
     float[] profile,
     int maximumDistanceRows) =>
    float[] shift = array.new_float(0)

    if array.size(profile) >= PROFILE_META_SIZE
        int rowCount = int(array.get(profile, META_ROW_COUNT))
        float profileBottom = array.get(profile, META_BOTTOM)
        float profileTop = array.get(profile, META_TOP)
        float rowHeight = array.get(profile, META_ROW_HEIGHT)
        int valueLowRow = int(array.get(profile, META_VAL_ROW))
        int upVolumeOffset = PROFILE_META_SIZE + rowCount
        int downVolumeOffset = PROFILE_META_SIZE + rowCount * 2
        int selectedRow = -1
        float selectedPrice = na
        float selectedRelative = -1.0
        int selectedDistance = 1000000000
        float selectedBuyerVolume = 0.0
        float selectedSellerVolume = 0.0

        // Select exactly one row within a consistent histogram-row distance
        // on either side of VAL. There is deliberately no minimum-volume,
        // persistence, or adjacent-row requirement.
        if rowCount > 0
            for rowIndex = 0 to rowCount - 1
                float rowLow =
                     profileBottom + rowIndex * rowHeight
                float rowHigh = math.min(
                     profileTop,
                     rowLow + rowHeight)
                float rowCenter = (rowLow + rowHigh) * 0.5
                float buyerVolume = array.get(
                     profile,
                     upVolumeOffset + rowIndex)
                float sellerVolume = array.get(
                     profile,
                     downVolumeOffset + rowIndex)
                bool isNearVAL =
                     math.abs(rowIndex - valueLowRow) <=
                          maximumDistanceRows
                bool hasPositiveRelative =
                     buyerVolume > sellerVolume and
                     sellerVolume > 0.0
                float relativeValue =
                     hasPositiveRelative ?
                     buyerVolume / sellerVolume : 0.0
                int distanceFromVAL =
                     math.abs(rowIndex - valueLowRow)
                bool isBetterRelative =
                     relativeValue > selectedRelative
                bool isCloserTie =
                     relativeValue == selectedRelative and
                     distanceFromVAL < selectedDistance
                bool isHigherPriceTie =
                     relativeValue == selectedRelative and
                     distanceFromVAL == selectedDistance and
                     (na(selectedPrice) or rowCenter > selectedPrice)

                if isNearVAL and
                     hasPositiveRelative and
                     (isBetterRelative or
                          isCloserTie or
                          isHigherPriceTie)
                    selectedRow := rowIndex
                    selectedPrice := rowCenter
                    selectedRelative := relativeValue
                    selectedDistance := distanceFromVAL
                    selectedBuyerVolume := buyerVolume
                    selectedSellerVolume := sellerVolume

        if selectedRow >= 0
            array.push(shift, selectedPrice)
            array.push(shift, selectedRelative)
            array.push(shift, selectedBuyerVolume)
            array.push(shift, selectedSellerVolume)

    shift

f_formatVolume(float volumeValue) =>
    na(volumeValue) ? "n/a" : str.tostring(volumeValue, "#,###")

f_formatCompactVolume(float volumeValue) =>
    string formattedVolume = "n/a"

    if not na(volumeValue)
        float absoluteVolume = math.abs(volumeValue)
        formattedVolume :=
             absoluteVolume >= 1000000000.0 ?
                  str.tostring(volumeValue / 1000000000.0, "#.##") + "B" :
             absoluteVolume >= 1000000.0 ?
                  str.tostring(volumeValue / 1000000.0, "#.##") + "M" :
             absoluteVolume >= 1000.0 ?
                  str.tostring(volumeValue / 1000.0, "#.##") + "K" :
                  str.tostring(volumeValue, "#")

    formattedVolume

f_directionalRelative(float primaryVolume, float opposingVolume) =>
    float relativeValue =
         opposingVolume > 0.0 ?
         primaryVolume / opposingVolume :
         primaryVolume > 0.0 ? 1000000000.0 : 0.0

    relativeValue

f_directionalText(float primaryVolume, float opposingVolume) =>
    string relativeText =
         opposingVolume > 0.0 ?
         str.tostring(
              f_directionalRelative(
                   primaryVolume,
                   opposingVolume),
              "#.##") : "n/a"

    f_formatCompactVolume(primaryVolume) +
         " x " +
         f_formatCompactVolume(opposingVolume) +
         " | R: " +
         relativeText

var float[] profileA = array.new_float(0)
var float[] valBuyerControlProfileA = array.new_float(0)
var float vahA = na
var float pocA = na
var float valA = na

if barstate.islast
    profileA := f_calculateProfile(
         rangeOpensA,
         rangeHighsA,
         rangeLowsA,
         rangeClosesA,
         rangeVolumesA,
         rangeFootprintPricesA,
         rangeFootprintBuyVolumesA,
         rangeFootprintSellVolumesA,
         usesNativeFootprintA,
         rowsLayout,
         rowSize,
         valueAreaPct,
         MAX_ROWS_PER_PROFILE,
         false)

    if useStableVALBuyerControlRows
        int stableControlTicksPerRowA = math.max(
             1,
             int(math.round(
                  valBuyerControlRowHeight /
                       syminfo.mintick)))
        valBuyerControlProfileA := f_calculateProfile(
             rangeOpensA,
             rangeHighsA,
             rangeLowsA,
             rangeClosesA,
             rangeVolumesA,
             rangeFootprintPricesA,
             rangeFootprintBuyVolumesA,
             rangeFootprintSellVolumesA,
             usesNativeFootprintA,
             "Ticks Per Row",
             stableControlTicksPerRowA,
             valueAreaPct,
             MAX_SIGNAL_ROWS,
             true)
    else
        valBuyerControlProfileA := profileA

    vahA := array.size(profileA) >= PROFILE_META_SIZE ?
         array.get(profileA, META_VAH) : na
    pocA := array.size(profileA) >= PROFILE_META_SIZE ?
         array.get(profileA, META_POC) : na
    valA := array.size(profileA) >= PROFILE_META_SIZE ?
         array.get(profileA, META_VAL) : na

float volumeVALToPOCA = f_profileRegionVolume(
     profileA,
     REGION_VAL_TO_POC)
float volumePOCToVAHA = f_profileRegionVolume(
     profileA,
     REGION_POC_TO_VAH)
float volumeBelowVALA = f_profileRegionVolume(
     profileA,
     REGION_BELOW_VAL)
float volumeAboveVAHA = f_profileRegionVolume(
     profileA,
     REGION_ABOVE_VAH)
float[] directionalVALToPOCA =
     f_profileRegionDirectionalVolumes(
          profileA,
          REGION_VAL_TO_POC)
float[] directionalPOCToVAHA =
     f_profileRegionDirectionalVolumes(
          profileA,
          REGION_POC_TO_VAH)
float[] stableVALBuyerTransitionA = f_valBuyerTransition(
     valBuyerControlProfileA,
     valBuyerMaxDistancePct,
     valBuyerMinRowVolumePct,
     valBuyerMinImprovementPct)
float[] originalVALBuyerTransitionA = f_valBuyerTransition(
     profileA,
     valBuyerMaxDistancePct,
     valBuyerMinRowVolumePct,
     valBuyerMinImprovementPct)
float[] valBuyerTransitionA = array.new_float(0)
if array.size(originalVALBuyerTransitionA) >= 5
    valBuyerTransitionA := originalVALBuyerTransitionA
else if useStableVALBuyerControlRows and
     array.size(stableVALBuyerTransitionA) >= 5
    valBuyerTransitionA := stableVALBuyerTransitionA
float[] valBuyerRelativeShiftA = f_highestBuyerRelativeNearVAL(
     profileA,
     valBuyerRelativeMaxDistanceRows)

// =============================================================================
// 4. LINES AND HISTOGRAMS
// =============================================================================
var line lineStartA = line.new(
     na, na, na, na,
     xloc = xloc.bar_time,
     color = color.new(color.aqua, 40),
     style = line.style_dashed,
     width = 1)
var line lineEndA = line.new(
     na, na, na, na,
     xloc = xloc.bar_time,
     color = color.new(color.aqua, 40),
     style = line.style_dashed,
     width = 1)

var line lineVahA = line.new(
     na, na, na, na,
     xloc = xloc.bar_time,
     color = color.red,
     width = 1)
var line linePocA = line.new(
     na, na, na, na,
     xloc = xloc.bar_time,
     color = color.white,
     width = 2)
var line lineValA = line.new(
     na, na, na, na,
     xloc = xloc.bar_time,
     color = color.green,
     width = 1)

var box[] histBoxesA = array.new_box(0)
var box profileBackgroundA = na
var box[] buyerVolumeZonesA = array.new_box(0)
var label[] buyerVolumeLabelsA = array.new_label(0)
var box[] sellerVolumeZonesA = array.new_box(0)
var label[] sellerVolumeLabelsA = array.new_label(0)
var label[] localBuyerDominanceLabelsA = array.new_label(0)
var label valBuyerTransitionLabelA = na
var label valBuyerRelativeShiftLabelA = na
var label valToPocDirectionalLabelA = na
var label pocToVahDirectionalLabelA = na

f_clearBoxes(box[] boxes) =>
    if array.size(boxes) > 0
        for boxIndex = 0 to array.size(boxes) - 1
            box.delete(array.get(boxes, boxIndex))
        array.clear(boxes)

f_clearLabels(label[] labels) =>
    if array.size(labels) > 0
        for labelIndex = 0 to array.size(labels) - 1
            label.delete(array.get(labels, labelIndex))
        array.clear(labels)

f_drawDirectionalRows(
     float[] directionalRows,
     box[] zoneBoxes,
     label[] volumeLabels,
     int rangeStartTime,
     int rangeEndTime,
     int labelTime,
     color zoneColor,
     color labelColor,
     bool showRows,
     bool showVolumes) =>
    int resultCount = int(array.size(directionalRows) / 4)
    int highestRelativeIndex = -1
    float highestRelative = -1.0

    if resultCount > 0
        for resultIndex = 0 to resultCount - 1
            int resultOffset = resultIndex * 4
            float relativeValue = f_directionalRelative(
                 array.get(directionalRows, resultOffset + 2),
                 array.get(directionalRows, resultOffset + 3))
            if relativeValue >= 1.0 and
                 relativeValue >= highestRelative
                highestRelativeIndex := resultIndex
                highestRelative := relativeValue

        if showRows
            for resultIndex = 0 to resultCount - 1
                int resultOffset = resultIndex * 4
                float rowBottom = array.get(
                     directionalRows,
                     resultOffset)
                float rowTop = array.get(
                     directionalRows,
                     resultOffset + 1)
                float primaryVolume = array.get(
                     directionalRows,
                     resultOffset + 2)
                float opposingVolume = array.get(
                     directionalRows,
                     resultOffset + 3)
                float relativeValue = f_directionalRelative(
                     primaryVolume,
                     opposingVolume)

                if relativeValue >= 1.0
                    bool isHighestRelative =
                         resultIndex == highestRelativeIndex
                    box directionalRow = box.new(
                         left = rangeStartTime,
                         top = rowTop,
                         right = rangeEndTime,
                         bottom = rowBottom,
                         xloc = xloc.bar_time,
                         bgcolor = color.new(
                              zoneColor,
                              isHighestRelative ? 60 : 88),
                         border_color = color.new(
                              zoneColor,
                              isHighestRelative ? 0 : 50),
                         border_width = 1)
                    array.push(zoneBoxes, directionalRow)

                    if showVolumes
                        label directionalLabel = label.new(
                             x = labelTime,
                             y = (rowBottom + rowTop) / 2.0,
                             text = f_directionalText(
                                  primaryVolume,
                                  opposingVolume),
                             xloc = xloc.bar_time,
                             yloc = yloc.price,
                             style = label.style_label_right,
                             color = labelColor,
                             textcolor = color.white,
                             size = size.tiny)
                        array.push(volumeLabels, directionalLabel)

f_drawLocalBuyerDominanceRows(
     float[] profile,
     label[] labels,
     int markerTime,
     color markerColor) =>
    if array.size(profile) >= PROFILE_META_SIZE
        int rowCount = int(array.get(profile, META_ROW_COUNT))
        float profileBottom = array.get(profile, META_BOTTOM)
        float profileTop = array.get(profile, META_TOP)
        float rowHeight = array.get(profile, META_ROW_HEIGHT)
        int upVolumeOffset = PROFILE_META_SIZE + rowCount
        int downVolumeOffset =
             PROFILE_META_SIZE + rowCount * 2

        if rowCount >= 3
            for rowIndex = 1 to rowCount - 2
                float buyerBelow = array.get(
                     profile,
                     upVolumeOffset + rowIndex - 1)
                float buyerCurrent = array.get(
                     profile,
                     upVolumeOffset + rowIndex)
                float buyerAbove = array.get(
                     profile,
                     upVolumeOffset + rowIndex + 1)
                float sellerBelow = array.get(
                     profile,
                     downVolumeOffset + rowIndex - 1)
                float sellerCurrent = array.get(
                     profile,
                     downVolumeOffset + rowIndex)
                float sellerAbove = array.get(
                     profile,
                     downVolumeOffset + rowIndex + 1)
                bool hasLocalBuyerDominance =
                     buyerCurrent > buyerBelow and
                     buyerCurrent > buyerAbove and
                     sellerCurrent < sellerBelow and
                     sellerCurrent < sellerAbove and
                     buyerCurrent >= sellerCurrent

                if hasLocalBuyerDominance
                    float rowLow =
                         profileBottom + rowIndex * rowHeight
                    float rowHigh = math.min(
                         profileTop,
                         rowLow + rowHeight)
                    label reversalMarker = label.new(
                         x = markerTime,
                         y = (rowLow + rowHigh) / 2.0,
                         text = "Reversal",
                         xloc = xloc.bar_time,
                         yloc = yloc.price,
                         style = label.style_label_right,
                         color = markerColor,
                         textcolor = color.white,
                         size = size.tiny)
                    array.push(labels, reversalMarker)

f_drawHistogram(
     float[] profile,
     box[] boxes,
     int rangeStartTime,
     int rangeEndTime,
     int barDurationMs,
     int widthPct,
     string placement,
     string displayMode,
     color upColor,
     color downColor,
     color valueUpColor,
     color valueDownColor,
     color totalColor,
     color valueTotalColor) =>
    if array.size(profile) >= PROFILE_META_SIZE and
         not na(rangeStartTime) and
         not na(rangeEndTime)
        float profileTop = array.get(profile, META_TOP)
        float rowHeight = array.get(profile, META_ROW_HEIGHT)
        int rowCount = int(array.get(profile, META_ROW_COUNT))
        int valueLowRow = int(array.get(profile, META_VAL_ROW))
        int valueHighRow = int(array.get(profile, META_VAH_ROW))
        bool useSplitDisplay =
             displayMode == "Up/Down" and rowCount <= MAX_SPLIT_ROWS
        float maximumVolume = 0.0
        int profileEndTime = rangeEndTime + barDurationMs
        int rangeWidthMs = math.max(
             barDurationMs,
             profileEndTime - rangeStartTime)
        int maximumWidthMs = math.max(
             1,
             int(math.round(rangeWidthMs * widthPct / 100.0)))

        for rowIndex = 0 to rowCount - 1
            maximumVolume := math.max(
                 maximumVolume,
                 array.get(profile, PROFILE_META_SIZE + rowIndex))

        if maximumVolume > 0.0
            float profileBottom = array.get(profile, META_BOTTOM)
            for rowIndex = 0 to rowCount - 1
                float rowVolume =
                     array.get(profile, PROFILE_META_SIZE + rowIndex)
                if rowVolume > 0.0
                    float rowUpVolume =
                         array.get(
                              profile,
                              PROFILE_META_SIZE + rowCount + rowIndex)
                    float rowDownVolume =
                         array.get(
                              profile,
                              PROFILE_META_SIZE + rowCount * 2 + rowIndex)
                    float rowLow =
                         profileBottom + rowIndex * rowHeight
                    float rowHigh =
                         math.min(profileTop, rowLow + rowHeight)
                    int rowWidthMs = math.max(
                         1,
                         int(math.round(
                              rowVolume / maximumVolume * maximumWidthMs)))
                    int rowLeft =
                         placement == "Right" ?
                         profileEndTime - rowWidthMs : rangeStartTime
                    int rowRight = rowLeft + rowWidthMs
                    bool insideValueArea =
                         rowIndex >= valueLowRow and
                              rowIndex <= valueHighRow

                    if not useSplitDisplay
                        color rowColor =
                             insideValueArea ?
                             color.new(valueTotalColor, 20) :
                             color.new(totalColor, 35)
                        box histogramRow = box.new(
                             left = rowLeft,
                             top = rowHigh,
                             right = rowRight,
                             bottom = rowLow,
                             xloc = xloc.bar_time,
                             bgcolor = rowColor,
                             border_color = color.new(rowColor, 100))
                        array.push(boxes, histogramRow)
                    else
                        int upWidthMs =
                             int(math.round(
                                  rowWidthMs * rowUpVolume / rowVolume))
                        if rowUpVolume > 0.0 and rowDownVolume > 0.0
                            upWidthMs := math.max(
                                 1,
                                 math.min(rowWidthMs - 1, upWidthMs))
                        else if rowUpVolume > 0.0
                            upWidthMs := rowWidthMs
                        else
                            upWidthMs := 0

                        int splitTime = rowLeft + upWidthMs
                        color displayedUpColor =
                             insideValueArea ?
                             color.new(valueUpColor, 15) :
                             color.new(upColor, 35)
                        color displayedDownColor =
                             insideValueArea ?
                             color.new(valueDownColor, 15) :
                             color.new(downColor, 35)

                        if rowUpVolume > 0.0 and splitTime > rowLeft
                            box upHistogramRow = box.new(
                                 left = rowLeft,
                                 top = rowHigh,
                                 right = splitTime,
                                 bottom = rowLow,
                                 xloc = xloc.bar_time,
                                 bgcolor = displayedUpColor,
                                 border_color =
                                      color.new(displayedUpColor, 100))
                            array.push(boxes, upHistogramRow)

                        if rowDownVolume > 0.0 and rowRight > splitTime
                            box downHistogramRow = box.new(
                                 left = splitTime,
                                 top = rowHigh,
                                 right = rowRight,
                                 bottom = rowLow,
                                 xloc = xloc.bar_time,
                                 bgcolor = displayedDownColor,
                                 border_color =
                                      color.new(displayedDownColor, 100))
                            array.push(boxes, downHistogramRow)

if barstate.islast
    f_clearBoxes(histBoxesA)
    f_clearBoxes(buyerVolumeZonesA)
    f_clearBoxes(sellerVolumeZonesA)
    f_clearLabels(buyerVolumeLabelsA)
    f_clearLabels(sellerVolumeLabelsA)
    f_clearLabels(localBuyerDominanceLabelsA)
    if not na(valBuyerTransitionLabelA)
        label.delete(valBuyerTransitionLabelA)
        valBuyerTransitionLabelA := na
    if not na(valBuyerRelativeShiftLabelA)
        label.delete(valBuyerRelativeShiftLabelA)
        valBuyerRelativeShiftLabelA := na
    if not na(valToPocDirectionalLabelA)
        label.delete(valToPocDirectionalLabelA)
        valToPocDirectionalLabelA := na
    if not na(pocToVahDirectionalLabelA)
        label.delete(pocToVahDirectionalLabelA)
        pocToVahDirectionalLabelA := na
    if not na(profileBackgroundA)
        box.delete(profileBackgroundA)
        profileBackgroundA := na

    int histogramBarMs = math.max(
         1,
         int(timeframe.in_seconds() * 1000.0))
    int endTimeA = endA + histogramBarMs
    int rangeWidthMsA = math.max(
         histogramBarMs,
         endTimeA - startA)
    int histogramMaximumWidthMsA = math.max(
         1,
         int(math.round(
              rangeWidthMsA * profileWidthPct / 100.0)))
    int histogramLabelTimeA =
         profilePlacement == "Left" ?
         startA :
         endTimeA - histogramMaximumWidthMsA
    int outsideLabelGapMsA = math.max(
         histogramBarMs * 2,
         int(math.round(histogramMaximumWidthMsA * 0.05)))
    int buyerHistogramLabelTimeA =
         histogramLabelTimeA - outsideLabelGapMsA
    int sellerHistogramLabelTimeA =
         histogramLabelTimeA - outsideLabelGapMsA * 2
    int valueAreaDirectionalLabelTimeA =
         histogramLabelTimeA - outsideLabelGapMsA * 3
    int reversalMarkerTimeA =
         histogramLabelTimeA
    color boundaryColorA =
         showRangeBoundaries ?
         color.new(color.aqua, 40) : color.new(color.aqua, 100)
    levelExtension =
         extendLevelsRight ? extend.right : extend.none

    line.set_color(lineStartA, boundaryColorA)
    line.set_color(lineEndA, boundaryColorA)
    line.set_extend(lineVahA, levelExtension)
    line.set_extend(linePocA, levelExtension)
    line.set_extend(lineValA, levelExtension)

    if array.size(profileA) >= PROFILE_META_SIZE
        float bottomA = array.get(profileA, META_BOTTOM)
        float topA = array.get(profileA, META_TOP)
        if showProfileBackground
            profileBackgroundA := box.new(
                 left = startA,
                 top = topA,
                 right = endTimeA,
                 bottom = bottomA,
                 xloc = xloc.bar_time,
                 bgcolor = profileBackgroundColor,
                 border_color = color.new(color.aqua, 75))
        line.set_xy1(lineStartA, startA, bottomA)
        line.set_xy2(lineStartA, startA, topA)
        line.set_xy1(lineEndA, endTimeA, bottomA)
        line.set_xy2(lineEndA, endTimeA, topA)
        line.set_xy1(lineVahA, startA, vahA)
        line.set_xy2(lineVahA, endTimeA, vahA)
        line.set_xy1(linePocA, startA, pocA)
        line.set_xy2(linePocA, endTimeA, pocA)
        line.set_xy1(lineValA, startA, valA)
        line.set_xy2(lineValA, endTimeA, valA)
        f_drawHistogram(
             profileA,
             histBoxesA,
             startA,
             endA,
             histogramBarMs,
             profileWidthPct,
             profilePlacement,
             volumeDisplay,
             upVolumeColor,
             downVolumeColor,
             valueAreaUpColor,
             valueAreaDownColor,
             totalVolumeColor,
             valueAreaTotalColor)
        float[] buyerRowsA = f_topDirectionalRows(
             profileA,
             true,
             4)
        f_drawDirectionalRows(
             buyerRowsA,
             buyerVolumeZonesA,
             buyerVolumeLabelsA,
             startA,
             endTimeA,
             buyerHistogramLabelTimeA,
             buyerZoneColor,
             color.green,
             showBuyerZone,
             showBuyerZoneVolumes)

        float[] sellerRowsA = f_topDirectionalRows(
             profileA,
             false,
             2)
        f_drawDirectionalRows(
             sellerRowsA,
             sellerVolumeZonesA,
             sellerVolumeLabelsA,
             startA,
             endTimeA,
             sellerHistogramLabelTimeA,
             sellerZoneColor,
             color.red,
             showSellerZone,
             showSellerZoneVolumes)

        if showValueAreaDirectionalLabels and
             array.size(directionalVALToPOCA) >= 2
            float valToPocBuyerVolumeA =
                 array.get(directionalVALToPOCA, 0)
            float valToPocSellerVolumeA =
                 array.get(directionalVALToPOCA, 1)
            if valToPocBuyerVolumeA + valToPocSellerVolumeA > 0.0
                string valToPocDirectionalTextA =
                     "VAL to POC | Buyers x Sellers\n" +
                     f_directionalText(
                          valToPocBuyerVolumeA,
                          valToPocSellerVolumeA)
                color valToPocDirectionalColorA =
                     valToPocBuyerVolumeA >= valToPocSellerVolumeA ?
                     color.green : color.red
                valToPocDirectionalLabelA := label.new(
                     x = valueAreaDirectionalLabelTimeA,
                     y = (valA + pocA) * 0.5,
                     text = valToPocDirectionalTextA,
                     xloc = xloc.bar_time,
                     yloc = yloc.price,
                     style = label.style_label_right,
                     color = valToPocDirectionalColorA,
                     textcolor = color.white,
                     size = size.tiny)

        if showValueAreaDirectionalLabels and
             array.size(directionalPOCToVAHA) >= 2
            float pocToVahBuyerVolumeA =
                 array.get(directionalPOCToVAHA, 0)
            float pocToVahSellerVolumeA =
                 array.get(directionalPOCToVAHA, 1)
            if pocToVahBuyerVolumeA + pocToVahSellerVolumeA > 0.0
                string pocToVahDirectionalTextA =
                     "POC to VAH | Buyers x Sellers\n" +
                     f_directionalText(
                          pocToVahBuyerVolumeA,
                          pocToVahSellerVolumeA)
                color pocToVahDirectionalColorA =
                     pocToVahBuyerVolumeA >= pocToVahSellerVolumeA ?
                     color.green : color.red
                pocToVahDirectionalLabelA := label.new(
                     x = valueAreaDirectionalLabelTimeA,
                     y = (pocA + vahA) * 0.5,
                     text = pocToVahDirectionalTextA,
                     xloc = xloc.bar_time,
                     yloc = yloc.price,
                     style = label.style_label_right,
                     color = pocToVahDirectionalColorA,
                     textcolor = color.white,
                     size = size.tiny)

        if showVALBuyerTransition and
             array.size(valBuyerTransitionA) >= 5
            bool establishesBuyerControlA =
                 array.get(valBuyerTransitionA, 1) == 1.0
            string transitionTextA =
                 establishesBuyerControlA ?
                 "VAL Buyer Control" : "VAL Buyer Shift"
            color transitionColorA =
                 establishesBuyerControlA ?
                 valBuyerControlColor : valBuyerShiftColor
            valBuyerTransitionLabelA := label.new(
                 x = histogramLabelTimeA,
                 y = array.get(valBuyerTransitionA, 0),
                 text = transitionTextA,
                 xloc = xloc.bar_time,
                 yloc = yloc.price,
                 style = label.style_label_right,
                 color = transitionColorA,
                 textcolor = color.white,
                 size = size.tiny)

        if showVALBuyerRelativeShift and
             array.size(valBuyerRelativeShiftA) >= 4
            string relativeShiftTextA =
                 "VAL Buyer Shift | R: " +
                 str.tostring(
                      array.get(valBuyerRelativeShiftA, 1),
                      "#.##")
            valBuyerRelativeShiftLabelA := label.new(
                 x = histogramLabelTimeA,
                 y = array.get(valBuyerRelativeShiftA, 0),
                 text = relativeShiftTextA,
                 xloc = xloc.bar_time,
                 yloc = yloc.price,
                 style = label.style_label_right,
                 color = valBuyerShiftColor,
                 textcolor = color.white,
                 size = size.tiny)

        if showLocalBuyerDominance
            f_drawLocalBuyerDominanceRows(
                 profileA,
                 localBuyerDominanceLabelsA,
                 reversalMarkerTimeA,
                 localBuyerDominanceColor)

// =============================================================================
// 5. PROFILE SUMMARY TABLE
// =============================================================================
var table compTable = table.new(
     position = position.top_right,
     columns = 2,
     rows = 11,
     bgcolor = color.new(color.black, 15),
     border_width = 1,
     border_color = color.gray)

if barstate.islast
    string effectiveRowsA =
         array.size(profileA) >= PROFILE_META_SIZE ?
         str.tostring(int(array.get(profileA, META_ROW_COUNT))) : "n/a"
    float displayedTotalVolumeA =
         array.size(profileA) >= PROFILE_META_SIZE ?
         array.get(profileA, META_TOTAL_VOLUME) : totalVolA

    table.cell(
         compTable, 0, 0, "FRVP Summary",
         text_color = color.white,
         text_size = size.small)
    table.cell(
         compTable, 1, 0, "Selected Range",
         text_color = color.aqua,
         text_size = size.small)

    table.cell(
         compTable, 0, 1, "Total Volume Sum:",
         text_color = color.white,
         text_size = size.small)
    table.cell(
         compTable, 1, 1, str.tostring(displayedTotalVolumeA, "#,###"),
         text_color = color.yellow,
         text_size = size.small)

    table.cell(
         compTable, 0, 2, "VAH (Red Line):",
         text_color = color.white,
         text_size = size.small)
    table.cell(
         compTable, 1, 2, str.tostring(vahA, format.mintick),
         text_color = color.red,
         text_size = size.small)

    table.cell(
         compTable, 0, 3, "POC (White Line):",
         text_color = color.white,
         text_size = size.small)
    table.cell(
         compTable, 1, 3, str.tostring(pocA, format.mintick),
         text_color = color.white,
         text_size = size.small)

    table.cell(
         compTable, 0, 4, "VAL (Green Line):",
         text_color = color.white,
         text_size = size.small)
    table.cell(
         compTable, 1, 4, str.tostring(valA, format.mintick),
         text_color = color.green,
         text_size = size.small)
    table.cell(
         compTable, 0, 5, "Effective Rows:",
         text_color = color.white,
         text_size = size.small)
    table.cell(
         compTable, 1, 5, effectiveRowsA,
         text_color = color.aqua,
         text_size = size.small)

    table.cell(
         compTable, 0, 6, "Below VAL:",
         text_color = color.white,
         text_size = size.small)
    table.cell(
         compTable, 1, 6, f_formatVolume(volumeBelowVALA),
         text_color = color.silver,
         text_size = size.small)

    table.cell(
         compTable, 0, 7, "VAL to POC:",
         text_color = color.white,
         text_size = size.small)
    table.cell(
         compTable, 1, 7, f_formatVolume(volumeVALToPOCA),
         text_color = color.green,
         text_size = size.small)

    table.cell(
         compTable, 0, 8, "POC to VAH:",
         text_color = color.white,
         text_size = size.small)
    table.cell(
         compTable, 1, 8, f_formatVolume(volumePOCToVAHA),
         text_color = color.red,
         text_size = size.small)


    table.cell(
         compTable, 0, 9, "Above VAH:",
         text_color = color.white,
         text_size = size.small)
    table.cell(
         compTable, 1, 9, f_formatVolume(volumeAboveVAHA),
         text_color = color.silver,
         text_size = size.small)

    string profileSourceA =
         usesNativeFootprintA ? "Native Footprint" :
         not useNativeFootprint ? "OHLCV Approximation" :
         footprintCapacityExceededA ? "OHLCV (Footprint Limit)" :
         "OHLCV (Footprint Unavailable)"
    color profileSourceColorA =
         usesNativeFootprintA ? color.lime : color.orange

    table.cell(
         compTable, 0, 10, "Profile Source:",
         text_color = color.white,
         text_size = size.small)
    table.cell(
         compTable, 1, 10, profileSourceA,
         text_color = profileSourceColorA,
         text_size = size.small)
