     maxval = 20.0, step = 0.1, group = CONTEXT_GROUP,
     display = display.data_window,
     tooltip = "Combined volume of bullish expansion bars above their volume average divided by the combined average volume of those bars.")
float minimumExpansionBullVolumeSharePct = input.float(
