//@version=6
indicator(
     "Support Resistance Reclaim",
     shorttitle = "SR Reclaim",
     overlay = true,
     max_bars_back = 1000,
     max_lines_count = 300,
     max_labels_count = 100)

// Strict sequence: support in an advance -> close below support -> failed
// reclaim from underneath -> strong-volume close above rejection resistance.

// PARITY_DETECTION_START
// TradingView CSV exports include this ID. Increment it whenever detection
// behavior changes so Python cannot accept an export from an older build.
const int VALIDATION_BUILD_ID = 2026100402
const string DETECTION_GROUP = "Four-Stage Pattern"
const string QUALITY_GROUP = "Breakout Quality"
const string CONTEXT_GROUP = "Context Evidence"
const string DISPLAY_GROUP = "Display"
const int MAXIMUM_ACTIVE_CANDIDATES = 60
const int MAXIMUM_KNOWN_LEVELS = 60
const float MAXIMUM_EXTENDED_ENTRY_RANGE_PCT = 15.0
const float MAXIMUM_MODERATE_VWAP_GAP_PCT = 25.0
const float MAXIMUM_VWAP_GAP_WITHOUT_DEEP_RESET_PCT = 40.0
const float MINIMUM_DEEP_RESET_BODY_RANGE_PCT = 60.0
// A compact support shelf can sit fractionally below a still-falling fast
// EMA. Keep this exception deliberately narrow so it does not weaken the
// normal trend-alignment path.
const float NEAR_EMA_SUPPORT_TOLERANCE_PCT = 0.10
const float NEAR_EMA_ENTRY_TOLERANCE_PCT = 0.15
const int NEAR_EMA_MAXIMUM_SUPPORT_TOUCHES = 3
const int NEAR_EMA_MAXIMUM_SUPPORT_SPAN_BARS = 3
const int NEAR_EMA_MAXIMUM_SUPPORT_TO_BREAK_BARS = 2
const int NEAR_EMA_MINIMUM_WICK_DEFENSES = 2
const int NEAR_EMA_MINIMUM_RESISTANCE_BARS = 3
const int NEAR_EMA_MAXIMUM_RESISTANCE_BARS = 10
const float NEAR_EMA_MINIMUM_PRIOR_ADVANCE_PCT = 30.0
const float NEAR_EMA_MINIMUM_BREAKDOWN_BODY_PCT = 80.0
const float NEAR_EMA_MAXIMUM_SUPPORT_HIGH_GAP_PCT = 3.0
const float NEAR_EMA_MAXIMUM_ENTRY_DISTANCE_PCT = 5.0
const float NEAR_EMA_MINIMUM_ENTRY_BODY_PCT = 50.0
const float NEAR_EMA_MINIMUM_ENTRY_RANGE_PCT = 5.0
const float NEAR_EMA_MINIMUM_VOLUME_EXPANSION = 1.30
// A fresh multi-bar support pattern gets one qualified breakout decision.
// Weak body expansion, or a long unresolved stage without repeated attempts,
// exhausts that exact pattern instead of allowing a later substitute signal.
const float MINIMUM_FRESH_BREAKOUT_BODY_EXPANSION = 1.50
const int MAXIMUM_FRESH_RESISTANCE_STAGE_BARS = 30
const int MINIMUM_MATURE_FRESH_RESISTANCE_ATTEMPTS = 3
// Repeatedly crossing the same former-support price turns it into a two-sided
// congestion level. After four distinct resistance attempts it is no longer a
// clean support-to-resistance flip.
const int MAXIMUM_VALID_RESISTANCE_ATTEMPTS = 4
// Failed expansion: elevated-volume balance, weak acceptance above the
// balance, then a decisive bearish return into it within three bars.
const int FAILED_EXPANSION_COMPRESSION_BARS = 20
const int FAILED_EXPANSION_REJECTION_WINDOW_BARS = 3
const float MINIMUM_FAILED_EXPANSION_OVERLAP_PCT = 70.0
const float MINIMUM_FAILED_COMPRESSION_VOLUME_RATIO = 1.50
const float MINIMUM_FAILED_BREAKOUT_VOLUME_RATIO = 2.0
const float MAXIMUM_FAILED_BREAKOUT_CLOSE_LOCATION_PCT = 65.0
const float MINIMUM_FAILED_BREAKOUT_UPPER_WICK_PCT = 30.0
const float MINIMUM_FAILED_REJECTION_BODY_PCT = 60.0
const float MAXIMUM_FAILED_REJECTION_CLOSE_LOCATION_PCT = 25.0
const float MINIMUM_FAILED_REJECTION_VOLUME_RATIO = 0.60
// A late reclaim inside a persistent staircase of lower highs is not a fresh
// continuation signal when price already accepted above the resistance-contact
// line. Four fixed windows keep this test cheap enough for the live indicator.
const int LOWER_HIGH_WINDOW_BARS = 30
const float MINIMUM_LOWER_HIGH_STEP_PCT = 1.0
const float MINIMUM_LOWER_HIGH_DECLINE_PCT = 5.0
const float LOWER_HIGH_CLEARANCE_TOLERANCE_PCT = 0.20
const int MINIMUM_ACCEPTED_CONTACT_CLOSES = 2
// A lower reclaim is a SETUP only when its still-active blocking layer is
// immediately overhead. If that layer later disappears, a new complete
// reclaim may mature the prior setup into an entry within this window.
const float MAXIMUM_NESTED_BLOCKER_GAP_PCT = 1.0
const int MINIMUM_SETUP_TO_ENTRY_BARS = 2
const int MAXIMUM_SETUP_TO_ENTRY_BARS = 20
// Session maturity is based on distinct high/pullback tiers, not every small
// new high. A tier is confirmed by an 8% pullback; the next tier must clear the
// prior peak by 5%. It becomes a veto only for a distant, weak micro-reset.
const float TREND_TIER_PULLBACK_PCT = 8.0
const float NEW_TREND_TIER_PCT = 5.0
const int MINIMUM_MATURE_TREND_TIERS = 4
const int MINIMUM_DECLINING_TREND_TIERS = 2
const float TREND_TIER_VOLUME_DECLINE_FACTOR = 0.90
const int MAXIMUM_MATURE_RESET_EXPANSION_SCORE = 1
const int MINIMUM_MATURE_RESET_DISTANCE_BARS = 20
// Once a valid entry has already occurred, two more confirmed high/pullback
// tiers describe a mature continuation rather than the start of a fresh leg.
// Only a complete 5/5 entry candle may qualify beyond that point.
const int POST_ENTRY_MATURE_TREND_TIERS = 2
const int POST_ENTRY_REQUIRED_CONFIRMATION_SCORE = 5
const float MINIMUM_DECISIVE_BUYER_DEFENSE_WICK_PCT = 20.0
const float MINIMUM_PIVOT_SUPPORT_CLOSE_LOCATION_PCT = 25.0
const float SIGNAL_CLUSTER_CLEAR_TOLERANCE_PCT = 4.0
const int RAPID_HIGHER_CONTINUATION_MINUTES = 35
const int RAPID_HIGHER_PRIOR_STAGE_BARS = 5
const float RAPID_HIGHER_MINIMUM_VOLUME_EXPANSION = 4.0
const float PIVOT_EXPANSION_PASS_THROUGH_BODY_PCT = 75.0
const int NESTED_EXPANSION_ANCHOR_BARS = 3
const float MINIMUM_NESTED_ANCHOR_BODY_PCT = 60.0
const float MINIMUM_NESTED_ANCHOR_CLOSE_LOCATION_PCT = 75.0
const float MINIMUM_NESTED_ANCHOR_VOLUME_RATIO = 1.15

string scanSession = input.session(
     "0400-2000", "Detection Session", group = DETECTION_GROUP,
     display = display.data_window)
int supportAnchorLookbackBars = input.int(
     120, "Support Search Bars", minval = 5, maxval = 120,
     group = DETECTION_GROUP, display = display.data_window,
     tooltip = "Searches recent bars for support that the current bearish bar actually breaks.")
int supportEvidenceLookbackBars = input.int(
     120, "Support Evidence Bars", minval = 10, maxval = 120,
     group = DETECTION_GROUP, display = display.data_window)
int maximumSupportToBreakBars = input.int(
     15, "Maximum Bars From Support To Break", minval = 2, maxval = 60,
     group = DETECTION_GROUP, display = display.data_window,
     tooltip = "Prevents a distant low cluster from becoming support for an unrelated breakdown.")
int maximumSetupBars = input.int(
     720, "Maximum Bars Since Support Break", minval = 20, maxval = 960,
     group = DETECTION_GROUP, display = display.data_window)
int minimumSupportTouches = input.int(
     2, "Minimum Support Bars", minval = 2, maxval = 10,
     group = DETECTION_GROUP, display = display.data_window)
int maximumSupportTouches = input.int(
     30, "Maximum Support Bars", minval = 5, maxval = 60,
     group = DETECTION_GROUP, display = display.data_window)
int minimumBarsAfterBreak = input.int(
     2, "Minimum Bars After Breakdown", minval = 2, maxval = 20,
     group = DETECTION_GROUP, display = display.data_window,
     tooltip = "Forces breakdown, resistance, and breakout to be separate stages.")
int minimumResistanceBars = input.int(
     1, "Minimum Resistance Bars", minval = 1, maxval = 20,
     group = DETECTION_GROUP, display = display.data_window)
int maximumResistanceGapBars = input.int(
     720, "Maximum Gap Between Resistance Tests", minval = 1, maxval = 960,
     group = DETECTION_GROUP, display = display.data_window,
     tooltip = "A new resistance episode replaces old, disconnected rejection evidence.")
int priorAdvanceLookbackBars = input.int(
     120, "Prior Advance Lookback Bars", minval = 20, maxval = 240,
     group = DETECTION_GROUP, display = display.data_window)
float minimumPriorAdvancePct = input.float(
     8.0, "Minimum Advance Before Support (%)", minval = 1.0,
     maxval = 200.0, step = 0.5, group = DETECTION_GROUP,
     display = display.data_window)
float supportClusterTolerancePct = input.float(
     3.5, "Support Shelf Width (%)", minval = 0.25, maxval = 8.0,
     step = 0.25, group = DETECTION_GROUP,
     display = display.data_window,
     tooltip = "Candle lows build the shelf, while repeated closes above tightly grouped body floors can identify rejected wick probes below accepted support.")
float maximumAcceptedSupportSpreadPct = input.float(
     0.65, "Maximum Accepted Support Spread (%)", minval = 0.1,
     maxval = 3.0, step = 0.05, group = DETECTION_GROUP,
     display = display.data_window,
     tooltip = "Maximum spread between body floors when rejected lower wicks are used to define the accepted support line.")
float minimumSupportWickToBodyPct = input.float(
     50.0, "Minimum Support Wick / Body (%)", minval = 0.0,
     maxval = 500.0, step = 5.0, group = DETECTION_GROUP,
     display = display.data_window,
     tooltip = "A wick probe counts as defended when its lower wick is at least this large relative to its candle body.")
float minimumBuyerDefenseLowerWickPct = input.float(
     10.0, "Minimum Buyer-Defense Lower Wick (%)", minval = 0.0,
     maxval = 100.0, step = 1.0, group = DETECTION_GROUP,
     display = display.data_window,
     tooltip = "At least one bar in the support formation must recover from a lower wick this large relative to its full candle range. Compact support can use the support bar or one of the two immediately preceding same-level bars.")
float minimumBreakBelowSupportPct = input.float(
     0.0, "Minimum Close Below Support (%)", minval = 0.0,
     maxval = 5.0, step = 0.1, group = DETECTION_GROUP,
     display = display.data_window)
float resistanceTouchTolerancePct = input.float(
     4.0, "Resistance Contact Distance (%)", minval = 0.1,
     maxval = 10.0, step = 0.25, group = DETECTION_GROUP,
     display = display.data_window,
     tooltip = "After the break, price must return close to the frozen support zone from below.")
float minimumResistanceUpperWickPct = input.float(
     15.0, "Minimum Resistance Upper Wick (%)", minval = 0.0,
     maxval = 100.0, step = 1.0, group = DETECTION_GROUP,
     display = display.data_window,
     tooltip = "At least one resistance-stage candle must show active selling through an upper wick of this size relative to its full range.")

int volumeAverageBars = input.int(
     20, "Volume Average Bars", minval = 5, maxval = 100,
     group = QUALITY_GROUP, display = display.data_window)
float minimumVolumeExpansion = input.float(
     1.15, "Minimum Volume vs Resistance", minval = 1.0,
     maxval = 10.0, step = 0.05, group = QUALITY_GROUP,
     display = display.data_window,
     tooltip = "Compares breakout volume with average volume on resistance bars.")
int minimumQuietResistanceBars = input.int(
     2, "Minimum Quiet Resistance Bars", minval = 1, maxval = 10,
     group = QUALITY_GROUP, display = display.data_window)
float minimumBodyExpansion = input.float(
     2.0, "Quiet Resistance Body Expansion", minval = 1.0,
     maxval = 10.0, step = 0.1, group = QUALITY_GROUP,
     display = display.data_window)
float minimumBreakoutPct = input.float(
     0.0, "Minimum Close Above Resistance (%)", minval = 0.0,
     maxval = 20.0, step = 0.05, group = QUALITY_GROUP,
     display = display.data_window,
     tooltip = "Zero still requires a strict close above the highest prior rejection price.")
float minimumCloseLocationPct = input.float(
     50.0, "Minimum Close Location (%)", minval = 50.0,
     maxval = 100.0, step = 1.0, group = QUALITY_GROUP,
     display = display.data_window,
     tooltip = "The breakout must close in the upper half of its candle.")
float minimumEntryBodyRangePct = input.float(
     35.0, "Minimum Entry Body / Range (%)", minval = 0.0,
     maxval = 100.0, step = 1.0, group = QUALITY_GROUP,
     display = display.data_window)
float minimumEntryRangePct = input.float(
     3.0, "Minimum Entry Range (%)", minval = 0.1,
     maxval = 50.0, step = 0.1, group = QUALITY_GROUP,
     display = display.data_window)
float compactEntryMinimumRangePct = input.float(
     2.0, "Compact Entry Minimum Range (%)", minval = 0.1,
     maxval = 50.0, step = 0.1, group = QUALITY_GROUP,
     display = display.data_window)
float compactEntryQuietStagePct = input.float(
     80.0, "Compact Entry Quiet Stage (%)", minval = 0.0,
     maxval = 100.0, step = 1.0, group = QUALITY_GROUP,
     display = display.data_window,
     tooltip = "Allows a smaller reclaim candle only after a predominantly below-average-volume resistance stage with strong body expansion.")
float minimumBreakdownBodyRangePct = input.float(
     30.0, "Minimum Breakdown Body / Range (%)", minval = 0.0,
     maxval = 100.0, step = 1.0, group = QUALITY_GROUP,
     display = display.data_window)
int recentStructureLookbackBars = input.int(
     30, "Recent Structure Lookback Bars", minval = 5, maxval = 120,
     group = QUALITY_GROUP, display = display.data_window)
float maximumRecentHighGapPct = input.float(
     15.0, "Maximum Gap To Recent High (%)", minval = 1.0,
     maxval = 100.0, step = 0.5, group = QUALITY_GROUP,
     display = display.data_window)
int longResistanceStageBars = input.int(
     30, "Long Resistance Stage Bars", minval = 10, maxval = 180,
     group = QUALITY_GROUP, display = display.data_window)
int normalResistanceStageBars = input.int(
     10, "Normal Resistance Stage Bars", minval = 1, maxval = 60,
     group = QUALITY_GROUP, display = display.data_window)
float maximumLongStageSupportWidthPct = input.float(
     4.0, "Maximum Long-Stage Support Width (%)", minval = 0.25,
     maxval = 15.0, step = 0.25, group = QUALITY_GROUP,
     display = display.data_window,
     tooltip = "Long resistance stages require a precise original support shelf, not a broad price zone.")
int duplicateCooldownBars = input.int(
     0, "Duplicate Cooldown Bars", minval = 0, maxval = 30,
     group = QUALITY_GROUP, display = display.data_window)
float duplicateLevelTolerancePct = input.float(
     3.5, "Duplicate Level Tolerance (%)", minval = 0.1,
     maxval = 20.0, step = 0.25, group = QUALITY_GROUP,
     display = display.data_window)
float maximumOverheadResistanceDistancePct = input.float(
     15.0, "Maximum Overhead Block Distance (%)", minval = 1.0,
     maxval = 50.0, step = 0.5, group = QUALITY_GROUP,
     display = display.data_window)
int minimumStackedOverheadLevels = input.int(
     3, "Stacked Overhead Levels To Block", minval = 2, maxval = 10,
     group = QUALITY_GROUP, display = display.data_window)
float strongCandidateVolumeExpansion = input.float(
     3.0, "Strong Candidate Volume Expansion", minval = 1.0,
     maxval = 10.0, step = 0.25, group = QUALITY_GROUP,
     display = display.data_window,
     tooltip = "When several candidates qualify on one bar, strong participation is ranked first, followed by the highest reclaimed level. The behavior score classifies the selected candidate without removing valid historical entries.")
int preferredResistanceAttempts = input.int(
     2, "Preferred Resistance Attempts", minval = 1, maxval = 5,
     group = QUALITY_GROUP, display = display.data_window,
     tooltip = "Separate resistance approaches are counted as attempts. The historical test favored exactly two attempts, so this evidence receives two quality points.")
float maximumQualityVolumeVsResistance = input.float(
     3.0, "Quality Maximum Volume vs Resistance", minval = 1.0,
     maxval = 10.0, step = 0.25, group = QUALITY_GROUP,
     display = display.data_window,
     tooltip = "Rewards controlled breakout participation instead of an extreme volume spike relative to the resistance bars.")
float maximumQualityVolumeVsPriorThree = input.float(
     3.0, "Quality Maximum Volume vs Prior 3 Bars", minval = 1.0,
     maxval = 10.0, step = 0.25, group = QUALITY_GROUP,
     display = display.data_window,
     tooltip = "Rewards a breakout whose volume expansion is meaningful but not climactic compared with the three immediately preceding bars.")
float minimumStageBullBearVolumeRatio = input.float(
     1.0, "Quality Minimum Bull / Bear Relative Volume", minval = 0.1,
     maxval = 5.0, step = 0.05, group = QUALITY_GROUP,
     display = display.data_window,
     tooltip = "Compares average relative volume on bullish and bearish candles during the resistance stage. This is candle-direction volume, not bid/ask aggressor volume.")
int highQualityScoreThreshold = input.int(
     3, "High Quality Score", minval = 1, maxval = 5,
     group = QUALITY_GROUP, display = display.data_window,
     tooltip = "A quality entry earns two points for the preferred attempt count and one point for each controlled-volume or buyer-dominance confirmation. This changes ranking and the marker, not basic eligibility.")
int participationVolumeAverageBars = input.int(
     60, "Participation Volume Average Bars", minval = 20, maxval = 240,
     group = QUALITY_GROUP, display = display.data_window,
     tooltip = "Confirms that the entry has meaningful participation beyond the small resistance candles immediately before it.")
float minimumParticipationVolumeExpansion = input.float(
     1.5, "Minimum Participation Volume Expansion", minval = 0.5,
     maxval = 10.0, step = 0.1, group = QUALITY_GROUP,
     display = display.data_window)
float maximumUnconditionalReclaimDistancePct = input.float(
     7.0, "Maximum Ordinary Reclaim Distance (%)", minval = 1.0,
     maxval = 30.0, step = 0.5, group = QUALITY_GROUP,
     display = display.data_window,
     tooltip = "A distant reclaim must come from an exceptional prior advance or a clean multi-bar resistance build.")
float exceptionalPriorAdvancePct = input.float(
     90.0, "Exceptional Prior Advance (%)", minval = 10.0,
     maxval = 500.0, step = 5.0, group = QUALITY_GROUP,
     display = display.data_window)
float minimumMomentumEmaGapPct = input.float(
     5.0, "Minimum Rising EMA Gap (%)", minval = 0.0,
     maxval = 30.0, step = 0.5, group = QUALITY_GROUP,
     display = display.data_window,
     tooltip = "Alternative confirmation for entries already trading well above a rising EMA20.")
int momentumEmaSlopeBars = input.int(
     5, "EMA Slope Bars", minval = 1, maxval = 30,
     group = QUALITY_GROUP, display = display.data_window)
float minimumLongStagePriorAdvancePct = input.float(
     30.0, "Long-Stage Minimum Prior Advance (%)", minval = 5.0,
     maxval = 200.0, step = 1.0, group = QUALITY_GROUP,
     display = display.data_window,
     tooltip = "A level that remains unresolved for a long time must originate from a meaningful advance.")
float highConvictionParticipationExpansion = input.float(
     4.0, "High-Conviction Participation Expansion", minval = 1.0,
     maxval = 20.0, step = 0.25, group = QUALITY_GROUP,
     display = display.data_window,
     tooltip = "Exceptional participation can override stacked historical overhead when both local and broader volume are strong.")
float maximumSameRegimeSupportRisePct = input.float(
     15.0, "Maximum Same-Regime Support Rise (%)", minval = 1.0,
     maxval = 50.0, step = 0.5, group = QUALITY_GROUP,
     display = display.data_window,
     tooltip = "Suppresses a later higher micro-support signal until price first resets through the support zone of the prior entry.")

int maximumContextEvidenceBars = input.int(
     10, "Maximum Bars From Context Evidence", minval = 2, maxval = 30,
     group = CONTEXT_GROUP, display = display.data_window,
     tooltip = "Recent expansion or a nested lower-level reclaim can confirm the context of a later entry. Neither condition is a mandatory entry gate.")
float minimumExpansionCloseLocationPct = input.float(
     80.0, "Expansion Close Location (%)", minval = 50.0,
     maxval = 100.0, step = 1.0, group = CONTEXT_GROUP,
     display = display.data_window)
float minimumExpansionVolumeRatio = input.float(
     1.0, "Expansion Volume vs Prior 5 Bars", minval = 0.5,
     maxval = 10.0, step = 0.05, group = CONTEXT_GROUP,
     display = display.data_window)
float minimumExpansionRangeRatio = input.float(
     1.0, "Expansion Range vs Prior 5 Bars", minval = 0.5,
     maxval = 10.0, step = 0.05, group = CONTEXT_GROUP,
     display = display.data_window)
float minimumFullExpansionGainPct = input.float(
     10.0, "Full Expansion Minimum Gain (%)", minval = 0.0,
     maxval = 500.0, step = 0.5, group = CONTEXT_GROUP,
     display = display.data_window,
     tooltip = "Measures the complete EMA20 expansion regime from its launch through the first support bar, not only the final volume burst.")
float minimumExpansionBullVolumeRatio = input.float(
